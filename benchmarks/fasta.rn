// fasta benchmark - The Computer Language Benchmarks Game
// https://benchmarksgame-team.pages.debian.net/benchmarksgame/

// LCG random number generator constants
IM = 139968u32
IA = 3877u32
IC = 29573u32
// Store seed in array so bootstrap does not shadow it as a local variable
// (bootstrap compiler bug: bare assignment in a func creates a local shadow)
rngSeed = [42u32]
WIDTH = 60u32

// Homo sapiens alu repeat string (287 chars).
ALU = "GGCCGGGCGCGGTGGCTCACGCCTGTAATCCCAGCACTTTGGGAGGCCGAGGCGGGCGGATCACCTGAGGTCAGGAGTTCGAGACCAGCCTGGCCAACATGGTGAAACCCCGTCTCTACTAAAAATACAAAAATTAGCCGGGCGTGGTGGCGCGCGCCTGTAATCCCAGCTACTCGGGAGGCTGAGGCAGGAGAATCGCTTGAACCCGGGAGGCGGAGGTTGCAGTGAGCCGAGATCGCGCCACTGCACTCCAGCCTGGGCGACAGAGCGAGACTCCGTCTCAAAAA"

// Map every possible LCG result directly to its symbol.  Keep the leader's
// f32 cumulative sums and f32 r conversion: boundary choices are part of the
// benchmark's deterministic output.
func buildLookup(symbols: [u8], probabilities: [f32]) -> [u8] {
  lookup = [0u8]
  lookup.resize(<u64>IM)
  sum = probabilities[0u64]
  symbolIndex = 0u64
  i = 0u64
  while i < <u64>IM {
    r = <f32>(1.0f64 * <f64>i / <f64>IM)
    if r >= sum {
      symbolIndex += 1u64
      sum += probabilities[symbolIndex]
    }
    lookup[i] = symbols[symbolIndex]
    i += 1u64
  }
  return lookup
}

func repeatFasta(s: string, count: u32) {
  pos = 0u32
  slen = <u32>s.length()
  col = 0u32
  for i = 0u32, i < count, i += 1 {
    writeByte(<u8>s[pos])
    col += 1
    if col == WIDTH {
      writeByte(10u8)
      col = 0u32
    }
    pos += 1
    if pos == slen {
      pos = 0u32
    }
  }
  if col > 0u32 {
    writeByte(10u8)
  }
}

func randomFasta(lookup: [u8], count: u32) {
  col = 0u32
  for i = 0u32, i < count, i += 1 {
    rngSeed[0] = (rngSeed[0] * IA + IC) % IM
    writeByte(lookup[<u64>rngSeed[0]])
    col += 1
    if col == WIDTH {
      writeByte(10u8)
      col = 0u32
    }
  }
  if col > 0u32 {
    writeByte(10u8)
  }
}

// Parse N from command line
n = 1000u32
if argv.length() > 1 {
  passed = false
  n = argv[1].toUint(u32, passed)
}

// IUB ambiguity codes and Homo sapiens frequencies use the leader's symbol
// order and f32 probabilities.  Build each full LCG lookup once.
iubSyms = [97u8, 99u8, 103u8, 116u8, 66u8, 68u8, 72u8, 75u8,
           77u8, 78u8, 82u8, 83u8, 86u8, 87u8, 89u8]
iubProbs = [0.27f32, 0.12f32, 0.12f32, 0.27f32,
            0.02f32, 0.02f32, 0.02f32, 0.02f32, 0.02f32,
            0.02f32, 0.02f32, 0.02f32, 0.02f32, 0.02f32, 0.02f32]
iubLookup = buildLookup(iubSyms, iubProbs)

hsSyms = [97u8, 99u8, 103u8, 116u8]
hsProbs = [0.3029549426680f32, 0.1979883004921f32,
           0.1975473066391f32, 0.3015094502008f32]
hsLookup = buildLookup(hsSyms, hsProbs)

// Main sequence
println ">ONE Homo sapiens alu"
repeatFasta(ALU, n * 2u32)
println ">TWO IUB ambiguity codes"
randomFasta(iubLookup, n * 3u32)
println ">THREE Homo sapiens frequency"
randomFasta(hsLookup, n * 5u32)
