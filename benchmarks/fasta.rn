// fasta benchmark - The Computer Language Benchmarks Game
// https://benchmarksgame-team.pages.debian.net/benchmarksgame/

// LCG random number generator constants
IM = 139968u32
IA = 3877u32
IC = 29573u32
// Store seed in array so bootstrap does not shadow it as a local variable
// (bootstrap compiler bug: bare assignment in a func creates a local shadow)
rngSeed = [42u32]
WIDTH = 60u32
// A complete ALU block starts both on a line boundary and at the beginning of
// the repeat.  60 and the 287-byte ALU length are coprime, so their product
// is their least common multiple.
ALU_LENGTH = 287u32
REPEAT_BLOCK_BASES = WIDTH * ALU_LENGTH
REPEAT_BLOCK_BYTES = REPEAT_BLOCK_BASES + ALU_LENGTH
// Random output cannot be reused because every base advances the LCG, but a
// single buffer still turns 6,000 scalar writes into one bulk write.
RANDOM_BLOCK_LINES = 100u32
RANDOM_BLOCK_BASES = WIDTH * RANDOM_BLOCK_LINES
RANDOM_BLOCK_BYTES = RANDOM_BLOCK_BASES + RANDOM_BLOCK_LINES

// Homo sapiens alu repeat string (287 chars).
ALU = "GGCCGGGCGCGGTGGCTCACGCCTGTAATCCCAGCACTTTGGGAGGCCGAGGCGGGCGGATCACCTGAGGTCAGGAGTTCGAGACCAGCCTGGCCAACATGGTGAAACCCCGTCTCTACTAAAAATACAAAAATTAGCCGGGCGTGGTGGCGCGCGCCTGTAATCCCAGCTACTCGGGAGGCTGAGGCAGGAGAATCGCTTGAACCCGGGAGGCGGAGGTTGCAGTGAGCCGAGATCGCGCCACTGCACTCCAGCCTGGGCGACAGAGCGAGACTCCGTCTCAAAAA"

// Map every possible LCG result directly to its symbol.  Keep the leader's
// f32 cumulative sums and f32 r conversion: boundary choices are part of the
// benchmark's deterministic output.
func buildLookup(symbols: [u8], probabilities: [f32]) -> [u8] {
  lookup = [0u8]
  lookup.resize(<u64>IM)
  sum = probabilities[0u64]
  symbolIndex = 0u64
  i = 0u64
  while i < <u64>IM {
    r = <f32>(1.0f64 * <f64>i / <f64>IM)
    if r >= sum {
      symbolIndex += 1u64
      sum += probabilities[symbolIndex]
    }
    lookup[i] = symbols[symbolIndex]
    i += 1u64
  }
  return lookup
}

// Fill a wrapped output block and return its exact byte length.  The caller
// retains this allocation across writes; bases may include arbitrary bytes.
func fillRepeatBlock(var output: [u8], s: string, bases: u32) -> u32 {
  sequenceIndex = 0u32
  outputIndex = 0u32
  i = 0u32
  while i < bases {
    output[<u64>outputIndex] = <u8>s[<u64>sequenceIndex]
    outputIndex += 1u32
    if (i + 1u32) % WIDTH == 0u32 {
      output[<u64>outputIndex] = 10u8
      outputIndex += 1u32
    }
    sequenceIndex += 1u32
    if sequenceIndex == ALU_LENGTH {
      sequenceIndex = 0u32
    }
    i += 1u32
  }
  if bases % WIDTH != 0u32 {
    output[<u64>outputIndex] = 10u8
    outputIndex += 1u32
  }
  return outputIndex
}

func repeatFasta(s: string, count: u32) {
  output = [0u8]
  output.resize(<u64>REPEAT_BLOCK_BYTES)
  blockLength = fillRepeatBlock(output, s, REPEAT_BLOCK_BASES)
  remaining = count
  while remaining >= REPEAT_BLOCK_BASES {
    writeBytes(output, <u64>blockLength, 0u64)
    remaining -= REPEAT_BLOCK_BASES
  }
  if remaining > 0u32 {
    partialLength = fillRepeatBlock(output, s, remaining)
    writeBytes(output, <u64>partialLength, 0u64)
  }
}

func fillRandomBlock(var output: [u8], lookup: [u8], bases: u32) -> u32 {
  outputIndex = 0u32
  i = 0u32
  while i < bases {
    rngSeed[0] = (rngSeed[0] * IA + IC) % IM
    output[<u64>outputIndex] = lookup[<u64>rngSeed[0]]
    outputIndex += 1u32
    if (i + 1u32) % WIDTH == 0u32 {
      output[<u64>outputIndex] = 10u8
      outputIndex += 1u32
    }
    i += 1u32
  }
  if bases % WIDTH != 0u32 {
    output[<u64>outputIndex] = 10u8
    outputIndex += 1u32
  }
  return outputIndex
}

func randomFasta(lookup: [u8], count: u32) {
  output = [0u8]
  output.resize(<u64>RANDOM_BLOCK_BYTES)
  remaining = count
  while remaining >= RANDOM_BLOCK_BASES {
    blockLength = fillRandomBlock(output, lookup, RANDOM_BLOCK_BASES)
    writeBytes(output, <u64>blockLength, 0u64)
    remaining -= RANDOM_BLOCK_BASES
  }
  if remaining > 0u32 {
    partialLength = fillRandomBlock(output, lookup, remaining)
    writeBytes(output, <u64>partialLength, 0u64)
  }
}

// Parse N from command line
n = 1000u32
if argv.length() > 1 {
  passed = false
  n = argv[1].toUint(u32, passed)
}

// IUB ambiguity codes and Homo sapiens frequencies use the leader's symbol
// order and f32 probabilities.  Build each full LCG lookup once.
iubSyms = [97u8, 99u8, 103u8, 116u8, 66u8, 68u8, 72u8, 75u8,
           77u8, 78u8, 82u8, 83u8, 86u8, 87u8, 89u8]
iubProbs = [0.27f32, 0.12f32, 0.12f32, 0.27f32,
            0.02f32, 0.02f32, 0.02f32, 0.02f32, 0.02f32,
            0.02f32, 0.02f32, 0.02f32, 0.02f32, 0.02f32, 0.02f32]
iubLookup = buildLookup(iubSyms, iubProbs)

hsSyms = [97u8, 99u8, 103u8, 116u8]
hsProbs = [0.3029549426680f32, 0.1979883004921f32,
           0.1975473066391f32, 0.3015094502008f32]
hsLookup = buildLookup(hsSyms, hsProbs)

// Main sequence
println ">ONE Homo sapiens alu"
repeatFasta(ALU, n * 2u32)
println ">TWO IUB ambiguity codes"
randomFasta(iubLookup, n * 3u32)
println ">THREE Homo sapiens frequency"
randomFasta(hsLookup, n * 5u32)
