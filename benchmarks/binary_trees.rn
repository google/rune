class Node(self: Node, allocationTag: u8) {
  self.left = null(self)
  self.right = null(self)

  func check(self) -> u32 {
    sum = 1u32
    left = self.left
    right = self.right
    if !isnull(left) {
      sum += left.check()
    }
    if !isnull(right) {
      sum += right.check()
    }
    return sum
  }
}

func makeTree(depth: u32) -> Node {
  node = Node(0u8)
  if depth != 0u32 {
    node.left = makeTree(depth - 1u32)
    node.right = makeTree(depth - 1u32)
  }
  return node
}

func checkRegionTree(depth: u32) -> u32 {
  return makeTree(depth).check()
}

minDepth = 4u32
maxDepth = 10u32
if argv.length() > 1 {
  passed = false
  maxDepth = argv[1].toUint(u32, passed)
}
stretchDepth = maxDepth + 1
stretchCheck = withRegion(
    stretchDepth, &checkRegionTree(stretchDepth), 0u64)
println "stretch tree of depth %u\t check: " % stretchDepth, stretchCheck
longLivedTree = makeTree(maxDepth)
iterations = 1u32 << maxDepth
for depth in range(minDepth, stretchDepth, 2u32) {
    checkTotal = 0u32
    for i = 1u32, i < iterations + 1u32, i += 1 {
        checkTotal += withRegion(
            depth, &checkRegionTree(depth), 0u64)
    }
    println "%u\t trees of depth %u\t check: " % (iterations, depth), checkTotal
    iterations >>= 2
}
println "long lived tree of depth %u\t check: " % maxDepth, longLivedTree.check()
