// k-nucleotide benchmark - The Computer Language Benchmarks Game
// https://benchmarksgame-team.pages.debian.net/benchmarksgame/
//
// The explicit ByteReader buffers stdin and reuses one line array. This avoids
// a runtime call per input byte while retaining arbitrary-length and final
// unterminated FASTA lines.

DNA_BASE_BITS = 2u64
DNA_ALPHABET_SIZE = 4u64
INITIAL_DNA_CAPACITY = 65536u64
IDENTITY_HASH_MAX_K = 6u64

ASCII_A = 65u8
ASCII_C = 67u8
ASCII_E = 69u8
ASCII_G = 71u8
ASCII_H = 72u8
ASCII_R = 82u8
ASCII_T = 84u8
ASCII_LOWER_A = 97u8
ASCII_LOWER_Z = 122u8
ASCII_CASE_OFFSET = 32u8
FASTA_HEADER = 62u8
BYTE_READER_EOF = 256u16

// Format a f64 as a string with exactly 3 decimal places.
func fmt3(v: f64) -> string {
  a = v
  scaled = a * 1000.0f64 + 0.5f64
  n = <u64>scaled
  ip = n / 1000u64
  fp = n % 1000u64
  s = ip.toString()
  s += "."
  fps = fp.toString()
  pad = 3u64 - fps.length()
  for kp = 0u64, kp < pad, kp += 1 {
    s += "0"
  }
  s += fps
  return s
}

// Sort parallel k-mer/count arrays by descending count, then ascending k-mer.
// The numeric k-mer order is the lexicographic order for A,C,G,T.
func sortKmerIndices(var kArr: [u64], var cArr: [u64]) {
  n = kArr.length()
  si = 1u64
  while si < n {
    keyK = kArr[si]
    keyC = cArr[si]
    j = si
    cont = true
    while j > 0u64 && cont {
      prevK = kArr[j - 1u64]
      prevC = cArr[j - 1u64]
      doSwap = false
      if prevC < keyC {
        doSwap = true
      }
      if prevC == keyC {
        if keyK < prevK {
          doSwap = true
        }
      }
      if doSwap {
        kArr[j] = prevK
        cArr[j] = prevC
        j -= 1u64
      } else {
        cont = false
      }
    }
    kArr[j] = keyK
    cArr[j] = keyC
    si += 1u64
  }
}

// Map uppercase DNA base (u8) to 0..3: A=0 C=1 G=2 T=3.
func charIdx(c: u8) -> u64 {
  if c == ASCII_A {
    return 0u64
  }
  if c == ASCII_C {
    return 1u64
  }
  if c == ASCII_G {
    return 2u64
  }
  return 3u64
}

func kmerMask(k: u64) -> u64 {
  return (1u64 << (DNA_BASE_BITS * k)) - 1u64
}

// Count every k-mer with Rune's open-addressed u64 map. Keeping the packed key
// in a u64 makes the rolling update constant-time for all requested lengths.
func countKmers(var dnaB: [u8], k: u64) -> U64Map {
  // Small packed keys already occupy the table uniformly. The FASTA
  // generator strongly correlates low bits for longer k-mers, so those use
  // the map's avalanche mixer instead of pathological identity slots.
  counts = u64MapNew(k <= IDENTITY_HASH_MAX_K)
  dnaLen = dnaB.length()
  if k > dnaLen {
    return counts
  }

  mask = kmerMask(k)
  key = 0u64
  i = 0u64
  // Build the first k-mer up to its final base without touching the map.
  // Keeping this short warmup separate removes the per-byte readiness branch
  // from the full steady-state scan. The k == 0 guard preserves this helper's
  // previous behavior even though every benchmark call uses a positive k.
  warmupEnd = 0u64
  if k > 0u64 {
    warmupEnd = k - 1u64
  }
  while i < warmupEnd {
    key = ((key << DNA_BASE_BITS) | <u64>dnaB[i]) & mask
    i += 1u64
  }

  // Each remaining byte completes exactly one k-mer, so the hot loop needs
  // no readiness test before incrementing the map.
  while i < dnaLen {
    key = ((key << DNA_BASE_BITS) | <u64>dnaB[i]) & mask
    // This benchmark is built with -U. Its owned live map and finite input
    // establish the unchecked increment's lifetime and count bounds.
    u64MapIncrementUnchecked(counts, key)
    i += 1u64
  }
  return counts
}

// Count and print all k-mers of the given length, sorted by count desc / kmer asc.
func printKmers(var dnaB: [u8], k: u64) {
  dnaLen = dnaB.length()
  counts = countKmers(dnaB, k)

  // Precompute powers of 4: powers[j] = 4^j
  powers = [1u64]
  powers.resize(k)
  pc = 1u64
  while pc < k {
    prev = powers[pc - 1u64]
    powers[pc] = prev * DNA_ALPHABET_SIZE
    pc += 1u64
  }

  // Copy the map into small parallel arrays for deterministic output. The key
  // array is independent of the map, so the map can be freed before sorting.
  kmerIndices = u64MapKeys(counts)
  numEntries = kmerIndices.length()
  kmerCounts = [0u64]
  kmerCounts.resize(numEntries)
  countIndex = 0u64
  while countIndex < numEntries {
    kmerCounts[countIndex] = u64MapGetOrZero(counts, kmerIndices[countIndex])
    countIndex += 1u64
  }
  u64MapFree(counts)
  sortKmerIndices(kmerIndices, kmerCounts)

  baseBytes = [ASCII_A, ASCII_C, ASCII_G, ASCII_T]
  total = dnaLen - k + 1u64
  pIdx = 0u64
  while pIdx < numEntries {
    kmerIndex = kmerIndices[pIdx]
    jc = 0u64
    while jc < k {
      cIdxVal = (kmerIndex / powers[k - 1u64 - jc]) % DNA_ALPHABET_SIZE
      writeByte(baseBytes[cIdxVal])
      jc += 1u64
    }
    pct = 100.0f64 * <f64>kmerCounts[pIdx] / <f64>total
    writeByte(32u8)
    println fmt3(pct)
    pIdx += 1u64
  }
  println ""
}

func encodeSeq(seq: string) -> u64 {
  key = 0u64
  i = 0u64
  while i < seq.length() {
    key = (key << DNA_BASE_BITS) | charIdx(<u8>seq[i])
    i += 1u64
  }
  return key
}

// Count every k-mer of seq's length in a library map, then query the requested
// sequence. This deliberately performs the full CLBG hash-table workload.
func countSeq(var dnaB: [u8], seq: string) -> u64 {
  counts = countKmers(dnaB, seq.length())
  count = u64MapGetOrZero(counts, encodeSeq(seq))
  u64MapFree(counts)
  return count
}

// Main: read buffered FASTA lines, find the header beginning with >THREE, and
// collect that record's DNA as packed-base digits. Start from a non-empty array
// and grow explicitly by doubling so input lines and records are unbounded by
// the initial allocation.
dnaCapacity = INITIAL_DNA_CAPACITY
dnaLength = 0u64
dnaBytes = [0u8]
dnaBytes.resize(dnaCapacity)
inThree = false
line = [0u8]
line.resize(0u64)
reader = byteReaderNew()
nextByte = byteReaderPeekByte(reader)
while nextByte != BYTE_READER_EOF {
  line = byteReaderReadlnInto(reader, line)
  lineLength = line.length()
  if lineLength > 0u64 && line[0] == FASTA_HEADER {
    inThree = false
    if lineLength >= 6u64 && line[1] == ASCII_T && line[2] == ASCII_H && line[3] == ASCII_R && line[4] == ASCII_E && line[5] == ASCII_E {
      inThree = true
    }
  } else if inThree {
    requiredCapacity = dnaLength + lineLength
    while dnaCapacity < requiredCapacity {
      dnaCapacity *= 2u64
    }
    if dnaBytes.length() < dnaCapacity {
      dnaBytes.resize(dnaCapacity)
    }

    lineIndex = 0u64
    while lineIndex < lineLength {
      cb = line[lineIndex]
      if cb >= ASCII_LOWER_A && cb <= ASCII_LOWER_Z {
        cb -= ASCII_CASE_OFFSET
      }
      dnaBytes[dnaLength] = <u8>charIdx(cb)
      dnaLength += 1u64
      lineIndex += 1u64
    }
  }
  nextByte = byteReaderPeekByte(reader)
}
byteReaderFree(reader)

dnaBytes.resize(dnaLength)

// Print k=1 and k=2 kmer frequencies.
printKmers(dnaBytes, 1u64)
printKmers(dnaBytes, 2u64)

// Print counts for specific sequences.
seqs = ["GGT", "GGTA", "GGTATT", "GGTATTTTAATT", "GGTATTTTAATTTATAGT"]
ssi = 0u64
while ssi < seqs.length() {
  seq = seqs[ssi]
  cnt = countSeq(dnaBytes, seq)
  println cnt, "\t", seq
  ssi += 1u64
}
