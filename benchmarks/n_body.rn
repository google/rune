// n-body benchmark - The Computer Language Benchmarks Game.
// Jovian planets + sun, symplectic-Euler integration, dt = 0.01.
//
// NOTE ON SQRT: Rune's math.sqrt is a software Newton's-method routine (there
// is no libm intrinsic exposed to Rune programs), so the pairwise-force sqrt
// dominates runtime. The C reference (n_body_ref.c) uses the SAME iterative
// sqrt so the two are an apples-to-apples language/codegen comparison; a libm
// build of the C reference is faster and is reported separately.

import math

PI = 3.141592653589793f64
solarMass = 4.0f64 * PI * PI
daysPerYear = 365.24f64

// Five bodies: index 0 = sun, 1..4 = Jupiter, Saturn, Uranus, Neptune.
x = [0.0f64, 4.84143144246472090f64, 8.34336671824457987f64,
     12.894369562139131f64, 15.379697114850917f64]
y = [0.0f64, -1.16032004402742839f64, 4.12479856412430479f64,
     -15.111151401698631f64, -25.919314609987964f64]
z = [0.0f64, -0.103622044471123109f64, -0.403523417114321381f64,
     -0.223307578892655734f64, 0.179258772950371181f64]
vx = [0.0f64, 0.00166007664274403694f64, -0.00276742510726862411f64,
      0.00296460137564761618f64, 0.00268067772490389322f64]
vy = [0.0f64, 0.00769901118419740425f64, 0.00499852801234917238f64,
      0.00237847173959480950f64, 0.00162824170038242295f64]
vz = [0.0f64, -0.0000690460016972063023f64, 0.0000230417297573763929f64,
      -0.0000296589568540237556f64, -0.0000951592254519715870f64]
mass = [1.0f64, 0.000954791938424326609f64, 0.000285885980666130812f64,
        0.0000436624404335156298f64, 0.0000515138902046611451f64]

NBODIES = 5u64

// Format a double to exactly 9 decimal places (matches C's %.9f for these
// value ranges); there is no width/precision format specifier in Rune.
func fmt9(v: f64) -> string {
  neg = v < 0.0f64
  a = v
  if neg {
    a = -v
  }
  scaled = a * 1.0e9f64 + 0.5f64
  n = <u64>scaled
  ip = n / 1000000000u64
  fp = n % 1000000000u64
  s = ""
  if neg {
    s = "-"
  }
  s += ip.toString()
  s += "."
  fps = fp.toString()
  pad = 9u64 - fps.length()
  for k = 0u64, k < pad, k += 1 {
    s += "0"
  }
  s += fps
  return s
}

func advance(dt: f64) {
  for i = 0u64, i < NBODIES, i += 1 {
    for j = i + 1u64, j < NBODIES, j += 1 {
      dx = x[i] - x[j]
      dy = y[i] - y[j]
      dz = z[i] - z[j]
      d2 = dx * dx + dy * dy + dz * dz
      dist = math.sqrt(d2)
      mag = dt / (d2 * dist)
      mi = mass[i]
      mj = mass[j]
      vx[i] = vx[i] - dx * mj * mag
      vy[i] = vy[i] - dy * mj * mag
      vz[i] = vz[i] - dz * mj * mag
      vx[j] = vx[j] + dx * mi * mag
      vy[j] = vy[j] + dy * mi * mag
      vz[j] = vz[j] + dz * mi * mag
    }
  }
  for i = 0u64, i < NBODIES, i += 1 {
    x[i] = x[i] + dt * vx[i]
    y[i] = y[i] + dt * vy[i]
    z[i] = z[i] + dt * vz[i]
  }
}

func energy() -> f64 {
  e = 0.0f64
  for i = 0u64, i < NBODIES, i += 1 {
    e += 0.5f64 * mass[i] * (vx[i] * vx[i] + vy[i] * vy[i] + vz[i] * vz[i])
    for j = i + 1u64, j < NBODIES, j += 1 {
      dx = x[i] - x[j]
      dy = y[i] - y[j]
      dz = z[i] - z[j]
      dist = math.sqrt(dx * dx + dy * dy + dz * dz)
      e -= mass[i] * mass[j] / dist
    }
  }
  return e
}

func offsetMomentum() {
  px = 0.0f64
  py = 0.0f64
  pz = 0.0f64
  for i = 0u64, i < NBODIES, i += 1 {
    px += vx[i] * mass[i]
    py += vy[i] * mass[i]
    pz += vz[i] * mass[i]
  }
  vx[0] = -px / solarMass
  vy[0] = -py / solarMass
  vz[0] = -pz / solarMass
}

n = 1000u64
if argv.length() > 1 {
  passed = false
  n = argv[1].toUint(u64, passed)
}

// Scale velocities to units of days/year and masses to solar masses.
for i = 0u64, i < NBODIES, i += 1 {
  vx[i] = vx[i] * daysPerYear
  vy[i] = vy[i] * daysPerYear
  vz[i] = vz[i] * daysPerYear
  mass[i] = mass[i] * solarMass
}

offsetMomentum()
println fmt9(energy())
for step = 0u64, step < n, step += 1 {
  advance(0.01f64)
}
println fmt9(energy())
