// reverse_complement.rn
// The Computer Language Benchmarks Game
// https://benchmarksgame-team.pages.debian.net/benchmarksgame/
//
// Reads FASTA from stdin (as produced by fasta), prints reverse-complement
// of each record wrapped at 60 columns with uppercase output.
//
// The bootstrap readln() implementation uses getline and returns a headed Rune
// string, so this processes each complete FASTA line without per-byte input
// calls. CLBG FASTA inputs have no blank lines; an empty line is the EOF marker.
// The sequence buffer starts from a 1-element literal to avoid empty-array
// resize fragility and grows without a fixed record-size limit.

COMPLEMENT_TABLE_SIZE = 256u64
complementTable = [0u8]
complementTable.resize(COMPLEMENT_TABLE_SIZE)
tableIndex = 0u64
while tableIndex < COMPLEMENT_TABLE_SIZE {
  complementTable[tableIndex] = <u8>tableIndex
  tableIndex += 1u64
}

complementTable[65u64] = 84u8
complementTable[97u64] = 84u8
complementTable[67u64] = 71u8
complementTable[99u64] = 71u8
complementTable[71u64] = 67u8
complementTable[103u64] = 67u8
complementTable[84u64] = 65u8
complementTable[116u64] = 65u8
complementTable[85u64] = 65u8
complementTable[117u64] = 65u8
complementTable[77u64] = 75u8
complementTable[109u64] = 75u8
complementTable[82u64] = 89u8
complementTable[114u64] = 89u8
complementTable[87u64] = 87u8
complementTable[119u64] = 87u8
complementTable[83u64] = 83u8
complementTable[115u64] = 83u8
complementTable[89u64] = 82u8
complementTable[121u64] = 82u8
complementTable[75u64] = 77u8
complementTable[107u64] = 77u8
complementTable[86u64] = 66u8
complementTable[118u64] = 66u8
complementTable[72u64] = 68u8
complementTable[104u64] = 68u8
complementTable[68u64] = 72u8
complementTable[100u64] = 72u8
complementTable[66u64] = 86u8
complementTable[98u64] = 86u8
complementTable[78u64] = 78u8
complementTable[110u64] = 78u8

func emitRevComp(seq: [u8], seqLen: u64) {
  // This local remains a compile-time constant in the generated helper.
  outputBufferCapacity = 65536u64
  output = [0u8]
  output.resize(outputBufferCapacity)
  outputLen = 0u64
  col = 0u32
  i = seqLen
  while i > 0u64 {
    i -= 1u64
    output[outputLen] = complementTable[seq[i]]
    outputLen += 1u64
    if outputLen == outputBufferCapacity {
      writeBytes(output)
      outputLen = 0u64
    }
    col += 1u32
    if col == 60u32 {
      output[outputLen] = 10u8
      outputLen += 1u64
      if outputLen == outputBufferCapacity {
        writeBytes(output)
        outputLen = 0u64
      }
      col = 0u32
    }
  }
  if col > 0u32 {
    output[outputLen] = 10u8
    outputLen += 1u64
  }
  if outputLen > 0u64 {
    trimmedOutput = output.resize(outputLen)
    writeBytes(trimmedOutput)
  }
}

// Sequence buffer: start with a 1-element literal (avoids the bootstrap
// empty-array-resize fragility), size to an initial capacity, then grow by
// doubling as needed so arbitrarily long sequences are handled correctly.
seqCap = 65536u64
seq = [0u8]
seq.resize(seqCap)
seqLen = 0u64
inRecord = false
line = readln()
while line.length() > 0u64 {
  if <u8>line[0] == 62u8 {
    if inRecord {
      emitRevComp(seq, seqLen)
      seqLen = 0u64
    }
    println line
    inRecord = true
  } else {
    linePos = 0u64
    while linePos < line.length() {
      if seqLen >= seqCap {
        seqCap = seqCap * 2u64
        seq.resize(seqCap)
      }
      seq[seqLen] = <u8>line[linePos]
      seqLen += 1u64
      linePos += 1u64
    }
  }
  line = readln()
}

if inRecord {
  emitRevComp(seq, seqLen)
}
