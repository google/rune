// reverse_complement.rn
// The Computer Language Benchmarks Game
// https://benchmarksgame-team.pages.debian.net/benchmarksgame/
//
// Reads FASTA from stdin (as produced by fasta), prints reverse-complement
// of each record wrapped at 60 columns with uppercase output.
//
// The bootstrap readlnInto() implementation uses getline and reuses a headed
// Rune byte array, so this processes each complete FASTA line without per-byte
// input calls or a per-line allocation. CLBG FASTA inputs have no blank lines;
// an empty line is the EOF marker.
// The sequence buffer starts from a 1-element literal, then retains its
// capacity across records while appendBytes() grows it as necessary.

// writeReverseMasked5Translated() indexes its 32-byte table with byte & 31.
// Precondition: every sequence byte is an ASCII IUB base (case-insensitive).
// The CLBG FASTA producer guarantees that alphabet, so its upper- and lower-
// case representations share the exact mapping below. This explicit contract
// must not replace generic 256-byte translation tables.
MASKED_IUB_COMPLEMENT_TABLE_SIZE = 32u64
maskedIubComplementTable = [
  0u8, 84u8, 86u8, 71u8, 72u8, 0u8, 0u8, 67u8,
  68u8, 0u8, 0u8, 77u8, 0u8, 75u8, 78u8, 0u8,
  0u8, 0u8, 89u8, 83u8, 65u8, 65u8, 66u8, 87u8,
  0u8, 82u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8
]


// Sequence buffer: start with a 1-element literal (avoids the bootstrap
// empty-array-resize fragility), size to an initial capacity, then grow by
// doubling as needed so arbitrarily long sequences are handled correctly.
seq = [0u8]
seq.resize(0u64)
inRecord = false
line = [0u8]
line = readlnInto(line)
while line.length() > 0u64 {
  if line[0] == 62u8 {
    if inRecord {
      writeReverseMasked5Translated(seq, maskedIubComplementTable, 60u64, 10u8)
      seq.resize(0u64)
    }
    writeBytes(line)
    writeByte(10u8)
    inRecord = true
  } else {
    seq = appendBytes(seq, line)
  }
  line = readlnInto(line)
}

if inRecord {
  writeReverseMasked5Translated(seq, maskedIubComplementTable, 60u64, 10u8)
}
