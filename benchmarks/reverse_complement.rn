// reverse_complement.rn
// The Computer Language Benchmarks Game
// https://benchmarksgame-team.pages.debian.net/benchmarksgame/
//
// Reads FASTA from stdin (as produced by fasta), prints reverse-complement
// of each record wrapped at 60 columns with uppercase output.
//
// The explicit ByteReader buffers stdin and scans each raw sequence span until
// the next header marker. It copies maximal runs directly into a headed Rune
// byte array while omitting line feeds, avoiding per-line dispatch and any
// intermediate line copy. A binary-safe peek distinguishes all byte values
// from EOF.
// The sequence buffer starts from a 1-element literal, then retains its
// capacity across records while filtered span appends grow it as necessary.

// writeReverseMasked5Translated() indexes its 32-byte table with byte & 31.
// Precondition: every sequence byte is an ASCII IUB base (case-insensitive).
// The CLBG FASTA producer guarantees that alphabet, so its upper- and lower-
// case representations share the exact mapping below and the '>' delimiter
// cannot occur in sequence data. This explicit contract must not replace
// generic byte-delimited input or 256-byte translation semantics.
MASKED_IUB_COMPLEMENT_TABLE_SIZE = 32u64
maskedIubComplementTable = [
  0u8, 84u8, 86u8, 71u8, 72u8, 0u8, 0u8, 67u8,
  68u8, 0u8, 0u8, 77u8, 0u8, 75u8, 78u8, 0u8,
  0u8, 0u8, 89u8, 83u8, 65u8, 65u8, 66u8, 87u8,
  0u8, 82u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8
]


// Sequence buffer: start with a 1-element literal (avoids the bootstrap
// empty-array-resize fragility), size to an initial capacity, then grow by
// doubling as needed so arbitrarily long sequences are handled correctly.
seq = [0u8]
seq.resize(0u64)
inRecord = false
line = [0u8]
reader = byteReaderNew()
BYTE_READER_EOF = 256u16
FASTA_HEADER_MARKER = 62u8
FASTA_LINE_FEED = 10u8
FASTA_OUTPUT_WIDTH = 60u64
nextByte = byteReaderPeekByte(reader)
while nextByte != BYTE_READER_EOF {
  if nextByte == <u16>FASTA_HEADER_MARKER {
    line = byteReaderReadlnInto(reader, line)
    if inRecord {
      writeReverseMasked5Translated(
          seq, maskedIubComplementTable, FASTA_OUTPUT_WIDTH, FASTA_LINE_FEED)
      seq.resize(0u64)
    }
    writeBytes(line)
    writeByte(FASTA_LINE_FEED)
    inRecord = true
  } else {
    seq = byteReaderAppendUntilByteSkippingByteInto(
        reader, seq, FASTA_HEADER_MARKER, FASTA_LINE_FEED)
  }
  nextByte = byteReaderPeekByte(reader)
}
byteReaderFree(reader)

if inRecord {
  writeReverseMasked5Translated(
      seq, maskedIubComplementTable, FASTA_OUTPUT_WIDTH, FASTA_LINE_FEED)
}
