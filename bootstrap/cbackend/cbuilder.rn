import database as db
import types

use clanguageclasses
use ctypegen
use escapestring
use int2cstring
use sym

relation HashedClass CurrentScope CIdentifier cascade

class CurrentScope(self) {
  self.depth = 0u32

  func open(self) {
    self.depth += 1
  }

  // True if a local named |sym| is already declared with the wide-integer
  // C type in the current emission scope.  A use of the local then carries
  // a wide value even when the reference's own type resolved to a scalar.
  func declaredWide(self, sym: Sym) -> bool {
    probe = CIdentifier(sym, null(CTypeExpr), false, false, false)
    found = self.findCIdentifier(probe)
    if isnull(found) || isnull(found.type) {
      return false
    }
    ft = found.type!
    if ft.type == CTypeExpr.Type.Defined {
      return ft.cDefinedType.name == "rn_wide"
    }
    return false
  }

  func close(self) {
    // Forget identifiers that were bound in the scope being closed, so that
    // the same name can be re-declared in a different function.
    closing = arrayof(CIdentifier)
    for id in self.cIdentifiers() {
      if id.scopeDepth == self.depth {
        closing.append(id)
      }
    }
    for id in closing {
      self.removeCIdentifier(id)
    }
    self.depth -= 1
  }

  func getIdentifier(self, name: Sym, type: CTypeExpr?, bindingInstance: bool, isLocal: bool) -> CIdentifier {
    // TODO: isLocal must be set when name is a variable bound in the current scope
    // i.e., first assigned in the current function body.
    id = CIdentifier(name, type, false, bindingInstance, isLocal)
    exists = self.findCIdentifier(id)
    if isnull(exists) {
      id.firstInstance = true
      id.scopeDepth = self.depth
      self.insertCIdentifier(id)
    } else if exists.scopeDepth < self.depth {
      // The match belongs to an enclosing emission — a different C
      // function whose locals are invisible here; declare anew.
      id.firstInstance = true
      id.scopeDepth = self.depth
      self.insertCIdentifier(id)
    } else {
      id.isParameter = exists.isLocal
      id.isVarParam = exists.isVarParam
    }
    return id
  }
}


/**
 * @brief list of declarations
 *
 * When generating code for a function, add any declaration that is created
 * or used inside the function body to a list, which can be added to the
 * enclosing function declaration.
 */
class DependencyList(self) {
  self.names = arrayof(string)

  func append(self, decname: string) {
    self.names.append(decname)
  }
}


/**
 * @brief a stack of dependency lists
 *
 * Functions may be nested, so we maintain a stack of dependency lists,
 * where lists higher up the stack correspond to enclosing function
 * definitions.
 */
relation DoublyLinked DependencyStack DependencyList cascade
class DependencyStack(self) {
  self.open()

  func open(self) {
    self.appendDependencyList(DependencyList())
  }

  func append(self, dec: string | CDeclaration) {
    typeswitch dec {
      string => self.lastDependencyList.append(dec)
      CDeclaration => self.lastDependencyList.append(dec.name())
    }
  }

  func top(self) -> DependencyList {
    return self.lastDependencyList!
  }

  // Record a dependency on the innermost open list, if any.  A call emitted at
  // module level (no enclosing function) has no list; such top-level code is
  // emitted in main() after all declarations, so it needs no ordering hint.
  func appendIfOpen(self, decname: string) {
    if !isnull(self.lastDependencyList) {
      self.lastDependencyList.append(decname)
    }
  }

  func close(self) {
    top = self.lastDependencyList!
    self.removeDependencyList(top)
  }
}

relation DoublyLinked CBuilder CBlock cascade
relation OneToOne CBuilder DependencyStack cascade

class CBuilder(self, tc: types.TypeChecker) {
  self.currentParamList = null(CParamList)
  self.currentExprList = null(CExprList)
  self.program = CProgram()
  self.currentBlock = null(CBlock)
  self.identifierScope = CurrentScope()
  self.typechecker = tc
  self.typeGenerator = CTypeGenerator(tc)
  self.emittedClassDecls = arrayof(string)
  self.functionNames = arrayof(string)
  self.functions = arrayof(db.Function)
  // Frame-index locals of try statements lexically enclosing the current
  // codegen point (see Statement.genCTry).  Entries below tryFrameBase
  // belong to enclosing functions and must not be touched.
  self.tryFrameSyms = arrayof(Sym)
  self.tryFrameDepth = 0u64
  self.tryFrameBase = 0u64
  // Rune scopes variables to the function, C to the block: locals must be
  // declared in the function's body block even when first assigned inside a
  // nested block.  Each openScope records how many CBlocks were open; the
  // first block opened after that is the function's body block.
  self.scopeBlockBases = arrayof(u64)
  self.scopeBaseCount = 0u64
  self.openBlockCount = 0u64
  // Module-level variables holding objects with destructors, finalized
  // when main exits.
  self.mainFinalSyms = arrayof(Sym)
  self.mainFinalNames = arrayof(string)
  // Names of module-level variables: emitted as file-scope C statics so
  // functions can reference them (a main-local would be out of scope).
  self.moduleVarNames = arrayof(string)
  // The polymorphic function instance currently being emitted: recursive
  // calls inside it reuse its specialization name and result width
  // directly (their snapshot types can chain to stale def-time bindings).
  self.currentEmittingFn = null(db.Function)
  self.currentEmittingName = ""
  self.currentEmittingResultWide = 0u32
  self.insertDependencyStack(DependencyStack())

  func registerModuleVariable(self, name: string) {
    for n in self.moduleVarNames {
      if n == name {
        return
      }
    }
    self.moduleVarNames.append(name)
  }

  func isModuleVariable(self, name: string) -> bool {
    for n in self.moduleVarNames {
      if n == name {
        return true
      }
    }
    return false
  }

  // Only top-level module assignments become C globals: functions reference
  // them by name (e.g. a class instance like foo).  Loop variables and
  // assignments nested in module-level control flow stay main()-locals —
  // registering those would capture every function's same-named locals.
  func registerModuleVariables(self, module: db.Function) {
    for statement in module.subBlock.statements() {
      if statement.type == db.StateType.Assign && !isnull(statement.expr) {
        assignExpr = statement.expr!
        if assignExpr.type == db.ExprType.Equals {
          lhs = assignExpr.firstChildExpr!
          if lhs.type == db.ExprType.Ident {
            self.registerModuleVariable(lhs.val.symVal.name)
          }
        }
      }
    }
    for childfunc in module.childFunctions() {
      if childfunc.type == db.FuncType.Module {
        self.registerModuleVariables(childfunc)
      }
    }
  }

  func build(self, module: db.Function) -> CProgram {
    self.registerFunctions(module)
    self.registerModuleVariables(module)
    self.resolveNestedInstantiations(module)
    // Deferred bodies typecheck under their first concrete instantiation
    // BEFORE any emission: statement rewriting (iterator inlining) must
    // finish before the emitter walks code.  Their expression types are
    // shared variables; each emission resolves them under its own
    // instantiation bindings.
    // Deferred constructors first: they re-create the class fields the
    // deferred methods and operators reference.
    for dctor in self.functions {
      if dctor.deferredTypecheck && dctor.type == db.FuncType.Constructor {
        if !isnull(dctor.typedValue) {
          dcty = dctor.typedValue!
          if dcty.type == types.Type.TypeClass.Polymorphic {
            dcpi = dcty.poly.instantiations
            if !isnull(dcpi) {
              dcDone = false
              for dcinst in dcpi {
                if !dcDone {
                  self.resolveInstantiation(dcinst)
                  if self.instantiationIsConcrete(dcinst) {
                    self.instantiate(dcty.poly!, dcinst)
                    self.typechecker.retypecheckDeferred(dctor)
                    dctor.deferredRetypechecked = true
                    self.deInstantiate(dcty.poly!)
                    dcDone = true
                  }
                }
              }
            }
          }
        }
      }
    }
    for dfn in self.functions {
      if dfn.deferredTypecheck && !dfn.deferredRetypechecked && !isnull(dfn.typedValue) {
        dfty = dfn.typedValue!
        if dfty.type == types.Type.TypeClass.Polymorphic {
          dpi = dfty.poly.instantiations
          if !isnull(dpi) {
            dDone = false
            for dinst in dpi {
              if !dDone {
                self.resolveInstantiation(dinst)
                // The result slot (last) is what the retypecheck computes;
                // only the parameter bindings need to be concrete.
                dConc = true
                dnb = dinst.varBindings.length()
                for dvi in range(dnb) {
                  if dvi + 1 < dnb {
                    dvb = self.typechecker.resolve(dinst.varBindings[dvi])
                    // Free variables nested inside a composite binding
                    // (Dict(v135, v136)) under-bind the body just like a
                    // bare variable: the retypecheck would bake stale
                    // types AND consume the one-shot flag, starving the
                    // emission-time retypecheck under real bindings.
                    if self.typechecker.hasFreeVars(dvb) {
                      dConc = false
                    }
                  }
                }
                if dConc {
                  // Try instantiations until one typechecks cleanly: a
                  // recorded one can come from an unreachable typeswitch
                  // arm (e.g. decParens(()) in the turing test).
                  dPreErrs = self.typechecker.countTypeErrors()
                  self.instantiate(dfty.poly!, dinst)
                  self.typechecker.retypecheckDeferred(dfn)
                  dfn.deferredRetypechecked = true
                  self.deInstantiate(dfty.poly!)
                  if self.typechecker.countTypeErrors() > dPreErrs {
                    // This instantiation does not typecheck (it can come
                    // from an unreachable typeswitch arm); the legacy
                    // compiler never checks unreachable paths.
                    while self.typechecker.countTypeErrors() > dPreErrs {
                      self.typechecker.popTypeError()
                    }
                    if !isnull(dfn.subBlock) {
                      self.typechecker.clearExprTypes(dfn.subBlock!)
                    }
                    dfn.deferredRetypechecked = false
                  } else {
                    dDone = true
                  }
                }
              }
            }
          }
        }
      }
    }
    module.genC(self)
    // Destroy module-level objects with destructors when main exits.
    for index in range(self.mainFinalSyms.length()) {
      finalRef = CExpr(CIdentifier(self.mainFinalSyms[index], null(CTypeExpr),
          false, false, false))
      finalRef2 = CExpr(CIdentifier(self.mainFinalSyms[index], null(CTypeExpr),
          false, false, false))
      finalArgs = CExprList()
      finalArgs.appendCExpr(finalRef)
      self.openBlock(module.location)
      self.addStatement(module.location,
          self.cCall(module.location, self.mainFinalNames[index], CExpr(finalArgs)))
      finalBody = self.closeBlock()
      self.program.addStatementToMain(
          CStatement(module.location, CStatementType.If, finalRef2, finalBody))
    }
    return self.program
  }

  // The C name of the class's destructor for instance type |ty|, or "" if
  // the class declares no final().
  func classFinalName(self, ty: types.Type?) -> string {
    if isnull(ty) {
      return ""
    }
    t = self.typechecker.resolve(ty!)
    if t.type != types.Type.TypeClass.Typename {
      return ""
    }
    info = self.typechecker.lookupClass(t.tyname.name)
    if isnull(info) || isnull(info.fn) {
      return ""
    }
    for childfunc in info.fn.childFunctions() {
      if childfunc.type == db.FuncType.Final {
        return self.classCName(t) + "_final"
      }
    }
    return ""
  }

  // The C name of the class's generated destroy() for instance type |ty|,
  // or "" if its destroy body is empty (no final() and no relations), in
  // which case cleanup is a no-op and no call is emitted.
  func classDestroyName(self, ty: types.Type?) -> string {
    if isnull(ty) {
      return ""
    }
    t = self.typechecker.resolve(ty!)
    if t.type != types.Type.TypeClass.Typename {
      return ""
    }
    info = self.typechecker.lookupClass(t.tyname.name)
    if isnull(info) || isnull(info.fn) {
      return ""
    }
    for childfunc in info.fn.childFunctions() {
      if (childfunc.sym.name == "destroy" &&
          childfunc.type == db.FuncType.Plain &&
          !isnull(childfunc.subBlock.firstStatement)) {
        return self.classCName(t) + "_destroy"
      }
    }
    return ""
  }

  // Record a module-level variable holding an object that needs its
  // destructor run at program exit.
  func registerMainFinal(self, sym: Sym, finalName: string) {
    for existing in self.mainFinalSyms {
      if existing == sym {
        return
      }
    }
    self.mainFinalSyms.append(sym)
    self.mainFinalNames.append(finalName)
  }

  // Record every function by name so call sites can emit not-yet-seen
  // polymorphic specializations on demand.
  func registerFunctions(self, fn: db.Function) {
    for childfunc in fn.childFunctions() {
      self.functionNames.append(childfunc.sym.name)
      self.functions.append(childfunc)
      self.registerFunctions(childfunc)
    }
  }

  func findFunction(self, name: string) -> db.Function? {
    for index in range(self.functionNames.length()) {
      if self.functionNames[index] == name {
        return self.functions[index]
      }
    }
    return null(db.Function)
  }

  // True if every binding of the instantiation resolves to a concrete type
  // in the current unifier context.
  func instantiationIsConcrete(self, inst: types.TyvarInstantiation) -> bool {
    for binding in inst.varBindings {
      if self.typechecker.hasFreeVars(binding) {
        return false
      }
    }
    return true
  }

  func openDependencyList(self) {
    self.dependencyStack.open()
  }

  func topDependencyList(self) -> DependencyList {
    return self.dependencyStack.top()
  }

  // Note that the function currently being emitted calls `decname`, so the C
  // emitter orders `decname` first (or emits its prototype when the two are
  // mutually recursive, e.g. a cascade destroy_Foo <-> destroy_Bar).
  func noteDependency(self, decname: string) {
    self.dependencyStack.appendIfOpen(decname)
  }

  func closeDependencyList(self) {
    self.dependencyStack.close()
  }

  func addDeclaration(self, dec: CDeclaration) {
    self.dependencyStack.append(dec)
    self.program.insertCDeclaration(dec)
  }

  // Class support ------------------------------------------------------------

  // True if ty is a class instance type.
  func isClassType(self, ty: types.Type?) -> bool {
    return self.typechecker.isClassType(ty)
  }

  // The C name for a class instantiation, e.g. Point_u64_u64.  This matches
  // both the call-site specialization name and the typedef name (minus _t).
  // The C name of a class instance: its struct typedef, methods, fields, and
  // the instances declared with that type.  Phantom parameters (see
  // TypeUnifier.registerPhantomMask) are dropped, so two instances differing
  // only in a phantom position (MyString(string) vs MyString([u8])) name the
  // same struct and assign to one another.  Use classCtorCName for the
  // constructor, which must stay distinct per argument type.
  func classCName(self, ty: types.Type) -> string {
    return self.classCNameImpl(ty, true)
  }

  // The C name of a class constructor: keeps every parameter, including
  // phantom ones, so a class whose constructor body branches on a phantom
  // parameter's type (a compile-time typeswitch) emits one C function per
  // argument type even though they all build the same struct.
  func classCtorCName(self, ty: types.Type) -> string {
    return self.classCNameImpl(ty, false)
  }

  func classCNameImpl(self, ty: types.Type, dropPhantom: bool) -> string {
    t = self.typechecker.resolve(ty)
    assert t.type == types.Type.TypeClass.Typename
    // Unresolved class parameters fall back to the class's single concrete
    // instantiation, matching the names the type generator emits.
    tn = self.typeGenerator.concreteClassTyname(t.tyname!)
    if dropPhantom {
      tn = self.typechecker.dropPhantomParams(tn)
    }
    if isnull(tn.params) {
      return tn.name.name
    }
    spec = tn.specializationString()
    if spec == "" {
      return tn.name.name
    }
    return "%s_%s" % (tn.name.name, spec)
  }

  // The C name to call a class method by.  Monomorphic methods are named
  // from their definition's resolved parameter types: a parameter fixed to
  // AnyInt by a literal (e.g. size = 0) is emitted under "Uint"/"Int" while
  // call-site arguments carry concrete widths like u64, so argument-based
  // names would not match the definition.
  func methodCallCName(self, instanceTy: types.Type, methodName: string,
                       argsTy: types.Type?) -> string {
    inst = self.typechecker.resolve(instanceTy)
    if inst.type == types.Type.TypeClass.Typename {
      info = self.typechecker.lookupClass(inst.tyname.name)
      if !isnull(info) && !isnull(info.fn) {
        for childfunc in info.fn.childFunctions() {
          if childfunc.sym.name == methodName {
            mty = childfunc.typedValue
            if !isnull(mty) && mty.type == types.Type.TypeClass.Function {
              return self.methodDefCName(mty!, methodName)
            }
          }
        }
      }
    }
    return self.methodCName(instanceTy, methodName, argsTy)
  }

  // The piece of a method specialization name contributed by one argument
  // type.  Class instances render through classCName so that unresolved
  // class parameters fall back to the concrete instantiation, keeping
  // definition-side and call-site names identical across contexts.
  func argTypePiece(self, ty: types.Type) -> string {
    t = self.typechecker.resolve(ty)
    if (t.type == types.Type.TypeClass.Typename &&
        !isnull(self.typechecker.lookupClass(t.tyname.name))) {
      return self.classCName(t)
    }
    return t.toString()
  }

  // The C name of a class method for a given instance type and argument
  // types: <class instantiation>_<method>[_<argtype>...].
  func methodCName(self, instanceTy: types.Type, methodName: string,
                   argsTy: types.Type?) -> string {
    name = self.classCName(instanceTy) + "_" + methodName
    if !isnull(argsTy) {
      t = self.typechecker.resolve(argsTy!)
      if t.type == types.Type.TypeClass.Tuple {
        for el in t.tuple.elements {
          name += "_" + self.argTypePiece(el)
        }
      } else {
        name += "_" + self.argTypePiece(t)
      }
    }
    return name
  }

  // The definition-side C name of a method, computed from the method's
  // resolved function type (whose first parameter is self).
  func methodDefCName(self, fnType: types.Type, methodName: string) -> string {
    assert fnType.type == types.Type.TypeClass.Function
    params = fnType.function.params
    if params.type == types.Type.TypeClass.Tuple && params.tuple.elements.length() > 0 {
      name = self.classCName(params.tuple.elements[0]) + "_" + methodName
      for i in range(params.tuple.elements.length()) {
        if i > 0 {
          name += "_" + self.argTypePiece(params.tuple.elements[i])
        }
      }
      return name
    }
    return self.classCName(params) + "_" + methodName
  }

  // Track class structs and methods we have already emitted, so multiple
  // instantiations with the same types are only emitted once.
  // Emit a method specialization at the call site when the definition-side
  // sweep has not produced it (its recorded instantiation only resolves
  // under an outer binding, e.g. a call from another class's method).
  func emitMethodOnDemand(self, instanceTy: types.Type, methodName: string,
      wantName: string, argsTy: types.Type? = null(types.Type)) {
    inst = self.typechecker.resolve(instanceTy)
    if inst.type != types.Type.TypeClass.Typename {
      return
    }
    info = self.typechecker.lookupClass(inst.tyname.name)
    if isnull(info) || isnull(info.fn) {
      return
    }
    for childfunc in info.fn.childFunctions() {
      if childfunc.sym.name == methodName && !isnull(childfunc.typedValue) {
        mty = childfunc.typedValue!
        if mty.type == types.Type.TypeClass.Polymorphic {
          pi = mty.poly.instantiations
          if !isnull(pi) {
            for minst in pi {
              if !self.alreadyEmitted(wantName) {
                // Resolve under the caller's active bindings first, like
                // the definition-side sweep; raw bindings can still hold
                // type variables and must not enter the unifier.
                self.resolveInstantiation(minst)
                if !self.instantiationIsConcrete(minst) {
                  // A method only ever called with bare class-name arguments
                  // (e.g. a relation's _compare, fed elements from a heap
                  // array typed by the bare class) records only non-concrete
                  // instantiations.  Under its instantiation bindings, pin the
                  // free class-instance params to the class's unique concrete
                  // instantiation, then re-resolve so the standard concrete
                  // path below emits its signature and body alike.  When no
                  // param can be pinned the instantiation stays non-concrete
                  // and is left for the on-demand synthesis below, as before.
                  self.instantiate(mty.poly!, minst)
                  self.concretizeMethodParams(childfunc)
                  self.deInstantiate(mty.poly!)
                  self.resolveInstantiation(minst)
                }
                if self.instantiationIsConcrete(minst) {
                  self.instantiate(mty.poly!, minst)
                  // A deferred body must retypecheck under these bindings
                  // before its statements emit.  The key is computed from
                  // the pre-retypecheck resolution: methodDefCName only
                  // reads the parameter types, which the retypecheck does
                  // not change.
                  odPreFn = self.typechecker.resolve(mty.poly.scope)
                  if odPreFn.type == types.Type.TypeClass.Function {
                    self.deferredRetypecheckFor(childfunc,
                        self.methodDefCName(odPreFn, methodName))
                  }
                  mfn = self.typechecker.resolve(mty.poly.scope)
                  if (mfn.type == types.Type.TypeClass.Function &&
                      !self.typechecker.hasFreeVars(mfn!) &&
                      self.methodDefCName(mfn!, methodName) == wantName) {
                    childfunc.genCMethodInstance(self, mfn!)
                  }
                  self.deInstantiate(mty.poly!)
                }
              }
            }
          }
          if !self.alreadyEmitted(wantName) {
            // No recorded instantiation produced the wanted specialization
            // (e.g. it only resolved under an outer binding): synthesize
            // one from this call's instance and argument types.
            opened = self.typechecker.openPoly(mty.poly!)
            if opened.type == types.Type.TypeClass.Function {
              params3 = opened.function.params
              te = null(types.TypeError)
              if (params3.type == types.Type.TypeClass.Tuple &&
                  params3.tuple.elements.length() > 0) {
                te = self.typechecker.unify(params3.tuple.elements[0], inst)
                if isnull(te) && !isnull(argsTy) {
                  rest = arrayof(types.Type)
                  for pidx in range(params3.tuple.elements.length()) {
                    if pidx > 0 {
                      rest.append(params3.tuple.elements[pidx])
                    }
                  }
                  if rest.length() == 1 {
                    restTy = rest[0]
                  } else {
                    restTy = types.Type(types.TupleType(rest))
                  }
                  te = self.typechecker.unify(restTy, argsTy!)
                }
              } else {
                te = self.typechecker.unify(params3, inst)
              }
              if isnull(te) {
                // openPoly's bindings stay active; retypecheck the deferred
                // body under them before emission, once per specialization.
                odPreFn3 = self.typechecker.resolve(opened)
                if odPreFn3.type == types.Type.TypeClass.Function {
                  self.deferredRetypecheckFor(childfunc,
                      self.methodDefCName(odPreFn3, methodName))
                }
                mfn3 = self.typechecker.resolve(opened)
                if (mfn3.type == types.Type.TypeClass.Function &&
                    !self.typechecker.hasFreeVars(mfn3!) &&
                    self.methodDefCName(mfn3!, methodName) == wantName) {
                  childfunc.genCMethodInstance(self, mfn3!)
                }
              }
            }
          }
        } else if mty.type == types.Type.TypeClass.Function {
          mfn2 = self.typechecker.resolve(mty!)
          if self.methodDefCName(mfn2, methodName) == wantName {
            childfunc.genCMethodInstance(self, mfn2)
          }
        }
      }
    }
  }

  // Under an active instantiation, bind each of the method's class-instance
  // parameters whose type-args are still free to the class's unique concrete
  // instantiation (concreteClassTyname's fallback).  This pins a relation
  // _compare's element params — which only ever see bare class-name arguments
  // from the heap array — so the instantiation re-resolves concrete and both
  // its signature and body (the user operator it dispatches to) emit.
  func concretizeMethodParams(self, fn: db.Function) {
    for variable in fn.variables() {
      // Only the non-self parameters (a relation _compare's children) need
      // pinning; self's instance type is already fixed by the call, and
      // resolving a self-referential self under the instantiation can walk a
      // variable chain the unifier forbids.
      if variable.isParam && variable.sym.name != "self" {
        if !isnull(variable.typedValue) {
          vt = self.typechecker.resolve(variable.typedValue!)
          if vt.type == types.Type.TypeClass.Typename {
            if !isnull(self.typechecker.lookupClass(vt.tyname.name)) {
              if self.typechecker.hasFreeVars(vt) {
                concrete = types.Type(self.typeGenerator.concreteClassTyname(vt.tyname!))
                if !self.typechecker.hasFreeVars(concrete) {
                  self.typechecker.unify(variable.typedValue!, concrete)
                }
              }
            }
          }
        }
      }
    }
  }

  func alreadyEmitted(self, name: string) -> bool {
    for n in self.emittedClassDecls {
      if n == name {
        return true
      }
    }
    return false
  }

  func markEmitted(self, name: string) {
    self.emittedClassDecls.append(name)
  }

  // True when every parameter binding of the instantiation is concrete.
  // The result slot (generalized free result variables sit at the end of
  // varBindings) may still be a free variable recorded at a call site;
  // requiring it to be concrete would skip exactly the instantiations
  // whose emission (with result repair) is wanted.  Call
  // resolveInstantiation first.
  func instantiationParamsConcrete(self, inst: types.TyvarInstantiation) -> bool {
    nb = inst.varBindings.length()
    for i in range(nb) {
      if i + 1 < nb {
        if self.typechecker.hasFreeVars(inst.varBindings[i]) {
          return false
        }
      }
    }
    return true
  }

  // Re-typecheck a deferred body once per emitted specialization, under the
  // caller's active instantiation bindings.  The body's expression types are
  // shared storage: each signature must re-derive them under its own
  // bindings, or the second signature emits the first's baked types (the
  // one-shot deferredRetypechecked flag did exactly that with two Dict
  // signatures in one program).  A retypecheck that fails under the active
  // bindings (e.g. an unreachable typeswitch arm) keeps the previous baking:
  // the body already typechecked cleanly once, so the errors are popped.
  func deferredRetypecheckFor(self, fn: db.Function, specKey: string) {
    if !fn.deferredTypecheck {
      return
    }
    retcKey = "retc$" + specKey
    if self.alreadyEmitted(retcKey) {
      return
    }
    self.markEmitted(retcKey)
    retcPreErrs = self.typechecker.countTypeErrors()
    self.typechecker.retypecheckDeferred(fn)
    fn.deferredRetypechecked = true
    while self.typechecker.countTypeErrors() > retcPreErrs {
      self.typechecker.popTypeError()
    }
  }

  func cClassDeclaration(self, location: db.Location, name: string,
                         fields: CParamList, toStringMethod: string,
                         refWidth: u32 = 0u32) -> CDeclaration {
    return CDeclaration(CClassDeclaration(location, name, fields, toStringMethod,
                                          refWidth))
  }

  // Create a function definition whose return type is given directly as a C
  // type, rather than derived from the symbol's typed value.
  func cFunDefWithReturnType(self, location: db.Location, name: string,
                             params: CParamList, body: CBlock,
                             returnType: CTypeExpr) -> CDeclaration {
    fundec = CDeclaration(CFunctionDeclaration(location, Sym.new(name), params,
                                               returnType, body))
    return fundec
  }

  // Declare a local variable with an explicit C type in the current block and
  // identifier scope, returning an expression referencing it.
  func declareLocal(self, sym: Sym, ctype: CTypeExpr?) -> CExpr {
    id = self.identifierScope.getIdentifier(sym, ctype, true, true)
    target = self.declarationBlock()
    if isnull(target) {
      target = self.currentBlock
    }
    if !isnull(target) {
      target.declare(id)
    } else {
      self.program.mainCBlock.declare(id)
    }
    return CExpr(id)
  }

  func findDeclaration(self, name: string) -> CDeclaration? {
    return self.program.findCDeclaration(name)
  }

  // A constructor call inside a polymorphic method records an
  // instantiation whose bindings reference the method's type variables;
  // it only resolves concretely under one of the method's own concrete
  // instantiations.  Bake those in before emission so class struct names
  // (e.g. a template class's arrayof(Element) field) resolve.
  func resolveNestedInstantiations(self, module: db.Function) {
    polys = arrayof(db.Function)
    self.collectPolyFns(module, polys)
    for outer in polys {
      oty = outer.typedValue!
      pi = oty.poly.instantiations
      if !isnull(pi) {
        for inst in pi {
          self.resolveInstantiation(inst)
          if self.instantiationIsConcrete(inst) {
            self.instantiate(oty.poly!, inst)
            for innerFn in polys {
              resolveInner = innerFn != outer
              if resolveInner {
                if innerFn.type == db.FuncType.Constructor {
                  ity = innerFn.typedValue!
                  ipi = ity.poly.instantiations
                  if !isnull(ipi) {
                    for iinst in ipi {
                      self.resolveInstantiation(iinst)
                    }
                  }
                }
              }
            }
            self.deInstantiate(oty.poly!)
          }
        }
      }
    }
  }

  func collectPolyFns(self, fn: db.Function, var out: [db.Function]) {
    for childfunc in fn.childFunctions() {
      if !isnull(childfunc.typedValue) {
        if childfunc.typedValue.type == types.Type.TypeClass.Polymorphic {
          out.append(childfunc)
        }
      }
      self.collectPolyFns(childfunc, out)
    }
  }

  func resolveInstantiation(self, inst: types.TyvarInstantiation) {
    // Update a TyvarInstantiation to remove variables: it should be a fully
    // concrete type.
    for index in range(inst.varBindings.length()) {
      inst.varBindings[index] = self.typechecker.resolve(inst.varBindings[index])
    }
    inst.type = self.typechecker.resolve(inst.type)
  }

  func instantiate(self, poly: types.PolymorphicType, inst: types.TyvarInstantiation) {
    self.typechecker.instantiate(poly, inst);
  }

  func deInstantiate(self, poly: types.PolymorphicType) {
    self.typechecker.deInstantiate(poly);
  }

  func specialize(self, sym: Sym, inst: types.TyvarInstantiation) -> Sym {
    // generate a new name including the specializations of the var bindings.
    // Note, we assume that resolveInstantiation() has been called on the
    // inst parameter beforehand.
    name = sym.name
    for binding in inst.varBindings {
      name += "_" + binding.toString()
    }
    newsym = Sym.new(name)
    newsym.typedValue = inst.type
    // Ensure that this new specialized symbol is in identifier scope.
    ctype = self.typeGenerator.genCType(inst.type)
    self.identifierScope.getIdentifier(newsym, ctype, false, false)
    return newsym
  }

  // Function bodies get a fresh try-frame context: a return inside a
  // function emitted on demand from a call site inside a try block must
  // not pop the calling function's frames.
  func openFunctionTryContext(self) -> u64 {
    saved = self.tryFrameBase
    self.tryFrameBase = self.tryFrameDepth
    return saved
  }

  func closeFunctionTryContext(self, saved: u64) {
    self.tryFrameBase = saved
  }

  func openScope(self) {
    self.identifierScope.open()
    if self.scopeBaseCount < self.scopeBlockBases.length() {
      self.scopeBlockBases[self.scopeBaseCount] = self.openBlockCount
    } else {
      self.scopeBlockBases.append(self.openBlockCount)
    }
    self.scopeBaseCount += 1
  }

  func closeScope(self) {
    self.identifierScope.close()
    if self.scopeBaseCount > 0 {
      self.scopeBaseCount -= 1
    }
  }

  // The block where local declarations belong: the body block of the
  // function currently being emitted, or null at module level.
  func declarationBlock(self) -> CBlock? {
    if self.scopeBaseCount == 0 {
      return null(CBlock)
    }
    base = self.scopeBlockBases[self.scopeBaseCount - 1]
    index = 0u64
    for block in self.cBlocks() {
      if index == base {
        return block
      }
      index += 1
    }
    return null(CBlock)
  }

  func openBlock(self, location: db.Location?) {
    self.currentBlock = CBlock(location)
    self.appendCBlock(self.currentBlock!)
    self.openBlockCount += 1
  }

  func closeBlock(self) -> CBlock {
    block = self.lastCBlock!
    self.removeCBlock(block)
    self.currentBlock = self.lastCBlock
    if self.openBlockCount > 0 {
      self.openBlockCount -= 1
    }
    return block
  }

  func addStatement(self, location: db.Location, statement: CStatement | CExpr) {
    typeswitch statement {
      CStatement => s = statement
      CExpr => s = CStatement(location, CStatementType.Expr, statement)
    }
    if isnull(self.lastCBlock) {
      self.program.addStatementToMain(s)
    } else {
      self.lastCBlock.appendCStatement(s)
    }
  }

  func openParamList(self) {
    assert isnull(self.currentParamList)
    self.currentParamList = CParamList()
  }

  func closeParamList(self) -> CParamList {
    assert !isnull(self.currentParamList)
    params = self.currentParamList!
    self.currentParamList = null(CParamList)
    return params
  }

  func addParam(self, param: CParameter) {
    assert !isnull(self.currentParamList)
    self.currentParamList.appendCParameter(param)
  }

  func genCType(self, ty: types.Type?) -> CTypeExpr? {
    if isnull(ty) {
      return null(CTypeExpr)
    }
    return self.typeGenerator.genCType(ty!)
  }

  // specializedType is used when generating specific instances of a
  // polymorphic type.
  func cParameter(self, location: db.Location, sym: Sym,
                  specializedType: types.Type? = null(types.Type),
                  isVar: bool = false) -> CParameter {
    if isnull(specializedType) {
      assert !isnull(sym.typedValue)
      ty = self.typechecker.resolve(sym.typedValue!)
      sym.typedValue = ty
      ctype = self.typeGenerator.genCType(ty)
    } else {
      ctype = self.typeGenerator.genCType(specializedType!)
    }
    if isVar && !isnull(ctype) {
      // var parameters pass by pointer; their references emit as (*name).
      ctype = CTypeExpr(CPointerType(ctype!))
    }
    // Add this parameter to the current scope (otherwise next time we
    // see it, it will appear to be 1st occurrence, and we'll try to
    // declare it).
    paramId = self.identifierScope.getIdentifier(sym, ctype, true, true)
    paramId.isVarParam = isVar
    return CParameter(location, sym.name, ctype!)
  }

  func cIdentifier(self, symbol: Sym, bindingInstance: bool,
      exprType: types.Type? = null(types.Type)) -> CExpr {
    // The reference's own typechecked type is authoritative; syms are
    // interned by name, so the sym's binding may be another function's
    // same-named local.  Fall back to scope lookup, then the sym.
    type = exprType
    if isnull(type) {
      type = self.typechecker.getSymbolType(symbol)
    }
    if isnull(type) {
      type = symbol.typedValue
    }
    ctype = null(CTypeExpr)
    if !isnull(type) {
      ty = self.typechecker.resolve(type!)
      // A bare function name (or a function-pointer value) is not a variable
      // to declare here; leave its C type null, exactly as when genCFunction
      // was a stub.  Function-pointer parameters get their fnptr type through
      // cParameter; emitting a function name just needs the identifier.
      if ty.type != types.Type.TypeClass.Function {
        ctype = self.typeGenerator.genCType(ty)
        if self.typechecker.isClassType(ty) {
          // Anything referencing a class instance needs its struct typedef.
          self.dependencyStack.append(self.classCName(ty) + "_class")
        }
      }
    }
    id = self.identifierScope.getIdentifier(symbol, ctype, bindingInstance, false)
    if !isnull(ctype) && id.firstInstance {
      // A module-variable name that is first assigned INSIDE a function body
      // is a function local that shadows the module variable (e.g. msqrt's
      // local counter `m` vs a caller's module-level `m`); declare it as a
      // local so it does not share the module static.  A bare reference
      // (read) still resolves to the module static.
      if self.isModuleVariable(symbol.name) &&
          !(bindingInstance && !isnull(self.currentEmittingFn)) {
        // A module-level variable: declared once at file scope, never as
        // a local of whatever function mentions it first.
        existingDec = self.findDeclaration(symbol.name)
        if isnull(existingDec) {
          vdec = CDeclaration(CVariableDeclaration(symbol.name, ctype!))
          if ctype.type == CTypeExpr.Type.Defined {
            vdec.addDependencyName(ctype.cDefinedType.name)
          } else if ctype.type == CTypeExpr.Type.Array {
            vdec.addDependencyName(ctype.cArrayType.name)
          } else if ctype.type == CTypeExpr.Type.Pointer {
            vdec.addDependencyName(ctype.cPointerType.target.toString() + "_class")
          }
          self.addDeclaration(vdec)
        } else if (ctype.type == CTypeExpr.Type.Defined &&
                   ctype.cDefinedType.name == "rn_wide" &&
                   existingDec.type == CDeclaration.Type.Variable) {
          // A later wide assignment upgrades a module static first declared
          // with a scalar type: an earlier emission pass can see the
          // initializer's still-open polymorphic result type before it
          // resolves wide.
          existingVar = existingDec.cVariableDeclaration
          if !(existingVar.ctype.type == CTypeExpr.Type.Defined &&
               existingVar.ctype.cDefinedType.name == "rn_wide") {
            existingVar.ctype = ctype!
            existingDec.addDependencyName("rn_wide")
          }
        }
      } else {
        target = self.declarationBlock()
        if !isnull(target) {
          target.declare(id)
        } else {
          // Module level: declare in main's body block so the variable is
          // visible across all top-level loops and blocks.
          self.program.mainCBlock.declare(id)
        }
      }
    }
    // Add this to the list of the current scope dependencies, unless it
    // is a parameter, or a local definition.
    if !id.isParameter {
      // TODO: figure out how to track local definition.
      self.dependencyStack.append(id.symbol.name)
    }
    return CExpr(id)
  }

  func cType(self, type: CType) -> CTypeExpr {
    return CTypeExpr(type)
  }

  // True if the type is an integer wider than 64 bits, returning its width
  // through the runtime header at runtime; 0 if not wide.
  func wideWidth(self, ty: types.Type?) -> u32 {
    if isnull(ty) {
      return 0u32
    }
    t = self.typechecker.resolve(ty!)
    if t.type == types.Type.TypeClass.Int && t.int.width > 64u32 {
      return t.int.width
    }
    return 0u32
  }

  // True if a local variable named |sym| has been declared with the wide
  // C type in the current function's emission scope.
  func localWide(self, sym: Sym) -> bool {
    return self.identifierScope.declaredWide(sym)
  }

  func wideSigned(self, ty: types.Type?) -> bool {
    t = self.typechecker.resolve(ty!)
    return t.type == types.Type.TypeClass.Int && t.int.isSigned
  }

  // A call to a wide-integer runtime helper.
  func cWideCall(self, location: db.Location, name: string, args: CExprList) -> CExpr {
    fn = CExpr(CIdentifier(Sym.new(name), null(CTypeExpr), false, false, false))
    return CExpr(CCall(location, CRuntimeFunction.WideCall, CExpr(args), fn,
        null(CTypeExpr)))
  }

  // Wrap an expression's C form as a wide value if its Rune type is wide
  // but it emitted as a 64-bit scalar (e.g. an adapted literal).
  func cWideFromU64(self, location: db.Location, arg: CExpr, width: u32,
                    isSigned: bool) -> CExpr {
    args = CExprList()
    args.appendCExpr(arg)
    args.appendCExpr(CExpr(CLiteral(db.Bigint(<u64>width), false)))
    args.appendCExpr(CExpr(CLiteral(db.Bigint(isSigned ? 1u64 : 0u64), false)))
    return self.cWideCall(location, "wide_from_u64", args)
  }

  // Integer arguments to printf-style format calls must widen to 64 bits:
  // the format emitter translates %u/%i/%x to their PRI*64 forms, which
  // read 8 bytes from the vararg list.  Wide arguments render as strings
  // (the format directive becomes %s; |directive| selects the base).
  func cFormatArg(self, location: db.Location, arg: CExpr, ty: types.Type?,
                  directive: u8 = 0u8) -> CExpr {
    if isnull(ty) {
      return arg
    }
    t = self.typechecker.resolve(ty!)
    if t.type == types.Type.TypeClass.Int {
      if t.int.width > 64u32 {
        wideArgs = CExprList()
        wideArgs.appendCExpr(arg)
        if directive == 'x' {
          wideArgs.appendCExpr(CExpr(CLiteral(db.Bigint(16u64), false)))
          return self.cWideCall(location, "wide_tostring_base", wideArgs)
        }
        return self.cWideCall(location, "wide_tostring", wideArgs)
      }
      argSigned = t.int.isSigned
    } else if t.type == types.Type.TypeClass.AnyInt {
      argSigned = t.anyInt.isSigned
    } else {
      return arg
    }
    return CExpr(CCastExpr(location, self.cIntType(location, argSigned, 64u32), arg))
  }

  // The directive characters of a printf-style Rune format, in argument
  // order (skipping %%).
  func formatDirectives(self, fmt: string) -> [u8] {
    dirs = arrayof(u8)
    pos = 0
    while pos < fmt.length() {
      if fmt[pos] == '%' && pos + 1 < fmt.length() {
        if fmt[pos + 1] == '%' {
          pos += 2
        } else {
          scan = pos + 1
          while (scan < fmt.length() &&
              ((fmt[scan] >= '0' && fmt[scan] <= '9') || fmt[scan] == '.' ||
               fmt[scan] == '[' || fmt[scan] == ']')) {
            scan += 1
          }
          if scan < fmt.length() {
            dirs.append(fmt[scan])
          }
          // Rune format widths follow the directive char (e.g. %x128).
          scan += 1
          while scan < fmt.length() && fmt[scan] >= '0' && fmt[scan] <= '9' {
            scan += 1
          }
          pos = scan
        }
      } else {
        pos += 1
      }
    }
    return dirs
  }

  // Rewrite a Rune format string so directives whose argument is a wide
  // integer become %s (the argument renders as a string).
  func rewriteWideFormat(self, fmt: string, wideArgFlags: [bool]) -> string {
    out = ""
    argIdx = 0
    pos = 0
    while pos < fmt.length() {
      if fmt[pos] == '%' && pos + 1 < fmt.length() && fmt[pos + 1] == '%' {
        out += "%%"
        pos += 2
      } else if fmt[pos] == '%' && pos + 1 < fmt.length() {
        scan = pos + 1
        while (scan < fmt.length() &&
            ((fmt[scan] >= '0' && fmt[scan] <= '9') || fmt[scan] == '.')) {
          scan += 1
        }
        isWideArg = argIdx < wideArgFlags.length() && wideArgFlags[argIdx]
        argIdx += 1
        // Rune format widths follow the directive char (e.g. %x128).
        widthEnd = scan + 1
        while widthEnd < fmt.length() && fmt[widthEnd] >= '0' && fmt[widthEnd] <= '9' {
          widthEnd += 1
        }
        if isWideArg && scan < fmt.length() {
          out += "%s"
          pos = widthEnd
        } else {
          while pos < widthEnd && pos < fmt.length() {
            out.append(fmt[pos])
            pos += 1
          }
        }
      } else {
        out.append(fmt[pos])
        pos += 1
      }
    }
    return out
  }

  func cIntType(self, location: db.Location, isSigned: bool, width: u32) -> CTypeExpr {
    if isSigned {
      if width <= 8 {
        prim = CPrimitiveType(CPrimitiveType.Type.Int8)
      } else if width <= 16 {
        prim = CPrimitiveType(CPrimitiveType.Type.Int16)
      } else if width <= 32 {
        prim = CPrimitiveType(CPrimitiveType.Type.Int32)
      } else if width <= 64 {
        prim = CPrimitiveType(CPrimitiveType.Type.Int64)
      } else {
        raise Status.Unimplemented, "No support for primitive integers of width larger than 64"
      }
    } else {
      if width <= 8 {
        prim = CPrimitiveType(CPrimitiveType.Type.Uint8)
      } else if width <= 16 {
        prim = CPrimitiveType(CPrimitiveType.Type.Uint16)
      } else if width <= 32 {
        prim = CPrimitiveType(CPrimitiveType.Type.Uint32)
      } else if width <= 64 {
        prim = CPrimitiveType(CPrimitiveType.Type.Uint64)
      } else {
        raise Status.Unimplemented, "No support for primitive integers of width larger than 64"
      }
    }
    return CTypeExpr(prim)
  }

  func cFloatType(self, location: db.Location, width: u32) -> CTypeExpr {
    if width == 32 {
      return CTypeExpr(CPrimitiveType(CPrimitiveType.Type.Float))
    } else if width == 64 {
      return CTypeExpr(CPrimitiveType(CPrimitiveType.Type.Double))
    }
    raise Status.Unimplemented, "No support for floating point width %u32." % width
  }

  func cStringType(self, location: db.Location) -> CTypeExpr {
    return CTypeExpr(CDefinedType("string"))
  }

  func cBooleanType(self, location: db.Location) -> CTypeExpr {
    return CTypeExpr(CPrimitiveType(CPrimitiveType.Type.Int8))
  }

  func cVoidType(self, location: db.Location) -> CTypeExpr {
    return CTypeExpr(CPrimitiveType(CPrimitiveType.Type.Void))
  }

  /* Rune expressions *********************************************************************/

  func cStringLiteral(self, value: string, printf: bool = false) -> CExpr {
    return CExpr(CLiteral(value, printf))
  }

  func cBoolLiteral(self, value: bool) -> CExpr {
    return CExpr(CLiteral(value, false))
  }

  func cIntLiteral(self, value: db.Bigint) -> CExpr {
    return CExpr(CLiteral(value, false))
  }

  func cUintLiteral(self, value: Uint) -> CExpr {
    return CExpr(CLiteral(value, false))
  }

  func cFloatLiteral(self, value: Float) -> CExpr {
    return CExpr(CLiteral(value, false))
  }

  func cUnaryMinus(self, location: db.Location, arg: CExpr) -> CExpr {
    return CExpr(CPrefixOperator(location, CPrefixOperator.Type.UnaryMinus, arg))
  }

  func cUnaryBitnot(self, location: db.Location, arg: CExpr) -> CExpr {
    return CExpr(CPrefixOperator(location, CPrefixOperator.Type.BitNot, arg))
  }

  func cUnaryNot(self, location: db.Location, arg: CExpr) -> CExpr {
    return CExpr(CPrefixOperator(location, CPrefixOperator.Type.LogNot, arg))
  }

  func cBinaryOperator(self, location: db.Location, op: CBinaryOperator.Type,
                       type: types.Type?, left: CExpr, right: CExpr) -> CExpr {
    ctype = self.genCType(type)
    return CExpr(CBinaryOperator(location, op, ctype, left, right))
  }

  func cCall(self, location: db.Location, fn: string | CExpr | CRuntimeFunction, args: CExpr?,
             relevantType: types.Type? = null(types.Type)) -> CExpr {
    ctype = null(CTypeExpr)
    if !isnull(relevantType) {
      ctype = self.typeGenerator.genCType(relevantType!)
    }
    typeswitch fn {
      string => {
        call = CCall(location, CRuntimeFunction.UserDefined, args,
                     CExpr(CIdentifier(Sym.new(fn), null(CTypeExpr), false, false, false)),
		     ctype)
        depdec = self.findDeclaration(fn)
        if !isnull(depdec) {
          self.dependencyStack.append(depdec!)
        }
      }
      CExpr => call = CCall(location, CRuntimeFunction.UserDefined, args, fn, ctype)
      CRuntimeFunction => call = CCall(location, fn, args, null(CExpr), ctype)
    }
    return CExpr(call)
  }

  // Tuples are special because they have no name, and different instances of the
  // type should match without difficulty. The idea is to generate a C structure type for
  // each different shape (or _type_) of tuple. We need to remember the definitions
  // we create for each separate tuple type, so that we can reuse them the next time
  // this tuple appears. To do this, we use a hash table, and the tuple type as a key.
  //
  // NOTE: tuples with element types with unbound type variables are not supported.
  // Declare the C struct for a tuple type (typedef, constructor, tostring,
  // isequal); parameters of deferred functions need this without a tuple
  // literal in sight.
  func ensureTupleDeclared(self, location: db.Location, ty: types.Type) {
    exists = self.typeGenerator.genCTuple(ty.tuple!)!
    if !exists.defined {
      // Declare nested tuple element types FIRST so a tuple struct containing a
      // tuple field (tuple1_t { tuple2_t el0; }) is emitted after the inner
      // tuple's typedef (otherwise the dependency below cannot be found and the
      // outer struct emits first -> "unknown type name").
      for nestedEl in ty.tuple.elements {
        nestedRes = self.typechecker.resolve(nestedEl)
        if nestedRes.type == types.Type.TypeClass.Tuple {
          self.ensureTupleDeclared(location, nestedRes)
        }
      }
      // Create the C struct definition -------------
      params = CParamList()
      deps = arrayof(string)
      for pair in ty.tuple.elements.items() {
        ctype = self.typeGenerator.genCType(pair[1])
        if ctype.type == CTypeExpr.Type.Defined {
          deps.append(ctype.toString())
        } else if ctype.type == CTypeExpr.Type.Array {
          deps.append(ctype.cArrayType.name)
        }
        params.append(CParameter(location, "el%s" % int2cstring(pair[0]), ctype!))
      }
      dec = CDeclaration(CStructDeclaration(location, exists.name, params, true))
      for name in deps {
        depdec = self.findDeclaration(name)
        if !isnull(depdec) {
          dec.addDependency(depdec!)
        }
      }
      self.addDeclaration(dec)
      exists.defined = true
    }
  }

  // Ensure the function-pointer typedef for |ty| (a FunctionType) exists.
  // A none result emits as void; an empty parameter tuple emits as (void).
  func ensureFunctionPtrDeclared(self, location: db.Location, ty: types.Type) {
    fnTy = ty.function!
    // genCFunction names the definition (fnptr<N>); fetch it to fill in.
    self.typeGenerator.genCFunction(fnTy)
    def = self.typeGenerator.findFnptrDef(fnTy)!
    if def.defined {
      return
    }
    resTy = self.typechecker.resolve(fnTy.result!)
    if resTy.type == types.Type.TypeClass.Typename && resTy.tyname.name.name == "none" {
      resultCType = self.cVoidType(location)
    } else {
      resultCType = self.genCType(resTy)!
    }
    paramCTypes = arrayof(CTypeExpr)
    pTy = self.typechecker.resolve(fnTy.params!)
    if pTy.type == types.Type.TypeClass.Tuple {
      for el in pTy.tuple.elements {
        paramCTypes.append(self.genCType(el)!)
      }
    } else {
      pIsNone = pTy.type == types.Type.TypeClass.Typename && pTy.tyname.name.name == "none"
      if !pIsNone {
        paramCTypes.append(self.genCType(pTy)!)
      }
    }
    decl = CDeclaration(CFunctionPtrDeclaration(location, def.name, paramCTypes, resultCType))
    // A defined-type result or parameter must be declared first.
    if resultCType.type == CTypeExpr.Type.Defined {
      rdep = self.findDeclaration(resultCType.cDefinedType.name)
      if !isnull(rdep) {
        decl.addDependency(rdep!)
      }
    }
    for pc in paramCTypes {
      if pc.type == CTypeExpr.Type.Defined {
        pdep = self.findDeclaration(pc.cDefinedType.name)
        if !isnull(pdep) {
          decl.addDependency(pdep!)
        }
      }
    }
    self.addDeclaration(decl)
    def.defined = true
  }

  func cTuple(self, location: db.Location, type: types.Type?, elements: CExprList) -> CExpr {
    ty = self.typechecker.resolve(type!);
    assert ty.type == types.Type.TypeClass.Tuple
    self.ensureTupleDeclared(location, ty)
    exists = self.typeGenerator.genCTuple(ty.tuple!)!

    constructorName = CIdentifier(Sym.new("%s" % exists.name), null(CTypeExpr),
                                  false, false, false)
    return CExpr(CCall(location, CRuntimeFunction.UserDefined, CExpr(elements),
                       CExpr(constructorName), null(CTypeExpr)))
  }

  // Ensure the C declaration for an array of |elementType| exists (the
  // typedef along with its init and tostring helpers).
  func ensureArrayDeclared(self, location: db.Location,
                           elementType: types.Type) -> CArrayDefinition {
    exists = self.typeGenerator.genCArray(elementType)!
    if !exists.defined {
      // create the C struct definition ------------
      dec = CDeclaration(CArrayDeclaration(location, exists.typeName, exists.cElementType!))
      if exists.cElementType.type == CTypeExpr.Type.Defined {
        depdec = self.findDeclaration(exists.cElementType.cDefinedType.name)
        if !isnull(depdec) {
          dec.addDependency(depdec!)
        }
      } else if exists.cElementType.type == CTypeExpr.Type.Array {
        // By name: an array-of-array element type may not be declared yet.
        dec.addDependencyName(exists.cElementType.cArrayType.name)
        if elementType.type == types.Type.TypeClass.Array {
          // Make sure the element array's declaration exists to resolve to.
          self.ensureArrayDeclared(location, elementType.array.elementType)
        }
      } else if exists.cElementType.type == CTypeExpr.Type.Pointer {
        // Arrays of class instances need the class struct typedef first.
        // By name: the class may not have been declared yet (e.g. a
        // relation hash-table field in an earlier class); names resolve
        // when declarations are ordered.
        dec.addDependencyName(
            exists.cElementType.cPointerType.target.toString() + "_class")
      }

      self.addDeclaration(dec)
      exists.dec = dec
      exists.defined = true
    }
    return exists!
  }

  func cArray(self, location: db.Location, elementType: types.Type, elements: [CExpr]) -> CExpr {
    ty = self.typechecker.resolve(elementType)
    exists = self.ensureArrayDeclared(location, elementType)
    constructorName = CIdentifier(Sym.new("%s_init" % exists.typeName),
                                  null(CTypeExpr),
                                  false, false, false)
    constructorArgs = CExprList()
    constructorArgs.appendCExpr(CExpr(CLiteral(db.Bigint(elements.length()), false)))
    for e in elements {
      constructorArgs.appendCExpr(e)
    }
    return CExpr(CCall(location, CRuntimeFunction.UserDefined,
                       CExpr(constructorArgs),
                       CExpr(constructorName), null(CTypeExpr)))
  }

  func cIndex(self, location: db.Location, indexeeType: types.Type,
              indexee: CExpr, index: u64|CExpr) -> CExpr {
    ity = indexeeType
    if ity.type == types.Type.TypeClass.Typename {
       st = self.typechecker.structInstanceType(ity!)
       if !isnull(st) {
         ity = st!
       } else {
         ity = self.typechecker.lookupTyname(ity.tyname.name)!
       }
    }

    typeswitch index {
      CExpr => {
        if ity.type != types.Type.TypeClass.Array {
          raise Status.Unimplemented, "CExprs can only index into arrays."
        }
        return CExpr(CIndexExpr(location, indexee, index))
      }
      default => {
        cFieldName = ""
        if ity.type == types.Type.TypeClass.Tuple {
          cFieldName = "el%s" % int2cstring(index)
        } else if ity.type == types.Type.TypeClass.Struct {
          cFieldName = ity.strct.fieldnames[index].name
        } else {
          raise Status.Unimplemented, "Indexing into non-tuple types."
        }
        return CExpr(CDotExpr(location, indexee, cFieldName, false))
     }
   }
  }

  func cStruct(self, location: db.Location, id: Sym, params: CParamList, body: CBlock) -> CDeclaration {
    // Create the C struct definition -------------
    deps = arrayof(string)
    for p in params.cParameters() {
      if p.type.type == CTypeExpr.Type.Defined {
        deps.append(p.type.toString())
      }
    }

    structdec = CDeclaration(CStructDeclaration(location, id.name, params, false))

    // Walk through the list of dependent type names to add dependent declarations to
    // dec, so that they will be emitted before this one.
    for name in deps {
      depdec = self.findDeclaration(name)
      if !isnull(depdec) {
        structdec.addDependency(depdec!)
      }
    }
    return structdec
  }

  func cFieldSelect(self, location: db.Location, strct: CExpr, field: Sym) -> CExpr {
    return CExpr(CDotExpr(location, strct, field.name, false))
  }

  /* Rune statements *******************************************************************/

  func cPrintlnStatement(self, location: db.Location, args: CExpr) -> CStatement {
    return CStatement(CStatementType.Call, self.cCall(location, CRuntimeFunction.Printf, args))
  }

  func cIfStatement(self, location: db.Location, expr: CExpr, body: CBlock) -> CStatement {
    return CStatement(location, CStatementType.If,expr, body)
  }

  func cElseStatement(self, location: db.Location, body: CBlock) -> CStatement {
    return CStatement(location, CStatementType.Else, null(CExpr), body)
  }

  func cElseIfStatement(self, location: db.Location, expr: CExpr, body: CBlock) -> CStatement {
    return CStatement(location, CStatementType.ElseIf, expr, body)
  }

  func cForStatement(self, location: db.Location, expr: CExpr, body: CBlock) -> CStatement {
    return CStatement(location, CStatementType.For, expr, body)
  }

  func cReturnStatement(self, location: db.Location, expr: CExpr?) -> CStatement {
    return CStatement(location, CStatementType.Return, expr)
  }

  /* Rune declarations *****************************************************************/

  // specializedType is used when generating specific instances of a
  // polymorphic type.
  func cFunDef(self, location: db.Location, id: Sym, params: CParamList,
               body: CBlock) -> CDeclaration {
    type = id.typedValue
    switch type.type {
      types.Type.TypeClass.Function => {
        // Functions returning none become void C functions, so a bare
        // return inside them is legal C.
        resTy = self.typechecker.resolve(type.function.result!)
        if resTy.type == types.Type.TypeClass.Typename &&
            resTy.tyname.name.name == "none" {
          returnType = self.cVoidType(location)
        } else {
          returnType = self.genCType(resTy)
        }
      }
      types.Type.TypeClass.Polymorphic => {
        raise Status.InvalidArgument, "Polymorphic functions should be specialized by now."
      }
      default => {
        raise Status.InvalidArgument, "The type of function ", id.name, " should be a function"
      }
    }
    return CDeclaration(CFunctionDeclaration(location, id, params, returnType!, body))
  }

}

