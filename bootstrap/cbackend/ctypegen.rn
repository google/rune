import types
use clanguageclasses

func hashCombine(hash1: u64, hash2: u64) -> u64 {
  // From https://stackoverflow.com/questions/19195183/how-to-properly-hash-the-custom-struct
  return hash1 ^ (0x9e3779b9 !+ (hash2 << 6) !+ (hash2 >> 2))
}

class CArrayDefinition(self, elementType: types.Type, typeName: string) {
  self.elementType = elementType
  self.typeName = typeName
  self.cElementType = null(CTypeExpr)
  self.ctype = null(CTypeExpr)


  func hash(self) -> u64 {
    return hashCombine(hashValue(self.typeName), self.elementType.hash())
  }

  func equals(self, other: CArrayDefinition) -> bool {
    return self.typeName == other.typeName && self.elementType.equals(other.elementType)
  }
}

class CTupleDefinition(self, type: types.TupleType, name: string) {
  self.type = type
  self.name = name
  self.defined = false
  self.ctype = null(CTypeExpr)

  func hash(self) -> u64 {
    return self.type.hash()
  }

  // We use the self.type as a key in the hashtable, so we only need to compare
  // the types.
  func equals(self, other: CTupleDefinition) -> bool {
    return ((isnull(self.type) && isnull(other.type))
            || (!isnull(self.type) && !isnull(other.type) && self.type!.equals(other.type!)))
  }
}

// A function-pointer C type, named fnptr<N>, keyed by the Rune FunctionType
// it represents so identical signatures share one typedef.  The C param and
// result types are computed lazily when the typedef is emitted (see
// CBuilder.ensureFunctionPtrDeclared), so merely naming the type is cheap.
class CFunctionPtrDefinition(self, type: types.FunctionType, name: string) {
  self.type = type
  self.name = name
  self.defined = false
  self.ctype = null(CTypeExpr)

  func hash(self) -> u64 {
    return self.type.hash()
  }

  func equals(self, other: CFunctionPtrDefinition) -> bool {
    return self.type!.equals(other.type!)
  }
}

relation HashedClass CTypeGenerator CArrayDefinition cascade
relation HashedClass CTypeGenerator CTupleDefinition cascade
// Function-pointer typedefs are few (one per distinct callback signature), so
// a DoublyLinked list with linear lookup suffices.  It is deliberately NOT a
// HashedClass relation: that relation's startup hash-bucket pool shifts every
// other allocation, and the legacy runtime's array-resize codegen corrupts at
// specific pool sizes (it broke graph.rn).  A linked list adds no bucket pool.
relation DoublyLinked CTypeGenerator CFunctionPtrDefinition cascade

class CTypeGenerator(self, typechecker: types.TypeChecker) {
  self.typechecker = typechecker
  self.nextTupleNumber = 1
  self.nextFnptrNumber = 1

  // The existing definition for |ty|, or null.
  func findFnptrDef(self, ty: types.FunctionType) -> CFunctionPtrDefinition? {
    for d in self.cFunctionPtrDefinitions() {
      if d.type!.equals(ty) {
        return d
      }
    }
    return null(CFunctionPtrDefinition)
  }

  func genCInt(self, ty: types.IntType) -> CTypeExpr? {
    if ty.width <= 8u32 {
      primty = ty.isSigned ? CPrimitiveType.Type.Int8 : CPrimitiveType.Type.Uint8
    } else if ty.width <= 16u32 {
      primty = ty.isSigned ? CPrimitiveType.Type.Int16 : CPrimitiveType.Type.Uint16
    } else if ty.width <= 32u32 {
      primty = ty.isSigned ? CPrimitiveType.Type.Int32 : CPrimitiveType.Type.Uint32
    } else if ty.width <= 64u32 {
      primty = ty.isSigned ? CPrimitiveType.Type.Int64 : CPrimitiveType.Type.Uint64
    } else {
      // Wider integers are heap limb arrays; see cruntime/wide_ints.inc.
      wideResult = CTypeExpr(CDefinedType("rn_wide"))
      if ty.isSigned {
        wideResult.runeSuffix = "i%u" % ty.width
      } else {
        wideResult.runeSuffix = "u%u" % ty.width
      }
      return wideResult
    }
    result = CTypeExpr(CPrimitiveType(primty))
    if ty.isSigned {
      result.runeSuffix = "i%u" % ty.width
    } else {
      result.runeSuffix = "u%u" % ty.width
    }
    return result
  }

  func genCAnyInt(self, ty: types.AnyIntType) -> CTypeExpr? {
    if ty.isSigned {
      result = CTypeExpr(CPrimitiveType(CPrimitiveType.Type.Int64))
      result.runeSuffix = "i64"
      return result
    }
    result = CTypeExpr(CPrimitiveType(CPrimitiveType.Type.Uint64))
    result.runeSuffix = "u64"
    return result
  }

  func genCFloat(self, ty: types.FloatType) -> CTypeExpr? {
    if ty.width == 32u32 {
      result = CTypeExpr(CPrimitiveType(CPrimitiveType.Type.Float))
      result.runeSuffix = "f32"
      return result
    }
    result = CTypeExpr(CPrimitiveType(CPrimitiveType.Type.Double))
    result.runeSuffix = "f64"
    return result
  }

  // When a class instance type still has unresolved parameters (e.g. a
  // field referencing another class whose parameters are not bound by this
  // emission context), substitute the class constructor's single concrete
  // instantiation.  Ambiguity leaves the type unchanged.
  func concreteClassTyname(self, ty: types.TypeName) -> types.TypeName {
    needsFallback = isnull(ty.params)
    if !needsFallback {
      for el in ty.params.elements {
        r = self.typechecker.resolve(el)
        if r.type == types.Type.TypeClass.Var {
          needsFallback = true
        }
      }
    }
    if !needsFallback {
      return self.typechecker.canonicalClassTyname(ty)
    }
    info = self.typechecker.lookupClass(ty.name)
    if isnull(info) || isnull(info.fn) || isnull(info.fn.typedValue) {
      return ty
    }
    fnType = info.fn.typedValue!
    // Collect candidate concrete instance types: the constructor's result
    // type for a monomorphic class (e.g. a self-referential class whose
    // type parameters all tied to the class itself), or each recorded
    // instantiation's result for a polymorphic one.
    candidates = arrayof(types.Type)
    if fnType.type == types.Type.TypeClass.Function {
      candidates.append(fnType.function.result!)
    } else if fnType.type == types.Type.TypeClass.Polymorphic {
      pi = fnType.poly.instantiations
      if !isnull(pi) {
        for inst in pi {
          it = inst.type
          if !isnull(it) && it.type == types.Type.TypeClass.Function {
            candidates.append(it.function.result!)
          }
        }
      }
    }
    best = null(types.TypeName)
    bestSpec = ""
    for cand in candidates {
      res = self.typechecker.resolve(cand)
      if res.type == types.Type.TypeClass.Typename && !isnull(res.tyname.params) {
        ctn = self.typechecker.canonicalClassTyname(res.tyname!)
        allConcrete = true
        for el2 in ctn.params.elements {
          r2 = self.typechecker.resolve(el2)
          if r2.type == types.Type.TypeClass.Var {
            allConcrete = false
          }
        }
        if allConcrete {
          instSpec = ctn.specializationString()
          if isnull(best) {
            best = ctn
            bestSpec = instSpec
          } else if instSpec != bestSpec {
            // Two distinct concrete forms: prefer one without a self-knot
            // parameter (a parameter that is the class's own bare name is
            // a nominal cut from a degenerate unification, not a real
            // specialization).  Genuinely ambiguous otherwise.
            bestKnot = self.hasSelfKnotParam(best!, ty.name)
            candKnot = self.hasSelfKnotParam(ctn, ty.name)
            if bestKnot && !candKnot {
              best = ctn
              bestSpec = instSpec
            } else if !bestKnot && candKnot {
              // Keep best.
            } else {
              return ty
            }
          }
        }
      }
    }
    if !isnull(best) {
      return best!
    }
    return ty
  }

  // True if any parameter of |tn| is the bare name |selfName| (a nominal
  // knot from self-referential unification).
  func hasSelfKnotParam(self, tn: types.TypeName, selfName) -> bool {
    if isnull(tn.params) {
      return false
    }
    for el in tn.params.elements {
      r = self.typechecker.resolve(el)
      if r.type == types.Type.TypeClass.Typename {
        if r.tyname!.name == selfName && isnull(r.tyname!.params) {
          return true
        }
      }
    }
    return false
  }

  func genCTypename(self, ty: types.TypeName) -> CTypeExpr? {
    // BigInt is an opaque GMP-backed runtime value, requested by its direct
    // builtins.  It is intentionally not an IntType: fixed-width integer
    // semantics must remain unchanged.
    if ty.name.name == "BigInt" {
      // CDefinedType appends its conventional `_t` suffix at emission.
      return CTypeExpr(CDefinedType("rn_bigint"))
    }
    if ty.name.name == "U64Map" {
      return CTypeExpr(CDefinedType("rn_u64map"))
    }
    // F64x4 is a portable by-value runtime struct. The typechecker confines it
    // to locals, so it never becomes part of a generated user-function ABI.
    if ty.name.name == "F64x4" {
      return CTypeExpr(CDefinedType("rn_f64x4"))
    }
    if !isnull(self.typechecker.lookupClass(ty.name)) {
      // The instance's struct collapses phantom parameters (see
      // TypeChecker.dropPhantomParams), so two instances differing only there
      // share one C type and assign to one another.
      cname = self.typechecker.dropPhantomParams(self.concreteClassTyname(ty))
      cspec = cname.specializationString()
      if cspec == "" {
        ctyname = cname.name.name
      } else {
        ctyname = "%s_%s" % (cname.name.name, cspec)
      }
      // Class instances are heap allocated and passed by pointer.
      return CTypeExpr(CPointerType(CTypeExpr(CDefinedType(ctyname))))
    }
    spec = ty.specializationString()
    if spec == "" {
       tyname = ty.name.name
    } else {
       tyname = "%s_%s" % (ty.name.name, spec)
    }
    einfo = self.typechecker.lookupEnum(ty.name)
    if !isnull(einfo) {
      // Enum values are plain unsigned integers in C.
      enumResult = CTypeExpr(CPrimitiveType(CPrimitiveType.Type.Uint32))
      if einfo.valueWidth > 0u32 {
        enumResult.runeSuffix = "u%u" % einfo.valueWidth
      }
      return enumResult
    }
    return CTypeExpr(CDefinedType(tyname))
  }

  func genCArray(self, elementType: types.Type) -> CArrayDefinition {
    def = CArrayDefinition(elementType, "")
    exists = self.findCArrayDefinition(def)
    if !isnull(exists) {
      return exists!
    }
    def.cElementType = self.genCType(elementType)!
    def.typeName = "%s_array" % def.cElementType.arrayElemName()
    def.ctype = CTypeExpr(CArrayType(def.cElementType))
    self.insertCArrayDefinition(def)
    return self.findCArrayDefinition(def)!
  }

  func genCChoice(self, ty: types.ChoiceType) -> CTypeExpr? {
    return null(CTypeExpr)
  }

  func genCTuple(self, type: types.TupleType) -> CTupleDefinition {
    // Does the definition already exist?
    def = CTupleDefinition(type, "")
    exists = self.findCTupleDefinition(def)
    if !isnull(exists) {
      return exists!
    }
    def.name = "tuple%u64" % self.nextTupleNumber
    self.nextTupleNumber += 1
    def.ctype = CTypeExpr(CDefinedType(def.name))
    self.insertCTupleDefinition(def)
    return self.findCTupleDefinition(def)!
  }

  // The C type of a function pointer: a named fnptr<N> typedef.  Find or
  // create the definition keyed by the signature; the typedef itself is
  // emitted on demand by CBuilder.ensureFunctionPtrDeclared.
  func genCFunction(self, ty: types.FunctionType) -> CTypeExpr? {
    exists = self.findFnptrDef(ty)
    if !isnull(exists) {
      return exists.ctype
    }
    def = CFunctionPtrDefinition(ty, "fnptr%u64" % self.nextFnptrNumber)
    self.nextFnptrNumber += 1
    def.ctype = CTypeExpr(CDefinedType(def.name))
    self.appendCFunctionPtrDefinition(def)
    return def.ctype
  }

  func genCPolymorphic(self, ty: types.PolymorphicType) -> CTypeExpr? {
    // keep track of the variables that are generated when a polytype is opened
    // their instantiations will provide the set of types we need to generate
    // for each function, using suffix for the type name.  Get the tuples in
    // first! because they do this already for tostring_....
    return null(CTypeExpr)
  }

  func genCType(self, ty: types.Type) -> CTypeExpr? {
    switch ty.type {
      types.Type.TypeClass.Var => {
        ty2 = self.typechecker.resolve(ty)
        if ty2.type == types.Type.TypeClass.Var {
          println "TypeGenerator: type variable %s is unresolved." % ty.toString()
          return null(CTypeExpr)
        }
        return self.genCType(ty2)
      }
      types.Type.TypeClass.Int => return self.genCInt(ty.int!)
      types.Type.TypeClass.AnyInt => return self.genCAnyInt(ty.anyInt!)
      types.Type.TypeClass.Float => return self.genCFloat(ty.float!)
      types.Type.TypeClass.Typename => return self.genCTypename(ty.tyname!)
      types.Type.TypeClass.Array => return self.genCArray(ty.array.elementType!).ctype
      types.Type.TypeClass.Choice => return self.genCChoice(ty.choice!)
      types.Type.TypeClass.Tuple => return self.genCTuple(ty.tuple!).ctype
      types.Type.TypeClass.Function => return self.genCFunction(ty.function!)
      types.Type.TypeClass.Polymorphic => return self.genCPolymorphic(ty.poly!)
    }
  }

}
