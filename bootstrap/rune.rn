import database as db
import io
import os
import parse
import types
import cbackend as c
use sym

gccOption = "--gcc"
clangCompilerPath = "clang"
gccCompilerPath = "gcc"

// Print commandline help and exit.
func usage() {
  println "Usage: ", argv[0], " [options...] <top level runeFile>\n" +
      "    -d|--debug:  Run in debug mode, which generates a lot of internal logging.\n" +
      "    -q:          Don't output trace information.\n" +
      "    -U|--unsafe: Omit fixed-width integer overflow checks (plain C +,-,* arithmetic).\n" +
      "    -O|--optimize: Optimized C build (-O3).\n" +
      "    -N|--native: Target the host CPU; disable FP contraction for reproducibility.\n" +
      "    " + gccOption + ":       Compile generated C with gcc instead of clang.\n" +
      "    --parseTree: Print parse trees of parsed files.\n" +
      "    --funcTree:  Print the tree of functions.\n" +
      "    --hir:       Print HIR output.\n" +
      "    --tc:        Print typechecker output.\n" +
      "    --oc <filename>: output C to the given filename.  A - means write to stdout.\n" +
      "    -p <dir>:    Use <dir> as the root directory for Rune's builtin packages.\n" +
      "    -n:          Do not compile the resulting .c file."
  exit(1i32)
}

// Run the selected C compiler on the C code we generated.
func runCCompiler(cFileName: string, debugMode: bool, optimized: bool,
                  nativeTarget: bool, useGcc: bool) -> bool {
  outFileName = stripSuffix(cFileName)
  optFlag = optimized? "-O3" : ""
  if debugMode {
    optFlag = "-g -O0";
  }
  nativeFlag = nativeTarget? "-march=native -ffp-contract=off" : ""
  compilerPath = useGcc? gccCompilerPath : clangCompilerPath
  // Programs using the regex builtins pull in the PCRE2 shim; link -lpcre2-8.
  regexLib = db.getRoot().usesRegex? " -lpcre2-8" : ""
  // The optional arbitrary-precision runtime is backed by GMP.
  gmpLib = db.getRoot().usesGmp? " -lgmp" : ""
  threadLib = db.getRoot().usesThreads? " -pthread" : ""
  command = "%s %s %s -Wno-main-return-type -fPIC -o %s %s -lm%s%s%s" %
      (compilerPath, optFlag, nativeFlag, outFileName, cFileName, regexLib, gmpLib,
       threadLib)
  return  os.system(command) == 0
}

func stripSuffix(fileName: string) -> string {
  i = fileName.length()
  while i > 0 && fileName[i - 1] != '.' {
    i -= 1
  }
  if i == 0 {
    return fileName
  }
  return fileName[0:i - 1]
}

if argv.length() <= 1 {
  usage();
}

root = db.getRoot()

packageDir = io.getenv("TEST_SRCDIR")
if packageDir != "" {
  if packageDir[packageDir.length() - 1] != '/' {
    packageDir.append('/')
  }
  packageDir.concat("google3/third_party/rune/bootstrap/")
} else {
  runeExe = argv[0]
  packageDir = runeExe[0 : runeExe.rfind("/") + 1]
}
root.packageDir  = packageDir

optimized = false
nativeTarget = false
useGcc = false
compileC = true
root.generateC = true

xArg = 1
while xArg < argv.length() && argv[xArg][0] == '-' {
  if argv[xArg] == "-d" || argv[xArg] == "--debug" {
    root.debugMode = true
    xArg += 1
  } else if argv[xArg] == "-q" {
    root.quietMode = true
    xArg += 1
  } else if argv[xArg] == "-O" || argv[xArg] == "--optimize" {
    optimized = true
    xArg += 1
  } else if argv[xArg] == "-N" || argv[xArg] == "--native" {
    nativeTarget = true
    xArg += 1
  } else if argv[xArg] == gccOption {
    useGcc = true
    xArg += 1
  } else if argv[xArg] == "-U" || argv[xArg] == "--unsafe" {
    root.unsafeMode = true
    xArg += 1
  } else if argv[xArg] == "--parseTree" {
    root.dumpParseTree = true
    xArg += 1
  } else if argv[xArg] == "--funcTree" {
    root.dumpFuncTree = true
    xArg += 1
  } else if argv[xArg] == "--hir" {
    root.dumpHir = true
    xArg += 1
  } else if argv[xArg] == "--tc" {
    root.traceTypes = true
    xArg += 1
  } else if argv[xArg] == "--oc" {
    xArg += 1
    if xArg == argv.length() {
      println "--oc requires an output filename"
      exit(1i32)
    }
    root.outputCFilename = argv[xArg]
    xArg += 1
  } else if argv[xArg] == "-p" {
    xArg += 1
    if xArg == argv.length() {
      println "-p requires a path to the root package directory"
      exit(1i32)
    }
    root.packageDir = argv[xArg]
    if root.packageDir[root.packageDir.length() - 1] != '/' {
      root.packageDir.append('/')
    }
      xArg += 1
  } else if argv[xArg] == "-n" {
    compileC = false
    xArg += 1
  } else {
    usage()
    exit(1i32)
  }
}

if xArg + 1 != argv.length() {
  usage()
}
parser = parse.Peg(root.packageDir + "parse/rune.syn")
parser.parseRules()
mainFunc = db.getMainFunc()
fileName = argv[xArg]
if fileName[fileName.length() - 3 : fileName.length()] != ".rn" {
  println "Rune file ", fileName, " must end in .rn."
  exit(1i32)
}
if !root.quietMode {
  println "Parsing ", fileName
}
moduleName = stripSuffix(fileName)
moduleResult = parse.loadTopModule(parser, fileName, mainFunc, Sym.new(moduleName))
if isnull(moduleResult) {
  exit(1i32)
}
module = moduleResult!
tc = types.TypeChecker()
// Desugar transformers/relations into ordinary generated members before
// typecheck (see types/desugar.rn).  Diagnostics raised here land in tc's
// error sink and are reported by countTypeErrors() below.
desugar = types.Desugar(tc)
desugar.desugarModule(module)
tc.function(module)
numTypeErrors = tc.countTypeErrors()
if numTypeErrors > 0 {
  println "Found %u type error%s." % (numTypeErrors, numTypeErrors > 1 ? "s" : "")
  tc.dumpTypeErrors()
  exit(1i32)
} else if root.generateC {
  if root.outputCFilename.length() == 0 {
    root.outputCFilename = moduleName + ".c"
  }
  program = c.CBuilder(tc).build(module)
  // Demand-driven specialization can make a previously free cast concrete.
  // CBuilder records those representation errors in the shared typechecker;
  // fail closed before emitting even placeholder C.
  numTypeErrors = tc.countTypeErrors()
  if numTypeErrors > 0 {
    println "Found %u type error%s." % (numTypeErrors, numTypeErrors > 1 ? "s" : "")
    tc.dumpTypeErrors()
    exit(1i32)
  } else {
    emitter = c.CEmitter(root.outputCFilename)
    program.emit(emitter)
    emitter.close()
    if compileC && !runCCompiler(root.outputCFilename, root.debugMode, optimized,
                                 nativeTarget, useGcc) {
      println "Could not compile ", fileName
      exit(1i32)
    }
  }
}
