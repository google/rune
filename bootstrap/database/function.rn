use sym

use root
use bigint
use location
use filepath
use value
use expr
use ident
use statement
use template
use block
use variable

import cbackend as c
import types

enum FuncType {
  Plain  // Includes methods.
  Operator  // Overloaded operator.
  Constructor
  Destructor
  Package  // Initializes all modules in the package.
  Module  // Initializes the module.
  Iterator
  Final
  Struct
  Enum
  Transformer
  Unittest
}

// Function linking type.
enum Linkage {
  Module  // Default, like Python, files in the same directory can access.
  Package  // Allow files in other directories to access.
  Libcall  // A library call API.  All params must have default values.
  Rpc  // An RPC API.  All params must have default values.
  Builtin  // Globally visible, never a lib call or RPC.
  ExternC  // An external C function.
  ExternRpc  // An external RPC function.
}

// Return a name for the function type.
func getFuncTypeName(type: FuncType) -> string {
  switch type {
    FuncType.Plain => return "func"  // Includes methods.
    FuncType.Unittest => return "unittest"  // Includes methods.
    FuncType.Constructor => return "class"
    FuncType.Destructor => return "destructor"
    FuncType.Package => return "package"  // Initializes all modules in the package.
    FuncType.Module => return "module"  // Initializes the module.
    FuncType.Iterator => return "iterator"
    FuncType.Operator => return "operator"
    FuncType.Final => return "final"
    FuncType.Struct => return "struct"
    FuncType.Enum => return "enum"
    FuncType.Transformer => return "transformer"
  }
}

// Create a new function.
class Function(self, parent: Function?, type: FuncType, sym: Sym,
    linkage: Linkage, location: Location) {
  self.type = type
  self.sym = sym
  self.linkage = linkage
  self.location = location
  self.isExtern = linkage == Linkage.ExternC || linkage == Linkage.ExternRpc
  self.opType = ExprType.Add  // Used for overloaded operators.
  // The function's type, set by the typechecker.  Syms are interned by
  // name, so sym.typedValue is unreliable when functions share a name
  // (e.g. the same operator overloaded by two classes).
  self.typedValue = null(types.Type)
  // The body needs structural knowledge of unconstrained parameters and
  // typechecks again under a concrete instantiation before emission.
  self.deferredTypecheck = false
  self.deferredRetypechecked = false
  if !isnull(parent) {
    parent.appendChildFunction(self)
    Ident(parent!, self, sym, location)
  }
  subBlock = Block(location)
  // Assume it can return until we learn otherwise.  This is only an issue when
  // evaluating recursive functions.
  subBlock.canReturn = true
  self.insertSubBlock(subBlock)

  // Return the name of the function.
  func name(self) -> string {
    return self.sym.name
  }

  func dumpParams(self, var text: string) {
    firstTime = true
    for variable in self.variables() {
      if !firstTime {
        text += ", "
      }
      firstTime = false
      if !variable.isParam {
        return
      }
      variable.dumpToString(text)
    }
  }

  // Dump the function to the end of |string| for debugging purposes.
  func dumpToString(self, var text: string) {
    if self.type == FuncType.Enum {
      self.dumpEnumToString(text)
      return
    }
    root.indent(text)
    dumpFuncHeader(self, text)
    self.dumpParams(text)
    text += ")"
    if !isnull(self.typeExpr) {
      text += " -> "
      self.typeExpr.dumpToString(text)
    }
    if self.linkage == Linkage.ExternC || self.linkage == Linkage.ExternRpc {
      text += "\n"
    } else {
      text += " {\n"
      getRoot().incrementIndent()
      self.subBlock.dumpToString(text)
      for function in self.childFunctions() {
        function.dumpToString(text)
      }
      getRoot().decrementIndent()
      getRoot().indent(text)
      text += "}\n"
    }

    func dumpFuncHeader(self: Function, var text: string) {
      if self.linkage == Linkage.ExternC {
        text.concat("extern \"C\" func %s" % self.name())
      } else if self.linkage == Linkage.ExternRpc {
        text.concat("rpc %s" % self.name())
      } else if self.type == FuncType.Final {
        text.concat("final")
      } else {
        text.concat("%s %s" % (getFuncTypeName(self.type), self.name()))
      }
      if self.type == FuncType.Constructor {
        template = self.template
        if template.refWidth != root.defaultRefWidth {
          text.concat(":u%u" % template.refWidth)
        }
      }
      text.append('(')
    }
  }

  // Dump an enumerated type to the string.
  func dumpEnumToString(self: Function, var text: string) {
    root.indent(text)
    text.concat("enum %s {\n" % self.name())
    getRoot().incrementIndent()
    for variable in self.variables() {
      root.indent(text)
      variable.dumpToString(text)
      text.append('\n')
    }
    getRoot().decrementIndent()
    root.indent(text)
    text.concat("}\n")
  }

  func genC(self: Function, builder: c.CBuilder) {
    switch self.type {
      FuncType.Module => self.genModule(builder)
      FuncType.Plain => self.genCPlainFunc(builder)
      FuncType.Operator => self.genCPlainFunc(builder)
      FuncType.Struct => self.genCStruct(builder)
      FuncType.Constructor => self.genCConstructor(builder)
      // Enum members are inlined as integer constants at their use sites.
      FuncType.Enum => return
      // Iterators are inlined into foreach statements by the typechecker;
      // nothing is emitted for the iterator function itself.
      FuncType.Iterator => return
      // Transformers are compile-time code generators.
      FuncType.Transformer => return
      default => raise Status.Unimplemented, "Function type not yet supported by C backend ", self.type
    }
  }

  func genModule(self: Function, builder: c.CBuilder) {
    // Imported modules are appended as child functions after the importing
    // module's own children; emit them first so their top-level statements
    // run before the importer's (matching typechecking order).
    for childfunc in self.childFunctions() {
      if childfunc.type == FuncType.Module {
        childfunc.genC(builder)
      }
    }
    for childfunc in self.childFunctions() {
      if childfunc.type != FuncType.Module {
        childfunc.genC(builder)
      }
    }
    for statement in self.subBlock.statements() {
      // Note that a Rune statement may correspond to a C statement in main()
      // or a C top-level declaration.
      statement.genC(builder)
    }
  }


  func genCPlainFunc(self: Function, builder: c.CBuilder) {
    if self.isExtern {
      // extern "C" functions are provided by the C runtime (under an rn_
      // prefix); nothing is emitted for the declaration itself.
      return
    }
    // TODO: figure out storage types.....

    // Is this a polymorphic type?  polymorphic type variables do not
    // correspond to anything in C (though we could try void*). Instead
    // we must iterate over all known instantiations -- this only works
    // because we are doing whole-program analysis before we generate
    // the C.  (i.e., it is not clear how this would work if we try to
    // compile different packages into separate C files).

    fntype = self.typedValue
    if isnull(fntype) {
      fntype = self.sym.typedValue
    }
    assert !isnull(fntype)

    if fntype.type == types.Type.TypeClass.Polymorphic {
      /******** Polymorphic function: iterate over instantiations *********/
       pi = fntype.poly.instantiations
       if !isnull(pi) {
         for instantiation in pi {
           builder.resolveInstantiation(instantiation)
           // Instantiations whose bindings still contain type variables only
           // resolve under an outer instantiation (e.g. a call from a
           // polymorphic class constructor); they are emitted on demand from
           // the call site while that outer binding is active.
           if builder.instantiationIsConcrete(instantiation) {
             self.genCPolyInstantiation(builder, instantiation)
           }
         }
      }
    } else {
      /******************* Monomorphic function *************************/
      // open new scope - new parameter bindings are added to the scope
      // automatically
      builder.openScope()
      builder.openParamList()
      for variable in self.variables() {
        param = variable.genCParameter(builder)  // param is added to new scope
        builder.addParam(param)
      }
      paramList = builder.closeParamList()
      builder.openDependencyList();
      savedTryBase = builder.openFunctionTryContext()
      // Mark that a function body is being emitted so its first-assigned
      // locals (including loop variables) shadow any same-named module
      // variable instead of sharing the module static.
      monoPrevEmittingFn = builder.currentEmittingFn
      builder.currentEmittingFn = self
      builder.openBlock(self.subBlock.location)
      for bodyStatement in self.subBlock.statements() {
        bodyStatement.genC(builder)
      }
      self.emitScopeExitFinals(builder)
      body = builder.closeBlock()
      builder.currentEmittingFn = monoPrevEmittingFn
      builder.closeFunctionTryContext(savedTryBase)
      builder.closeScope()
      fundec = builder.cFunDef(self.location, self.sym, paramList, body)
      // Function-pointer parameters need their fnptr<N> typedef emitted first.
      for monoVar in self.variables() {
        if monoVar.isParam && !isnull(monoVar.typedValue) {
          monoPt = builder.typechecker.resolve(monoVar.typedValue!)
          if monoPt.type == types.Type.TypeClass.Function {
            builder.ensureFunctionPtrDeclared(self.location, monoPt)
            monoFnptrCType = builder.typeGenerator.genCFunction(monoPt.function!)
            if !isnull(monoFnptrCType) {
              fundec.addDependencyName(monoFnptrCType.cDefinedType.name)
            }
          }
        }
      }
      fundec.addDependencies(builder.topDependencyList().names)
      builder.closeDependencyList()
      builder.addDeclaration(fundec)
    }
  }

  // Rune frees an object when its last reference drops.  The C backend has no
  // reference counts, so it approximates the common case: a function that
  // returns nothing cannot hand a locally built array of objects back to its
  // caller, so when it returns those objects are unreachable and their
  // destructors must run.  Only object arrays that are plain locals (not
  // parameters) of a void function qualify; anything that might escape (a
  // non-void return, an object stored in a relation or global) is left alone.
  // Must be called while the function body block and parameter scope are still
  // open so the array locals resolve and the loop index declares into the body.
  func emitScopeExitFinals(self: Function, builder: c.CBuilder) {
    fntype = self.typedValue
    if isnull(fntype) {
      return
    }
    if fntype.type != types.Type.TypeClass.Function {
      return
    }
    resTy = builder.typechecker.resolve(fntype.function.result!)
    isVoid = (resTy.type == types.Type.TypeClass.Typename &&
              resTy.tyname.name.name == "none")
    if !isVoid {
      return
    }
    // Function locals are not tracked as Variables, so find the object arrays
    // from their defining assignments: a top-level `name = <array-of-class>`
    // statement.  Each local is destroyed once, in declaration order.
    seen = arrayof(string)
    for statement in self.subBlock.statements() {
      if (statement.type == StateType.Assign && !isnull(statement.expr) &&
          statement.expr.type == ExprType.Equals) {
        lhs = statement.expr.firstChildExpr
        if (!isnull(lhs) && lhs.type == ExprType.Ident &&
            !isnull(lhs.typedValue) && !isnull(lhs.val.symVal)) {
          vty = builder.typechecker.resolve(lhs.typedValue!)
          if vty.type == types.Type.TypeClass.Array {
            sym = lhs.val.symVal!
            already = false
            for s in seen {
              if s == sym.name {
                already = true
              }
            }
            if !already {
              elemTy = vty.array.elementType!
              destroyName = builder.classDestroyName(elemTy)
              if destroyName == "" {
                destroyName = builder.classFinalName(elemTy)
              }
              if destroyName != "" {
                seen.append(sym.name)
                self.emitArrayElementFinals(builder, sym, vty, destroyName)
              }
            }
          }
        }
      }
    }
  }

  // Emit `for (i = 0; i < array_length(arr); i++) if (arr[i]) destroy(arr[i]);`
  // into the current (open) block, destroying every live element of |arrSym|.
  func emitArrayElementFinals(self: Function, builder: c.CBuilder, arrSym: Sym,
                              arrTy: types.Type, destroyName: string) {
    loc = self.location
    u64type = builder.cIntType(loc, false, 64u32)
    idxSym = Sym.new("%s_finalidx" % arrSym.name)
    idxDecl = builder.declareLocal(idxSym, u64type)
    zero = Bigint(0u64)
    init = c.CExpr(c.CBinaryOperator(loc, c.CBinaryOperator.Type.Assign,
        null(c.CTypeExpr), idxDecl, builder.cIntLiteral(zero)))
    lenCall = builder.cCall(loc, c.CRuntimeFunction.ArrayLength,
        builder.cIdentifier(arrSym, false, arrTy))
    idxRef1 = c.CExpr(c.CIdentifier(idxSym, null(c.CTypeExpr), false, false, false))
    cond = c.CExpr(c.CBinaryOperator(loc, c.CBinaryOperator.Type.LessThan,
        null(c.CTypeExpr), idxRef1, lenCall))
    one = Bigint(1u64)
    idxRef2 = c.CExpr(c.CIdentifier(idxSym, null(c.CTypeExpr), false, false, false))
    idxRef3 = c.CExpr(c.CIdentifier(idxSym, null(c.CTypeExpr), false, false, false))
    plus = c.CExpr(c.CBinaryOperator(loc, c.CBinaryOperator.Type.Plus,
        null(c.CTypeExpr), idxRef2, builder.cIntLiteral(one)))
    incr = c.CExpr(c.CBinaryOperator(loc, c.CBinaryOperator.Type.Assign,
        null(c.CTypeExpr), idxRef3, plus))
    forList = c.CExprList()
    forList.appendCExpr(init)
    forList.appendCExpr(cond)
    forList.appendCExpr(incr)
    builder.openBlock(loc)
    idxRef4 = c.CExpr(c.CIdentifier(idxSym, null(c.CTypeExpr), false, false, false))
    condElem = c.CExpr(c.CIndexExpr(loc,
        builder.cIdentifier(arrSym, false, arrTy), idxRef4))
    idxRef5 = c.CExpr(c.CIdentifier(idxSym, null(c.CTypeExpr), false, false, false))
    callElem = c.CExpr(c.CIndexExpr(loc,
        builder.cIdentifier(arrSym, false, arrTy), idxRef5))
    destroyArgs = c.CExprList()
    destroyArgs.appendCExpr(callElem)
    builder.openBlock(loc)
    builder.addStatement(loc, builder.cCall(loc, destroyName, c.CExpr(destroyArgs)))
    ifBody = builder.closeBlock()
    builder.addStatement(loc,
        c.CStatement(loc, c.CStatementType.If, condElem, ifBody))
    loopBody = builder.closeBlock()
    builder.addStatement(loc,
        c.CStatement(loc, c.CStatementType.For, c.CExpr(forList), loopBody))
  }

  // Emit a single specialization of a polymorphic function under the given
  // instantiation.  Also called on demand from poly call sites, while an
  // outer instantiation binding is active.
  func genCPolyInstantiation(self: Function, builder: c.CBuilder,
                             instantiation: types.TyvarInstantiation) {
    fntype = self.typedValue!
    // Resolve each parameter's own type under the instantiation.
    // The generalized variables in varBindings do not align
    // positionally with the parameters (operator type variables can
    // be generalized too), so positional lookup is wrong.
    builder.instantiate(fntype.poly!, instantiation)
    paramTypes = arrayof(types.Type)
    for variable in self.variables() {
      if isnull(variable.typedValue) {
        // A parameter that never typechecked (poisoned method).
        paramTypes.append(types.NONETY())
      } else {
        ptResolved = builder.typechecker.resolve(variable.typedValue!)
        if ptResolved.type == types.Type.TypeClass.Tuple {
          // Tuple-typed parameters need the typedef even when no tuple
          // literal has emitted yet.
          builder.ensureTupleDeclared(self.location, ptResolved)
        }
        paramTypes.append(ptResolved)
      }
    }
    // The specialization name comes from the resolved parameter
    // types, matching genSpecializationName at call sites.
    paramTuple = types.Type(types.TupleType(paramTypes))
    specializedName = paramTuple.genSpecializationName(self.sym.name)
    if builder.alreadyEmitted(specializedName) {
      builder.deInstantiate(fntype.poly!)
      return
    }
    builder.markEmitted(specializedName)
    builder.openScope()
    builder.openParamList()
    index = 0
    for variable in self.variables() {
      param = variable.genCParameter(builder, paramTypes[index])
      builder.addParam(param)
      index += 1
    }
    paramList = builder.closeParamList()
    // The function block may generate dependencies, e.g., inner
    // functions or tuples or structs. Ensure that these are listed
    // as depedencies of this function.
    builder.openDependencyList();
    savedTryBase = builder.openFunctionTryContext()
    prevEmittingFn = builder.currentEmittingFn
    prevEmittingName = builder.currentEmittingName
    prevEmittingResultWide = builder.currentEmittingResultWide
    builder.currentEmittingFn = self
    builder.currentEmittingName = specializedName
    builder.currentEmittingResultWide = builder.wideWidth(fntype.poly.scope.function.result)
    if self.deferredTypecheck && !self.deferredRetypechecked {
      // Only instantiations synthesized at emission reach here (recorded
      // ones retypecheck in the pre-emission pass); bindings are active.
      builder.typechecker.retypecheckDeferred(self)
      self.deferredRetypechecked = true
    }
    body = self.subBlock.genC(builder)
    builder.currentEmittingFn = prevEmittingFn
    builder.currentEmittingName = prevEmittingName
    builder.currentEmittingResultWide = prevEmittingResultWide
    builder.closeFunctionTryContext(savedTryBase)
    builder.deInstantiate(fntype.poly!)
    builder.closeScope()
    newsym = Sym.new(specializedName)
    newsym.typedValue = instantiation.type
    if isnull(newsym.typedValue) {
      // A synthesized instantiation may carry no type; the resolved scope
      // serves for the return type.
      newsym.typedValue = builder.typechecker.resolve(fntype.poly.scope)
    }
    fundec = builder.cFunDef(self.location, newsym, paramList, body)
    // Class-typed parameters need the class struct typedef emitted first.
    for pt in paramTypes {
      if builder.isClassType(pt) {
        fundec.addDependencyName(builder.classCName(pt) + "_class")
      }
      if pt.type == types.Type.TypeClass.Tuple {
        fundec.addDependencyName(builder.typeGenerator.genCTuple(pt.tuple!).name)
      }
      if pt.type == types.Type.TypeClass.Array {
        ptDef = builder.ensureArrayDeclared(self.location, pt.array.elementType!)
        fundec.addDependencyName(ptDef.typeName)
      }
      if pt.type == types.Type.TypeClass.Function {
        // A function-pointer parameter needs its fnptr<N> typedef emitted.
        builder.ensureFunctionPtrDeclared(self.location, pt)
        fnptrCType = builder.typeGenerator.genCFunction(pt.function!)
        if !isnull(fnptrCType) {
          fundec.addDependencyName(fnptrCType.cDefinedType.name)
        }
      }
    }
    fundec.addDependencies(builder.topDependencyList().names)
    builder.closeDependencyList()
    builder.addDeclaration(fundec)
  }

  // Generate C code for a class: a struct typedef per instantiation, a
  // constructor function that heap-allocates and initializes an instance,
  // and the class's methods.
  func genCConstructor(self: Function, builder: c.CBuilder) {
    fntype = self.typedValue
    if isnull(fntype) {
      fntype = self.sym.typedValue
    }
    assert !isnull(fntype)
    info = builder.typechecker.lookupClass(self.sym)
    assert !isnull(info)

    if fntype.type == types.Type.TypeClass.Polymorphic {
      pi = fntype.poly.instantiations
      if !isnull(pi) {
        for instantiation in pi {
          builder.resolveInstantiation(instantiation)
          // Skip instantiations that are not concrete (e.g. recorded while
          // typechecking another polymorphic body); the concrete ones cover
          // every class that is actually constructed.
          if builder.instantiationIsConcrete(instantiation) {
            builder.instantiate(fntype.poly!, instantiation)
            self.genCConstructorInstance(builder, info!)
            builder.deInstantiate(fntype.poly!)
          }
        }
      }
    } else {
      self.genCConstructorInstance(builder, info!)
    }

    // Emit the methods for each of their own instantiations.
    for childfunc in self.childFunctions() {
      if childfunc.type == FuncType.Plain {
        childfunc.genCMethod(builder)
      } else if childfunc.type == FuncType.Operator {
        // Operators are standalone functions, not methods.
        childfunc.genCPlainFunc(builder)
      }
    }
  }

  // Generate the struct typedef and constructor function for one
  // instantiation of a class.  Must be called with the class's type
  // variables instantiated in the typechecker.
  func genCConstructorInstance(self: Function, builder: c.CBuilder, info: types.ClassInfo) {
    if isnull(info.selfType) {
      println "DBGNST class=", self.sym.name
      return
    }
    instType = builder.typechecker.resolve(info.selfType!)
    // The struct (and methods, final, toString) is named without phantom
    // parameters and emitted once; the constructor keeps them and emits per
    // argument type (its body's typeswitch picks a different conversion).  For
    // a class with no phantom parameters these names are identical, so the
    // behavior is unchanged.
    className = builder.classCName(instType)
    ctorName = builder.classCtorCName(instType)
    if builder.alreadyEmitted(ctorName) {
      return
    }
    structAlready = builder.alreadyEmitted(className)
    builder.markEmitted(ctorName)
    if !structAlready {
      builder.markEmitted(className)
    }

    if !structAlready {
    // The struct fields, with this instantiation's concrete types.  Field
    // types that name other declarations (structs, arrays, other classes)
    // must be emitted before this class.
    fieldDeps = arrayof(string)
    fields = c.CParamList()
    for i in range(info.strct.fieldnames.length()) {
      fieldty = builder.typechecker.resolve(info.strct.fieldtypes[i])
      if fieldty.type == types.Type.TypeClass.Var {
        // A field whose baked type stayed an open variable (e.g. its
        // create-on-assign unification reverted with the deferral
        // rollback): recover the type from the constructor body's
        // self.<field> = <expr> assignment.
        for fstmt in self.subBlock.statements() {
          if !isnull(fstmt.expr) {
            if fstmt.expr.type == ExprType.Equals {
              flhs = fstmt.expr.firstChildExpr!
              if flhs.type == ExprType.Dot {
                fbase = flhs.firstChildExpr!
                fmem = fbase.nextExprChildExpr!
                if (fbase.type == ExprType.Ident &&
                    fmem.type == ExprType.Ident) {
                  if fbase.val.symVal.name == "self" &&
                      fmem.val.symVal.name == info.strct.fieldnames[i].name {
                    frhs = flhs.nextExprChildExpr!
                    if !isnull(frhs.typedValue) {
                      fr = builder.typechecker.resolve(frhs.typedValue!)
                      if fr.type != types.Type.TypeClass.Var {
                        fieldty = fr
                        // Later retypechecks (the generated destroy) read
                        // the field type from the class info; persist it.
                        info.strct.fieldtypes[i] = fr
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
      ctype = builder.genCType(fieldty)
      if ctype.type == c.CTypeExpr.Type.Defined {
        fieldDeps.append(ctype.toString())
      } else if ctype.type == c.CTypeExpr.Type.Array {
        fieldDeps.append(ctype.cArrayType.name)
      } else if ctype.type == c.CTypeExpr.Type.Pointer {
        fieldDeps.append(ctype.cPointerType.target.toString() + "_class")
      }
      fieldParam = c.CParameter(self.location, info.strct.fieldnames[i].name, ctype!)
      for gname in info.generatedFieldNames {
        if gname == info.strct.fieldnames[i].name {
          fieldParam.noPrint = true
        }
      }
      fields.append(fieldParam)
    }
    toStringMethod = ""
    for childfunc in self.childFunctions() {
      if childfunc.sym.name == "toString" {
        toStringMethod = className + "_toString"
      }
    }
    refWidth = 0u32
    if !isnull(self.template) {
      if self.template.explicitWidth {
        refWidth = self.template.refWidth
      }
    }
    classDec = builder.cClassDeclaration(self.location, className, fields,
        toStringMethod, refWidth)
    for depName in fieldDeps {
      classDec.addDependencyName(depName)
    }
    builder.addDeclaration(classDec)
    }

    // The constructor function: allocates the instance, runs the body, and
    // returns the instance pointer.  Named with phantom parameters kept, so
    // each argument-type variant is its own C function.
    builder.openScope()
    builder.openParamList()
    for variable in self.variables() {
      if variable.sym.name != "self" {
        pty = builder.typechecker.resolve(variable.typedValue!)
        param = variable.genCParameter(builder, pty)
        builder.addParam(param)
      }
    }
    paramList = builder.closeParamList()
    builder.openDependencyList()
    builder.openBlock(self.location)

    selfSym = Sym.new("self")
    ptrType = builder.genCType(instType)
    selfRef = builder.declareLocal(selfSym, ptrType)
    callocArgs = c.CExprList()
    one = Bigint(1u32)
    callocArgs.appendCExpr(builder.cIntLiteral(one))
    sizeofArg = c.CExpr(c.CIdentifier(Sym.new(className + "_t"), null(c.CTypeExpr),
                                      false, false, false))
    callocArgs.appendCExpr(builder.cCall(self.location, "sizeof", sizeofArg))
    callocCall = builder.cCall(self.location, "calloc", c.CExpr(callocArgs))
    assign = c.CExpr(c.CBinaryOperator(self.location, c.CBinaryOperator.Type.Assign,
                                       null(c.CTypeExpr), selfRef, callocCall))
    builder.addStatement(self.location, assign)

    // Number the instance: self->rn_id = ++<class>_idcounter.
    counterRef = c.CExpr(c.CIdentifier(Sym.new(className + "_idcounter"),
                                       null(c.CTypeExpr), false, false, false))
    counterRef2 = c.CExpr(c.CIdentifier(Sym.new(className + "_idcounter"),
                                        null(c.CTypeExpr), false, false, false))
    counterRef3 = c.CExpr(c.CIdentifier(Sym.new(className + "_idcounter"),
                                        null(c.CTypeExpr), false, false, false))
    one2 = Bigint(1u32)
    bump = c.CExpr(c.CBinaryOperator(self.location, c.CBinaryOperator.Type.Assign,
        null(c.CTypeExpr), counterRef,
        c.CExpr(c.CBinaryOperator(self.location, c.CBinaryOperator.Type.Plus,
            null(c.CTypeExpr), counterRef2, builder.cIntLiteral(one2)))))
    builder.addStatement(self.location, bump)
    selfRef2 = c.CExpr(c.CIdentifier(selfSym, null(c.CTypeExpr), false, false, false))
    idAssign = c.CExpr(c.CBinaryOperator(self.location, c.CBinaryOperator.Type.Assign,
        null(c.CTypeExpr),
        c.CExpr(c.CDotExpr(self.location, selfRef2, "rn_id", true)), counterRef3))
    builder.addStatement(self.location, idAssign)

    for statement in self.subBlock.statements() {
      statement.genC(builder)
    }

    retRef = c.CExpr(c.CIdentifier(selfSym, null(c.CTypeExpr), false, false, false))
    builder.addStatement(self.location, builder.cReturnStatement(self.location, retRef))
    body = builder.closeBlock()
    builder.closeScope()

    fundec = builder.cFunDefWithReturnType(self.location, ctorName, paramList, body, ptrType!)
    fundec.addDependencyName(className + "_class")
    fundec.addDependencies(builder.topDependencyList().names)
    builder.closeDependencyList()
    builder.addDeclaration(fundec)

    if !structAlready {
    // A final() destructor is called from generated cleanup code, never
    // from user calls, so emit it per instantiation like toString below.
    for childfunc in self.childFunctions() {
      if childfunc.type == FuncType.Final {
        if isnull(childfunc.typedValue) {
          // Never typechecked (no user call site): demand it now so the
          // body's expressions carry types into emission.
          builder.typechecker.demandMethod(info, childfunc)
        }
        fty = childfunc.typedValue
        if isnull(fty) {
          fty = childfunc.sym.typedValue
        }
        if !isnull(fty) {
          if fty.type == types.Type.TypeClass.Polymorphic {
            ffn = builder.typechecker.resolve(fty.poly.scope)
          } else {
            ffn = fty!
          }
          if !builder.typechecker.hasFreeVars(ffn) {
            childfunc.genCMethodInstance(builder, ffn)
          }
        }
      }
    }

    // The generated destroy() runs relation removal and the final()
    // destructor; cleanup code calls it without a user call site, so emit
    // it per instantiation like final above.
    for childfunc in self.childFunctions() {
      if childfunc.sym.name == "destroy" && childfunc.type == FuncType.Plain {
        if isnull(childfunc.typedValue) {
          builder.typechecker.demandMethod(info, childfunc)
        }
        dty = childfunc.typedValue
        if isnull(dty) {
          dty = childfunc.sym.typedValue
        }
        if !isnull(dty) {
          if dty.type == types.Type.TypeClass.Polymorphic {
            // A deferred destroy resolves only under its (synthesized)
            // instantiation bindings.
            dInstE = dty.poly.instantiations.firstTyvarInstantiation
            if !isnull(dInstE) {
              builder.instantiate(dty.poly!, dInstE!)
              if childfunc.deferredTypecheck && !childfunc.deferredRetypechecked {
                // The recorded instantiation only resolves under this
                // class instantiation's bindings (the pre-emission pass
                // saw open variables); retypecheck here like the
                // genCPolyInstantiation fallback.
                builder.typechecker.retypecheckDeferred(childfunc)
                childfunc.deferredRetypechecked = true
              }
              dInstFn = builder.typechecker.resolve(dty.poly.scope)
              if !builder.typechecker.hasFreeVars(dInstFn) {
                childfunc.genCMethodInstance(builder, dInstFn)
              }
              builder.deInstantiate(dty.poly!)
              dfn = null(types.Type)
            } else {
              if childfunc.deferredTypecheck && !childfunc.deferredRetypechecked {
                // No instantiation was ever recorded (method dispatch does
                // not open the poly); the class bindings active here are
                // enough for the body to retypecheck concretely.
                builder.typechecker.retypecheckDeferred(childfunc)
                childfunc.deferredRetypechecked = true
              }
              dfn = builder.typechecker.resolve(dty.poly.scope)
            }
          } else {
            dfn = dty!
          }
          if !isnull(dfn) {
            if !builder.typechecker.hasFreeVars(dfn!) {
              childfunc.genCMethodInstance(builder, dfn!)
            }
          }
        }
      }
    }

    // A user-defined toString must be emitted for this instantiation even if
    // user code never calls it: the class's tostring_<class> print helper
    // references it.  The class's type variables are bound here, so the
    // method's type resolves concretely.
    for childfunc in self.childFunctions() {
      if childfunc.sym.name == "toString" && childfunc.type == FuncType.Plain {
        if isnull(childfunc.typedValue) {
          builder.typechecker.demandMethod(info, childfunc)
        }
        mty = childfunc.typedValue
        if isnull(mty) {
          mty = childfunc.sym.typedValue
        }
        if !isnull(mty) {
          if mty.type == types.Type.TypeClass.Polymorphic {
            mfn = builder.typechecker.resolve(mty.poly.scope)
          } else {
            mfn = mty!
          }
          if !builder.typechecker.hasFreeVars(mfn) {
            childfunc.genCMethodInstance(builder, mfn)
          }
        }
      }
    }
    }
  }

  // Generate C code for a class method, once per recorded instantiation.
  func genCMethod(self: Function, builder: c.CBuilder) {
    fntype = self.typedValue
    if isnull(fntype) {
      // The method was never called or typechecked; nothing to emit.
      return
    }
    if fntype.type == types.Type.TypeClass.Polymorphic {
      pi = fntype.poly.instantiations
      if !isnull(pi) {
        for instantiation in pi {
          builder.resolveInstantiation(instantiation)
          if builder.instantiationIsConcrete(instantiation) {
            builder.instantiate(fntype.poly!, instantiation)
            self.genCMethodInstance(builder, instantiation.type)
            builder.deInstantiate(fntype.poly!)
          }
        }
      }
    } else if fntype.type == types.Type.TypeClass.Function {
      self.genCMethodInstance(builder, fntype!)
    }
  }

  // Generate one specialization of a class method.  fnInstType is the
  // method's resolved function type, including the self parameter.
  func genCMethodInstance(self: Function, builder: c.CBuilder, fnInstType: types.Type) {
    if fnInstType.type != types.Type.TypeClass.Function {
      return
    }
    methodName = builder.methodDefCName(fnInstType, self.sym.name)
    if builder.alreadyEmitted(methodName) {
      return
    }
    builder.markEmitted(methodName)

    builder.openScope()
    builder.openParamList()
    params = fnInstType.function.params
    index = 0
    for variable in self.variables() {
      if params.type == types.Type.TypeClass.Tuple {
        pty = params.tuple.elements[index]
      } else {
        pty = params
      }
      param = variable.genCParameter(builder, builder.typechecker.resolve(pty))
      builder.addParam(param)
      index += 1
    }
    paramList = builder.closeParamList()
    builder.openDependencyList()
    savedTryBase = builder.openFunctionTryContext()
    if self.sym.name == "destroy" {
      // destroy() must be idempotent: cleanup paths (cascade deletion,
      // reference overwrite, program exit) can reach an object more than
      // once.  Emit: if (self) { if (self->rn_id) { <body> rn_id = 0; } }
      destroySelfSym = Sym.new("self")
      builder.openBlock(self.location)
      builder.openBlock(self.location)
      builder.openBlock(self.location)
      for destroyStatement in self.subBlock.statements() {
        destroyStatement.genC(builder)
      }
      zeroSelfRef = c.CExpr(c.CIdentifier(destroySelfSym, null(c.CTypeExpr),
          false, false, false))
      zeroVal = Bigint(0u32)
      zeroAssign = c.CExpr(c.CBinaryOperator(self.location,
          c.CBinaryOperator.Type.Assign, null(c.CTypeExpr),
          c.CExpr(c.CDotExpr(self.location, zeroSelfRef, "rn_id", true)),
          builder.cIntLiteral(zeroVal)))
      builder.addStatement(self.location, zeroAssign)
      destroyGuardBody = builder.closeBlock()
      idSelfRef = c.CExpr(c.CIdentifier(destroySelfSym, null(c.CTypeExpr),
          false, false, false))
      idRef = c.CExpr(c.CDotExpr(self.location, idSelfRef, "rn_id", true))
      builder.addStatement(self.location, c.CStatement(self.location,
          c.CStatementType.If, idRef, destroyGuardBody))
      destroyNullBody = builder.closeBlock()
      condSelfRef = c.CExpr(c.CIdentifier(destroySelfSym, null(c.CTypeExpr),
          false, false, false))
      builder.addStatement(self.location, c.CStatement(self.location,
          c.CStatementType.If, condSelfRef, destroyNullBody))
      body = builder.closeBlock()
    } else {
      body = self.subBlock.genC(builder)
    }
    builder.closeFunctionTryContext(savedTryBase)
    builder.closeScope()

    resTy = builder.typechecker.resolve(fnInstType.function.result)
    if resTy.type == types.Type.TypeClass.Typename && resTy.tyname.name.name == "none" {
      returnType = builder.cVoidType(self.location)
    } else {
      returnType = builder.genCType(resTy)
    }
    fundec = builder.cFunDefWithReturnType(self.location, methodName, paramList, body, returnType!)
    // The method's self parameter needs the class struct typedef.
    params2 = fnInstType.function.params
    if params2.type == types.Type.TypeClass.Tuple && params2.tuple.elements.length() > 0 {
      fundec.addDependencyName(builder.classCName(params2.tuple.elements[0]) + "_class")
    } else {
      fundec.addDependencyName(builder.classCName(params2) + "_class")
    }
    // Array- and tuple-typed parameters need their typedefs first too.
    if params2.type == types.Type.TypeClass.Tuple {
      for p2el in params2.tuple.elements {
        p2r = builder.typechecker.resolve(p2el)
        if p2r.type == types.Type.TypeClass.Array {
          p2def = builder.ensureArrayDeclared(self.location, p2r.array.elementType!)
          fundec.addDependencyName(p2def.typeName)
        } else if p2r.type == types.Type.TypeClass.Tuple {
          builder.ensureTupleDeclared(self.location, p2r)
          fundec.addDependencyName(builder.typeGenerator.genCTuple(p2r.tuple!).name)
        }
      }
    }
    fundec.addDependencies(builder.topDependencyList().names)
    builder.closeDependencyList()
    builder.addDeclaration(fundec)
  }

  func genCStruct(self: Function, builder: c.CBuilder) {
    fntype = self.typedValue
    if isnull(fntype) {
      fntype = self.sym.typedValue
    }
    assert !isnull(fntype)

    if fntype.type == types.Type.TypeClass.Polymorphic {
      /******** Polymorphic function: iterate over instantiations *********/
       pi = fntype.poly.instantiations
       if !isnull(pi) {
         for instantiation in pi {
           builder.resolveInstantiation(instantiation)
           if builder.instantiationIsConcrete(instantiation) {
             self.genCStructInstance(builder, instantiation)
           }
         }
      }
    } else {
      /******************* Monomorphic function *************************/
      // open new scope - new parameter bindings are added to the scope
      // automatically
      builder.openScope()
      builder.openParamList()
      for variable in self.variables() {
        param = variable.genCParameter(builder)  // param is added to new scope
        builder.addParam(param)
      }
      paramList = builder.closeParamList()
      builder.openDependencyList();
      body = self.subBlock.genC(builder)
      builder.closeScope()
      fundec = builder.cStruct(self.location, self.sym, paramList, body)
      fundec.addDependencies(builder.topDependencyList().names)
      builder.closeDependencyList()
      builder.addDeclaration(fundec)
    }
  }

  // Emit one specialization of a struct: typedef, constructor and tostring.
  // The specialization name comes from the resolved field types, matching
  // genCTypename and call-site naming.
  func genCStructInstance(self: Function, builder: c.CBuilder,
                          instantiation: types.TyvarInstantiation) {
    fntype = self.typedValue!
    builder.instantiate(fntype.poly!, instantiation)
    paramTypes = arrayof(types.Type)
    for variable in self.variables() {
      paramTypes.append(builder.typechecker.resolve(variable.typedValue!))
    }
    paramTuple = types.Type(types.TupleType(paramTypes))
    specializedName = paramTuple.genSpecializationName(self.sym.name)
    if builder.alreadyEmitted(specializedName) {
      builder.deInstantiate(fntype.poly!)
      return
    }
    builder.markEmitted(specializedName)
    builder.openScope()
    builder.openParamList()
    index = 0
    for variable in self.variables() {
      param = variable.genCParameter(builder, paramTypes[index])
      builder.addParam(param)
      index += 1
    }
    paramList = builder.closeParamList()
    builder.openDependencyList();
    body = self.subBlock.genC(builder)
    builder.deInstantiate(fntype.poly!)
    builder.closeScope()
    fundec = builder.cStruct(self.location, Sym.new(specializedName), paramList, body)
    fundec.addDependencies(builder.topDependencyList().names)
    builder.closeDependencyList()
    builder.addDeclaration(fundec)
  }

  // Dump the function to stdout for debugging purposes.
  func dump(self) {
    text = ""
    self.dumpToString(text)
    print text
  }

  // Make a copy of the function in |destBlock|.
  func copy(self, destFunc: Function) -> Function {
    newFunction = Function(destFunc, self.type, self.sym, self.linkage, self.location)
    for variable in self.variables() {
      variable.copy(newFunction)
    }
    // Nested function definitions (e.g. a helper inside a transformer's
    // method template) copy along with their parent.
    for childFunction in self.childFunctions() {
      childFunction.copy(newFunction)
    }
    newBlock = self.subBlock.copy()
    newFunction.insertSubBlock(newBlock)
    if !isnull(self.typeExpr) {
      newFunction.typeExpr = self.typeExpr.copy()
    }
    // TODO: Comment this back in when we port templates.
    // if self.type == FuncType.Constructor {
      // self.templ.copy(newFunction)
    // }
    return newFunction
  }

  // Prepend a call statement to |childFunction| at the end of |function|.
  // |childFunction| will be called with no parameters.
  func prependFunctionCall(self, childFunction: Function) -> Statement {
    statement = self.appendFunctionCall(childFunction)
    // Move the statement to the start of the block.
    block = self.subBlock!
    block.removeStatement(statement)
    block.insertStatement(statement)
    return statement
  }

  // Append a call statement to |childFunction| at the end of |function|.
  // |childFunction| will be called with no parameters.
  func appendFunctionCall(self, childFunction: Function) -> Statement {
    ident = childFunction.firstNameIdent
    pathExpr = ident.createPathExpr()
    block = self.subBlock!
    location = Location(block.location.filepath!, 0u32, 0u32, 0u32)
    emptyParamsExpr = Expr(ExprType.List, location)
    callExpr = Expr.newBinary(ExprType.Call, pathExpr, emptyParamsExpr, location)
    statement = Statement(block, StateType.Call, location)
    statement.insertExpr(callExpr)
    return statement
  }

  // Generate a unique name for an identifier in the function, based on |name|.
  // Just use |name| if there is no conflict, otherwise, add _n, where n is an
  // integer to make the name unique in the function.
  func createUniqueSym(self, sym: Sym) -> Sym {
    if isnull(self.findIdent(sym)) {
      return sym
    }
    counter = 1u32
    do {
      newSym = Sym.new("%s_%u" % (sym.name, counter))
      counter += 1
    } while !isnull(self.findIdent(newSym))
    return newSym
  }

  // Create a path expression to this function.
  func createPathExpr(self) -> Expr {
    identExpr = Expr.newIdent(self.sym, self.location)
    parent = self.parentFunction
    if isnull(parent) {
      return identExpr
    }
    prefixExpr = parent.createPathExpr()
    return Expr.newBinary(ExprType.Dot, prefixExpr, identExpr, self.location)
  }
}

// Modules loaded by import statements, registered under their alias (the
// last identifier of the import path, or the name after "as").  The
// typechecker uses this to resolve <alias>.<member> expressions; modules
// otherwise share one global namespace in the bootstrap.
moduleAliases = arrayof(Sym)
moduleAliasTargets = arrayof(Function)

func registerModuleAlias(alias: Sym, moduleFunc: Function) {
  for i in range(moduleAliases.length()) {
    if moduleAliases[i] == alias {
      return
    }
  }
  moduleAliases.append(alias)
  moduleAliasTargets.append(moduleFunc)
}

func lookupModuleAlias(alias: Sym) -> Function? {
  for i in range(moduleAliases.length()) {
    if moduleAliases[i] == alias {
      return moduleAliasTargets[i]
    }
  }
  return null(Function)
}

// Container functions holding prependcode/appendcode code, indexed by the
// statement's codeBlockIndex (object comparisons are unreliable as keys).
codeBlockContainers = arrayof(Function)

func registerCodeBlock(statement: Statement, container: Function) {
  statement.codeBlockIndex = <u32>codeBlockContainers.length()
  codeBlockContainers.append(container)
}

func lookupCodeBlock(statement: Statement) -> Function? {
  if statement.codeBlockIndex == 0xffffffffu32 {
    return null(Function)
  }
  return codeBlockContainers[<u64>statement.codeBlockIndex]
}

// Append a call statement to the module initialization function in the root function.
func insertModuleInitializationCall(moduleFunc: Function) {
  pathExpr = moduleFunc.createPathExpr()
  block = moduleFunc.subBlock!
  location = Location(block.location.filepath!, 0u32, 0u32, 0u32)
  emptyParamsExpr = Expr(ExprType.List, location)
  callExpression = Expr.newBinary(ExprType.Call, pathExpr, emptyParamsExpr, location)
  block = getMainFunc().subBlock!
  statement = Statement(block, StateType.Call, location)
  statement.insertExpr(callExpression)
  // Move the statement to after the last initialization call.
  lastInitializer = root.lastInitializerStatement
  block.removeStatement(statement)
  if !isnull(lastInitializer) {
    block.insertAfterStatement(lastInitializer, statement)
  } else {
    block.insertStatement(statement)
  }
  root.lastInitializerStatement = statement
}

// The root function of the function tree.
relation OneToOne Root:"Main" Function:"Main" cascade
relation DoublyLinked Function:"Parent" Function:"Child" cascade
relation OneToOne Filepath:"Module" Function:"Module"

// Create the main function.
func createMainFunc() {
  rootFilepath = Filepath("Root filepath", null(Filepath), true)
  rootLocation = Location(rootFilepath, 0u32, 0u32, 0u32)
  mainFunc = Function(null(Function), FuncType.Package,
        Sym.new("main"), Linkage.Package, rootLocation)
  typeExpr = Expr(ExprType.IntType, rootLocation)
  typeExpr.width = 32u32
  mainFunc.insertTypeExpr(typeExpr)
  getRoot().insertMainFunction(mainFunc)
  rootBlock = mainFunc.subBlock!
  rootFilepath.insertModuleFunction(mainFunc)
  nullExpr = null(Expr(ExprType.Add, rootLocation))
  u32TypeExpr = Expr(ExprType.UintType, rootLocation)
  stringTypeExpr = Expr(ExprType.StringType, rootLocation)
  u32TypeExpr.width = 32u32
  argcVar = Variable(mainFunc, true, true, Sym.new("argc"), nullExpr, u32TypeExpr, true, rootLocation)
  argvVar = Variable(mainFunc, true, true, Sym.new("argv"), nullExpr,
      stringTypeExpr, true, rootLocation)
  statement = Statement(mainFunc.subBlock!, StateType.Return, rootLocation)
  retVal = Expr.newConstant(Value(0i32), rootLocation)
  statement.insertExpr(retVal)
}

root = getRoot()
createMainFunc()

unittest {
  use statement

  mainFunc = getMainFunc()
  rootLocation = mainFunc.location
  rootFilepath = rootLocation.filepath
  argcVar = mainFunc.firstVariable!
  argvVar = argcVar.nextFunctionVariable!

  func createEmptyFunction(owningFunc: Function?, name: string) -> Function {
    return Function(owningFunc, FuncType.Plain, Sym.new(name), Linkage.Module, rootLocation)
  }

  func createPrintlnFunction(owningFunc: Function?, name: string, text: string) {
    function = createEmptyFunction(owningFunc, name);
    block = function.subBlock!
    Statement(block, StateType.Println, rootLocation)
    return function
  }
}

unittest dumpTest {
  mainFunc.dump()
}

unittest copyTest {
  destFunc = createEmptyFunction(null(Function), "destFunc")
  destFunc = mainFunc.copy(destFunc)
  destFunc.dump()
}

unittest prependAndAppendFunctionCallTest {
  destFunc = createEmptyFunction(null(Function), "destFunc")
  mainCopy = mainFunc.copy(destFunc)
  // Create an inner function.
  topFunc = createEmptyFunction(mainCopy, "topFunc")
  botFunc = createEmptyFunction(mainCopy, "botFunc")
  lastStatement = mainCopy.appendFunctionCall(botFunc)
  firstStatement = mainCopy.prependFunctionCall(topFunc)
  subBlock = mainCopy.subBlock!
  assert subBlock.firstStatement == firstStatement
  assert subBlock.lastStatement == lastStatement
  mainCopy.dump()
}

unittest insertModuleInitializationCallTest {
  // Create an inner function.
  function1 = createEmptyFunction(getRoot().mainFunction!, "module1")
  function2 = createEmptyFunction(getRoot().mainFunction!, "module2")
  insertModuleInitializationCall(function1)
  insertModuleInitializationCall(function2)
  getMainFunc().dump()
}

unittest createUniqueSymTest {
  baseSym = Sym.new("printTest")
  topFunc = createEmptyFunction(getMainFunc(), "topFunc")
  createPrintlnFunction(topFunc, baseSym.name, "func1")
  newSym = topFunc.createUniqueSym(baseSym)
  assert newSym.name == "printTest_1"
  createPrintlnFunction(topFunc, newSym.name, "func2")
  newSym = topFunc.createUniqueSym(baseSym)
  assert newSym.name == "printTest_2"
  createPrintlnFunction(topFunc, newSym.name, "func3")
  topFunc.dump()
}

unittest createConstructorTest {
  mainFunc = getMainFunc()
  rootLocation = mainFunc.location
  rootFilepath = rootLocation.filepath
  constructor = Function(mainFunc, FuncType.Constructor, Sym.new("Foo"),
      Linkage.Module, rootLocation)
  template = Template(constructor, 16u32, rootLocation)
}

unittest newIteratorAndOperatorTest {
  itr = Function(mainFunc, FuncType.Iterator, Sym.new("testItr"), Linkage.Module, rootLocation)
  op = Function(mainFunc, FuncType.Operator, Sym.new("*"), Linkage.Module, rootLocation)
  op.opType = ExprType.Mul
  itr.dump()
  op.dump()
  itr.destroy()
  op.destroy()
}
