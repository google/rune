            externArgs, externFn, null(c.CTypeExpr)))
      }
    }

    // The call expression's own type can lose its polymorphic wrapper (the
    // typechecker resolves shallowly), e.g. for recursive calls inside the
    // function's body; fall back to the definition's type.
    polyType = fntype
    if polyType.type != types.Type.TypeClass.Polymorphic && left.type == ExprType.Ident {
      polyCallee = builder.findFunction(left.val.symVal.name)
      if !isnull(polyCallee) && !isnull(polyCallee.typedValue) &&
          polyCallee.typedValue.type == types.Type.TypeClass.Polymorphic &&
