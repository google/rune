          "byteReaderNew" => byteReaderFn = c.CRuntimeFunction.ByteReaderNew
          "byteReaderPeekByte" => byteReaderFn = c.CRuntimeFunction.ByteReaderPeekByte
          "byteReaderAppendUntilByteSkippingByteInto" => byteReaderFn = c.CRuntimeFunction.ByteReaderAppendUntilByteSkippingByteInto
          "byteReaderAppendlnInto" => byteReaderFn = c.CRuntimeFunction.ByteReaderAppendLnInto
          "byteReaderReadlnInto" => byteReaderFn = c.CRuntimeFunction.ByteReaderReadLnInto
          default => byteReaderFn = c.CRuntimeFunction.ByteReaderFree
        }
        byteReaderArgs = c.CExprList()
        if right.typedValue.type == types.Type.TypeClass.Tuple {
          for child in right.childExprs() {
            byteReaderArgs.appendCExpr(child.genC(builder))
          }
        } else if !(right.type == ExprType.List && isnull(right.firstChildExpr)) {
