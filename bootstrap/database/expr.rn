      if (builtinName == "u64MapNew" || builtinName == "u64MapAdd" ||
          builtinName == "u64MapIncrementUnchecked" ||
          builtinName == "u64MapGetOrZero" || builtinName == "u64MapKeys" ||
          builtinName == "u64MapFree") &&
