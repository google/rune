      }
      if (builtinName == "regexCount" || builtinName == "regexReplace") &&
          isnull(builder.findFunction(builtinName)) {
        // regexCount(pattern, text) / regexReplace(pattern, repl, text) map to
        // the PCRE2 shim (cbackend/cruntime/regex.inc).  The typechecker types
        // these calls on demand at the call site (see TypeChecker.expr's Call
        // handler); flag the root so the clang link line adds -lpcre2-8.
        getRoot().usesRegex = true
        rxfn = builtinName == "regexCount"?
            c.CRuntimeFunction.RegexCount : c.CRuntimeFunction.RegexReplace
        rxparms = c.CExprList()
        if right.typedValue.type == types.Type.TypeClass.Tuple {
          for child in right.childExprs() {
            rxparms.appendCExpr(child.genC(builder))
          }
        } else {
          rxparms.appendCExpr(right.genC(builder))
        }
        return builder.cCall(self.location, rxfn, c.CExpr(rxparms))
      }
      if (builtinName == "bigIntNew" || builtinName == "bigIntSet" ||
          builtinName == "bigIntAdd" || builtinName == "bigIntSub" ||
          builtinName == "bigIntMul" || builtinName == "bigIntMulU64" ||
          builtinName == "bigIntAddU64" || builtinName == "bigIntSubU64" ||
          builtinName == "bigIntDivTrunc" || builtinName == "bigIntLess" ||
          builtinName == "bigIntToU64" || builtinName == "bigIntToString") &&
          isnull(builder.findFunction(builtinName)) {
        // BigInt is a deliberately explicit GMP-backed opaque value.  Its
        // operations take an output destination where applicable, so hot
        // loops can reuse GMP capacity instead of allocating every result.
        getRoot().usesGmp = true
        switch builtinName {
          "bigIntNew" => bigIntFn = c.CRuntimeFunction.BigIntNew
          "bigIntSet" => bigIntFn = c.CRuntimeFunction.BigIntSet
          "bigIntAdd" => bigIntFn = c.CRuntimeFunction.BigIntAdd
          "bigIntSub" => bigIntFn = c.CRuntimeFunction.BigIntSub
          "bigIntMul" => bigIntFn = c.CRuntimeFunction.BigIntMul
          "bigIntMulU64" => bigIntFn = c.CRuntimeFunction.BigIntMulU64
          "bigIntAddU64" => bigIntFn = c.CRuntimeFunction.BigIntAddU64
          "bigIntSubU64" => bigIntFn = c.CRuntimeFunction.BigIntSubU64
          "bigIntDivTrunc" => bigIntFn = c.CRuntimeFunction.BigIntDivTrunc
          "bigIntLess" => bigIntFn = c.CRuntimeFunction.BigIntLess
          "bigIntToU64" => bigIntFn = c.CRuntimeFunction.BigIntToU64
          default => bigIntFn = c.CRuntimeFunction.BigIntToString
        }
        bigIntArgs = c.CExprList()
        if right.typedValue.type == types.Type.TypeClass.Tuple {
          for child in right.childExprs() {
            bigIntArgs.appendCExpr(child.genC(builder))
          }
        } else {
          bigIntArgs.appendCExpr(right.genC(builder))
        }
        return builder.cCall(self.location, bigIntFn, c.CExpr(bigIntArgs))
      }
      if (builtinName == "f64x4FromLanes" || builtinName == "f64x4Splat" ||
          builtinName == "f64x4Load" ||
          builtinName == "f64x4Store" || builtinName == "f64x4Add" ||
          builtinName == "f64x4Sub" || builtinName == "f64x4Mul" ||
          builtinName == "f64x4SquaredLengths4" ||
          builtinName == "f64x4LessEqualMask" ||
          builtinName == "f64x4Lane" ||
          builtinName == "f64x4HorizontalSum" ||
          builtinName == "f64x4ApproxReciprocal" ||
          builtinName == "f64x4ApproxReciprocalSqrt" ||
          builtinName == "simdAvxAvailable") &&
          isnull(builder.findFunction(builtinName)) {
        // Mark only the enclosing generated function for the AVX target. The
        // runtime defines the target macro and keeps all other Rune functions
        // on the portable baseline target.
        if builtinName != "simdAvxAvailable" &&
            !isnull(builder.currentEmittingFn) {
          builder.currentEmittingFn!.usesF64x4 = true
        }
        switch builtinName {
          "f64x4FromLanes" => f64x4Fn = c.CRuntimeFunction.F64x4FromLanes
          "f64x4Splat" => f64x4Fn = c.CRuntimeFunction.F64x4Splat
          "f64x4Load" => f64x4Fn = c.CRuntimeFunction.F64x4Load
          "f64x4Store" => f64x4Fn = c.CRuntimeFunction.F64x4Store
          "f64x4Add" => f64x4Fn = c.CRuntimeFunction.F64x4Add
          "f64x4Sub" => f64x4Fn = c.CRuntimeFunction.F64x4Sub
          "f64x4Mul" => f64x4Fn = c.CRuntimeFunction.F64x4Mul
          "f64x4SquaredLengths4" => f64x4Fn = c.CRuntimeFunction.F64x4SquaredLengths4
          "f64x4LessEqualMask" => f64x4Fn = c.CRuntimeFunction.F64x4LessEqualMask
          "f64x4Lane" => f64x4Fn = c.CRuntimeFunction.F64x4Lane
          "f64x4HorizontalSum" => f64x4Fn = c.CRuntimeFunction.F64x4HorizontalSum
          "f64x4ApproxReciprocal" => f64x4Fn = c.CRuntimeFunction.F64x4ApproxReciprocal
          "f64x4ApproxReciprocalSqrt" => f64x4Fn = c.CRuntimeFunction.F64x4ApproxReciprocalSqrt
          default => f64x4Fn = c.CRuntimeFunction.SimdAvxAvailable
        }
        f64x4Args = c.CExprList()
        if right.typedValue.type == types.Type.TypeClass.Tuple {
          for child in right.childExprs() {
            f64x4Args.appendCExpr(child.genC(builder))
          }
        } else if !(right.type == ExprType.List && isnull(right.firstChildExpr)) {
          f64x4Args.appendCExpr(right.genC(builder))
        }
