                }
              }
            }
          }
          if wsReliable {
            builder.wantSpecName = specializedName
            builder.wantSpecParams = argTypes
            builder.wantSpecResult = null(types.Type)
          }
          pi = polyType.poly.instantiations
          emitted = false
          for inst in pi {
            if !emitted {
              // Find the recorded instantiation matching this call site by
              // comparing specialization names under the current bindings.
              builder.instantiate(polyType.poly!, inst)
              ptypes = arrayof(types.Type)
              for variable in callee.variables() {
                if isnull(variable.typedValue) {
                  // A parameter that never typechecked (poisoned method).
                  ptypes.append(types.NONETY())
                } else {
                  ptypes.append(builder.typechecker.resolve(variable.typedValue!))
                }
              }
              iname = types.Type(types.TupleType(ptypes)).genSpecializationName(callee.sym.name)
              // A recorded instantiation whose resolved parameters still hold
              // free variables is not emittable (genCType of a Var is null).
              // Such an instantiation is the artifact of a deferred recursive
              // function typechecking its own recursive call before its type
              // is known (turing's addParens(decParens(a), incParens(b))
              // records a v-NN self-instantiation).  Never adopt it; let a
              // concrete recorded match, or the synthesis path below, win.
              pConcrete = true
              for pt in ptypes {
                if builder.typechecker.hasFreeVars(pt) {
                  pConcrete = false
                }
              }
              builder.deInstantiate(polyType.poly!)
              adoptName = iname == specializedName && pConcrete
              if !adoptName {
                // A deferred function's argument snapshots used to compose
                // an unreliable name.  The live recovery composes GROUND
                // names now, so only adopt the definition's name when the
                // composed one still holds free or adaptable pieces.
                cnUnreliable = (builder.typechecker.hasFreeVars(argTypes) ||
                    builder.typechecker.containsAdaptableType(argTypes))
                if callee.deferredTypecheck && pConcrete && cnUnreliable {
                  adoptName = true
                  specializedName = iname
                }
              }
              if adoptName {
                if callee.type == FuncType.Struct {
                  callee.genCStructInstance(builder, inst)
                } else {
                  callee.genCPolyInstantiation(builder, inst)
                }
                emitted = true
              }
            }
          }
          if !emitted {
            // No recorded instantiation matches (e.g. a recursive call
            // whose definition-time instantiation never resolved):
            // synthesize one by opening the polymorphic type fresh.  A
            // constructor binds through its result (the call's own
            // resolved instance type); other functions bind through the
            // argument types.
            openedFn = polyType.poly!.open(builder.typechecker.unifier,
                &builder.typechecker.unifier.newVar())
            if openedFn.type == types.Type.TypeClass.Function {
              if callee.type == FuncType.Constructor && !isnull(self.typedValue) {
                te = builder.typechecker.unify(openedFn.function.result!,
                    builder.typechecker.resolve(self.typedValue!))
                if isnull(te) {
                  // The call's slot can carry FREE pieces (a.width's
                  // type under an on-demand op-body emission left
                  // Integer(u8, v-175) — genCType then panics on the
                  // free field).  Ground the residue through the
                  // RECOVERED argument types, trailed so a mismatch
                  // binds nothing.
                  builder.typechecker.unifier.beginBindTrail()
                  ctTe2 = builder.typechecker.unify(openedFn.function.params!, argTypes)
                  if isnull(ctTe2) {
                    builder.typechecker.unifier.commitBindTrail()
                  } else {
                    builder.typechecker.unifier.rollbackBindTrail()
                  }
                }
              } else {
                te = builder.typechecker.unify(openedFn.function.params!, argTypes)
              }
              if isnull(te) {
                newInst = polyType.poly.instantiations.lastTyvarInstantiation
                if !isnull(newInst) {
                  builder.resolveInstantiation(newInst!)
                  synthOk = builder.instantiationIsConcrete(newInst!)
                  if !synthOk {
                    // The unify above grounded the params; only the result
                    // var stays free until a round typechecks the deferred
                    // body under them.  Run that round now.
                    builder.instantiate(polyType.poly!, newInst!)
                    builder.typechecker.materializeSpec(callee!, specializedName)
                    builder.deInstantiate(polyType.poly!)
                    builder.resolveInstantiation(newInst!)
                    synthOk = builder.instantiationIsConcrete(newInst!)
                  }
                  if !synthOk {
                    // Ground params suffice: only the RESULT slot stays
                    // free through the recursive fixpoint, and the
                    // definition derives it from its emitted return path.
                    synthOk = builder.instantiationParamsConcrete(newInst!)
                  }
                  if synthOk {
                    if callee.type == FuncType.Struct {
                      callee.genCStructInstance(builder, newInst!)
                    } else if callee.type == FuncType.Constructor {
                      ctorInfo = builder.typechecker.lookupClass(callee.sym)
                      if !isnull(ctorInfo) {
                        builder.instantiate(polyType.poly!, newInst!)
                        callee.genCConstructorInstance(builder, ctorInfo!)
                        builder.deInstantiate(polyType.poly!)
                      }
                    } else {
                      // The pre-loop want handoff is consumed by the FIRST
                      // genCPolyInstantiation; restore it for the synthesis
                      // (an adopt attempt may already have cleared it).
                      if wsReliable {
                        builder.wantSpecName = specializedName
                        builder.wantSpecParams = argTypes
                        builder.wantSpecResult = null(types.Type)
                      }
                      callee.genCPolyInstantiation(builder, newInst!)
                    }
                  }
                }
              }
            }
          }
        }
      }

      // Name composition may have run other specs' rounds (recovery
      // fallback / nested emission); resolve the args under OUR round.
      builder.restoreEmittingRound()
      specialization = Sym.new(specializedName)
      cfn = builder.cIdentifier(specialization, false)
    } else if (left.type == ExprType.Ident && !isnull(self.typedValue) &&
               builder.isClassType(self.typedValue) &&
               builder.typechecker.resolve(self.typedValue!).tyname.name.name ==
                   left.val.symVal.name) {
      // Monomorphic class constructor: the definition is emitted under the
      // specialized class name even when no type variables are involved.  Use
      // the constructor name (phantom parameters kept) to match its definition.
      specializedName = builder.classCtorCName(
          builder.typechecker.resolve(self.typedValue!))
      cfn = builder.cIdentifier(Sym.new(specializedName), false)
    } else {
      cfn = left.genC(builder)
    }
    // var parameters of the callee receive the address of their argument.
    varFlags = arrayof(bool)
    if left.type == ExprType.Ident {
      varCallee = builder.findFunction(left.val.symVal.name)
      if !isnull(varCallee) {
        for v in varCallee.variables() {
          if v.isParam {
            varFlags.append(!v.isConst)
          }
        }
      }
    }
    flattenArgs = right.typedValue.type == types.Type.TypeClass.Tuple
    if flattenArgs {
      // A single tuple-valued argument is passed whole, not flattened
      // (the callee declares exactly one parameter).
      if varFlags.length() == 1 {
        flattenArgs = false
      }
      if !isnull(right.firstChildExpr) {
        if isnull(right.firstChildExpr.nextExprChildExpr) {
          oneChildTy = right.firstChildExpr.typedValue
          if !isnull(oneChildTy) {
            if builder.typechecker.resolve(oneChildTy!).type == types.Type.TypeClass.Tuple {
              flattenArgs = false
            }
          }
        }
      }
    }
    if flattenArgs {
      // Special case -- if right is a tuple, we need to encode cargs as a
      // CExprList of parameters, not as an actual tuple object. Otherwise,
      // instead of generating "f(a1, a2, ...)" we'll generate
      // "f(tupleX(a1, a2, ...))".
      parms = c.CExprList()
      argIndex = 0
      for child in right.childExprs() {
        carg = child.genC(builder)
        if argIndex < varFlags.length() && varFlags[argIndex] {
          carg = c.CExpr(c.CPrefixOperator(self.location,
              c.CPrefixOperator.Type.AddressOf, carg))
        }
        parms.appendCExpr(carg)
        argIndex += 1
      }
      cargs = c.CExpr(parms)
    } else {
      cargs = right.genC(builder)
      if varFlags.length() > 0 && varFlags[0] {
        cargs = c.CExpr(c.CPrefixOperator(self.location,
            c.CPrefixOperator.Type.AddressOf, cargs))
      }
    }
    return builder.cCall(self.location, cfn, cargs)
  }

  func genCType(self, builder: c.CBuilder) -> c.CTypeExpr {
    switch self.type {
      ExprType.UintType => return builder.cIntType(self.location, false, self.width)
      ExprType.IntType => return builder.cIntType(self.location, true, self.width)
      ExprType.FloatType => return builder.cFloatType(self.location, self.width)
      ExprType.StringType => return builder.cStringType(self.location)
      ExprType.BoolType => return builder.cBooleanType(self.location)
      ExprType.NoneType => return builder.cVoidType(self.location)
      ExprType.Ident => raise Status.Unimplemented, "named types not yet supported"
      default => raise Status.Unimplemented, "TypeExpression type not yet supported by C backend", self.type
      // TODO:
      //ExprType.Typeindex
      //ExprType.Namedparam
    }
  }
}

// Expressions form a tree, with each expression having a doubly-linked list of children.
relation DoublyLinked Expr:"Parent" Expr:"Child" cascade
relation DoublyLinked Ident Expr
relation OneToOne Statement Expr cascade
relation OneToOne Variable:"Initializer" Expr:"Initializer" cascade
relation OneToOne Variable:"Type" Expr:"Type" cascade
relation OneToOne Function:"Type" Expr:"Type" cascade

unittest {
  filepath = Filepath.new("test_filepath", null(Filepath), false)
  location = Location(filepath, 0u32, 0u32, 0u32)

  func createBinaryExpr() -> Expr {
    left = Expr.newConstant(Value("Hello"), location)
    assert left.getPrecedence() == getPrecedence(ExprType.Constant)
    right = Expr.newConstant(Value("World"), location)
    assert right.getPrecedence() == getPrecedence(ExprType.Constant)
    return Expr.newBinary(ExprType.Lt, left, right, location)
  }
}

unittest basicExprTest {
  ltExpr = createBinaryExpr()
  assert ltExpr.toString() == "\"Hello\" < \"World\""
}

unittest destroyTest {
  use block

  filepath = Filepath.new("test_filepath", null(Filepath), false)
  location = Location(filepath, 0u32, 0u32, 0u32)
  block = Block(location)
  statement =  Statement(block, StateType.Print, location)
  i = Bigint(0xdeadbeefu32, 256u32)
  expr = Expr.newConstant(Value(i), location)
  statement.insertExpr(expr)
  expr.destroy()
  assert isnull(statement.expr)
}

unittest copyTest {
  expr1 = createBinaryExpr()
  expr2 = expr1.copy()
  assert expr1 != expr2
  assert expr1.toString() == "\"Hello\" < \"World\""
  assert expr2.toString() == "\"Hello\" < \"World\""
}

unittest unaryTest {
  valueExpr = Expr.newConstant(Value(123u32), location)
  expr = Expr.newUnary(ExprType.Negate, valueExpr, location)
  expr.dump()
}

unittest newIdentTest {
  expr = Expr.newIdent(Sym.new("test"), location)
  expr.dump()
}

unittest getExprTypeNameTest {
  for i in range(<u32>ExprType.Add, <u32>ExprType.Namedparam) {
    type = <ExprType>i
    if type != ExprType.Negate && type != ExprType.NegateTrunc {
      assert type == getExprTypeFromSym(Sym.new(getExprTypeName(type)))
    }
  }
}

unittest {
  println "PASSED"
}
