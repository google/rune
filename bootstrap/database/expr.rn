      }
    }

    // Calls to extern "C" functions are emitted under an rn_ prefix and
    // implemented by the C runtime, even when integer-constrained parameters
    // made the function type polymorphic.
    if left.type == ExprType.Ident {
      externCallee = builder.findFunction(left.val.symVal.name)
      if !isnull(externCallee) && externCallee.isExtern {
        externFn = c.CExpr(c.CIdentifier(left.val.symVal!, null(c.CTypeExpr),
            false, false, false))
        if right.typedValue.type == types.Type.TypeClass.Tuple {
          externParms = c.CExprList()
          for child in right.childExprs() {
            externParms.appendCExpr(child.genC(builder))
          }
          externArgs = c.CExpr(externParms)
        } else {
