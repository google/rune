        return builder.cCall(self.location, left.val.symVal.name,
            c.CExpr(lfArgs))
      }
      // Append the instantiated types to the name (its specialization).
      // Resolve the argument types first: inside the body of another
      // polymorphic emission they are type variables bound by the currently
      // active instantiation.  Rebuild tuples from the child expressions:
      // the list's own snapshot resolved at typecheck time, losing
      // variables that adapt per instantiation.
      if right.type == ExprType.List || right.type == ExprType.Tuple {
        argElems = arrayof(types.Type)
        for argChild in right.childExprs() {
          argElems.append(argChild.resolvedArgType(builder))
        }
        argTypes = types.Type(types.TupleType(argElems))
      } else {
        argTypes = right.resolvedArgType(builder)
      }
      ctorCallee = builder.findFunction(left.val.symVal.name)
      ctorResultTy = null(types.Type)
      if (!isnull(ctorCallee) && ctorCallee.type == FuncType.Constructor &&
          !isnull(self.typedValue)) {
        // Constructor call: the definition is named from the instance type
        // (classCName canonicalizes self-referential class parameters);
        // composing from the argument types diverges for such classes.
        ctorResultTy = builder.typechecker.resolve(self.typedValue!)
        if ctorResultTy.type != types.Type.TypeClass.Typename {
          // Unresolved under this emission context; use the argument types.
          ctorResultTy = null(types.Type)
        }
      }
      if !isnull(ctorResultTy) {
        // The constructor is named with phantom parameters kept (classCtorCName),
        // matching its definition; the struct it builds collapses them.
        specializedName = builder.classCtorCName(ctorResultTy!)
      } else {
        // The definition (genCPolyInstantiation) names from TupleType(paramTypes)
        // -- a one-element tuple for a single-parameter function.  When a single
        // value (not a List/Tuple args node) is passed to a one-parameter
        // function, wrap the arg type the same way so the call name matches the
        // def; otherwise a tuple-typed argument's name is one nesting level too
        // shallow (genSpecializationName of a tuple flattens to its elements).
        nameTy = argTypes
        if right.type != ExprType.List && right.type != ExprType.Tuple {
