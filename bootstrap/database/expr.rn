      }
      if (builtinName == "byteReaderNew" ||
          builtinName == "byteReaderPeekByte" ||
          builtinName == "byteReaderAppendUntilByteSkippingByteInto" ||
          builtinName == "byteReaderAppendlnInto" ||
          builtinName == "byteReaderReadlnInto" ||
          builtinName == "byteReaderFree") &&
          isnull(builder.findFunction(builtinName)) {
