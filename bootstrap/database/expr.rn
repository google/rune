        // does not otherwise cause the array typedef to be emitted.
        if builtinName == "u64MapKeys" {
          builder.ensureArrayDeclared(self.location, types.U(64))
        }
        switch builtinName {
          "u64MapNew" => u64MapFn = c.CRuntimeFunction.U64MapNew
          "u64MapAdd" => u64MapFn = c.CRuntimeFunction.U64MapAdd
          "u64MapIncrementUnchecked" => u64MapFn = c.CRuntimeFunction.U64MapIncrementUnchecked
          "u64MapGetOrZero" => u64MapFn = c.CRuntimeFunction.U64MapGetOrZero
          "u64MapKeys" => u64MapFn = c.CRuntimeFunction.U64MapKeys
          default => u64MapFn = c.CRuntimeFunction.U64MapFree
        }
        u64MapArgs = c.CExprList()
        if right.typedValue.type == types.Type.TypeClass.Tuple {
          for child in right.childExprs() {
            u64MapArgs.appendCExpr(child.genC(builder))
          }
        } else {
          u64MapArgs.appendCExpr(right.genC(builder))
        }
