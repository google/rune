use sym

use filepath
use location
use value
use bigint
use datatype
use ident
use statement
use variable
use function

import cbackend as c
import types


enum ExprType {
  Constant // Any constant such as true, false, "test", 1, 3.14f32, 0xabci255, etc.
  RandUint  // e.g. rand256.
  Ident  // a
  Array  // [1u8, 2u8, 3u8, 4u8] or "passed"
  Modint  // 2 mod p
  // If you modify the list from Add to Rotr, also update the corresponding
  // assignment operator types, in the same order.
  Add  // a + b
  Sub  // a - b
  Mul  // a * b
  Div  // a / b
  Mod  // a % b
  And  // a && b
  Or   // a || b
  Xor  // a ^^ b
  Bitand  // a & b
  Bitor   // a | b
  Bitxor  // a ^ b
  Exp  // a ** b
  Shl  // a << b
  Shr  // a >> b
  Rotl  // a <<< b
  Rotr  // a >>> b
  AddTrunc  // a !+ b
  SubTrunc  // a !- b
  MulTrunc  // a !* b
  Bitnot  // ~a
  Lt  // a < b
  Le  // a <= b
  Gt  // a > b
  Ge  // a >= b
  Equal  // a == b
  Notequal  // a != b
  Negate  // -a
  NegateTrunc  // !-a
  Not  // !a
  Cast  // <b>a
  CastTrunc  // !<b>a
  Select  // passed? a : b
  Call  // fact(n)
  Index  // a[i]
  Slice  // a[a:b]
  Secret  // secret(password)
  Reveal  // reveal(mac)
  Equals  // a = b
  // If you modify the list from AddEquals to RotrEquals, also update the
  // corresponding operator types, in the same order.
  AddEquals  // a += b
  SubEquals  // a -= b
  MulEquals  // a *= b
  DivEquals  // a /= b
  ModEquals  // a %= b
  AndEquals  // a &&= b
  OrEquals   // a ||= b
  XorEquals  // a ^^= b
  BitandEquals  // a &= b
  BitorEquals   // a |= b
  BitxorEquals  // a ^= b
  ExpEquals  // a **= b
  ShlEquals  // a <<= b
  ShrEquals  // a >>= b
  RotlEquals  // a <<<= b
  RotrEquals  // a >>>= b
  AddTruncEquals  // a !+ b
  SubTruncEquals  // a !- b
  MulTruncEquals  // a !* b
  Dot  // a.b
  Dotdotdot  // case u1 ... u32
  List  // fact(a, b, c)
  Tuple  // return (1, 2, "passed")
  As  // import foo as bar
  In  // if element in set
  Const  // const self.x = x
  Null  // null(Node())
  Notnull  // n = node!
  Funcaddr  // &max(0u32, 0u32)
  Arrayof  // arrayof(u32)
  Typeof  // typeof a
  Unsigned  // unsigned(3i32)
  Signed  // signed(3u32)
  Widthof  // widthof a
  Isnull  // isnull(entry)
  // Type expressions:
  UintType  // x: u32 = y
  IntType  // x: i32 = y
  FloatType  // x: f32 = y
  StringType  // x: string = y
  BoolType  // done: bool = checkForDone()
  NoneType  // func foo(x) -> none
  Typeindex  // u32[]
  Namedparam  // Myclass(name = "me", profession = "hacker")
}

// Return the operator precedence.  This is similar to C, but fixes an acknowledged mistake:
// bitwise operators should bind more tightly than relational operators.  By the time C's
// authors realized this mistake, there was already too much C code that would break to fix it.
// Example: "value & 1 == 0" should test that value is even, but in C the result is always 0.
func getPrecedence(type: ExprType) -> u32 {
  switch type {
    // In increasing order of precedence.
    ExprType.Dotdotdot => return 1u32
    ExprType.Select => return 2u32
    ExprType.Or => return 3u32
    ExprType.Xor => return 4u32
    ExprType.And => return 5u32
    ExprType.In => return 6u32
    ExprType.Modint => return 7u32
    ExprType.Lt, ExprType.Le, ExprType.Gt, ExprType.Ge, ExprType.Equal, ExprType.Notequal => return 8u32

    ExprType.Bitor => return 9u32
    ExprType.Bitxor => return 10u32
    ExprType.Bitand => return 11u32
    ExprType.Shl, ExprType.Shr, ExprType.Rotl, ExprType.Rotr => return 12u32
    ExprType.Sub, ExprType.Add, ExprType.SubTrunc, ExprType.AddTrunc => return 13u32
    ExprType.Mul, ExprType.Div, ExprType.Mod, ExprType.MulTrunc => return 14u32
    ExprType.Exp, ExprType.Not, ExprType.Bitnot, ExprType.Negate, ExprType.NegateTrunc, ExprType.Cast, ExprType.CastTrunc => return 15u32
    ExprType.Dot, ExprType.Notnull, ExprType.Call, ExprType.Index, ExprType.Slice => return 16u32
    ExprType.Ident, ExprType.Constant, ExprType.Array, ExprType.Tuple, ExprType.Secret, ExprType.Reveal, ExprType.Arrayof, ExprType.Typeof, ExprType.Null, ExprType.Funcaddr, ExprType.Unsigned, ExprType.Signed, ExprType.Widthof, ExprType.Isnull => return 17u32

    default => return 1u32
  }
}

// Return the expression type's name.
func getExprTypeName(type: ExprType) -> string {
  switch type {
    ExprType.Ident => return "<ident>"
    ExprType.Array => return "<array>"
    ExprType.Add => return "+"
    ExprType.Sub => return "-"
    ExprType.Mul => return "*"
    ExprType.Div => return "/"
    ExprType.Mod => return "%"
    ExprType.And => return "&&"
    ExprType.Or => return "||"
    ExprType.Xor => return "^^"
    ExprType.Bitand => return "&"
    ExprType.Bitor => return "|"
    ExprType.Bitxor => return "^"
    ExprType.Exp => return "**"
    ExprType.Shl => return "<<"
    ExprType.Shr => return ">>"
    ExprType.Rotl => return "<<<"
    ExprType.Rotr => return ">>>"
    ExprType.AddTrunc => return "!+"
    ExprType.SubTrunc => return "!-"
    ExprType.MulTrunc => return "!*"
    ExprType.Bitnot => return "~"
    ExprType.Lt => return "<"
    ExprType.Le => return "<="
    ExprType.Gt => return ">"
    ExprType.Ge => return ">="
    ExprType.Equal => return "=="
    ExprType.Notequal => return "!="
    ExprType.Negate => return "-"
    ExprType.NegateTrunc => return "!-"
    ExprType.Not => return "!"
    ExprType.Cast => return "<>"
    ExprType.CastTrunc => return "!<>"
    ExprType.Select => return "?:"
    ExprType.Call => return "()"
    ExprType.Index => return "[]"
    ExprType.Slice => return "[:]"
    ExprType.Secret => return "secret"
    ExprType.Reveal => return "reveal"
    ExprType.Equals => return "="
    ExprType.AddEquals => return "+="
    ExprType.SubEquals => return "-="
    ExprType.MulEquals => return "*="
    ExprType.DivEquals => return "/="
    ExprType.ModEquals => return "%="
    ExprType.AndEquals => return "&&="
    ExprType.OrEquals => return "||="
    ExprType.XorEquals => return "^^="
    ExprType.BitandEquals => return "&="
    ExprType.BitorEquals => return "|="
    ExprType.BitxorEquals => return "^="
    ExprType.ExpEquals => return "**="
    ExprType.ShlEquals => return "<<="
    ExprType.ShrEquals => return ">>="
    ExprType.RotlEquals => return "<<<="
    ExprType.RotrEquals => return ">>>="
    ExprType.AddTruncEquals => return "!+="
    ExprType.SubTruncEquals => return "!-="
    ExprType.MulTruncEquals => return "!*="
    ExprType.Dot => return "."
    ExprType.Dotdotdot => return "..."
    ExprType.Tuple => return "tuple"
    ExprType.List => return "list"
    ExprType.As => return "as"
    ExprType.In => return "in"
    ExprType.Const => return "const"
    ExprType.Null => return "null"
    ExprType.Notnull => return "notnull"
    ExprType.Funcaddr => return "funcaddr"
    ExprType.Arrayof => return "arrayof"
    ExprType.Typeof => return "typeof"
    ExprType.Unsigned => return "unsigned"
    ExprType.Signed => return "signed"
    ExprType.Widthof => return "widthof"
    ExprType.Isnull => return "isnull"
    ExprType.UintType => return "uinttype"
    ExprType.IntType => return "inttype"
    ExprType.FloatType => return "floattype"
    ExprType.StringType => return "stringtype"
    ExprType.BoolType => return "booltype"
    ExprType.NoneType => return "nonetype"
    ExprType.Typeindex => return "typeindex"
    ExprType.Namedparam => return "namedparam"
    default => panic "Unexpected expression type ", type
  }
}

// Return the expression type given its sym.
func getExprTypeFromSym(sym: Sym) -> ExprType {
  // TODO: pre-build this symbols for improved speed.
  switch sym {
    Sym.new("+") => return ExprType.Add
    Sym.new("-") => return ExprType.Sub
    Sym.new("*") => return ExprType.Mul
    Sym.new("/") => return ExprType.Div
    Sym.new("%") => return ExprType.Mod
    Sym.new("&&") => return ExprType.And
    Sym.new("||") => return ExprType.Or
    Sym.new("^^") => return ExprType.Xor
    Sym.new("&") => return ExprType.Bitand
    Sym.new("|") => return ExprType.Bitor
    Sym.new("^") => return ExprType.Bitxor
    Sym.new("**") => return ExprType.Exp
    Sym.new("<<") => return ExprType.Shl
    Sym.new(">>") => return ExprType.Shr
    Sym.new("<<<") => return ExprType.Rotl
    Sym.new(">>>") => return ExprType.Rotr
    Sym.new("!+") => return ExprType.AddTrunc
    Sym.new("!-") => return ExprType.SubTrunc
    Sym.new("!*") => return ExprType.MulTrunc
    Sym.new("~") => return ExprType.Bitnot
    Sym.new("<") => return ExprType.Lt
    Sym.new("<=") => return ExprType.Le
    Sym.new(">") => return ExprType.Gt
    Sym.new(">=") => return ExprType.Ge
    Sym.new("==") => return ExprType.Equal
    Sym.new("!=") => return ExprType.Notequal
    Sym.new("-") => return ExprType.Negate
    Sym.new("!-") => return ExprType.NegateTrunc
    Sym.new("!") => return ExprType.Not
    Sym.new("<>") => return ExprType.Cast
    Sym.new("!<>") => return ExprType.CastTrunc
    Sym.new("?:") => return ExprType.Select
    Sym.new("()") => return ExprType.Call
    Sym.new("[]") => return ExprType.Index
    Sym.new("[:]") => return ExprType.Slice
    Sym.new("secret") => return ExprType.Secret
    Sym.new("reveal") => return ExprType.Reveal
    Sym.new("=") => return ExprType.Equals
    Sym.new("+=") => return ExprType.AddEquals
    Sym.new("-=") => return ExprType.SubEquals
    Sym.new("*=") => return ExprType.MulEquals
    Sym.new("/=") => return ExprType.DivEquals
    Sym.new("%=") => return ExprType.ModEquals
    Sym.new("&&=") => return ExprType.AndEquals
    Sym.new("||=") => return ExprType.OrEquals
    Sym.new("^^=") => return ExprType.XorEquals
    Sym.new("&=") => return ExprType.BitandEquals
    Sym.new("|=") => return ExprType.BitorEquals
    Sym.new("^=") => return ExprType.BitxorEquals
    Sym.new("**=") => return ExprType.ExpEquals
    Sym.new("<<=") => return ExprType.ShlEquals
    Sym.new(">>=") => return ExprType.ShrEquals
    Sym.new("<<<=") => return ExprType.RotlEquals
    Sym.new(">>>=") => return ExprType.RotrEquals
    Sym.new("!+=") => return ExprType.AddTruncEquals
    Sym.new("!-=") => return ExprType.SubTruncEquals
    Sym.new("!*=") => return ExprType.MulTruncEquals
    Sym.new(".") => return ExprType.Dot
    Sym.new("...") => return ExprType.Dotdotdot
    Sym.new("tuple") => return ExprType.Tuple
    Sym.new("list") => return ExprType.List
    Sym.new("as") => return ExprType.As
    Sym.new("in") => return ExprType.In
    Sym.new("const") => return ExprType.Const
    Sym.new("null") => return ExprType.Null
    Sym.new("notnull") => return ExprType.Notnull
    Sym.new("funcaddr") => return ExprType.Funcaddr
    Sym.new("arrayof") => return ExprType.Arrayof
    Sym.new("typeof") => return ExprType.Typeof
    Sym.new("unsigned") => return ExprType.Unsigned
    Sym.new("signed") => return ExprType.Signed
    Sym.new("widthof") => return ExprType.Widthof
    Sym.new("isnull") => return ExprType.Isnull
    Sym.new("uinttype") => return ExprType.UintType
    Sym.new("inttype") => return ExprType.IntType
    Sym.new("floattype") => return ExprType.FloatType
    Sym.new("stringtype") => return ExprType.StringType
    Sym.new("booltype") => return ExprType.BoolType
    Sym.new("nonetype") => return ExprType.NoneType
    Sym.new("typeindex") => return ExprType.Typeindex
    Sym.new("namedparam") => return ExprType.Namedparam
  }
}

// Return the binary operator corresponding to a compound assignment operator,
// e.g. AddEquals -> Add.  Returns ExprType.Equals for plain assignment.
export func getCompoundAssignBaseOp(type: ExprType) -> ExprType {
  switch type {
    ExprType.AddEquals => return ExprType.Add
    ExprType.SubEquals => return ExprType.Sub
    ExprType.MulEquals => return ExprType.Mul
    ExprType.DivEquals => return ExprType.Div
    ExprType.ModEquals => return ExprType.Mod
    ExprType.AndEquals => return ExprType.And
    ExprType.OrEquals => return ExprType.Or
    ExprType.XorEquals => return ExprType.Xor
    ExprType.BitandEquals => return ExprType.Bitand
    ExprType.BitorEquals => return ExprType.Bitor
    ExprType.BitxorEquals => return ExprType.Bitxor
    ExprType.ExpEquals => return ExprType.Exp
    ExprType.ShlEquals => return ExprType.Shl
    ExprType.ShrEquals => return ExprType.Shr
    ExprType.RotlEquals => return ExprType.Rotl
    ExprType.RotrEquals => return ExprType.Rotr
    ExprType.AddTruncEquals => return ExprType.AddTrunc
    ExprType.SubTruncEquals => return ExprType.SubTrunc
    ExprType.MulTruncEquals => return ExprType.MulTrunc
    default => return ExprType.Equals
  }
}

// Whether an argument of this type can select a specialization whose
// parameter has the given type: equal types, or an adaptable
// unsuffixed-literal type (AnyInt) against any integer type.  Compared by
// specialization name: Type.equals does not see structurally equal
// parameter tuples as equal.
func typeArgCompatible(argType: types.Type, paramType: types.Type) -> bool {
  if argType.specializationName() == paramType.specializationName() {
    return true
  }
  paramIsInt = (paramType.type == types.Type.TypeClass.Int ||
                paramType.type == types.Type.TypeClass.AnyInt)
  if argType.type == types.Type.TypeClass.AnyInt && paramIsInt {
    return true
  }
  return (paramType.type == types.Type.TypeClass.AnyInt &&
          argType.type == types.Type.TypeClass.Int)
}

// The expression class represents all expression trees in Rune.
class Expr(self, type: ExprType, location: Location) {
  self.type = type
  self.location = location
  self.isType = false
  self.isConst = false
  self.autocast = false  // Set on integer constants without a type suffix.
  self.width = 0u32
  // TODO: add datatype when ported to Rune.
  // self.datatype = null(Datatype)
  self.val = null(Value(0u32))
  self.bindingInstance = false
  self.typedValue = null(types.Type)

  func newConstant(value: Value, location: Location) -> Expr {
    expr = Expr(ExprType.Constant, location)
    expr.val = value
    return expr
  }

  func newBinary(type: ExprType, left: Expr, right: Expr, location: Location) -> Expr {
    expr = Expr(type, location)
    expr.appendChildExpr(left)
    expr.appendChildExpr(right)
    return expr
  }

  func newUnary(type: ExprType, child: Expr, location: Location) -> Expr {
    expr = Expr(type, location)
    expr.appendChildExpr(child)
    return expr
  }

  func newIdent(sym: Sym, location: Location) -> Expr {
    expr = Expr(ExprType.Ident, location)
    expr.val = Value(sym)
    return expr
  }

  func newTuple(children, location) -> Expr {
    expr = Expr(ExprType.Tuple, location)
    for child in children {
      expr.appendChildExpr(child)
    }
    return expr
  }

  func newArray(children, location) -> Expr {
    expr = Expr(ExprType.Array, location)
    for child in children {
      expr.appendChildExpr(child)
    }
    return expr
  }

  // Return the precedence of the expression.
  func getPrecedence(self) -> u32 {
    return getPrecedence(self.type)
  }

  // Return the name of this expression's type.
  func typeName(self) {
    return getExprTypeName(self.type)
  }

  // Dump an expression list, separated by commas.
  func dumpList(self, var text: string) {
    firstTime = true
    for child in self.childExprs() {
      if !firstTime {
        text += ", "
      }
      firstTime = false
      child.dumpToString(text)
    }
  }

  // Write out a call expression.
  func dumpCall(self, var text: string) {
    left = self.firstChildExpr!
    right = left.nextExprChildExpr!
    left.dumpToString(text)
    text += "("
    if !isnull(right) {
      right.dumpToString(text)
    }
    text += ")"
  }

  // Write out an index expression.
  func dumpIndex(self, var text: string) {
    left = self.firstChildExpr!
    right = left.nextExprChildExpr!
    left.dumpToString(text)
    text += "["
    if !isnull(right) {
      right.dumpToString(text)
    }
    text += "]"
  }

  // Write out a slice expression.
  func dumpSlice(self, var text: string) {
    left = self.firstChildExpr!
    lower = left.nextExprChildExpr!
    upper = lower.nextExprChildExpr!
    left.dumpToString(text)
    text += "["
    lower.dumpToString(text)
    text += ":"
    upper.dumpToString(text)
    text += "]"
  }

  // Write out a cast expression.
  func dumpCast(self, var text: string, parentPrecedence: u32, truncate: bool) {
    left = self.firstChildExpr!
    right = left.nextExprChildExpr!
    precedence = self.getPrecedence()
    if precedence <= parentPrecedence {
      text += "("
    }
    if truncate {
      text += "!"
    }
    text += "<"
    left.dumpToString(text)
    text += ">"
    right.dumpToString(text)
    if precedence <= parentPrecedence {
      text += ")"
    }
  }

  // Write out a select expression.
  func dumpSelect(self, var text: string, parentPrecedence: u32) {
    s = self.firstChildExpr!
    a = s.nextExprChildExpr!
    b = a.nextExprChildExpr!
    precedence = self.getPrecedence()
    if precedence <= parentPrecedence {
      text += "("
    }
    s.dumpToString(text)
    text += " ? "
    a.dumpToString(text)
    text += " : "
    b.dumpToString(text)
    if precedence <= parentPrecedence {
      text += ")"
    }
  }

  // Write out a binary expression.
  func dumpBinary(self, var text: string, opType: string, parentPrecedence: u32) {
    parent = self.parentExpr
    left = self.firstChildExpr!
    right = left.nextExprChildExpr!
    precedence = self.getPrecedence()
    needParens = precedence <= parentPrecedence && precedence < getPrecedence(ExprType.Dot)
    if needParens {
      text += "("
    }
    left.dumpToString(text)
    if precedence < getPrecedence(ExprType.Dot) {
      text += " " + opType + " "
    } else {
      text += opType
    }
    right.dumpToString(text)
    if needParens {
      text += ")"
    }
  }

  // Write out a prefix expression.
  func dumpPrefix(self, var text: string, opType: string, parentPrecedence: u32) {
    left = self.firstChildExpr!
    precedence = self.getPrecedence()
    if precedence <= parentPrecedence {
      text += "("
    }
    text += opType
    left.dumpToString(text)
    if precedence <= parentPrecedence {
      text += ")"
    }
  }

  // Dump a builtin function such as typeof(a).
  func dumpBuiltin(self, var text: string, name: string) {
    left = self.firstChildExpr!
    text += name + "("
    left.dumpToString(text)
    text += ")"
  }

  // Write out the array expression.
  func dumpArray(self, var text: string) {
    text += "["
    firstTime = true
    for child in self.childExprs() {
      if !firstTime {
        text += ", "
      }
      firstTime = false
      child.dumpToString(text)
    }
    text += "]"
  }

  // Write out the tuple expression.
  func dumpTuple(self, var text: string) {
    text += "("
    firstTime = true
    for child in self.childExprs() {
      if !firstTime {
        text += ", "
      }
      firstTime = false
      child.dumpToString(text)
    }
    text += ")"
  }

  // Write out the assignment expression.
  func dumpAssignment(self, var text) {
    target = self.firstChildExpr!
    value = target.nextExprChildExpr!
    constraint = value.nextExprChildExpr
    target.dumpToString(text)
    if !isnull(constraint) {
      text.concat(": ")
      constraint.dumpToString(text)
    }
    text.append(' ')
    text += getExprTypeName(self.type)
    text.append(' ')
    value.dumpToString(text)
  }

  // Write out the expression in a reasonably readable format to the end of |string|.
  func dumpToString(self, var text: string) {
    parent = self.parentExpr
    parentPrecedence = 0u32
    if !isnull(parent) {
      parentPrecedence = parent.getPrecedence()
    }
    switch self.type {
      ExprType.Constant => text += self.val.toString()
      ExprType.Ident => text += self.val.symVal.name
      ExprType.Array => self.dumpArray(text)
      ExprType.Tuple => self.dumpTuple(text)
      ExprType.RandUint => text += "rand%u" % self.width
      ExprType.Modint => self.dumpBinary(text, "mod", parentPrecedence)
      ExprType.Add => self.dumpBinary(text, "+", parentPrecedence)
      ExprType.Sub => self.dumpBinary(text, "-", parentPrecedence)
      ExprType.Mul => self.dumpBinary(text, "*", parentPrecedence)
      ExprType.Div => self.dumpBinary(text, "/", parentPrecedence)
      ExprType.Mod => self.dumpBinary(text, "%", parentPrecedence)
      ExprType.And => self.dumpBinary(text, "&&", parentPrecedence)
      ExprType.Or => self.dumpBinary(text, "||", parentPrecedence)
      ExprType.Xor => self.dumpBinary(text, "^^", parentPrecedence)
      ExprType.Bitand => self.dumpBinary(text, "&", parentPrecedence)
      ExprType.Bitor => self.dumpBinary(text, "|", parentPrecedence)
      ExprType.Bitxor => self.dumpBinary(text, "^", parentPrecedence)
      ExprType.Exp => self.dumpBinary(text, "**", parentPrecedence)
      ExprType.Shl => self.dumpBinary(text, "<<", parentPrecedence)
      ExprType.Shr => self.dumpBinary(text, ">>", parentPrecedence)
      ExprType.Rotl => self.dumpBinary(text, "<<<", parentPrecedence)
      ExprType.Rotr => self.dumpBinary(text, ">>>", parentPrecedence)
      ExprType.AddTrunc => self.dumpBinary(text, "!+", parentPrecedence)
      ExprType.SubTrunc => self.dumpBinary(text, "!-", parentPrecedence)
      ExprType.MulTrunc => self.dumpBinary(text, "!*", parentPrecedence)
      ExprType.Lt => self.dumpBinary(text, "<", parentPrecedence)
      ExprType.Le => self.dumpBinary(text, "<=", parentPrecedence)
      ExprType.Gt => self.dumpBinary(text, ">", parentPrecedence)
      ExprType.Ge => self.dumpBinary(text, ">=", parentPrecedence)
      ExprType.Equal => self.dumpBinary(text, "==", parentPrecedence)
      ExprType.Notequal => self.dumpBinary(text, "!=", parentPrecedence)
      ExprType.Negate => self.dumpPrefix(text, "-", parentPrecedence)
      ExprType.NegateTrunc => self.dumpPrefix(text, "!-", parentPrecedence)
      ExprType.Not => self.dumpPrefix(text, "!", parentPrecedence)
      ExprType.Bitnot => self.dumpPrefix(text, "~", parentPrecedence)
      ExprType.Cast => self.dumpCast(text, parentPrecedence, false)
      ExprType.CastTrunc => self.dumpCast(text, parentPrecedence, true)
      ExprType.Select => self.dumpSelect(text, parentPrecedence)
      ExprType.Call => self.dumpCall(text)
      ExprType.Funcaddr => self.dumpPrefix(text, "&", parentPrecedence)
      ExprType.Arrayof => self.dumpBuiltin(text, "arrayof")
      ExprType.Typeof => self.dumpBuiltin(text, "typeof")
      ExprType.Unsigned => self.dumpBuiltin(text, "unsigned")
      ExprType.Signed => self.dumpBuiltin(text, "signed")
      ExprType.Widthof => self.dumpBuiltin(text, "widthof")
      ExprType.Isnull => self.dumpBuiltin(text, "isnull")
      ExprType.Null => self.dumpBuiltin(text, "null")
      ExprType.Notnull => {
        self.firstChildExpr.dumpToString(text)
        text.append('!')
      }
      ExprType.Index, ExprType.Typeindex => self.dumpIndex(text)
      ExprType.Slice => self.dumpSlice(text)
      ExprType.Secret => {
        text += "secret("
        self.firstChildExpr.dumpToString(text)
        text += ")"
      }
      ExprType.Reveal => {
        text += "reveal("
        self.firstChildExpr.dumpToString(text)
        text += ")"
      }
      ExprType.Const => self.dumpPrefix(text, "const ", parentPrecedence)
      ExprType.Equals, ExprType.AddEquals, ExprType.SubEquals, ExprType.MulEquals,
          ExprType.DivEquals, ExprType.ModEquals, ExprType.AndEquals, ExprType.OrEquals,
          ExprType.XorEquals, ExprType.ExpEquals, ExprType.ShlEquals, ExprType.ShrEquals,
          ExprType.RotlEquals, ExprType.RotrEquals, ExprType.AddTruncEquals,
          ExprType.SubTruncEquals, ExprType.MulTruncEquals, ExprType.BitandEquals,
          ExprType.BitorEquals, ExprType.BitxorEquals => self.dumpAssignment(text)
      ExprType.As => self.dumpBinary(text, "as", parentPrecedence)
      ExprType.In => self.dumpBinary(text, "in", parentPrecedence)
      ExprType.Dot => self.dumpBinary(text, ".", parentPrecedence)
      ExprType.Dotdotdot => self.dumpBinary(text, "...", parentPrecedence)
      ExprType.List => self.dumpList(text)
      ExprType.UintType => text += "u%u" % self.width
      ExprType.IntType => text += "i%u" % self.width
      ExprType.FloatType => text += "f%u" % self.width
      ExprType.StringType => text += "string"
      ExprType.BoolType => text += "bool"
      ExprType.NoneType => text += "none"
      ExprType.Namedparam => {
        text += self.firstChildExpr.val.symVal.name + " = "
        self.lastChildExpr.dumpToString(text)
      }
    }
  }

  // Convert the expression to a string in a reasonably readable format.
  func toString(self) -> string {
    text = ""
    self.dumpToString(text)
    return text
  }

  // Write out the expression in a reasonably readable format.
  func dump(self: Expr) {
    text = ""
    self.dumpToString(text)
    println text
  }

  // Make a deep copy of the expression.
  func copy(self: Expr) -> Expr {
    newExpr = Expr(self.type, self.location)
    // TODO: Comment in when we port datatype to Rune.
    // newExpr.datatype = expr.datatype
    newExpr.isType = self.isType
    self.isConst = self.isConst
    newExpr.width = self.width
    newExpr.autocast = self.autocast
    newExpr.val = self.val
    for child in self.childExprs() {
      newChild = child.copy()
      newExpr.appendChildExpr(newChild)
    }
    return newExpr
  }

  // C Generator ------------------------------------------------------------------

  func genC(self, builder: c.CBuilder) -> c.CExpr {
    switch self.type {
      // First, the operators that map directly to C binary operators
      ExprType.AddTrunc => return self.genCBinaryOp(builder)
      ExprType.Constant => {
        wlit = builder.wideWidth(self.typedValue)
        if (wlit > 0u32 && (self.val.type == DatatypeType.Int ||
            self.val.type == DatatypeType.Uint) && self.val.intVal.width <= 64u32) {
          // An unsuffixed literal adapted to a wide type: widen its 64-bit
          // form at runtime.
          return builder.cWideFromU64(self.location,
              self.val.genC(builder, false), wlit,
              builder.wideSigned(self.typedValue))
        }
        return self.val.genC(builder, false)
      }
      ExprType.Ident => {
        if self.val.symVal.name == "argv" && !self.bindingInstance {
          // The program's argument list, built from main()'s argc/argv.
          // Declare the string-array type so its tostring helper exists.
          if !isnull(self.typedValue) {
            argvTy = builder.typechecker.resolve(self.typedValue!)
            if argvTy.type == types.Type.TypeClass.Array {
              builder.ensureArrayDeclared(self.location, argvTy.array.elementType!)
            }
          }
          argvArgs = c.CExprList()
          argvArgs.appendCExpr(c.CExpr(c.CIdentifier(Sym.new("argc"),
              null(c.CTypeExpr), false, false, false)))
          argvArgs.appendCExpr(c.CExpr(c.CIdentifier(Sym.new("argv"),
              null(c.CTypeExpr), false, false, false)))
          return builder.cCall(self.location, c.CRuntimeFunction.ArgvArray,
              c.CExpr(argvArgs))
        }
        return self.val.genC(builder, self.bindingInstance)
      }
      ExprType.List => return self.genCList(builder)
      ExprType.Mod => return self.genCBinaryOp(builder)
      ExprType.MulTrunc => return self.genCBinaryOp(builder)
      ExprType.Negate => return self.genCPrefixOp(builder)
      ExprType.NegateTrunc => return self.genCPrefixOp(builder)
      ExprType.And => return self.genCBinaryOp(builder)
      ExprType.Or => return self.genCBinaryOp(builder)
      ExprType.Bitand => return self.genCBinaryOp(builder)
      ExprType.Bitor => return self.genCBinaryOp(builder)
      ExprType.Bitxor => return self.genCBinaryOp(builder)
      ExprType.Bitnot => return self.genCPrefixOp(builder)
      ExprType.Not => return self.genCPrefixOp(builder)
      ExprType.Shl => return self.genCBinaryOp(builder)
      ExprType.Shr => return self.genCBinaryOp(builder)
      ExprType.SubTrunc => return self.genCBinaryOp(builder)
      ExprType.Lt => return self.genCBinaryOp(builder)
      ExprType.Le => return self.genCBinaryOp(builder)
      ExprType.Gt => return self.genCBinaryOp(builder)
      ExprType.Ge => return self.genCBinaryOp(builder)
      ExprType.Equal => return self.genCBinaryOp(builder)
      ExprType.Notequal => return self.genCBinaryOp(builder)
      ExprType.In => return self.genCBinaryOp(builder)

      // Now, the operators that map to runtime functions
      ExprType.Add => return self.genCBinaryOp(builder)
      ExprType.Div => return self.genCBinaryOp(builder)
      ExprType.Exp => return self.genCBinaryOp(builder)
      ExprType.Mul => return self.genCBinaryOp(builder)
      ExprType.Rotl => return self.genCBinaryOp(builder)
      ExprType.Rotr => return self.genCBinaryOp(builder)
      ExprType.Sub => return self.genCBinaryOp(builder)

      ExprType.Call => return self.genCCall(builder)

      // Assignment
      ExprType.Equals => return self.genCBinaryOp(builder)

      // Type values (t = u32, bar(string), typeof(x)) exist only at compile
      // time; where a runtime value is syntactically required (a call
      // argument), a zero dummy of the resolved type stands in.
      ExprType.UintType => return self.genCTypeDummy(builder)
      ExprType.IntType => return self.genCTypeDummy(builder)
      ExprType.FloatType => return self.genCTypeDummy(builder)
      ExprType.StringType => return self.genCTypeDummy(builder)
      ExprType.BoolType => return self.genCTypeDummy(builder)
      ExprType.NoneType => return self.genCTypeDummy(builder)
      ExprType.Typeof => return self.genCTypeDummy(builder)
      ExprType.Typeindex => return c.CExpr(self.genCType(builder))
      ExprType.Namedparam => return c.CExpr(self.genCType(builder))

      // Null handling: class instances are C pointers.
      ExprType.Null => return self.genCTypeDummy(builder)
      ExprType.Isnull => return c.CExpr(c.CPrefixOperator(self.location,
          c.CPrefixOperator.Type.LogNot, self.firstChildExpr.genC(builder)))
      ExprType.Notnull => return self.firstChildExpr.genC(builder)

      ExprType.Widthof => return self.genCWidthof(builder)
      ExprType.Unsigned => return self.genCSignConversion(builder)
      ExprType.Signed => return self.genCSignConversion(builder)

      // Arrays
      ExprType.Arrayof => return self.genCArrayOf(builder)
      ExprType.Array => return self.genCArray(builder)

      // Tuples
      ExprType.Tuple => return self.genCTuple(builder)
      ExprType.Index => return self.genCIndex(builder)
      ExprType.Slice => return self.genCSlice(builder)
      ExprType.Modint => return self.genCModint(builder)
      ExprType.RandUint => {
        randArgs = c.CExprList()
        randArgs.appendCExpr(c.CExpr(c.CLiteral(Bigint(<u64>self.width), false)))
        if self.width <= 64u32 {
          return builder.cWideCall(self.location, "rn_rand_u64", randArgs)
        }
        return builder.cWideCall(self.location, "wide_rand", randArgs)
      }

      // Structs
      ExprType.Dot => return self.genCFieldSel(builder)

      // The conditional operator a ? b : c.
      ExprType.Select => return self.genCSelect(builder)

      // Casts: <T>x and !<T>x.
      ExprType.Cast => return self.genCCast(builder)
      ExprType.CastTrunc => return self.genCCast(builder)

      default => raise Status.Unimplemented, "Expression type not yet supported by C backend: ", getExprTypeName(self.type)
    }
  }

  func genCList(self, builder: c.CBuilder) -> c.CExpr {
    // The Hello World test requires a single-valued list of expressions to be
    // passed as arguments to a procedure call.
    elements = c.CExprList()
    for child in self.childExprs() {
      elements.appendCExpr(child.genC(builder))
    }
    return c.CExpr(elements)
  }

  // "fmt" % args as an expression: format into a fresh heap string via the
  // string_sprintf runtime helper.  Rune format codes are converted to
  // printf codes by the string literal escaper.
  func genCStringFormat(self, builder: c.CBuilder, left: Expr, right: Expr) -> c.CExpr {
    if left.type != ExprType.Constant || left.val.type != DatatypeType.String {
      raise Status.Unimplemented, "String formatting requires a literal format string"
    }
    args = c.CExprList()
    // Integers widen to 64 bits to match the PRI*64 format directives;
    // wide arguments render as strings via a %s directive.
    fmtWideFlags = arrayof(bool)
    if right.type == ExprType.Tuple {
      for child in right.childExprs() {
        fmtWideFlags.append(builder.wideWidth(child.typedValue) > 0u32)
      }
    } else {
      fmtWideFlags.append(builder.wideWidth(right.typedValue) > 0u32)
    }
    fmtDirs = builder.formatDirectives(left.val.stringVal)
    args.appendCExpr(builder.cStringLiteral(
        builder.rewriteWideFormat(left.val.stringVal, fmtWideFlags), printf=true))
    fmtArgIdx = 0
    if right.type == ExprType.Tuple {
      for child in right.childExprs() {
        fmtDir = fmtArgIdx < fmtDirs.length() ? fmtDirs[fmtArgIdx] : 0u8
        args.appendCExpr(builder.cFormatArg(self.location, child.genC(builder),
            child.typedValue, fmtDir))
        fmtArgIdx += 1
      }
    } else {
      fmtDir = fmtDirs.length() > 0 ? fmtDirs[0] : 0u8
      args.appendCExpr(builder.cFormatArg(self.location, right.genC(builder),
          right.typedValue, fmtDir))
    }
    return builder.cCall(self.location, c.CRuntimeFunction.StringSprintf, c.CExpr(args))
  }

  // Generate a call to a user-defined operator function whose parameter
  // types match the operand types.  Specializations not yet emitted by the
  // module sweep are emitted on demand.  Returns null when no registered
  // operator matches, so the caller falls back to the builtin form.
  //
  // Matching compares the operand types against each recorded
  // instantiation's resolved parameter types, allowing an unsuffixed
  // literal (typed AnyInt) to match a concrete integer parameter; an exact
  // name comparison would never match because the call site only knows the
  // literal's adaptable type.
  func genCUserOperator(self, builder: c.CBuilder, l: c.CExpr, r: c.CExpr,
                        left: Expr, right: Expr) -> c.CExpr? {
    tc = builder.typechecker
    ltype = tc.resolve(left.typedValue!)
    rtype = tc.resolve(right.typedValue!)
    for i in range(tc.operatorFns.length()) {
      opfn = tc.operatorFns[i]
      if opfn.opType == self.type {
        opty = tc.operatorTypes[i]
        callName = ""
        if opty.type == types.Type.TypeClass.Polymorphic {
          for inst in opty.poly.instantiations {
            if callName == "" {
              builder.instantiate(opty.poly!, inst)
              ptypes = arrayof(types.Type)
              for variable in opfn.variables() {
                ptypes.append(tc.resolve(variable.typedValue!))
              }
              iname = types.Type(types.TupleType(ptypes)).genSpecializationName(opfn.sym.name)
              builder.deInstantiate(opty.poly!)
              if (ptypes.length() == 2 &&
                  typeArgCompatible(ltype, ptypes[0]) &&
                  typeArgCompatible(rtype, ptypes[1])) {
                if !builder.alreadyEmitted(iname) {
                  opfn.genCPolyInstantiation(builder, inst)
                }
                callName = iname
              }
            }
          }
        } else if opty.type == types.Type.TypeClass.Function {
          // Monomorphic operator, emitted under its plain name; check the
          // parameter types match these operands.
          mtypes = arrayof(types.Type)
          for variable in opfn.variables() {
            mtypes.append(tc.resolve(variable.typedValue!))
          }
          if (mtypes.length() == 2 &&
              typeArgCompatible(ltype, mtypes[0]) &&
              typeArgCompatible(rtype, mtypes[1])) {
            callName = opfn.sym.name
          }
        }
        if callName != "" {
          args = c.CExprList()
          args.appendCExpr(l)
          args.appendCExpr(r)
          return builder.cCall(self.location, callName, c.CExpr(args))
        }
      }
    }
    return null(c.CExpr)
  }

  // A zero value standing in for an expression with no runtime
  // representation: type values passed as arguments, and null(Foo), which
  // becomes a zero (null) pointer of the class's C struct type.
  func genCTypeDummy(self, builder: c.CBuilder) -> c.CExpr {
    dummyType = builder.typechecker.resolve(self.typedValue!)
    dummyZero = Bigint(0u64)
    zeroExpr = builder.cIntLiteral(dummyZero)
    dummyCType = builder.genCType(dummyType)
    if isnull(dummyCType) {
      return zeroExpr
    }
    return c.CExpr(c.CCastExpr(self.location, dummyCType!, zeroExpr))
  }

  // widthof(e) is a compile-time constant: the bit width of e's type.
  func genCWidthof(self, builder: c.CBuilder) -> c.CExpr {
    widthChild = self.firstChildExpr!
    widthType = builder.typechecker.resolve(widthChild.typedValue!)
    widthValue = Bigint(<u64>widthType.width())
    return builder.cIntLiteral(widthValue)
  }

  // unsigned(x)/signed(x) reinterpret x with flipped signedness.
  func genCSignConversion(self, builder: c.CBuilder) -> c.CExpr {
    signChild = self.firstChildExpr!
    signTarget = builder.typechecker.resolve(self.typedValue!)
    signW = builder.wideWidth(self.typedValue)
    if signW > 0u32 {
      // Wide values change signedness through wide_cast so the header's
      // sign flag updates.
      signArgs = c.CExprList()
      signArgs.appendCExpr(signChild.genC(builder))
      signArgs.appendCExpr(c.CExpr(c.CLiteral(Bigint(<u64>signW), false)))
      signArgs.appendCExpr(c.CExpr(c.CLiteral(
          Bigint(builder.wideSigned(self.typedValue) ? 1u64 : 0u64), false)))
      signArgs.appendCExpr(c.CExpr(c.CLiteral(Bigint(1u64), false)))
      return builder.cWideCall(self.location, "wide_cast", signArgs)
    }
    signCType = builder.genCType(signTarget)
    if isnull(signCType) {
      raise Status.Unimplemented, "unsigned()/signed() target type not supported by C backend"
    }
    return c.CExpr(c.CCastExpr(self.location, signCType!, signChild.genC(builder)))
  }

  func genCCast(self, builder: c.CBuilder) -> c.CExpr {
    typeChild = self.firstChildExpr!
    valueChild = typeChild.nextExprChildExpr!
    v = valueChild.genC(builder)
    target = builder.typechecker.resolve(self.typedValue!)
    // Casting a string to string is the identity; strings are char buffers.
    if (builder.typechecker.isStringType(self.typedValue) &&
        builder.typechecker.isStringType(valueChild.typedValue)) {
      return v
    }
    wTo = builder.wideWidth(self.typedValue)
    wFrom = builder.wideWidth(valueChild.typedValue)
    if wTo > 0u32 || wFrom > 0u32 {
      isTruncCast = self.type == ExprType.CastTrunc
      if wTo > 0u32 && wFrom > 0u32 {
        castArgs = c.CExprList()
        castArgs.appendCExpr(v)
        castArgs.appendCExpr(c.CExpr(c.CLiteral(Bigint(<u64>wTo), false)))
        castArgs.appendCExpr(c.CExpr(c.CLiteral(
            Bigint(builder.wideSigned(self.typedValue) ? 1u64 : 0u64), false)))
        castArgs.appendCExpr(c.CExpr(c.CLiteral(
            Bigint(isTruncCast ? 1u64 : 0u64), false)))
        return builder.cWideCall(self.location, "wide_cast", castArgs)
      }
      if wTo > 0u32 {
        // A 64-bit-or-narrower value widening: extend by the source's sign,
        // then adopt the target signedness.
        srcSigned = false
        srcTy = builder.typechecker.resolve(valueChild.typedValue!)
        if srcTy.type == types.Type.TypeClass.Int {
          srcSigned = srcTy.int.isSigned
        } else if srcTy.type == types.Type.TypeClass.AnyInt {
          srcSigned = srcTy.anyInt.isSigned
        }
        widened = builder.cWideFromU64(self.location, v, wTo, srcSigned)
        adoptArgs = c.CExprList()
        adoptArgs.appendCExpr(widened)
        adoptArgs.appendCExpr(c.CExpr(c.CLiteral(Bigint(<u64>wTo), false)))
        adoptArgs.appendCExpr(c.CExpr(c.CLiteral(
            Bigint(builder.wideSigned(self.typedValue) ? 1u64 : 0u64), false)))
        adoptArgs.appendCExpr(c.CExpr(c.CLiteral(Bigint(1u64), false)))
        return builder.cWideCall(self.location, "wide_cast", adoptArgs)
      }
      // Wide to 64 bits or narrower.
      narrowArgs = c.CExprList()
      narrowArgs.appendCExpr(v)
      narrowed = builder.cWideCall(self.location, "wide_to_u64", narrowArgs)
      cty = builder.genCType(target)
      return c.CExpr(c.CCastExpr(self.location, cty!, narrowed))
    }
    ctype = builder.genCType(target)
    if isnull(ctype) {
      raise Status.Unimplemented, "Cast target type not supported by C backend"
    }
    if (builder.isClassType(valueChild.typedValue) &&
        (target.type == types.Type.TypeClass.Int ||
         target.type == types.Type.TypeClass.AnyInt)) {
      // Casting an object reference to an integer yields its 1-based id.
      idSel = c.CExpr(c.CDotExpr(self.location, v, "rn_id", true))
      return c.CExpr(c.CCastExpr(self.location, ctype!, idSel))
    }
    return c.CExpr(c.CCastExpr(self.location, ctype!, v))
  }

  func genCSelect(self, builder: c.CBuilder) -> c.CExpr {
    condChild = self.firstChildExpr!
    trueChild = condChild.nextExprChildExpr!
    falseChild = trueChild.nextExprChildExpr!
    return c.CExpr(c.CSelectExpr(self.location, condChild.genC(builder),
                                 trueChild.genC(builder), falseChild.genC(builder)))
  }

  func genCPrefixOp(self, builder: c.CBuilder) -> c.CExpr {
    parent = self.parentExpr
    left = self.firstChildExpr!

    if builder.wideWidth(left.typedValue) > 0u32 {
      wideFn = ""
      switch self.type {
        ExprType.Negate => wideFn = "wide_neg"
        ExprType.NegateTrunc => wideFn = "wide_negtrunc"
        ExprType.Bitnot => wideFn = "wide_not"
        default => wideFn = ""
      }
      if wideFn != "" {
        wideArgs = c.CExprList()
        wideArgs.appendCExpr(left.genC(builder))
        return builder.cWideCall(self.location, wideFn, wideArgs)
      }
    }
    switch self.type {
      ExprType.Negate, ExprType.NegateTrunc => {
        // C unary minus on unsigned types already truncates (wraps).
        return builder.cUnaryMinus(self.location, left.genC(builder))
      }
      ExprType.Bitnot => {
        return builder.cUnaryBitnot(self.location, left.genC(builder))
      }
      ExprType.Not => {
        return builder.cUnaryNot(self.location, left.genC(builder))
      }

      default => raise Status.Unimplemented, "Unary expression operator not yet supported by C backend: ", getExprTypeName(self.type)
    }
  }

  func genCBinaryOp(self, builder: c.CBuilder) -> c.CExpr {
    parent = self.parentExpr
    left = self.firstChildExpr!
    right = left.nextExprChildExpr!

    if self.type == ExprType.Mod && builder.typechecker.isStringType(left.typedValue) {
      // "fmt" % args is sprintf-like formatting, not arithmetic.
      return self.genCStringFormat(builder, left, right)
    }

    if self.type == ExprType.Equals {
      self.bindingInstance = true
    }
    l = left.genC(builder)
    self.bindingInstance = false
    r = right.genC(builder)

    wideW = builder.wideWidth(left.typedValue)
    if wideW == 0u32 {
      wideW = builder.wideWidth(right.typedValue)
    }
    if wideW > 0u32 && self.type != ExprType.Equals {
      return self.genCWideBinaryOp(builder, l, r, left, right, wideW)
    }

    if (self.type != ExprType.Equals &&
        (builder.isClassType(left.typedValue) || builder.isClassType(right.typedValue))) {
      uop = self.genCUserOperator(builder, l, r, left, right)
      if !isnull(uop) {
        return uop!
      }
    }
    if (self.type == ExprType.Equals && right.type == ExprType.Constant &&
        right.val.type == DatatypeType.String) {
      // Copy string literals on assignment so writes through the variable
      // (s[0] = c, s.append(...)) do not mutate the static literal.
      dupArgs = c.CExprList()
      dupArgs.appendCExpr(r)
      r = builder.cCall(self.location, c.CRuntimeFunction.StringDup, c.CExpr(dupArgs))
    }

    // First, generate C Binary Operators for those operators that map
    // directly to C operators.
    switch self.type {
      ExprType.AddTrunc => op = c.CBinaryOperator.Type.Plus
      ExprType.SubTrunc => op = c.CBinaryOperator.Type.Minus
      ExprType.MulTrunc => op = c.CBinaryOperator.Type.Times
      ExprType.Mod => {
        // C's % is integer-only; floats use fmod() from math.h.
        isFloatMod = false
        if !isnull(left.typedValue) {
          modTy = builder.typechecker.resolve(left.typedValue!)
          isFloatMod = modTy.type == types.Type.TypeClass.Float
        }
        if isFloatMod {
          list = c.CExprList()
          list.appendCExpr(l)
          list.appendCExpr(r)
          return builder.cCall(self.location, c.CRuntimeFunction.FloatModulus, c.CExpr(list))
        }
        op = c.CBinaryOperator.Type.Modulus
      }
      ExprType.And => op = c.CBinaryOperator.Type.LogAnd
      ExprType.Or =>  op = c.CBinaryOperator.Type.LogOr
      ExprType.Bitand => op = c.CBinaryOperator.Type.BitAnd
      ExprType.Bitor => op = c.CBinaryOperator.Type.BitOr
      ExprType.Bitxor => {
        if builder.typechecker.isStringType(left.typedValue) {
          // Strings XOR byte-wise via a runtime helper.
          list = c.CExprList()
          list.appendCExpr(l)
          list.appendCExpr(r)
          return builder.cCall(self.location, c.CRuntimeFunction.StringXor, c.CExpr(list))
        }
        op = c.CBinaryOperator.Type.BitXor
      }
      ExprType.Shl => op = c.CBinaryOperator.Type.ShiftLeft
      ExprType.Shr => op = c.CBinaryOperator.Type.ShiftRight
      ExprType.Lt => op = c.CBinaryOperator.Type.LessThan
      ExprType.Le => op = c.CBinaryOperator.Type.LessThanEqual
      ExprType.Gt => op = c.CBinaryOperator.Type.GreaterThan
      ExprType.Ge => op = c.CBinaryOperator.Type.GreaterThanEqual
      ExprType.Equal => op = c.CBinaryOperator.Type.Equals
      ExprType.Notequal => op = c.CBinaryOperator.Type.NotEquals
      ExprType.Equals => op = c.CBinaryOperator.Type.Assign

      default => {
        // Float arithmetic maps to plain C operators; there is no overflow
        // detection for floating point.
        isFloat = false
        if !isnull(left.typedValue) {
          lty = builder.typechecker.resolve(left.typedValue!)
          isFloat = lty.type == types.Type.TypeClass.Float
        }
        if isFloat {
          switch self.type {
            ExprType.Add => fop = c.CBinaryOperator.Type.Plus
            ExprType.Sub => fop = c.CBinaryOperator.Type.Minus
            ExprType.Mul => fop = c.CBinaryOperator.Type.Times
            ExprType.Div => fop = c.CBinaryOperator.Type.Divides
            default => raise Status.Unimplemented, "Float operator not yet supported by C backend: ", getExprTypeName(self.type)
          }
          return builder.cBinaryOperator(self.location, fop, left.typedValue, l, r)
        }
        switch self.type {
          ExprType.Add => {
            if left.typedValue == types.STRING() {
              raise Status.Unimplemented, "String addition not yet supported by C backend"
            } else if left.typedValue.type == types.Type.TypeClass.Array {
              fn = c.CRuntimeFunction.ArrayConcat
            } else {
              fn = c.CRuntimeFunction.AddWithOverflowDetect
            }
          }
          ExprType.Mul => fn = c.CRuntimeFunction.MulWithOverflowDetect
          ExprType.Sub => fn = c.CRuntimeFunction.SubWithOverflowDetect
          ExprType.Div => fn = c.CRuntimeFunction.DivWithOverflowDetect
          ExprType.Exp => fn = c.CRuntimeFunction.Exponentiate
          ExprType.Rotl => fn = c.CRuntimeFunction.RotateLeft
          ExprType.Rotr => fn = c.CRuntimeFunction.RotateRight
          default => {
            self.location.error("Binary expression operator not yet supported by C backend: " + getExprTypeName(self.type))
            raise Status.Unimplemented, "Binary expression operator not yet supported by C backend: ", getExprTypeName(self.type)
          }
        }
        // Can Rune do arbitrary length calls?
        list = c.CExprList()
        list.appendCExpr(l)
        list.appendCExpr(r)
        return builder.cCall(self.location, fn, c.CExpr(list))
      }
    }
    return builder.cBinaryOperator(self.location, op, left.typedValue, l, r)
  }

  // Binary operators on integers wider than 64 bits map to wide_* runtime
  // helpers.  Shift and exponent right-hand sides stay 64-bit scalars.
  func genCWideBinaryOp(self, builder: c.CBuilder, l: c.CExpr, r: c.CExpr,
                        left: Expr, right: Expr, wideW: u32) -> c.CExpr {
    scalarRhs = (self.type == ExprType.Shl || self.type == ExprType.Shr ||
        self.type == ExprType.Rotl || self.type == ExprType.Rotr ||
        self.type == ExprType.Exp)
    wl = l
    wr = r
    if builder.wideWidth(left.typedValue) == 0u32 {
      wl = builder.cWideFromU64(self.location, l, wideW,
          builder.wideSigned(right.typedValue))
    }
    if scalarRhs {
      if builder.wideWidth(right.typedValue) > 0u32 {
        toArgs = c.CExprList()
        toArgs.appendCExpr(r)
        wr = builder.cWideCall(self.location, "wide_to_u64", toArgs)
      }
    } else if builder.wideWidth(right.typedValue) == 0u32 {
      wr = builder.cWideFromU64(self.location, r, wideW,
          builder.wideSigned(left.typedValue))
    }
    args = c.CExprList()
    args.appendCExpr(wl)
    args.appendCExpr(wr)
    extraFlag = -1i32
    cmpOp = c.CBinaryOperator.Type.LessThan
    isCmp = false
    switch self.type {
      ExprType.Add => wideName = "wide_add"
      ExprType.Sub => wideName = "wide_sub"
      ExprType.AddTrunc => wideName = "wide_addtrunc"
      ExprType.SubTrunc => wideName = "wide_subtrunc"
      ExprType.Mul => {
        wideName = "wide_mul"
        extraFlag = 0i32
      }
      ExprType.MulTrunc => {
        wideName = "wide_mul"
        extraFlag = 1i32
      }
      ExprType.Div => wideName = "wide_div"
      ExprType.Mod => wideName = "wide_rem"
      ExprType.Exp => wideName = "wide_exp"
      ExprType.Shl => wideName = "wide_shl"
      ExprType.Shr => wideName = "wide_shr"
      ExprType.Rotl => wideName = "wide_rotl"
      ExprType.Rotr => wideName = "wide_rotr"
      ExprType.Bitand => {
        wideName = "wide_bitop"
        extraFlag = 0i32
      }
      ExprType.Bitor => {
        wideName = "wide_bitop"
        extraFlag = 1i32
      }
      ExprType.Bitxor => {
        wideName = "wide_bitop"
        extraFlag = 2i32
      }
      ExprType.Equal => {
        return builder.cWideCall(self.location, "wide_eq", args)
      }
      ExprType.Notequal => {
        eqCall = builder.cWideCall(self.location, "wide_eq", args)
        return c.CExpr(c.CPrefixOperator(self.location,
            c.CPrefixOperator.Type.LogNot, eqCall))
      }
      ExprType.Lt, ExprType.Le, ExprType.Gt, ExprType.Ge => {
        isCmp = true
        wideName = "wide_cmp"
        switch self.type {
          ExprType.Lt => cmpOp = c.CBinaryOperator.Type.LessThan
          ExprType.Le => cmpOp = c.CBinaryOperator.Type.LessThanEqual
          ExprType.Gt => cmpOp = c.CBinaryOperator.Type.GreaterThan
          default => cmpOp = c.CBinaryOperator.Type.GreaterThanEqual
        }
      }
      default => raise Status.Unimplemented, "Wide integer operator not supported: ", getExprTypeName(self.type)
    }
    if extraFlag >= 0i32 {
      args.appendCExpr(c.CExpr(c.CLiteral(Bigint(<u64>extraFlag), false)))
    }
    wideCall = builder.cWideCall(self.location, wideName, args)
    if isCmp {
      zeroLit = c.CExpr(c.CLiteral(Bigint(0u64), false))
      return c.CExpr(c.CBinaryOperator(self.location, cmpOp,
          null(c.CTypeExpr), wideCall, zeroLit))
    }
    return wideCall
  }

  func genCArrayOf(self, builder: c.CBuilder) -> c.CExpr {
    left = self.firstChildExpr!
    elements = arrayof(c.CExpr)
    return builder.cArray(self.location, left.typedValue!, elements)
  }

  func genCArray(self, builder: c.CBuilder) -> c.CExpr {
    left = self.firstChildExpr!
    elements = arrayof(c.CExpr)
    for child in self.childExprs() {
      elements.append(child.genC(builder))
    }
    return builder.cArray(self.location, left.typedValue!, elements)
  }

  func genCTuple(self, builder: c.CBuilder) -> c.CExpr {
    elements = c.CExprList()
    for child in self.childExprs() {
      cexpr = child.genC(builder)
      elements.appendCExpr(child.genC(builder))
    }
    // Tuple types should not be null (if they are, they contain an expression not yet
    // supported by the typechecker, and therefore not the c backend either).
    // self.typedValue should have been set by the typechecker before C generation
    // begins.
    return builder.cTuple(self.location, self.typedValue, elements)
  }

  func genCIndex(self, builder: c.CBuilder) -> c.CExpr {
    indexee = self.firstChildExpr!
    index = indexee.nextExprChildExpr!
    // We know from typechecking that index is a u64.
    left = indexee.genC(builder)
    if indexee.typedValue.type == types.Type.TypeClass.Array {
      right = index.genC(builder)
      return builder.cIndex(self.location, indexee.typedValue, left, right)
    }
    if builder.typechecker.isStringType(indexee.typedValue) {
      // Strings index directly as C char buffers.
      right = index.genC(builder)
      return c.CExpr(c.CIndexExpr(self.location, left, right))
    }
    assert index.type == ExprType.Constant && index.val.type == DatatypeType.Uint
    i = index.val.intVal.uint64()
    return builder.cIndex(self.location, indexee.typedValue, left, i)
  }

  // <left> mod <m>: emit the left expression tree with every arithmetic
  // operator mapped to a modular runtime helper and every leaf reduced into
  // [0, m).  The modulus expression re-generates per use site (it appears as
  // an argument of each helper call); a C expression object can only sit in
  // one argument list.
  func genCModint(self, builder: c.CBuilder) -> c.CExpr {
    left = self.firstChildExpr!
    modulus = left.nextExprChildExpr!
    return left.genCModular(builder, modulus)
  }

  func genCModular(self, builder: c.CBuilder, modulus: Expr) -> c.CExpr {
    if builder.wideWidth(modulus.typedValue) > 0u32 {
      return self.genCModularWide(builder, modulus)
    }
    switch self.type {
      ExprType.Add, ExprType.Sub, ExprType.Mul, ExprType.Div => {
        l = self.firstChildExpr!
        r = l.nextExprChildExpr!
        switch self.type {
          ExprType.Add => modfn = c.CRuntimeFunction.ModAdd
          ExprType.Sub => modfn = c.CRuntimeFunction.ModSub
          ExprType.Mul => modfn = c.CRuntimeFunction.ModMul
          default => modfn = c.CRuntimeFunction.ModDiv
        }
        args = c.CExprList()
        args.appendCExpr(l.genCModular(builder, modulus))
        args.appendCExpr(r.genCModular(builder, modulus))
        args.appendCExpr(modulus.genC(builder))
        return builder.cCall(self.location, modfn, c.CExpr(args))
      }
      ExprType.Exp => {
        // The base reduces mod m; the exponent is an ordinary integer.
        b = self.firstChildExpr!
        e = b.nextExprChildExpr!
        expArgs = c.CExprList()
        expArgs.appendCExpr(b.genCModular(builder, modulus))
        expArgs.appendCExpr(e.genC(builder))
        expArgs.appendCExpr(modulus.genC(builder))
        return builder.cCall(self.location, c.CRuntimeFunction.ModExp, c.CExpr(expArgs))
      }
      ExprType.Negate, ExprType.NegateTrunc => {
        negChild = self.firstChildExpr!
        negArgs = c.CExprList()
        negArgs.appendCExpr(negChild.genCModular(builder, modulus))
        negArgs.appendCExpr(modulus.genC(builder))
        return builder.cCall(self.location, c.CRuntimeFunction.ModNegate, c.CExpr(negArgs))
      }
      ExprType.Equal, ExprType.Notequal, ExprType.Lt, ExprType.Le, ExprType.Gt, ExprType.Ge => {
        // Compare values after reduction.
        l = self.firstChildExpr!
        r = l.nextExprChildExpr!
        switch self.type {
          ExprType.Equal => cmpop = c.CBinaryOperator.Type.Equals
          ExprType.Notequal => cmpop = c.CBinaryOperator.Type.NotEquals
          ExprType.Lt => cmpop = c.CBinaryOperator.Type.LessThan
          ExprType.Le => cmpop = c.CBinaryOperator.Type.LessThanEqual
          ExprType.Gt => cmpop = c.CBinaryOperator.Type.GreaterThan
          default => cmpop = c.CBinaryOperator.Type.GreaterThanEqual
        }
        // Reduced values are uint64; equality emits isequal_uint64_t.
        return c.CExpr(c.CBinaryOperator(self.location, cmpop,
            builder.cIntType(self.location, false, 64u32),
            l.genCModular(builder, modulus), r.genCModular(builder, modulus)))
      }
      default => {
        // A leaf value: reduce it into [0, m), respecting its sign.
        leafIsSigned = false
        if !isnull(self.typedValue) {
          leafTy = builder.typechecker.resolve(self.typedValue!)
          if leafTy.type == types.Type.TypeClass.Int {
            leafIsSigned = leafTy.int.isSigned
          } else if leafTy.type == types.Type.TypeClass.AnyInt {
            leafIsSigned = leafTy.anyInt.isSigned
          }
        }
        leafArgs = c.CExprList()
        leafArgs.appendCExpr(self.genC(builder))
        leafArgs.appendCExpr(modulus.genC(builder))
        if leafIsSigned {
          return builder.cCall(self.location, c.CRuntimeFunction.ModReduceSigned, c.CExpr(leafArgs))
        }
        return builder.cCall(self.location, c.CRuntimeFunction.ModReduce, c.CExpr(leafArgs))
      }
    }
  }

  // Modular arithmetic with a modulus wider than 64 bits: every operand
  // becomes a wide value and the wide_mod* helpers keep results in [0, m).
  func genCWideModOperand(self, builder: c.CBuilder, modulus: Expr) -> c.CExpr {
    mW = builder.wideWidth(modulus.typedValue)
    v = self.genC(builder)
    if builder.wideWidth(self.typedValue) == 0u32 {
      leafSigned = false
      leafTy = builder.typechecker.resolve(self.typedValue!)
      if leafTy.type == types.Type.TypeClass.Int {
        leafSigned = leafTy.int.isSigned
      } else if leafTy.type == types.Type.TypeClass.AnyInt {
        leafSigned = leafTy.anyInt.isSigned
      }
      v = builder.cWideFromU64(self.location, v, mW, leafSigned)
    }
    return v
  }

  func genCModularWide(self, builder: c.CBuilder, modulus: Expr) -> c.CExpr {
    switch self.type {
      ExprType.Add, ExprType.Sub, ExprType.Mul, ExprType.Div => {
        l = self.firstChildExpr!
        r = l.nextExprChildExpr!
        switch self.type {
          ExprType.Add => wmName = "wide_modadd"
          ExprType.Sub => wmName = "wide_modsub"
          ExprType.Mul => wmName = "wide_modmul"
          default => wmName = "wide_moddiv"
        }
        args = c.CExprList()
        args.appendCExpr(l.genCModularWide(builder, modulus))
        args.appendCExpr(r.genCModularWide(builder, modulus))
        args.appendCExpr(modulus.genC(builder))
        return builder.cWideCall(self.location, wmName, args)
      }
      ExprType.Exp => {
        b = self.firstChildExpr!
        e = b.nextExprChildExpr!
        expArgs = c.CExprList()
        expArgs.appendCExpr(b.genCModularWide(builder, modulus))
        expArgs.appendCExpr(e.genCWideModOperand(builder, modulus))
        expArgs.appendCExpr(modulus.genC(builder))
        return builder.cWideCall(self.location, "wide_modexp", expArgs)
      }
      ExprType.Negate, ExprType.NegateTrunc => {
        negChild = self.firstChildExpr!
        negArgs = c.CExprList()
        negArgs.appendCExpr(negChild.genCModularWide(builder, modulus))
        negArgs.appendCExpr(modulus.genC(builder))
        return builder.cWideCall(self.location, "wide_modneg", negArgs)
      }
      ExprType.Equal, ExprType.Notequal, ExprType.Lt, ExprType.Le, ExprType.Gt, ExprType.Ge => {
        l = self.firstChildExpr!
        r = l.nextExprChildExpr!
        cmpArgs = c.CExprList()
        cmpArgs.appendCExpr(l.genCModularWide(builder, modulus))
        cmpArgs.appendCExpr(r.genCModularWide(builder, modulus))
        if self.type == ExprType.Equal {
          return builder.cWideCall(self.location, "wide_eq", cmpArgs)
        }
        if self.type == ExprType.Notequal {
          wEqCall = builder.cWideCall(self.location, "wide_eq", cmpArgs)
          return c.CExpr(c.CPrefixOperator(self.location,
              c.CPrefixOperator.Type.LogNot, wEqCall))
        }
        switch self.type {
          ExprType.Lt => wCmpOp = c.CBinaryOperator.Type.LessThan
          ExprType.Le => wCmpOp = c.CBinaryOperator.Type.LessThanEqual
          ExprType.Gt => wCmpOp = c.CBinaryOperator.Type.GreaterThan
          default => wCmpOp = c.CBinaryOperator.Type.GreaterThanEqual
        }
        wCmpCall = builder.cWideCall(self.location, "wide_cmp", cmpArgs)
        return c.CExpr(c.CBinaryOperator(self.location, wCmpOp,
            null(c.CTypeExpr), wCmpCall, c.CExpr(c.CLiteral(Bigint(0u64), false))))
      }
      default => {
        // A leaf value: reduce it into [0, m).
        redArgs = c.CExprList()
        redArgs.appendCExpr(self.genCWideModOperand(builder, modulus))
        redArgs.appendCExpr(modulus.genC(builder))
        return builder.cWideCall(self.location, "wide_modreduce", redArgs)
      }
    }
  }

  func genCSlice(self, builder: c.CBuilder) -> c.CExpr {
    base = self.firstChildExpr!
    lower = base.nextExprChildExpr!
    upper = lower.nextExprChildExpr!
    args = c.CExprList()
    args.appendCExpr(base.genC(builder))
    args.appendCExpr(lower.genC(builder))
    args.appendCExpr(upper.genC(builder))
    if builder.typechecker.isStringType(self.typedValue) {
      return builder.cCall(self.location, c.CRuntimeFunction.StringSlice, c.CExpr(args))
    }
    return builder.cCall(self.location, c.CRuntimeFunction.ArraySlice, c.CExpr(args),
        self.typedValue)
  }

  func genCFieldSel(self, builder: c.CBuilder) -> c.CExpr {
    strct = self.firstChildExpr!
    field = strct.nextExprChildExpr!
    if strct.type == ExprType.Ident {
      // Enum member accesses are inlined as integer constants.
      einfo = builder.typechecker.lookupEnum(strct.val.symVal!)
      if !isnull(einfo) {
        value = einfo.memberValue(field.toString())
        bigValue = Bigint(value)
        return builder.cIntLiteral(bigValue)
      }
      // The except-clause exception variable: its fields read locals bound
      // at handler entry (see Statement.genCExcept), e.g. e_errorMessage.
      if !isnull(strct.typedValue) {
        excTy = builder.typechecker.resolve(strct.typedValue!)
        if excTy.type == types.Type.TypeClass.Typename &&
            excTy.tyname.name.name == "Exception" {
          fieldSym = Sym.new(strct.val.symVal.name + "_" + field.toString())
          return c.CExpr(c.CIdentifier(fieldSym, null(c.CTypeExpr), false, false, false))
        }
      }
    }
    left = strct.genC(builder)
    if builder.isClassType(strct.typedValue) {
      // Class instances are pointers; use -> to access data members.
      return c.CExpr(c.CDotExpr(self.location, left, field.toString(), true))
    }
    return builder.cFieldSelect(self.location, left, field.val.symVal!)
  }

  func genCCall(self, builder: c.CBuilder) -> c.CExpr {
    left = self.firstChildExpr!
    right = left.nextExprChildExpr!
    fntype = left.typedValue
    assert !isnull(fntype)

    if left.type == ExprType.Dot {
      // Handle method calls on class instances.
      base = left.firstChildExpr!
      if builder.isClassType(base.typedValue) {
        method = base.nextExprChildExpr!
        name = builder.methodCallCName(base.typedValue!, method.toString(), right.typedValue)
        args = c.CExprList()
        args.appendCExpr(base.genC(builder))
        if right.typedValue.type == types.Type.TypeClass.Tuple {
          for child in right.childExprs() {
            args.appendCExpr(child.genC(builder))
          }
        } else {
          args.appendCExpr(right.genC(builder))
        }
        return builder.cCall(self.location, name, c.CExpr(args))
      }
      // Built-in methods on strings.
      strBase = left.firstChildExpr!
      if builder.typechecker.isStringType(strBase.typedValue) {
        field = strBase.nextExprChildExpr!
        switch field.toString() {
          "length" => strfn = c.CRuntimeFunction.StringLength
          "append" => strfn = c.CRuntimeFunction.StringAppendChar
          "concat" => strfn = c.CRuntimeFunction.StringConcat
          "find" => strfn = c.CRuntimeFunction.StringFind
          "rfind" => strfn = c.CRuntimeFunction.StringRfind
          "toHex" => strfn = c.CRuntimeFunction.StringToHex
          "fromHex" => strfn = c.CRuntimeFunction.StringFromHex
          "resize" => strfn = c.CRuntimeFunction.StringResize
          "reverse" => strfn = c.CRuntimeFunction.StringReverse
          default => raise Status.Unimplemented, "Unknown string builtin method: \"", field, "\""
        }
        strArgs = c.CExprList()
        strArgs.appendCExpr(strBase.genC(builder))
        argCount = 0
        if right.typedValue.type == types.Type.TypeClass.Tuple {
          for child in right.childExprs() {
            strArgs.appendCExpr(child.genC(builder))
            argCount += 1
          }
        } else {
          strArgs.appendCExpr(right.genC(builder))
          argCount += 1
        }
        if field.toString() == "find" || field.toString() == "rfind" {
          // The C helpers take a fixed offset parameter; default it to 0.
          if argCount < 2 {
            zeroOffset = Bigint(0u64)
            strArgs.appendCExpr(builder.cIntLiteral(zeroOffset))
          }
        }
        return builder.cCall(self.location, strfn, c.CExpr(strArgs))
      }

      // Built-in methods on bool and integer values.
      scalarBase = left.firstChildExpr!
      if !isnull(scalarBase.typedValue) {
        bty = builder.typechecker.resolve(scalarBase.typedValue!)
        if bty.type == types.Type.TypeClass.Typename && bty.tyname.name.name == "bool" {
          bArgs = c.CExprList()
          bArgs.appendCExpr(scalarBase.genC(builder))
          return builder.cCall(self.location, c.CRuntimeFunction.BoolToString, c.CExpr(bArgs))
        }
        if bty.type == types.Type.TypeClass.Int || bty.type == types.Type.TypeClass.AnyInt {
          field = scalarBase.nextExprChildExpr!
          if bty.type == types.Type.TypeClass.Int {
            intSigned = bty.int.isSigned
            intWidth = bty.int.width
          } else {
            intSigned = bty.anyInt.isSigned
            intWidth = 64u32
          }
          switch field.toString() {
            "toString" => {
              if intSigned {
                intfn = c.CRuntimeFunction.IntToString
              } else {
                intfn = c.CRuntimeFunction.UintToString
              }
            }
            "toStringLE" => intfn = c.CRuntimeFunction.IntToStringLE
            "toStringBE" => intfn = c.CRuntimeFunction.IntToStringBE
            default => raise Status.Unimplemented, "Unknown integer builtin method: \"", field, "\""
          }
          iArgs = c.CExprList()
          iArgs.appendCExpr(scalarBase.genC(builder))
          iArgCount = 1
          if right.typedValue.type == types.Type.TypeClass.Tuple {
            for child in right.childExprs() {
              iArgs.appendCExpr(child.genC(builder))
              iArgCount += 1
            }
          } else {
            iArgs.appendCExpr(right.genC(builder))
            iArgCount += 1
          }
          if field.toString() == "toString" {
            // The C helpers take a fixed base parameter; default it to 10.
            if iArgCount < 2 {
              iArgs.appendCExpr(builder.cIntLiteral(Bigint(10u64)))
            }
          } else {
            // toStringLE/toStringBE need the receiver's width in bytes.
            iArgs.appendCExpr(builder.cIntLiteral(Bigint(<u64>(intWidth / 8u32))))
          }
          return builder.cCall(self.location, intfn, c.CExpr(iArgs))
        }
      }

      // Built-in methods on arrays.
      array = left.firstChildExpr!
      if array.typedValue.type == types.Type.TypeClass.Array {
        field = array.nextExprChildExpr!
        switch field.toString() {
          "append" => fn = c.CRuntimeFunction.ArrayAppend
          "concat" => fn = c.CRuntimeFunction.ArrayConcat
          "resize" => fn = c.CRuntimeFunction.ArrayResize
          "items" => fn = c.CRuntimeFunction.ArrayItems
          "length" => fn = c.CRuntimeFunction.ArrayLength
          "reverse" => fn = c.CRuntimeFunction.ArrayReverse
          "values" => fn = c.CRuntimeFunction.ArrayValues
          default => raise Status.Unimplemented, "Unknown array builtin operator: \"", field, "\""
        }
        args = c.CExprList()
        args.append(array.genC(builder))
        args.append(right.genC(builder))
        return builder.cCall(self.location, fn, c.CExpr(args), right.typedValue)
      }
    }

    // Process and byte-level IO builtins map to runtime helpers.
    if left.type == ExprType.Ident {
      builtinName = left.val.symVal.name
      if builtinName == "secret" || builtinName == "reveal" {
        // The bootstrap has no constant-time mode; secrecy wrappers are
        // identity functions.
        inner = right
        if right.type == ExprType.List && !isnull(right.firstChildExpr) {
          inner = right.firstChildExpr!
        }
        return inner.genC(builder)
      }
      if builtinName == "readln" && isnull(builder.findFunction("readln")) {
        return builder.cCall(self.location, c.CRuntimeFunction.ReadLn, null(c.CExpr))
      }
      if builtinName == "chr" && isnull(builder.findFunction("chr")) {
        chrArg = right
        if right.type == ExprType.List && !isnull(right.firstChildExpr) {
          chrArg = right.firstChildExpr!
        }
        chrArgs = c.CExprList()
        chrArgs.appendCExpr(chrArg.genC(builder))
        return builder.cCall(self.location, c.CRuntimeFunction.StringChr, c.CExpr(chrArgs))
      }
      if builtinName == "abs" && isnull(builder.findFunction("abs")) {
        // abs() maps to fabs for floats, llabs for integers; C's abs()
        // truncates doubles to int.
        absArg = right
        if right.type == ExprType.List && !isnull(right.firstChildExpr) {
          absArg = right.firstChildExpr!
        }
        absFn = c.CRuntimeFunction.IntAbs
        if !isnull(absArg.typedValue) {
          absTy = builder.typechecker.resolve(absArg.typedValue!)
          if absTy.type == types.Type.TypeClass.Float {
            absFn = c.CRuntimeFunction.FloatAbs
          }
        }
        absArgs = c.CExprList()
        absArgs.appendCExpr(absArg.genC(builder))
        return builder.cCall(self.location, absFn, c.CExpr(absArgs))
      }
      if (builtinName == "exit" || builtinName == "readByte" ||
          builtinName == "writeByte" || builtinName == "readBytes" ||
          builtinName == "writeBytes") {
        switch builtinName {
          "exit" => iofn = c.CRuntimeFunction.Exit
          "readByte" => iofn = c.CRuntimeFunction.ReadByte
          "writeByte" => iofn = c.CRuntimeFunction.WriteByte
          "readBytes" => iofn = c.CRuntimeFunction.ReadBytes
          default => iofn = c.CRuntimeFunction.WriteBytes
        }
        ioparms = c.CExprList()
        if right.typedValue.type == types.Type.TypeClass.Tuple {
          for child in right.childExprs() {
            ioparms.appendCExpr(child.genC(builder))
          }
        } else {
          ioparms.appendCExpr(right.genC(builder))
        }
        return builder.cCall(self.location, iofn, c.CExpr(ioparms))
      }
    }

    // Calls to extern "C" functions are emitted under an rn_ prefix and
    // implemented by the C runtime, even when integer-constrained parameters
    // made the function type polymorphic.
    if left.type == ExprType.Ident {
      externCallee = builder.findFunction(left.val.symVal.name)
      if !isnull(externCallee) && externCallee.isExtern {
        externFn = c.CExpr(c.CIdentifier(left.val.symVal!, null(c.CTypeExpr),
            false, false, false))
        if right.typedValue.type == types.Type.TypeClass.Tuple {
          externParms = c.CExprList()
          for child in right.childExprs() {
            externParms.appendCExpr(child.genC(builder))
          }
          externArgs = c.CExpr(externParms)
        } else {
          externArgs = right.genC(builder)
        }
        return c.CExpr(c.CCall(self.location, c.CRuntimeFunction.ExternC,
            externArgs, externFn, null(c.CTypeExpr)))
      }
    }

    // The call expression's own type can lose its polymorphic wrapper (the
    // typechecker resolves shallowly), e.g. for recursive calls inside the
    // function's body; fall back to the definition's type.
    polyType = fntype
    if polyType.type != types.Type.TypeClass.Polymorphic && left.type == ExprType.Ident {
      polyCallee = builder.findFunction(left.val.symVal.name)
      if !isnull(polyCallee) && !isnull(polyCallee.typedValue) &&
          polyCallee.typedValue.type == types.Type.TypeClass.Polymorphic &&
          !polyCallee.isExtern {
        polyType = polyCallee.typedValue!
      }
    }
    if polyType.type == types.Type.TypeClass.Polymorphic {
      // A function expression need not be a simple identifier; it may be the
      // result of an expression, for example, a higher-order function that
      // returns a function. Moreover, that function may be polymorphic, and
      // only specialize at this call point. We do not currently handle such a
      // case.
      // Right now, we only handle the case where the polymorphic function
      // expression is an identifier.
      if left.type != ExprType.Ident {
        raise Status.Unimplemented, "Can't generate code for polymorphic function expression ", left.toString()
      }
      // Append the instantiated types to the name (its specialization).
      // Resolve the argument types first: inside the body of another
      // polymorphic emission they are type variables bound by the currently
      // active instantiation.  Rebuild tuples from the child expressions:
      // the list's own snapshot resolved at typecheck time, losing
      // variables that adapt per instantiation.
      if right.type == ExprType.List || right.type == ExprType.Tuple {
        argElems = arrayof(types.Type)
        for argChild in right.childExprs() {
          argElems.append(builder.typechecker.resolve(argChild.typedValue!))
        }
        argTypes = types.Type(types.TupleType(argElems))
      } else {
        argTypes = builder.typechecker.resolve(right.typedValue!)
      }
      specializedName = argTypes.genSpecializationName(left.val.symVal.name)
      if !builder.alreadyEmitted(specializedName) {
        // The definition-side sweep skips instantiations whose bindings only
        // resolve under an outer instantiation (e.g. a call from a
        // polymorphic class constructor).  Emit the specialization now,
        // while that binding is active.
        callee = builder.findFunction(left.val.symVal.name)
        if !isnull(callee) {
          pi = polyType.poly.instantiations
          emitted = false
          for inst in pi {
            if !emitted {
              // Find the recorded instantiation matching this call site by
              // comparing specialization names under the current bindings.
              builder.instantiate(polyType.poly!, inst)
              ptypes = arrayof(types.Type)
              for variable in callee.variables() {
                ptypes.append(builder.typechecker.resolve(variable.typedValue!))
              }
              iname = types.Type(types.TupleType(ptypes)).genSpecializationName(callee.sym.name)
              builder.deInstantiate(polyType.poly!)
              if iname == specializedName {
                if callee.type == FuncType.Struct {
                  callee.genCStructInstance(builder, inst)
                } else {
                  callee.genCPolyInstantiation(builder, inst)
                }
                emitted = true
              }
            }
          }
          if !emitted {
            // No recorded instantiation matches (e.g. a recursive call
            // whose definition-time instantiation never resolved):
            // synthesize one by opening the polymorphic type fresh and
            // unifying its parameters with this call's argument types.
            openedFn = builder.typechecker.openPoly(polyType.poly!)
            if openedFn.type == types.Type.TypeClass.Function {
              te = builder.typechecker.unify(openedFn.function.params!, argTypes)
              if isnull(te) {
                newInst = polyType.poly.instantiations.lastTyvarInstantiation
                if !isnull(newInst) {
                  builder.resolveInstantiation(newInst!)
                  if builder.instantiationIsConcrete(newInst!) {
                    if callee.type == FuncType.Struct {
                      callee.genCStructInstance(builder, newInst!)
                    } else {
                      callee.genCPolyInstantiation(builder, newInst!)
                    }
                  }
                }
              }
            }
          }
        }
      }
      specialization = Sym.new(specializedName)
      cfn = builder.cIdentifier(specialization, false)
    } else if (left.type == ExprType.Ident && !isnull(self.typedValue) &&
               builder.isClassType(self.typedValue) &&
               builder.typechecker.resolve(self.typedValue!).tyname.name.name ==
                   left.val.symVal.name) {
      // Monomorphic class constructor: the definition is emitted under the
      // specialized class name even when no type variables are involved.
      specializedName = right.typedValue.genSpecializationName(left.val.symVal.name)
      cfn = builder.cIdentifier(Sym.new(specializedName), false)
    } else {
      cfn = left.genC(builder)
    }
    // var parameters of the callee receive the address of their argument.
    varFlags = arrayof(bool)
    if left.type == ExprType.Ident {
      varCallee = builder.findFunction(left.val.symVal.name)
      if !isnull(varCallee) {
        for v in varCallee.variables() {
          if v.isParam {
            varFlags.append(!v.isConst)
          }
        }
      }
    }
    if right.typedValue.type == types.Type.TypeClass.Tuple {
      // Special case -- if right is a tuple, we need to encode cargs as a
      // CExprList of parameters, not as an actual tuple object. Otherwise,
      // instead of generating "f(a1, a2, ...)" we'll generate
      // "f(tupleX(a1, a2, ...))".
      parms = c.CExprList()
      argIndex = 0
      for child in right.childExprs() {
        carg = child.genC(builder)
        if argIndex < varFlags.length() && varFlags[argIndex] {
          carg = c.CExpr(c.CPrefixOperator(self.location,
              c.CPrefixOperator.Type.AddressOf, carg))
        }
        parms.appendCExpr(carg)
        argIndex += 1
      }
      cargs = c.CExpr(parms)
    } else {
      cargs = right.genC(builder)
      if varFlags.length() > 0 && varFlags[0] {
        cargs = c.CExpr(c.CPrefixOperator(self.location,
            c.CPrefixOperator.Type.AddressOf, cargs))
      }
    }
    return builder.cCall(self.location, cfn, cargs)
  }

  func genCType(self, builder: c.CBuilder) -> c.CTypeExpr {
    switch self.type {
      ExprType.UintType => return builder.cIntType(self.location, false, self.width)
      ExprType.IntType => return builder.cIntType(self.location, true, self.width)
      ExprType.FloatType => return builder.cFloatType(self.location, self.width)
      ExprType.StringType => return builder.cStringType(self.location)
      ExprType.BoolType => return builder.cBooleanType(self.location)
      ExprType.NoneType => return builder.cVoidType(self.location)
      ExprType.Ident => raise Status.Unimplemented, "named types not yet supported"
      default => raise Status.Unimplemented, "TypeExpression type not yet supported by C backend", self.type
      // TODO:
      //ExprType.Typeindex
      //ExprType.Namedparam
    }
  }
}

// Expressions form a tree, with each expression having a doubly-linked list of children.
relation DoublyLinked Expr:"Parent" Expr:"Child" cascade
relation DoublyLinked Ident Expr
relation OneToOne Statement Expr cascade
relation OneToOne Variable:"Initializer" Expr:"Initializer" cascade
relation OneToOne Variable:"Type" Expr:"Type" cascade
relation OneToOne Function:"Type" Expr:"Type" cascade

unittest {
  filepath = Filepath.new("test_filepath", null(Filepath), false)
  location = Location(filepath, 0u32, 0u32, 0u32)

  func createBinaryExpr() -> Expr {
    left = Expr.newConstant(Value("Hello"), location)
    assert left.getPrecedence() == getPrecedence(ExprType.Constant)
    right = Expr.newConstant(Value("World"), location)
    assert right.getPrecedence() == getPrecedence(ExprType.Constant)
    return Expr.newBinary(ExprType.Lt, left, right, location)
  }
}

unittest basicExprTest {
  ltExpr = createBinaryExpr()
  assert ltExpr.toString() == "\"Hello\" < \"World\""
}

unittest destroyTest {
  use block

  filepath = Filepath.new("test_filepath", null(Filepath), false)
  location = Location(filepath, 0u32, 0u32, 0u32)
  block = Block(location)
  statement =  Statement(block, StateType.Print, location)
  i = Bigint(0xdeadbeefu32, 256u32)
  expr = Expr.newConstant(Value(i), location)
  statement.insertExpr(expr)
  expr.destroy()
  assert isnull(statement.expr)
}

unittest copyTest {
  expr1 = createBinaryExpr()
  expr2 = expr1.copy()
  assert expr1 != expr2
  assert expr1.toString() == "\"Hello\" < \"World\""
  assert expr2.toString() == "\"Hello\" < \"World\""
}

unittest unaryTest {
  valueExpr = Expr.newConstant(Value(123u32), location)
  expr = Expr.newUnary(ExprType.Negate, valueExpr, location)
  expr.dump()
}

unittest newIdentTest {
  expr = Expr.newIdent(Sym.new("test"), location)
  expr.dump()
}

unittest getExprTypeNameTest {
  for i in range(<u32>ExprType.Add, <u32>ExprType.Namedparam) {
    type = <ExprType>i
    if type != ExprType.Negate && type != ExprType.NegateTrunc {
      assert type == getExprTypeFromSym(Sym.new(getExprTypeName(type)))
    }
  }
}

unittest {
  println "PASSED"
}
