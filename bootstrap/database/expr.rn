        }
        rrArgs = c.CExprList()
        rrArgs.appendCExpr(rrArg.genC(builder))
        return builder.cCall(self.location, "rn_rand_range", c.CExpr(rrArgs))
      }
      if builtinName == "randString" && isnull(builder.findFunction("randString")) {
        rsArg = right
        if right.type == ExprType.List && !isnull(right.firstChildExpr) {
          rsArg = right.firstChildExpr!
        }
        rsArgs = c.CExprList()
        rsArgs.appendCExpr(rsArg.genC(builder))
        return builder.cCall(self.location, "rn_rand_string", c.CExpr(rsArgs))
      }
      if builtinName == "chr" && isnull(builder.findFunction("chr")) {
        chrArg = right
        if right.type == ExprType.List && !isnull(right.firstChildExpr) {
          chrArg = right.firstChildExpr!
        }
        chrArgs = c.CExprList()
        chrArgs.appendCExpr(chrArg.genC(builder))
        return builder.cCall(self.location, c.CRuntimeFunction.StringChr, c.CExpr(chrArgs))
      }
      if builtinName == "abs" && isnull(builder.findFunction("abs")) {
        // abs() maps to fabs for floats, llabs for integers; C's abs()
        // truncates doubles to int.
        absArg = right
        if right.type == ExprType.List && !isnull(right.firstChildExpr) {
          absArg = right.firstChildExpr!
        }
        absFn = c.CRuntimeFunction.IntAbs
        if !isnull(absArg.typedValue) {
          absTy = builder.typechecker.resolve(absArg.typedValue!)
          if absTy.type == types.Type.TypeClass.Float {
            absFn = c.CRuntimeFunction.FloatAbs
          }
        }
        absArgs = c.CExprList()
        absArgs.appendCExpr(absArg.genC(builder))
        return builder.cCall(self.location, absFn, c.CExpr(absArgs))
      }
      if builtinName == "sqrt" && isnull(builder.findFunction("sqrt")) {
        // A bare sqrt(x) with no user/module sqrt in scope maps to libm's
        // hardware sqrt.  The typechecker types the bare call f64 -> f64 on
        // demand (see the sqrt case in TypeChecker.expr's Call handler); no
        // function body is ever emitted, so this interception always fires.
        sqArg = right
        if right.type == ExprType.List && !isnull(right.firstChildExpr) {
          sqArg = right.firstChildExpr!
        }
        sqArgs = c.CExprList()
        sqArgs.appendCExpr(sqArg.genC(builder))
        return builder.cCall(self.location, c.CRuntimeFunction.Sqrt, c.CExpr(sqArgs))
      }
      if (builtinName == "exit" || builtinName == "readByte" ||
          builtinName == "writeByte" || builtinName == "readBytes" ||
          builtinName == "writeBytes" || builtinName == "readlnInto" ||
          builtinName == "appendBytes" || builtinName == "writeReverseTranslated" ||
          builtinName == "writeReverseMasked5Translated") {
        switch builtinName {
          "exit" => iofn = c.CRuntimeFunction.Exit
          "readByte" => iofn = c.CRuntimeFunction.ReadByte
          "writeByte" => iofn = c.CRuntimeFunction.WriteByte
          "readBytes" => iofn = c.CRuntimeFunction.ReadBytes
          "readlnInto" => iofn = c.CRuntimeFunction.ReadLnInto
          "appendBytes" => iofn = c.CRuntimeFunction.AppendBytes
          "writeReverseTranslated" => iofn = c.CRuntimeFunction.WriteReverseTranslated
          "writeReverseMasked5Translated" => iofn = c.CRuntimeFunction.WriteReverseMasked5Translated
          default => iofn = c.CRuntimeFunction.WriteBytes
        }
        ioparms = c.CExprList()
        if right.typedValue.type == types.Type.TypeClass.Tuple {
          for child in right.childExprs() {
            ioparms.appendCExpr(child.genC(builder))
          }
        } else {
          ioparms.appendCExpr(right.genC(builder))
        }
