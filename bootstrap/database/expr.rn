use sym

use filepath
use location
use root
use value
use bigint
use block
use datatype
use ident
use statement
use variable
use function

import cbackend as c
import types


enum ExprType {
  Constant // Any constant such as true, false, "test", 1, 3.14f32, 0xabci255, etc.
  RandUint  // e.g. rand256.
  Ident  // a
  Array  // [1u8, 2u8, 3u8, 4u8] or "passed"
  Modint  // 2 mod p
  // If you modify the list from Add to Rotr, also update the corresponding
  // assignment operator types, in the same order.
  Add  // a + b
  Sub  // a - b
  Mul  // a * b
  Div  // a / b
  Mod  // a % b
  And  // a && b
  Or   // a || b
  Xor  // a ^^ b
  Bitand  // a & b
  Bitor   // a | b
  Bitxor  // a ^ b
  Exp  // a ** b
  Shl  // a << b
  Shr  // a >> b
  Rotl  // a <<< b
  Rotr  // a >>> b
  AddTrunc  // a !+ b
  SubTrunc  // a !- b
  MulTrunc  // a !* b
  Bitnot  // ~a
  Lt  // a < b
  Le  // a <= b
  Gt  // a > b
  Ge  // a >= b
  Equal  // a == b
  Notequal  // a != b
  Negate  // -a
  NegateTrunc  // !-a
  Not  // !a
  Cast  // <b>a
  CastTrunc  // !<b>a
  Select  // passed? a : b
  Call  // fact(n)
  Index  // a[i]
  Slice  // a[a:b]
  Secret  // secret(password)
  Reveal  // reveal(mac)
  Equals  // a = b
  // If you modify the list from AddEquals to RotrEquals, also update the
  // corresponding operator types, in the same order.
  AddEquals  // a += b
  SubEquals  // a -= b
  MulEquals  // a *= b
  DivEquals  // a /= b
  ModEquals  // a %= b
  AndEquals  // a &&= b
  OrEquals   // a ||= b
  XorEquals  // a ^^= b
  BitandEquals  // a &= b
  BitorEquals   // a |= b
  BitxorEquals  // a ^= b
  ExpEquals  // a **= b
  ShlEquals  // a <<= b
  ShrEquals  // a >>= b
  RotlEquals  // a <<<= b
  RotrEquals  // a >>>= b
  AddTruncEquals  // a !+ b
  SubTruncEquals  // a !- b
  MulTruncEquals  // a !* b
  Dot  // a.b
  Dotdotdot  // case u1 ... u32
  List  // fact(a, b, c)
  Tuple  // return (1, 2, "passed")
  As  // import foo as bar
  In  // if element in set
  Const  // const self.x = x
  Null  // null(Node())
  Notnull  // n = node!
  Funcaddr  // &max(0u32, 0u32)
  Arrayof  // arrayof(u32)
  Typeof  // typeof a
  Unsigned  // unsigned(3i32)
  Signed  // signed(3u32)
  Widthof  // widthof a
  Isnull  // isnull(entry)
  // Type expressions:
  UintType  // x: u32 = y
  IntType  // x: i32 = y
  FloatType  // x: f32 = y
  StringType  // x: string = y
  BoolType  // done: bool = checkForDone()
  NoneType  // func foo(x) -> none
  Typeindex  // u32[]
  Namedparam  // Myclass(name = "me", profession = "hacker")
}

// Return the operator precedence.  This is similar to C, but fixes an acknowledged mistake:
// bitwise operators should bind more tightly than relational operators.  By the time C's
// authors realized this mistake, there was already too much C code that would break to fix it.
// Example: "value & 1 == 0" should test that value is even, but in C the result is always 0.
func getPrecedence(type: ExprType) -> u32 {
  switch type {
    // In increasing order of precedence.
    ExprType.Dotdotdot => return 1u32
    ExprType.Select => return 2u32
    ExprType.Or => return 3u32
    ExprType.Xor => return 4u32
    ExprType.And => return 5u32
    ExprType.In => return 6u32
    ExprType.Modint => return 7u32
    ExprType.Lt, ExprType.Le, ExprType.Gt, ExprType.Ge, ExprType.Equal, ExprType.Notequal => return 8u32

    ExprType.Bitor => return 9u32
    ExprType.Bitxor => return 10u32
    ExprType.Bitand => return 11u32
    ExprType.Shl, ExprType.Shr, ExprType.Rotl, ExprType.Rotr => return 12u32
    ExprType.Sub, ExprType.Add, ExprType.SubTrunc, ExprType.AddTrunc => return 13u32
    ExprType.Mul, ExprType.Div, ExprType.Mod, ExprType.MulTrunc => return 14u32
    ExprType.Exp, ExprType.Not, ExprType.Bitnot, ExprType.Negate, ExprType.NegateTrunc, ExprType.Cast, ExprType.CastTrunc => return 15u32
    ExprType.Dot, ExprType.Notnull, ExprType.Call, ExprType.Index, ExprType.Slice => return 16u32
    ExprType.Ident, ExprType.Constant, ExprType.Array, ExprType.Tuple, ExprType.Secret, ExprType.Reveal, ExprType.Arrayof, ExprType.Typeof, ExprType.Null, ExprType.Funcaddr, ExprType.Unsigned, ExprType.Signed, ExprType.Widthof, ExprType.Isnull => return 17u32

    default => return 1u32
  }
}

// Return the expression type's name.
func getExprTypeName(type: ExprType) -> string {
  switch type {
    ExprType.Ident => return "<ident>"
    ExprType.Array => return "<array>"
    ExprType.Add => return "+"
    ExprType.Sub => return "-"
    ExprType.Mul => return "*"
    ExprType.Div => return "/"
    ExprType.Mod => return "%"
    ExprType.And => return "&&"
    ExprType.Or => return "||"
    ExprType.Xor => return "^^"
    ExprType.Bitand => return "&"
    ExprType.Bitor => return "|"
    ExprType.Bitxor => return "^"
    ExprType.Exp => return "**"
    ExprType.Shl => return "<<"
    ExprType.Shr => return ">>"
    ExprType.Rotl => return "<<<"
    ExprType.Rotr => return ">>>"
    ExprType.AddTrunc => return "!+"
    ExprType.SubTrunc => return "!-"
    ExprType.MulTrunc => return "!*"
    ExprType.Bitnot => return "~"
    ExprType.Lt => return "<"
    ExprType.Le => return "<="
    ExprType.Gt => return ">"
    ExprType.Ge => return ">="
    ExprType.Equal => return "=="
    ExprType.Notequal => return "!="
    ExprType.Negate => return "-"
    ExprType.NegateTrunc => return "!-"
    ExprType.Not => return "!"
    ExprType.Cast => return "<>"
    ExprType.CastTrunc => return "!<>"
    ExprType.Select => return "?:"
    ExprType.Call => return "()"
    ExprType.Index => return "[]"
    ExprType.Slice => return "[:]"
    ExprType.Secret => return "secret"
    ExprType.Reveal => return "reveal"
    ExprType.Equals => return "="
    ExprType.AddEquals => return "+="
    ExprType.SubEquals => return "-="
    ExprType.MulEquals => return "*="
    ExprType.DivEquals => return "/="
    ExprType.ModEquals => return "%="
    ExprType.AndEquals => return "&&="
    ExprType.OrEquals => return "||="
    ExprType.XorEquals => return "^^="
    ExprType.BitandEquals => return "&="
    ExprType.BitorEquals => return "|="
    ExprType.BitxorEquals => return "^="
    ExprType.ExpEquals => return "**="
    ExprType.ShlEquals => return "<<="
    ExprType.ShrEquals => return ">>="
    ExprType.RotlEquals => return "<<<="
    ExprType.RotrEquals => return ">>>="
    ExprType.AddTruncEquals => return "!+="
    ExprType.SubTruncEquals => return "!-="
    ExprType.MulTruncEquals => return "!*="
    ExprType.Dot => return "."
    ExprType.Dotdotdot => return "..."
    ExprType.Tuple => return "tuple"
    ExprType.List => return "list"
    ExprType.As => return "as"
    ExprType.In => return "in"
    ExprType.Const => return "const"
    ExprType.Null => return "null"
    ExprType.Notnull => return "notnull"
    ExprType.Funcaddr => return "funcaddr"
    ExprType.Arrayof => return "arrayof"
    ExprType.Typeof => return "typeof"
    ExprType.Unsigned => return "unsigned"
    ExprType.Signed => return "signed"
    ExprType.Widthof => return "widthof"
    ExprType.Isnull => return "isnull"
    ExprType.UintType => return "uinttype"
    ExprType.IntType => return "inttype"
    ExprType.FloatType => return "floattype"
    ExprType.StringType => return "stringtype"
    ExprType.BoolType => return "booltype"
    ExprType.NoneType => return "nonetype"
    ExprType.Typeindex => return "typeindex"
    ExprType.Namedparam => return "namedparam"
    default => panic "Unexpected expression type ", type
  }
}

// Return the expression type given its sym.
func getExprTypeFromSym(sym: Sym) -> ExprType {
  // TODO: pre-build this symbols for improved speed.
  switch sym {
    Sym.new("+") => return ExprType.Add
    Sym.new("-") => return ExprType.Sub
    Sym.new("*") => return ExprType.Mul
    Sym.new("/") => return ExprType.Div
    Sym.new("%") => return ExprType.Mod
    Sym.new("&&") => return ExprType.And
    Sym.new("||") => return ExprType.Or
    Sym.new("^^") => return ExprType.Xor
    Sym.new("&") => return ExprType.Bitand
    Sym.new("|") => return ExprType.Bitor
    Sym.new("^") => return ExprType.Bitxor
    Sym.new("**") => return ExprType.Exp
    Sym.new("<<") => return ExprType.Shl
    Sym.new(">>") => return ExprType.Shr
    Sym.new("<<<") => return ExprType.Rotl
    Sym.new(">>>") => return ExprType.Rotr
    Sym.new("!+") => return ExprType.AddTrunc
    Sym.new("!-") => return ExprType.SubTrunc
    Sym.new("!*") => return ExprType.MulTrunc
    Sym.new("~") => return ExprType.Bitnot
    Sym.new("<") => return ExprType.Lt
    Sym.new("<=") => return ExprType.Le
    Sym.new(">") => return ExprType.Gt
    Sym.new(">=") => return ExprType.Ge
    Sym.new("==") => return ExprType.Equal
    Sym.new("!=") => return ExprType.Notequal
    Sym.new("-") => return ExprType.Negate
    Sym.new("!-") => return ExprType.NegateTrunc
    Sym.new("!") => return ExprType.Not
    Sym.new("<>") => return ExprType.Cast
    Sym.new("!<>") => return ExprType.CastTrunc
    Sym.new("?:") => return ExprType.Select
    Sym.new("()") => return ExprType.Call
    Sym.new("[]") => return ExprType.Index
    Sym.new("[:]") => return ExprType.Slice
    Sym.new("secret") => return ExprType.Secret
    Sym.new("reveal") => return ExprType.Reveal
    Sym.new("=") => return ExprType.Equals
    Sym.new("+=") => return ExprType.AddEquals
    Sym.new("-=") => return ExprType.SubEquals
    Sym.new("*=") => return ExprType.MulEquals
    Sym.new("/=") => return ExprType.DivEquals
    Sym.new("%=") => return ExprType.ModEquals
    Sym.new("&&=") => return ExprType.AndEquals
    Sym.new("||=") => return ExprType.OrEquals
    Sym.new("^^=") => return ExprType.XorEquals
    Sym.new("&=") => return ExprType.BitandEquals
    Sym.new("|=") => return ExprType.BitorEquals
    Sym.new("^=") => return ExprType.BitxorEquals
    Sym.new("**=") => return ExprType.ExpEquals
    Sym.new("<<=") => return ExprType.ShlEquals
    Sym.new(">>=") => return ExprType.ShrEquals
    Sym.new("<<<=") => return ExprType.RotlEquals
    Sym.new(">>>=") => return ExprType.RotrEquals
    Sym.new("!+=") => return ExprType.AddTruncEquals
    Sym.new("!-=") => return ExprType.SubTruncEquals
    Sym.new("!*=") => return ExprType.MulTruncEquals
    Sym.new(".") => return ExprType.Dot
    Sym.new("...") => return ExprType.Dotdotdot
    Sym.new("tuple") => return ExprType.Tuple
    Sym.new("list") => return ExprType.List
    Sym.new("as") => return ExprType.As
    Sym.new("in") => return ExprType.In
    Sym.new("const") => return ExprType.Const
    Sym.new("null") => return ExprType.Null
    Sym.new("notnull") => return ExprType.Notnull
    Sym.new("funcaddr") => return ExprType.Funcaddr
    Sym.new("arrayof") => return ExprType.Arrayof
    Sym.new("typeof") => return ExprType.Typeof
    Sym.new("unsigned") => return ExprType.Unsigned
    Sym.new("signed") => return ExprType.Signed
    Sym.new("widthof") => return ExprType.Widthof
    Sym.new("isnull") => return ExprType.Isnull
    Sym.new("uinttype") => return ExprType.UintType
    Sym.new("inttype") => return ExprType.IntType
    Sym.new("floattype") => return ExprType.FloatType
    Sym.new("stringtype") => return ExprType.StringType
    Sym.new("booltype") => return ExprType.BoolType
    Sym.new("nonetype") => return ExprType.NoneType
    Sym.new("typeindex") => return ExprType.Typeindex
    Sym.new("namedparam") => return ExprType.Namedparam
  }
}

// Return the binary operator corresponding to a compound assignment operator,
// e.g. AddEquals -> Add.  Returns ExprType.Equals for plain assignment.
export func getCompoundAssignBaseOp(type: ExprType) -> ExprType {
  switch type {
    ExprType.AddEquals => return ExprType.Add
    ExprType.SubEquals => return ExprType.Sub
    ExprType.MulEquals => return ExprType.Mul
    ExprType.DivEquals => return ExprType.Div
    ExprType.ModEquals => return ExprType.Mod
    ExprType.AndEquals => return ExprType.And
    ExprType.OrEquals => return ExprType.Or
    ExprType.XorEquals => return ExprType.Xor
    ExprType.BitandEquals => return ExprType.Bitand
    ExprType.BitorEquals => return ExprType.Bitor
    ExprType.BitxorEquals => return ExprType.Bitxor
    ExprType.ExpEquals => return ExprType.Exp
    ExprType.ShlEquals => return ExprType.Shl
    ExprType.ShrEquals => return ExprType.Shr
    ExprType.RotlEquals => return ExprType.Rotl
    ExprType.RotrEquals => return ExprType.Rotr
    ExprType.AddTruncEquals => return ExprType.AddTrunc
    ExprType.SubTruncEquals => return ExprType.SubTrunc
    ExprType.MulTruncEquals => return ExprType.MulTrunc
    default => return ExprType.Equals
  }
}

// Whether an argument of this type can select a specialization whose
// parameter has the given type: equal types, or an adaptable
// unsuffixed-literal type (AnyInt) against any integer type.  Compared by
// specialization name: Type.equals does not see structurally equal
// parameter tuples as equal.
// The right-hand side of the first `name = <expr>` assignment in |block|
// (searched recursively), or null.  A function local declares through its
// first assignment, so that expression carries the local's type when the
// identifier's own type snapshot is stale (see resolvedArgType).
func findLocalDecl(block: Block?, name: string) -> Expr? {
  if isnull(block) {
    return null(Expr)
  }
  for statement in block.statements() {
    if !isnull(statement.expr) {
      if statement.expr.type == ExprType.Equals {
        dlhs = statement.expr.firstChildExpr!
        if dlhs.type == ExprType.Ident {
          if dlhs.val.symVal.name == name {
            return dlhs.nextExprChildExpr
          }
        }
      }
    }
    dsub = findLocalDecl(statement.subBlock, name)
    if !isnull(dsub) {
      return dsub
    }
  }
  return null(Expr)
}

// Re-resolve |expr|'s type (and its children's, first) through
// resolvedArgType's recovery when it is under-resolved, baking the result
// into typedValue.  See Statement.rebakeBlockTypes.
func rebakeExprTypes(builder: c.CBuilder, expr: Expr, root: Block?) {
  for child in expr.childExprs() {
    rebakeExprTypes(builder, child, root)
  }
  if !isnull(expr.typedValue) {
    if argTypeUnderResolved(builder, expr.typedValue!) {
      recovered = expr.resolvedArgType(builder, 0u32, root)
      if !argTypeUnderResolved(builder, recovered) {
        expr.typedValue = recovered
      }
    }
  }
}

// The first return statement's expression in |block| (searched
// recursively), or null.  Roots resolvedArgType's method-return recovery.
func findReturnExpr(block: Block) -> Expr? {
  for statement in block.statements() {
    if statement.type == StateType.Return {
      if !isnull(statement.expr) {
        return statement.expr
      }
    }
    if !isnull(statement.subBlock) {
      rsub = findReturnExpr(statement.subBlock!)
      if !isnull(rsub) {
        return rsub
      }
    }
  }
  return null(Expr)
}

// If |t| is an under-resolved class Typename (bare knot or free params),
// adopt the class's concrete instantiation the way the C type generator
// does; otherwise return |t| unchanged.
func adoptConcreteBaseTy(builder: c.CBuilder, t: types.Type) -> types.Type {
  if t.type != types.Type.TypeClass.Typename {
    return t
  }
  if !argTypeUnderResolved(builder, t) {
    return t
  }
  concrete = types.Type(builder.typeGenerator.concreteClassTyname(t.tyname!))
  if argTypeUnderResolved(builder, concrete) {
    return t
  }
  return concrete
}

// True if |t| resolves to a type that cannot fully name a specialization:
// it holds a free type variable, or a bare class-name knot (a Typename with
// no parameter tuple) somewhere in its structure.
func argTypeUnderResolved(builder: c.CBuilder, t: types.Type) -> bool {
  if builder.typechecker.hasFreeVars(t) {
    return true
  }
  return argTypeHasBareKnot(builder, t, 0u32)
}

func argTypeHasBareKnot(builder: c.CBuilder, t: types.Type, depth: u32) -> bool {
  if depth > 8u32 {
    return false
  }
  rt = builder.typechecker.resolve(t)
  if rt.type == types.Type.TypeClass.Typename {
    if isnull(rt.tyname.params) {
      // Only class knots count: builtin named types (string, none) are
      // Typenames with no parameter tuple and are fully resolved -- and a
      // bare name of a PARAMETERLESS class is complete, too.
      kinfo = builder.typechecker.lookupClass(rt.tyname.name)
      if isnull(kinfo) {
        return false
      }
      return kinfo.paramVars.length() > 0
    }
    for element in rt.tyname.params.elements {
      if argTypeHasBareKnot(builder, element, depth + 1u32) {
        return true
      }
    }
    return false
  }
  if rt.type == types.Type.TypeClass.Array {
    return argTypeHasBareKnot(builder, rt.array.elementType!, depth + 1u32)
  }
  if rt.type == types.Type.TypeClass.Tuple {
    for element in rt.tuple.elements {
      if argTypeHasBareKnot(builder, element, depth + 1u32) {
        return true
      }
    }
    return false
  }
  return false
}

func typeArgCompatible(argType: types.Type, paramType: types.Type) -> bool {
  // An unresolved type variable on either side is a "don't know" slot that
  // matches anything: a deferred operator's operand (e.g. a recursive call's
  // result type) or an operator parameter whose own type-arg stayed a variable.
  // The other operand disambiguates which overload is meant.
  if argType.type == types.Type.TypeClass.Var ||
      paramType.type == types.Type.TypeClass.Var {
    return true
  }
  if argType.specializationName() == paramType.specializationName() {
    return true
  }
  paramIsInt = (paramType.type == types.Type.TypeClass.Int ||
                paramType.type == types.Type.TypeClass.AnyInt)
  if argType.type == types.Type.TypeClass.AnyInt && paramIsInt {
    return true
  }
  if paramType.type == types.Type.TypeClass.AnyInt &&
      argType.type == types.Type.TypeClass.Int {
    return true
  }
  // Two instantiations of the same parameterized class (e.g. Foo(u100) vs the
  // operator parameter Foo(v46)) match when their type-args match slot by slot,
  // with a variable slot treated as a wildcard (above).  specializationName
  // misses this because a variable slot stringifies differently.
  if (argType.type == types.Type.TypeClass.Typename &&
      paramType.type == types.Type.TypeClass.Typename &&
      argType.tyname.name.name == paramType.tyname.name.name) {
    if isnull(argType.tyname.params) && isnull(paramType.tyname.params) {
      return true
    }
    if isnull(argType.tyname.params) || isnull(paramType.tyname.params) {
      // A bare class knot on ONE side is a same-class wildcard: a relation
      // method's template operand (bare Element) against the concrete
      // instance (heapsort's compareElement fell to a C pointer compare).
      return true
    }
    if !isnull(argType.tyname.params) && !isnull(paramType.tyname.params) {
      aels = argType.tyname.params.elements
      pels = paramType.tyname.params.elements
      if aels.length() == pels.length() {
        for slot in range(aels.length()) {
          if !typeArgCompatible(aels[slot], pels[slot]) {
            return false
          }
        }
        return true
      }
    }
  }
  return false
}

// The expression class represents all expression trees in Rune.
class Expr(self, type: ExprType, location: Location) {
  self.type = type
  self.location = location
  self.isType = false
  self.isConst = false
  // Call arguments already rewritten to full positional form; a second
  // typecheck pass (deferral retry) must not rebuild them.
  self.argsNormalized = false
  self.autocast = false  // Set on integer constants without a type suffix.
  self.width = 0u32
  // TODO: add datatype when ported to Rune.
  // self.datatype = null(Datatype)
  self.val = null(Value(0u32))
  self.bindingInstance = false
  self.typedValue = null(types.Type)

  func newConstant(value: Value, location: Location) -> Expr {
    expr = Expr(ExprType.Constant, location)
    expr.val = value
    return expr
  }

  func newBinary(type: ExprType, left: Expr, right: Expr, location: Location) -> Expr {
    expr = Expr(type, location)
    expr.appendChildExpr(left)
    expr.appendChildExpr(right)
    return expr
  }

  func newUnary(type: ExprType, child: Expr, location: Location) -> Expr {
    expr = Expr(type, location)
    expr.appendChildExpr(child)
    return expr
  }

  func newIdent(sym: Sym, location: Location) -> Expr {
    expr = Expr(ExprType.Ident, location)
    expr.val = Value(sym)
    return expr
  }

  func newTuple(children, location) -> Expr {
    expr = Expr(ExprType.Tuple, location)
    for child in children {
      expr.appendChildExpr(child)
    }
    return expr
  }

  func newArray(children, location) -> Expr {
    expr = Expr(ExprType.Array, location)
    for child in children {
      expr.appendChildExpr(child)
    }
    return expr
  }

  // Return the precedence of the expression.
  func getPrecedence(self) -> u32 {
    return getPrecedence(self.type)
  }

  // Return the name of this expression's type.
  func typeName(self) {
    return getExprTypeName(self.type)
  }

  // Dump an expression list, separated by commas.
  func dumpList(self, var text: string) {
    firstTime = true
    for child in self.childExprs() {
      if !firstTime {
        text += ", "
      }
      firstTime = false
      child.dumpToString(text)
    }
  }

  // Write out a call expression.
  func dumpCall(self, var text: string) {
    left = self.firstChildExpr!
    right = left.nextExprChildExpr!
    left.dumpToString(text)
    text += "("
    if !isnull(right) {
      right.dumpToString(text)
    }
    text += ")"
  }

  // Write out an index expression.
  func dumpIndex(self, var text: string) {
    left = self.firstChildExpr!
    right = left.nextExprChildExpr!
    left.dumpToString(text)
    text += "["
    if !isnull(right) {
      right.dumpToString(text)
    }
    text += "]"
  }

  // Write out a slice expression.
  func dumpSlice(self, var text: string) {
    left = self.firstChildExpr!
    lower = left.nextExprChildExpr!
    upper = lower.nextExprChildExpr!
    left.dumpToString(text)
    text += "["
    lower.dumpToString(text)
    text += ":"
    upper.dumpToString(text)
    text += "]"
  }

  // Write out a cast expression.
  func dumpCast(self, var text: string, parentPrecedence: u32, truncate: bool) {
    left = self.firstChildExpr!
    right = left.nextExprChildExpr!
    precedence = self.getPrecedence()
    if precedence <= parentPrecedence {
      text += "("
    }
    if truncate {
      text += "!"
    }
    text += "<"
    left.dumpToString(text)
    text += ">"
    right.dumpToString(text)
    if precedence <= parentPrecedence {
      text += ")"
    }
  }

  // Write out a select expression.
  func dumpSelect(self, var text: string, parentPrecedence: u32) {
    s = self.firstChildExpr!
    a = s.nextExprChildExpr!
    b = a.nextExprChildExpr!
    precedence = self.getPrecedence()
    if precedence <= parentPrecedence {
      text += "("
    }
    s.dumpToString(text)
    text += " ? "
    a.dumpToString(text)
    text += " : "
    b.dumpToString(text)
    if precedence <= parentPrecedence {
      text += ")"
    }
  }

  // Write out a binary expression.
  func dumpBinary(self, var text: string, opType: string, parentPrecedence: u32) {
    parent = self.parentExpr
    left = self.firstChildExpr!
    right = left.nextExprChildExpr!
    precedence = self.getPrecedence()
    needParens = precedence <= parentPrecedence && precedence < getPrecedence(ExprType.Dot)
    if needParens {
      text += "("
    }
    left.dumpToString(text)
    if precedence < getPrecedence(ExprType.Dot) {
      text += " " + opType + " "
    } else {
      text += opType
    }
    right.dumpToString(text)
    if needParens {
      text += ")"
    }
  }

  // Write out a prefix expression.
  func dumpPrefix(self, var text: string, opType: string, parentPrecedence: u32) {
    left = self.firstChildExpr!
    precedence = self.getPrecedence()
    if precedence <= parentPrecedence {
      text += "("
    }
    text += opType
    left.dumpToString(text)
    if precedence <= parentPrecedence {
      text += ")"
    }
  }

  // Dump a builtin function such as typeof(a).
  func dumpBuiltin(self, var text: string, name: string) {
    left = self.firstChildExpr!
    text += name + "("
    left.dumpToString(text)
    text += ")"
  }

  // Write out the array expression.
  func dumpArray(self, var text: string) {
    text += "["
    firstTime = true
    for child in self.childExprs() {
      if !firstTime {
        text += ", "
      }
      firstTime = false
      child.dumpToString(text)
    }
    text += "]"
  }

  // Write out the tuple expression.
  func dumpTuple(self, var text: string) {
    text += "("
    firstTime = true
    for child in self.childExprs() {
      if !firstTime {
        text += ", "
      }
      firstTime = false
      child.dumpToString(text)
    }
    text += ")"
  }

  // Write out the assignment expression.
  func dumpAssignment(self, var text) {
    target = self.firstChildExpr!
    value = target.nextExprChildExpr!
    constraint = value.nextExprChildExpr
    target.dumpToString(text)
    if !isnull(constraint) {
      text.concat(": ")
      constraint.dumpToString(text)
    }
    text.append(' ')
    text += getExprTypeName(self.type)
    text.append(' ')
    value.dumpToString(text)
  }

  // Write out the expression in a reasonably readable format to the end of |string|.
  func dumpToString(self, var text: string) {
    parent = self.parentExpr
    parentPrecedence = 0u32
    if !isnull(parent) {
      parentPrecedence = parent.getPrecedence()
    }
    switch self.type {
      ExprType.Constant => text += self.val.toString()
      ExprType.Ident => text += self.val.symVal.name
      ExprType.Array => self.dumpArray(text)
      ExprType.Tuple => self.dumpTuple(text)
      ExprType.RandUint => text += "rand%u" % self.width
      ExprType.Modint => self.dumpBinary(text, "mod", parentPrecedence)
      ExprType.Add => self.dumpBinary(text, "+", parentPrecedence)
      ExprType.Sub => self.dumpBinary(text, "-", parentPrecedence)
      ExprType.Mul => self.dumpBinary(text, "*", parentPrecedence)
      ExprType.Div => self.dumpBinary(text, "/", parentPrecedence)
      ExprType.Mod => self.dumpBinary(text, "%", parentPrecedence)
      ExprType.And => self.dumpBinary(text, "&&", parentPrecedence)
      ExprType.Or => self.dumpBinary(text, "||", parentPrecedence)
      ExprType.Xor => self.dumpBinary(text, "^^", parentPrecedence)
      ExprType.Bitand => self.dumpBinary(text, "&", parentPrecedence)
      ExprType.Bitor => self.dumpBinary(text, "|", parentPrecedence)
      ExprType.Bitxor => self.dumpBinary(text, "^", parentPrecedence)
      ExprType.Exp => self.dumpBinary(text, "**", parentPrecedence)
      ExprType.Shl => self.dumpBinary(text, "<<", parentPrecedence)
      ExprType.Shr => self.dumpBinary(text, ">>", parentPrecedence)
      ExprType.Rotl => self.dumpBinary(text, "<<<", parentPrecedence)
      ExprType.Rotr => self.dumpBinary(text, ">>>", parentPrecedence)
      ExprType.AddTrunc => self.dumpBinary(text, "!+", parentPrecedence)
      ExprType.SubTrunc => self.dumpBinary(text, "!-", parentPrecedence)
      ExprType.MulTrunc => self.dumpBinary(text, "!*", parentPrecedence)
      ExprType.Lt => self.dumpBinary(text, "<", parentPrecedence)
      ExprType.Le => self.dumpBinary(text, "<=", parentPrecedence)
      ExprType.Gt => self.dumpBinary(text, ">", parentPrecedence)
      ExprType.Ge => self.dumpBinary(text, ">=", parentPrecedence)
      ExprType.Equal => self.dumpBinary(text, "==", parentPrecedence)
      ExprType.Notequal => self.dumpBinary(text, "!=", parentPrecedence)
      ExprType.Negate => self.dumpPrefix(text, "-", parentPrecedence)
      ExprType.NegateTrunc => self.dumpPrefix(text, "!-", parentPrecedence)
      ExprType.Not => self.dumpPrefix(text, "!", parentPrecedence)
      ExprType.Bitnot => self.dumpPrefix(text, "~", parentPrecedence)
      ExprType.Cast => self.dumpCast(text, parentPrecedence, false)
      ExprType.CastTrunc => self.dumpCast(text, parentPrecedence, true)
      ExprType.Select => self.dumpSelect(text, parentPrecedence)
      ExprType.Call => self.dumpCall(text)
      ExprType.Funcaddr => self.dumpPrefix(text, "&", parentPrecedence)
      ExprType.Arrayof => self.dumpBuiltin(text, "arrayof")
      ExprType.Typeof => self.dumpBuiltin(text, "typeof")
      ExprType.Unsigned => self.dumpBuiltin(text, "unsigned")
      ExprType.Signed => self.dumpBuiltin(text, "signed")
      ExprType.Widthof => self.dumpBuiltin(text, "widthof")
      ExprType.Isnull => self.dumpBuiltin(text, "isnull")
      ExprType.Null => self.dumpBuiltin(text, "null")
      ExprType.Notnull => {
        self.firstChildExpr.dumpToString(text)
        text.append('!')
      }
      ExprType.Index, ExprType.Typeindex => self.dumpIndex(text)
      ExprType.Slice => self.dumpSlice(text)
      ExprType.Secret => {
        text += "secret("
        self.firstChildExpr.dumpToString(text)
        text += ")"
      }
      ExprType.Reveal => {
        text += "reveal("
        self.firstChildExpr.dumpToString(text)
        text += ")"
      }
      ExprType.Const => self.dumpPrefix(text, "const ", parentPrecedence)
      ExprType.Equals, ExprType.AddEquals, ExprType.SubEquals, ExprType.MulEquals,
          ExprType.DivEquals, ExprType.ModEquals, ExprType.AndEquals, ExprType.OrEquals,
          ExprType.XorEquals, ExprType.ExpEquals, ExprType.ShlEquals, ExprType.ShrEquals,
          ExprType.RotlEquals, ExprType.RotrEquals, ExprType.AddTruncEquals,
          ExprType.SubTruncEquals, ExprType.MulTruncEquals, ExprType.BitandEquals,
          ExprType.BitorEquals, ExprType.BitxorEquals => self.dumpAssignment(text)
      ExprType.As => self.dumpBinary(text, "as", parentPrecedence)
      ExprType.In => self.dumpBinary(text, "in", parentPrecedence)
      ExprType.Dot => self.dumpBinary(text, ".", parentPrecedence)
      ExprType.Dotdotdot => self.dumpBinary(text, "...", parentPrecedence)
      ExprType.List => self.dumpList(text)
      ExprType.UintType => text += "u%u" % self.width
      ExprType.IntType => text += "i%u" % self.width
      ExprType.FloatType => text += "f%u" % self.width
      ExprType.StringType => text += "string"
      ExprType.BoolType => text += "bool"
      ExprType.NoneType => text += "none"
      ExprType.Namedparam => {
        text += self.firstChildExpr.val.symVal.name + " = "
        self.lastChildExpr.dumpToString(text)
      }
    }
  }

  // Convert the expression to a string in a reasonably readable format.
  func toString(self) -> string {
    text = ""
    self.dumpToString(text)
    return text
  }

  // Write out the expression in a reasonably readable format.
  func dump(self: Expr) {
    text = ""
    self.dumpToString(text)
    println text
  }

  // Make a deep copy of the expression.
  func copy(self: Expr) -> Expr {
    newExpr = Expr(self.type, self.location)
    // TODO: Comment in when we port datatype to Rune.
    // newExpr.datatype = expr.datatype
    newExpr.isType = self.isType
    newExpr.isConst = self.isConst
    newExpr.width = self.width
    newExpr.autocast = self.autocast
    newExpr.val = self.val
    for child in self.childExprs() {
      newChild = child.copy()
      newExpr.appendChildExpr(newChild)
    }
    return newExpr
  }

  // C Generator ------------------------------------------------------------------

  func genC(self, builder: c.CBuilder) -> c.CExpr {
    switch self.type {
      // First, the operators that map directly to C binary operators
      ExprType.AddTrunc => return self.genCBinaryOp(builder)
      ExprType.Constant => {
        wlit = builder.wideWidth(self.typedValue)
        if (wlit > 0u32 && (self.val.type == DatatypeType.Int ||
            self.val.type == DatatypeType.Uint) && self.val.intVal.width <= 64u32) {
          // An unsuffixed literal adapted to a wide type: widen its 64-bit
          // form at runtime.
          return builder.cWideFromU64(self.location,
              self.val.genC(builder, false), wlit,
              builder.wideSigned(self.typedValue))
        }
        return self.val.genC(builder, false)
      }
      ExprType.Ident => {
        if self.val.symVal.name == "argv" && !self.bindingInstance {
          // The program's argument list, built from main()'s argc/argv.
          // Declare the string-array type so its tostring helper exists.
          if !isnull(self.typedValue) {
            argvTy = builder.typechecker.resolve(self.typedValue!)
            if argvTy.type == types.Type.TypeClass.Array {
              builder.ensureArrayDeclared(self.location, argvTy.array.elementType!)
            }
          }
          argvArgs = c.CExprList()
          argvArgs.appendCExpr(c.CExpr(c.CIdentifier(Sym.new("argc"),
              null(c.CTypeExpr), false, false, false)))
          argvArgs.appendCExpr(c.CExpr(c.CIdentifier(Sym.new("argv"),
              null(c.CTypeExpr), false, false, false)))
          return builder.cCall(self.location, c.CRuntimeFunction.ArgvArray,
              c.CExpr(argvArgs))
        }
        return self.val.genC(builder, self.bindingInstance, self.typedValue)
      }
      ExprType.List => return self.genCList(builder)
      ExprType.Mod => return self.genCBinaryOp(builder)
      ExprType.MulTrunc => return self.genCBinaryOp(builder)
      ExprType.Negate => return self.genCPrefixOp(builder)
      ExprType.NegateTrunc => return self.genCPrefixOp(builder)
      ExprType.And => return self.genCBinaryOp(builder)
      ExprType.Or => return self.genCBinaryOp(builder)
      ExprType.Xor => return self.genCBinaryOp(builder)
      ExprType.Bitand => return self.genCBinaryOp(builder)
      ExprType.Bitor => return self.genCBinaryOp(builder)
      ExprType.Bitxor => return self.genCBinaryOp(builder)
      ExprType.Bitnot => return self.genCPrefixOp(builder)
      ExprType.Not => return self.genCPrefixOp(builder)
      ExprType.Shl => return self.genCBinaryOp(builder)
      ExprType.Shr => return self.genCBinaryOp(builder)
      ExprType.SubTrunc => return self.genCBinaryOp(builder)
      ExprType.Lt => return self.genCBinaryOp(builder)
      ExprType.Le => return self.genCBinaryOp(builder)
      ExprType.Gt => return self.genCBinaryOp(builder)
      ExprType.Ge => return self.genCBinaryOp(builder)
      ExprType.Equal => return self.genCBinaryOp(builder)
      ExprType.Notequal => return self.genCBinaryOp(builder)
      ExprType.In => return self.genCBinaryOp(builder)

      // Now, the operators that map to runtime functions
      ExprType.Add => return self.genCBinaryOp(builder)
      ExprType.Div => return self.genCBinaryOp(builder)
      ExprType.Exp => return self.genCBinaryOp(builder)
      ExprType.Mul => return self.genCBinaryOp(builder)
      ExprType.Rotl => return self.genCBinaryOp(builder)
      ExprType.Rotr => return self.genCBinaryOp(builder)
      ExprType.Sub => return self.genCBinaryOp(builder)

      ExprType.Call => return self.genCCall(builder)

      // Assignment
      ExprType.Equals => return self.genCBinaryOp(builder)

      // Type values (t = u32, bar(string), typeof(x)) exist only at compile
      // time; where a runtime value is syntactically required (a call
      // argument), a zero dummy of the resolved type stands in.
      ExprType.UintType => return self.genCTypeDummy(builder)
      ExprType.IntType => return self.genCTypeDummy(builder)
      ExprType.FloatType => return self.genCTypeDummy(builder)
      ExprType.StringType => return self.genCTypeDummy(builder)
      ExprType.BoolType => return self.genCTypeDummy(builder)
      ExprType.NoneType => return self.genCTypeDummy(builder)
      ExprType.Typeof => return self.genCTypeDummy(builder)
      ExprType.Typeindex => return c.CExpr(self.genCType(builder))
      ExprType.Namedparam => return c.CExpr(self.genCType(builder))

      // Null handling: class instances are C pointers.
      ExprType.Null => return self.genCTypeDummy(builder)
      ExprType.Isnull => return c.CExpr(c.CPrefixOperator(self.location,
          c.CPrefixOperator.Type.LogNot, self.firstChildExpr.genC(builder)))
      ExprType.Notnull => return self.firstChildExpr.genC(builder)

      ExprType.Widthof => return self.genCWidthof(builder)
      ExprType.Unsigned => return self.genCSignConversion(builder)
      ExprType.Signed => return self.genCSignConversion(builder)

      // Arrays
      ExprType.Arrayof => return self.genCArrayOf(builder)
      ExprType.Array => return self.genCArray(builder)

      // Tuples
      ExprType.Tuple => return self.genCTuple(builder)
      ExprType.Index => return self.genCIndex(builder)
      ExprType.Slice => return self.genCSlice(builder)
      ExprType.Modint => return self.genCModint(builder)
      ExprType.RandUint => {
        randArgs = c.CExprList()
        randArgs.appendCExpr(c.CExpr(c.CLiteral(Bigint(<u64>self.width), false)))
        if self.width <= 64u32 {
          return builder.cWideCall(self.location, "rn_rand_u64", randArgs)
        }
        return builder.cWideCall(self.location, "wide_rand", randArgs)
      }

      // Structs
      ExprType.Dot => return self.genCFieldSel(builder)

      // The conditional operator a ? b : c.
      ExprType.Select => return self.genCSelect(builder)

      // Casts: <T>x and !<T>x.
      ExprType.Cast => return self.genCCast(builder)
      ExprType.CastTrunc => return self.genCCast(builder)

      // &foo(...): the address of a function.  A C function name decays to a
      // function pointer, so emitting the callee's name suffices.
      ExprType.Funcaddr => return self.genCFuncaddr(builder)

      default => raise Status.Unimplemented, "Expression type not yet supported by C backend: ", getExprTypeName(self.type)
    }
  }

  func genCList(self, builder: c.CBuilder) -> c.CExpr {
    // The Hello World test requires a single-valued list of expressions to be
    // passed as arguments to a procedure call.
    elements = c.CExprList()
    for child in self.childExprs() {
      elements.appendCExpr(child.genC(builder))
    }
    return c.CExpr(elements)
  }

  // "fmt" % args as an expression: format into a fresh heap string via the
  // string_sprintf runtime helper.  Rune format codes are converted to
  // printf codes by the string literal escaper.
  func genCStringFormat(self, builder: c.CBuilder, left: Expr, right: Expr) -> c.CExpr {
    if left.type != ExprType.Constant || left.val.type != DatatypeType.String {
      raise Status.Unimplemented, "String formatting requires a literal format string"
    }
    args = c.CExprList()
    // Integers widen to 64 bits to match the PRI*64 format directives;
    // wide arguments render as strings via a %s directive.
    fmtWideFlags = arrayof(bool)
    if right.type == ExprType.Tuple {
      for child in right.childExprs() {
        fmtWideFlags.append(builder.wideWidth(child.typedValue) > 0u32)
      }
    } else {
      fmtWideFlags.append(builder.wideWidth(right.typedValue) > 0u32)
    }
    fmtDirs = builder.formatDirectives(left.val.stringVal)
    args.appendCExpr(builder.cStringLiteral(
        builder.rewriteWideFormat(left.val.stringVal, fmtWideFlags), printf=true))
    fmtArgIdx = 0
    if right.type == ExprType.Tuple {
      for child in right.childExprs() {
        fmtDir = fmtArgIdx < fmtDirs.length() ? fmtDirs[fmtArgIdx] : 0u8
        args.appendCExpr(builder.cFormatArg(self.location, child.genC(builder),
            child.typedValue, fmtDir))
        fmtArgIdx += 1
      }
    } else {
      fmtDir = fmtDirs.length() > 0 ? fmtDirs[0] : 0u8
      args.appendCExpr(builder.cFormatArg(self.location, right.genC(builder),
          right.typedValue, fmtDir))
    }
    return builder.cCall(self.location, c.CRuntimeFunction.StringSprintf, c.CExpr(args))
  }

  // Generate a call to a user-defined operator function whose parameter
  // types match the operand types.  Specializations not yet emitted by the
  // module sweep are emitted on demand.  Returns null when no registered
  // operator matches, so the caller falls back to the builtin form.
  //
  // Matching compares the operand types against each recorded
  // instantiation's resolved parameter types, allowing an unsuffixed
  // literal (typed AnyInt) to match a concrete integer parameter; an exact
  // name comparison would never match because the call site only knows the
  // literal's adaptable type.
  func genCUserOperator(self, builder: c.CBuilder, l: c.CExpr, r: c.CExpr,
                        left: Expr, right: Expr) -> c.CExpr? {
    tc = builder.typechecker
    ltype = tc.resolve(left.typedValue!)
    rtype = tc.resolve(right.typedValue!)
    for i in range(tc.operatorFns.length()) {
      opfn = tc.operatorFns[i]
      if opfn.opType == self.type {
        opty = tc.operatorTypes[i]
        callName = ""
        if opty.type == types.Type.TypeClass.Polymorphic {
          for inst in opty.poly.instantiations {
            if callName == "" {
              builder.instantiate(opty.poly!, inst)
              ptypes = arrayof(types.Type)
              for variable in opfn.variables() {
                ptypes.append(tc.resolve(variable.typedValue!))
              }
              iname = types.Type(types.TupleType(ptypes)).genSpecializationName(opfn.sym.name)
              builder.deInstantiate(opty.poly!)
              // Skip an instantiation whose parameter types still hold free
              // variables: it was recorded while the operator was applied to
              // unconstrained operands (e.g. a relation _compare's generic
              // children) and would emit an un-typeable C function.  A
              // concrete instantiation for these operands is recorded when the
              // caller's body is retypechecked, and matches below.
              ptypesFree = false
              for pt in ptypes {
                if tc.hasFreeVars(pt) {
                  ptypesFree = true
                }
              }
              if (ptypes.length() == 2 &&
                  typeArgCompatible(ltype, ptypes[0]) &&
                  typeArgCompatible(rtype, ptypes[1])) {
                if !ptypesFree {
                  if !builder.alreadyEmitted(iname) {
                    opfn.genCPolyInstantiation(builder, inst)
                  }
                  callName = iname
                }
              }
            }
          }
          if callName == "" {
            // No recorded instantiation is concrete for these operands (the
            // operator was only ever applied to a relation method's generic
            // children, which never retypecheck); synthesize one from the
            // resolved operand types.
            opOpened = tc.openPoly(opty.poly!)
            if opOpened.type == types.Type.TypeClass.Function {
              opArgs = arrayof(types.Type)
              opArgs.append(ltype)
              opArgs.append(rtype)
              tc.unifier.beginBindTrail()
              opTe = tc.unify(opOpened.function.params!,
                  types.Type(types.TupleType(opArgs)))
              if isnull(opTe) {
                tc.unifier.commitBindTrail()
              } else {
                tc.unifier.rollbackBindTrail()
                // The operator's generalized params FROZE under an
                // earlier signature of a multi-signature class
                // (Integer's op + baked (u32,u32); the (u64,u32) pair
                // fails structurally).  Force the spec through the
                // want machinery: the def-side name collision triggers
                // adoption of these GROUND operand types.
                opWInst = opty.poly.instantiations.lastTyvarInstantiation
                if !isnull(opWInst) &&
                    !tc.hasFreeVars(ltype) && !tc.hasFreeVars(rtype) {
                  opWTuple = types.Type(types.TupleType([ltype, rtype]))
                  opWName = opWTuple.genSpecializationName(opfn.sym.name)
                  builder.wantSpecName = opWName
                  builder.wantSpecParams = opWTuple
                  builder.wantSpecResult = null(types.Type)
                  if !builder.alreadyEmitted(opWName) {
                    opfn.genCPolyInstantiation(builder, opWInst!)
                  }
                  if builder.alreadyEmitted(opWName) {
                    callName = opWName
                  }
                }
              }
              if isnull(opTe) {
                opNewInst = opty.poly.instantiations.lastTyvarInstantiation
                if !isnull(opNewInst) {
                  builder.resolveInstantiation(opNewInst!)
                  builder.instantiate(opty.poly!, opNewInst!)
                  optypes = arrayof(types.Type)
                  for opVariable in opfn.variables() {
                    optypes.append(tc.resolve(opVariable.typedValue!))
                  }
                  opIname = types.Type(types.TupleType(optypes)).genSpecializationName(opfn.sym.name)
                  opFree = false
                  for opt in optypes {
                    if tc.hasFreeVars(opt) {
                      opFree = true
                    }
                  }
                  builder.deInstantiate(opty.poly!)
                  if opFree == false && optypes.length() == 2 {
                    if !builder.alreadyEmitted(opIname) {
                      opfn.genCPolyInstantiation(builder, opNewInst!)
                    }
                    callName = opIname
                  } else if opFree && !tc.hasFreeVars(ltype) &&
                      !tc.hasFreeVars(rtype) {
                    // The synthesized instantiation's slots keep free
                    // pieces (Integer's width var) although the OPERANDS
                    // are ground: force the spec through the want
                    // machinery — the free-params adoption grounds it.
                    ofTuple = types.Type(types.TupleType([ltype, rtype]))
                    ofName = ofTuple.genSpecializationName(opfn.sym.name)
                    builder.wantSpecName = ofName
                    builder.wantSpecParams = ofTuple
                    builder.wantSpecResult = null(types.Type)
                    if !builder.alreadyEmitted(ofName) {
                      opfn.genCPolyInstantiation(builder, opNewInst!)
                    }
                    if builder.alreadyEmitted(ofName) {
                      callName = ofName
                    }
                  }
                }
              }
            }
          }
        } else if opty.type == types.Type.TypeClass.Function {
          // Monomorphic operator, emitted under its plain name; check the
          // parameter types match these operands.
          mtypes = arrayof(types.Type)
          for variable in opfn.variables() {
            mtypes.append(tc.resolve(variable.typedValue!))
          }
          if (mtypes.length() == 2 &&
              typeArgCompatible(ltype, mtypes[0]) &&
              typeArgCompatible(rtype, mtypes[1])) {
            callName = opfn.sym.name
          }
        }
        if callName != "" {
          args = c.CExprList()
          args.appendCExpr(l)
          args.appendCExpr(r)
          return builder.cCall(self.location, callName, c.CExpr(args))
        }
      }
    }
    return null(c.CExpr)
  }

  // A zero value standing in for an expression with no runtime
  // representation: type values passed as arguments, and null(Foo), which
  // becomes a zero (null) pointer of the class's C struct type.
  func genCTypeDummy(self, builder: c.CBuilder) -> c.CExpr {
    dummyType = builder.typechecker.resolve(self.typedValue!)
    if dummyType.type == types.Type.TypeClass.Array {
      // null([u32]) may be the only mention of the array type; its
      // typedef and tostring helper must exist.
      builder.ensureArrayDeclared(self.location, dummyType.array.elementType!)
    }
    if builder.typechecker.isStringType(dummyType) {
      // null(string) is the empty string; a null char* would print as
      // "(null)" through printf.
      return builder.cStringLiteral("")
    }
    dummyZero = Bigint(0u64)
    zeroExpr = builder.cIntLiteral(dummyZero)
    dummyWide = builder.wideWidth(self.typedValue)
    if dummyWide > 0u32 {
      // A wide null must be a real zero limb array, not a null pointer:
      // printing or arithmetic dereferences it.
      return builder.cWideFromU64(self.location, zeroExpr, dummyWide,
          builder.wideSigned(self.typedValue))
    }
    dummyCType = builder.genCType(dummyType)
    if isnull(dummyCType) {
      return zeroExpr
    }
    return c.CExpr(c.CCastExpr(self.location, dummyCType!, zeroExpr))
  }

  // widthof(e) is a compile-time constant: the bit width of e's type.
  func genCWidthof(self, builder: c.CBuilder) -> c.CExpr {
    widthChild = self.firstChildExpr!
    widthType = builder.typechecker.resolve(widthChild.typedValue!)
    widthValue = Bigint(<u64>widthType.width())
    return builder.cIntLiteral(widthValue)
  }

  // unsigned(x)/signed(x) reinterpret x with flipped signedness.
  func genCSignConversion(self, builder: c.CBuilder) -> c.CExpr {
    signChild = self.firstChildExpr!
    signTarget = builder.typechecker.resolve(self.typedValue!)
    signW = builder.wideWidth(self.typedValue)
    if signW > 0u32 {
      // Wide values change signedness through wide_cast so the header's
      // sign flag updates.
      signArgs = c.CExprList()
      signArgs.appendCExpr(signChild.genC(builder))
      signArgs.appendCExpr(c.CExpr(c.CLiteral(Bigint(<u64>signW), false)))
      signArgs.appendCExpr(c.CExpr(c.CLiteral(
          Bigint(builder.wideSigned(self.typedValue) ? 1u64 : 0u64), false)))
      signArgs.appendCExpr(c.CExpr(c.CLiteral(Bigint(1u64), false)))
      return builder.cWideCall(self.location, "wide_cast", signArgs)
    }
    signCType = builder.genCType(signTarget)
    if isnull(signCType) {
      raise Status.Unimplemented, "unsigned()/signed() target type not supported by C backend"
    }
    return c.CExpr(c.CCastExpr(self.location, signCType!, signChild.genC(builder)))
  }

  func genCCast(self, builder: c.CBuilder) -> c.CExpr {
    typeChild = self.firstChildExpr!
    valueChild = typeChild.nextExprChildExpr!
    v = valueChild.genC(builder)
    target = builder.typechecker.resolve(self.typedValue!)
    if (argTypeUnderResolved(builder, target) ||
        builder.typechecker.containsAdaptableType(target) ||
        target.type == types.Type.TypeClass.Polymorphic) {
      // The cast's slot holds one round's binding (or the callee's
      // whole poly): <t>0 with t = typeof(distancefunc(array[0])) —
      // recover the target from the TYPE child's declaration chain.
      tgtRec = typeChild.resolvedArgType(builder)
      if (!builder.typechecker.hasFreeVars(tgtRec) &&
          tgtRec.type != types.Type.TypeClass.Polymorphic) {
        target = tgtRec
      }
    }
    // Casting a string to string is the identity; strings are char buffers.
    if (builder.typechecker.isStringType(self.typedValue) &&
        builder.typechecker.isStringType(valueChild.typedValue)) {
      return v
    }
    // A tuple-typed cast (<arow>x, a typeof-cast) is the identity at the
    // C level: struct casts are invalid C, and the value already has the
    // target's layout when the Rune types unified.
    if target.type == types.Type.TypeClass.Tuple {
      return v
    }
    wTo = builder.wideWidth(self.typedValue)
    if wTo == 0u32 {
      // The slot renders adaptable AnyInt as 64-bit; the recovered
      // target above knows the true width (<typeof(avec[0])>1 in a u65
      // spec must build a wide value, not C-cast to rn_wide_t).
      wTo = builder.wideWidth(target)
    }
    wFrom = builder.wideWidth(valueChild.typedValue)
    if wFrom == 0u32 && valueChild.emittedWide(builder) {
      wFrom = wTo
    }
    if wTo > 0u32 || wFrom > 0u32 {
      isTruncCast = self.type == ExprType.CastTrunc
      if wTo > 0u32 && wFrom > 0u32 {
        castArgs = c.CExprList()
        castArgs.appendCExpr(v)
        castArgs.appendCExpr(c.CExpr(c.CLiteral(Bigint(<u64>wTo), false)))
        castArgs.appendCExpr(c.CExpr(c.CLiteral(
            Bigint(builder.wideSigned(self.typedValue) ? 1u64 : 0u64), false)))
        castArgs.appendCExpr(c.CExpr(c.CLiteral(
            Bigint(isTruncCast ? 1u64 : 0u64), false)))
        return builder.cWideCall(self.location, "wide_cast", castArgs)
      }
      if wTo > 0u32 {
        // A 64-bit-or-narrower value widening: extend by the source's sign,
        // then adopt the target signedness.
        srcSigned = false
        srcTy = builder.typechecker.resolve(valueChild.typedValue!)
        if srcTy.type == types.Type.TypeClass.Int {
          srcSigned = srcTy.int.isSigned
        } else if srcTy.type == types.Type.TypeClass.AnyInt {
          srcSigned = srcTy.anyInt.isSigned
        }
        widened = builder.cWideFromU64(self.location, v, wTo, srcSigned)
        adoptArgs = c.CExprList()
        adoptArgs.appendCExpr(widened)
        adoptArgs.appendCExpr(c.CExpr(c.CLiteral(Bigint(<u64>wTo), false)))
        adoptArgs.appendCExpr(c.CExpr(c.CLiteral(
            Bigint(builder.wideSigned(self.typedValue) ? 1u64 : 0u64), false)))
        adoptArgs.appendCExpr(c.CExpr(c.CLiteral(Bigint(1u64), false)))
        return builder.cWideCall(self.location, "wide_cast", adoptArgs)
      }
      // Wide to 64 bits or narrower.
      narrowArgs = c.CExprList()
      narrowArgs.appendCExpr(v)
      narrowed = builder.cWideCall(self.location, "wide_to_u64", narrowArgs)
      cty = builder.genCType(target)
      casted = c.CExpr(c.CCastExpr(self.location, cty!, narrowed))
      return self.maskToWidth(builder, casted, target)
    }
    // genCType() caches an array's C spelling but does not emit its typedef.
    // A cast may be the first and only array use, as in
    // <[u8]>readBytes(n), so request the declaration explicitly.
    if target.type == types.Type.TypeClass.Array {
      builder.ensureArrayDeclared(self.location, target.array.elementType!)
    }
    ctype = builder.genCType(target)
    if isnull(ctype) {
      raise Status.Unimplemented, "Cast target type not supported by C backend"
    }
    if (builder.isClassType(valueChild.typedValue) &&
        (target.type == types.Type.TypeClass.Int ||
         target.type == types.Type.TypeClass.AnyInt)) {
      // Casting an object reference to an integer yields its 1-based id.
      idSel = c.CExpr(c.CDotExpr(self.location, v, "rn_id", true))
      return c.CExpr(c.CCastExpr(self.location, ctype!, idSel))
    }
    // Casting TO a class type that defines a `<>` conversion operator invokes
    // that operator (e.g. <Foo>1 builds Foo(1)); a plain C pointer cast would
    // reinterpret the integer as a Foo* and crash.
    if builder.isClassType(self.typedValue) &&
        !builder.isClassType(valueChild.typedValue) {
      castOp = self.genCCastOperator(builder, target, valueChild, v, ctype!)
      if !isnull(castOp) {
        return castOp!
      }
    }
    return c.CExpr(c.CCastExpr(self.location, ctype!, v))
  }

  // Emit a call to a user-defined `<>` cast operator for `<Class>value`.  The
  // operator is `operator <>(self: Class, other)`; a cast has no self instance,
  // so a null Class pointer is passed (the operator body uses only `other`).
  // The operator is not dispatched at typecheck, so its instantiation is
  // synthesized here.  Returns null if no matching `<>` operator exists.
  func genCCastOperator(self, builder: c.CBuilder, target: types.Type,
                        valueChild: Expr, v: c.CExpr, ctype: c.CTypeExpr) -> c.CExpr? {
    tc = builder.typechecker
    vtype = tc.resolve(valueChild.typedValue!)
    for i in range(tc.operatorFns.length()) {
      opfn = tc.operatorFns[i]
      if opfn.opType == ExprType.Cast {
        opty = tc.operatorTypes[i]
        callName = ""
        argPair = types.Type(types.TupleType([target, vtype]))
        if opty.type == types.Type.TypeClass.Polymorphic {
          for inst in opty.poly.instantiations {
            if callName == "" {
              builder.instantiate(opty.poly!, inst)
              cptypes = arrayof(types.Type)
              for variable in opfn.variables() {
                cptypes.append(tc.resolve(variable.typedValue!))
              }
              cFree = false
              for pt in cptypes {
                if tc.hasFreeVars(pt) {
                  cFree = true
                }
              }
              ciname = types.Type(types.TupleType(cptypes)).genSpecializationName(opfn.sym.name)
              builder.deInstantiate(opty.poly!)
              if (cptypes.length() == 2 && !cFree &&
                  typeArgCompatible(target, cptypes[0]) &&
                  typeArgCompatible(vtype, cptypes[1])) {
                if !builder.alreadyEmitted(ciname) {
                  opfn.genCPolyInstantiation(builder, inst)
                }
                callName = ciname
              }
            }
          }
          if callName == "" {
            // Synthesize: open the operator poly, unify its parameters with
            // (target class, value type), and emit.
            openedOp = opty.poly!.open(tc.unifier, &tc.unifier.newVar())
            if openedOp.type == types.Type.TypeClass.Function {
              cTe = tc.unify(openedOp.function.params!, argPair)
              if isnull(cTe) {
                synInst = opty.poly.instantiations.lastTyvarInstantiation
                if !isnull(synInst) {
                  builder.resolveInstantiation(synInst!)
                  if builder.instantiationIsConcrete(synInst!) {
                    builder.instantiate(opty.poly!, synInst!)
                    synCp = arrayof(types.Type)
                    for variable in opfn.variables() {
                      synCp.append(tc.resolve(variable.typedValue!))
                    }
                    synName = types.Type(types.TupleType(synCp)).genSpecializationName(opfn.sym.name)
                    builder.deInstantiate(opty.poly!)
                    if !builder.alreadyEmitted(synName) {
                      opfn.genCPolyInstantiation(builder, synInst!)
                    }
                    callName = synName
                  }
                }
              }
            }
          }
        } else if opty.type == types.Type.TypeClass.Function {
          mtypes = arrayof(types.Type)
          for variable in opfn.variables() {
            mtypes.append(tc.resolve(variable.typedValue!))
          }
          if (mtypes.length() == 2 &&
              typeArgCompatible(target, mtypes[0]) &&
              typeArgCompatible(vtype, mtypes[1])) {
            callName = opfn.sym.name
          }
        }
        if callName != "" {
          dummySelf = c.CExpr(c.CCastExpr(self.location, ctype,
              c.CExpr(c.CLiteral(Bigint(0u64), false))))
          castArgs = c.CExprList()
          castArgs.appendCExpr(dummySelf)
          castArgs.appendCExpr(v)
          return builder.cCall(self.location, callName, c.CExpr(castArgs))
        }
      }
    }
    return null(c.CExpr)
  }

  // A value cast to an unsigned integer whose bit width is narrower than its C
  // storage type (e.g. u3 lives in a uint8_t) must drop the bits above the
  // width so the result equals the source taken mod 2**width. Standard widths
  // (8/16/32/64) need no masking — the C type already truncates.
  func maskToWidth(self, builder: c.CBuilder, expr: c.CExpr, target: types.Type) -> c.CExpr {
    if target.type != types.Type.TypeClass.Int {
      return expr
    }
    if target.int.isSigned {
      return expr
    }
    w = target.int.width
    if w >= 64u32 || w == 8u32 || w == 16u32 || w == 32u32 {
      return expr
    }
    mask = (1u64 << <u64>w) - 1u64
    return c.CExpr(c.CBinaryOperator(self.location, c.CBinaryOperator.Type.BitAnd,
        null(c.CTypeExpr), expr, c.CExpr(c.CLiteral(Bigint(mask), false))))
  }

  func genCSelect(self, builder: c.CBuilder) -> c.CExpr {
    condChild = self.firstChildExpr!
    trueChild = condChild.nextExprChildExpr!
    falseChild = trueChild.nextExprChildExpr!
    return c.CExpr(c.CSelectExpr(self.location, condChild.genC(builder),
                                 trueChild.genC(builder), falseChild.genC(builder)))
  }

  func genCPrefixOp(self, builder: c.CBuilder) -> c.CExpr {
    parent = self.parentExpr
    left = self.firstChildExpr!

    if builder.wideWidth(left.typedValue) > 0u32 {
      wideFn = ""
      switch self.type {
        ExprType.Negate => wideFn = "wide_neg"
        ExprType.NegateTrunc => wideFn = "wide_negtrunc"
        ExprType.Bitnot => wideFn = "wide_not"
        default => wideFn = ""
      }
      if wideFn != "" {
        wideArgs = c.CExprList()
        wideArgs.appendCExpr(left.genC(builder))
        return builder.cWideCall(self.location, wideFn, wideArgs)
      }
    }
    switch self.type {
      ExprType.Negate, ExprType.NegateTrunc => {
        // C unary minus on unsigned types already truncates (wraps).
        return builder.cUnaryMinus(self.location, left.genC(builder))
      }
      ExprType.Bitnot => {
        return builder.cUnaryBitnot(self.location, left.genC(builder))
      }
      ExprType.Not => {
        return builder.cUnaryNot(self.location, left.genC(builder))
      }

      default => raise Status.Unimplemented, "Unary expression operator not yet supported by C backend: ", getExprTypeName(self.type)
    }
  }

  func genCBinaryOp(self, builder: c.CBuilder) -> c.CExpr {
    parent = self.parentExpr
    left = self.firstChildExpr!
    right = left.nextExprChildExpr!

    if self.type == ExprType.Mod && builder.typechecker.isStringType(left.typedValue) {
      // "fmt" % args is sprintf-like formatting, not arithmetic.
      return self.genCStringFormat(builder, left, right)
    }

    if self.type == ExprType.Equals {
      self.bindingInstance = true
      // Mark the assignment target so the backend knows this mention is a
      // write (a local declaration when inside a function), not a read.
      left.bindingInstance = true
      // An assignment target that lost its type (deferral retypecheck
      // does not re-type plain assignment LHS idents) takes the value's
      // type; the interned-sym fallback may belong to another function's
      // same-named local.
      if left.type == ExprType.Ident && isnull(left.typedValue) {
        if !isnull(right.typedValue) {
          left.typedValue = right.typedValue
        }
      }
      if left.type == ExprType.Ident && !isnull(left.typedValue) {
        // A local holding a FUNCTION VALUE types as the callee's whole
        // poly (no C type); an under-resolved local (funcptr's total,
        // typed <t>0 through a typeof chain) declares nothing.  The
        // RHS's recovery yields the concrete type.
        eqL = builder.typechecker.resolve(left.typedValue!)
        eqLAdaptTuple = builder.typechecker.containsAdaptableType(eqL)
        if (eqL.type == types.Type.TypeClass.Polymorphic ||
            (argTypeUnderResolved(builder, eqL) &&
             (right.type == ExprType.Cast ||
              right.type == ExprType.CastTrunc)) ||
            eqLAdaptTuple) {
          eqRec = right.resolvedArgType(builder)
          if (!builder.typechecker.hasFreeVars(eqRec) &&
              eqRec.type != types.Type.TypeClass.Polymorphic) {
            left.typedValue = eqRec
          }
        }
      }
    }
    if self.type == ExprType.Lt {
    }
    if self.type != ExprType.Equals {
      // Recover under-resolved (or cleared) operand types -- a relation
      // method's bare-knot parameters -- so width computation and
      // user-operator dispatch see the concrete class instance.
      lNeedsRec = isnull(left.typedValue)
      if !lNeedsRec {
        lNeedsRec = argTypeUnderResolved(builder, left.typedValue!)
      }

      if lNeedsRec {
        lRec = left.resolvedArgType(builder)
        if !argTypeUnderResolved(builder, lRec) {
          left.typedValue = lRec
        }
      }
      rNeedsRec = isnull(right.typedValue)
      if !rNeedsRec {
        rNeedsRec = argTypeUnderResolved(builder, right.typedValue!)
      }

      if rNeedsRec {
        rRec = right.resolvedArgType(builder)
        if !argTypeUnderResolved(builder, rRec) {
          right.typedValue = rRec
        }
      }
    }
    rPre = null(c.CExpr)
    if self.type == ExprType.Equals && (right.type == ExprType.Funcaddr ||
        right.type == ExprType.Cast || right.type == ExprType.CastTrunc) {
      // Generate the RHS FIRST: a funcaddr emits (and records) the
      // referenced specialization, and the LHS's declaration recovery
      // reads that record (funcptr's distancefunc local).
      rPre = right.genC(builder)
      if left.type == ExprType.Ident && !isnull(left.typedValue) {
        eqL2 = builder.typechecker.resolve(left.typedValue!)
        if (eqL2.type == types.Type.TypeClass.Polymorphic ||
            argTypeUnderResolved(builder, eqL2) ||
            builder.typechecker.containsAdaptableType(eqL2)) {
          eqRec2 = right.resolvedArgType(builder)
          if (!builder.typechecker.hasFreeVars(eqRec2) &&
              eqRec2.type != types.Type.TypeClass.Polymorphic) {
            left.typedValue = eqRec2
          }
        }
      }
    }
    l = left.genC(builder)
    self.bindingInstance = false
    if isnull(rPre) {
      r = right.genC(builder)
    } else {
      r = rPre!
    }

    // A class-typed operand dispatches to a user operator BEFORE wide
    // arithmetic: `scalar * Point` with a u255 scalar is Point's
    // operator *, not wide_mul (the u64 edwards test masked this
    // ordering; only the wide variant exposed it).
    if (self.type != ExprType.Equals &&
        (builder.isClassType(left.typedValue) || builder.isClassType(right.typedValue))) {
      uop = self.genCUserOperator(builder, l, r, left, right)
      if !isnull(uop) {
        return uop!
      }
    }

    wideW = builder.wideWidth(left.typedValue)
    if wideW == 0u32 {
      wideW = builder.wideWidth(right.typedValue)
    }
    if wideW == 0u32 && self.type != ExprType.Equals {
      // An ADAPTABLE slot renders 64-bit and hides a wide operand; probe
      // the live recovery WITHOUT overwriting the shared node (a
      // destructive recovery baked one spec's u65 into every spec).
      wpSoft = isnull(left.typedValue)
      if !wpSoft {
        wpSoft = builder.typechecker.containsAdaptableType(
            builder.typechecker.resolve(left.typedValue!))
      }
      if wpSoft {
        wideW = builder.wideWidth(left.resolvedArgType(builder))
      }
      if wideW == 0u32 {
        wpSoft = isnull(right.typedValue)
        if !wpSoft {
          wpSoft = builder.typechecker.containsAdaptableType(
              builder.typechecker.resolve(right.typedValue!))
        }
        if wpSoft {
          wideW = builder.wideWidth(right.resolvedArgType(builder))
        }
      }
    }
    if wideW > 0u32 && self.type != ExprType.Equals {
      return self.genCWideBinaryOp(builder, l, r, left, right, wideW)
    }

    // String ordering comparisons are lexicographic, not the char* pointer
    // comparison C's <, <=, > and >= would give (== and != already route
    // through isequal_string_t).  Emit strcmp(l, r) <op> 0.
    isStrOrder = false
    if builder.typechecker.isStringType(left.typedValue) {
      if self.type == ExprType.Lt {
        isStrOrder = true
      }
      if self.type == ExprType.Le {
        isStrOrder = true
      }
      if self.type == ExprType.Gt {
        isStrOrder = true
      }
      if self.type == ExprType.Ge {
        isStrOrder = true
      }
    }
    if isStrOrder {
      switch self.type {
        ExprType.Lt => strCmpOp = c.CBinaryOperator.Type.LessThan
        ExprType.Le => strCmpOp = c.CBinaryOperator.Type.LessThanEqual
        ExprType.Gt => strCmpOp = c.CBinaryOperator.Type.GreaterThan
        default => strCmpOp = c.CBinaryOperator.Type.GreaterThanEqual
      }
      strCmpArgs = c.CExprList()
      strCmpArgs.appendCExpr(l)
      strCmpArgs.appendCExpr(r)
      strCmpCall = builder.cCall(self.location, "strcmp", c.CExpr(strCmpArgs))
      // strcmp returns a signed int; compare against a signed 0 so a negative
      // result is not converted to a large unsigned value (0i32 emits "0").
      return c.CExpr(c.CBinaryOperator(self.location, strCmpOp,
          null(c.CTypeExpr), strCmpCall, c.CExpr(c.CLiteral(Bigint(0i32), false))))
    }
    if (self.type == ExprType.Equals && right.type == ExprType.Constant &&
        right.val.type == DatatypeType.String) {
      // Copy string literals on assignment so writes through the variable
      // (s[0] = c, s.append(...)) do not mutate the static literal.
      dupArgs = c.CExprList()
      dupArgs.appendCExpr(r)
      r = builder.cCall(self.location, c.CRuntimeFunction.StringDup, c.CExpr(dupArgs))
    }
    // Arrays have value semantics: assigning an array-typed variable, field or
    // element (q = p) must copy the buffer so the two names do not alias.  A
    // fresh temporary (call/slice/concat/literal) needs no copy, so restrict
    // this to aliasing-prone lvalue reads (Ident / Dot / Index).
    if (self.type == ExprType.Equals && !isnull(right.typedValue) &&
        (right.type == ExprType.Ident || right.type == ExprType.Dot ||
         right.type == ExprType.Index) &&
        builder.typechecker.resolve(right.typedValue!).type ==
            types.Type.TypeClass.Array) {
      arrDupArgs = c.CExprList()
      arrDupArgs.appendCExpr(r)
      r = builder.cCall(self.location, c.CRuntimeFunction.ArrayDup, c.CExpr(arrDupArgs))
    }

    // An unsuffixed integer literal keeps its adaptable AnyInt type even
    // after unifying with a concrete SIGNED operand (unifyAnyInt accepts
    // an unsigned AnyInt against a signed Int without narrowing), so it
    // emits as `0ul` and a signed comparison like `localb < 0` runs
    // UNSIGNED in C -- flipping the branch (gf2PowMod's negative-exponent
    // guard never fired, looping forever).  Cast the literal to the
    // concrete sibling's C type so the comparison keeps its signedness.
    // (The strcmp path above uses the same signed-0 trick.)
    if (self.type == ExprType.Lt || self.type == ExprType.Le ||
        self.type == ExprType.Gt || self.type == ExprType.Ge ||
        self.type == ExprType.Equal || self.type == ExprType.Notequal) {
      if right.type == ExprType.Constant && !isnull(left.typedValue) &&
          !isnull(right.typedValue) {
        cmpLTy = builder.typechecker.resolve(left.typedValue!)
        if (cmpLTy.type == types.Type.TypeClass.Int &&
            builder.typechecker.containsAdaptableType(
                builder.typechecker.resolve(right.typedValue!)) &&
            builder.wideWidth(left.typedValue) == 0u32) {
          r = c.CExpr(c.CCastExpr(self.location, builder.genCType(cmpLTy)!, r))
        }
      }
      if left.type == ExprType.Constant && !isnull(right.typedValue) &&
          !isnull(left.typedValue) {
        cmpRTy = builder.typechecker.resolve(right.typedValue!)
        if (cmpRTy.type == types.Type.TypeClass.Int &&
            builder.typechecker.containsAdaptableType(
                builder.typechecker.resolve(left.typedValue!)) &&
            builder.wideWidth(right.typedValue) == 0u32) {
          l = c.CExpr(c.CCastExpr(self.location, builder.genCType(cmpRTy)!, l))
        }
      }
    }

    // First, generate C Binary Operators for those operators that map
    // directly to C operators.
    switch self.type {
      ExprType.AddTrunc => op = c.CBinaryOperator.Type.Plus
      ExprType.SubTrunc => op = c.CBinaryOperator.Type.Minus
      ExprType.MulTrunc => op = c.CBinaryOperator.Type.Times
      ExprType.Mod => {
        // C's % is integer-only; floats use fmod() from math.h.
        isFloatMod = false
        if !isnull(left.typedValue) {
          modTy = builder.typechecker.resolve(left.typedValue!)
          isFloatMod = modTy.type == types.Type.TypeClass.Float
        }
        if isFloatMod {
          list = c.CExprList()
          list.appendCExpr(l)
          list.appendCExpr(r)
          return builder.cCall(self.location, c.CRuntimeFunction.FloatModulus, c.CExpr(list))
        }
        op = c.CBinaryOperator.Type.Modulus
      }
      ExprType.And => op = c.CBinaryOperator.Type.LogAnd
      ExprType.Or =>  op = c.CBinaryOperator.Type.LogOr
      // Boolean xor: C has no ^^; != on bools is equivalent.
      ExprType.Xor => op = c.CBinaryOperator.Type.NotEquals
      ExprType.Bitand => op = c.CBinaryOperator.Type.BitAnd
      ExprType.Bitor => op = c.CBinaryOperator.Type.BitOr
      ExprType.Bitxor => {
        if builder.typechecker.isStringType(left.typedValue) {
          // Strings XOR byte-wise via a runtime helper.
          list = c.CExprList()
          list.appendCExpr(l)
          list.appendCExpr(r)
          return builder.cCall(self.location, c.CRuntimeFunction.StringXor, c.CExpr(list))
        }
        op = c.CBinaryOperator.Type.BitXor
      }
      ExprType.Shl => op = c.CBinaryOperator.Type.ShiftLeft
      ExprType.Shr => op = c.CBinaryOperator.Type.ShiftRight
      ExprType.Lt => op = c.CBinaryOperator.Type.LessThan
      ExprType.Le => op = c.CBinaryOperator.Type.LessThanEqual
      ExprType.Gt => op = c.CBinaryOperator.Type.GreaterThan
      ExprType.Ge => op = c.CBinaryOperator.Type.GreaterThanEqual
      ExprType.Equal => op = c.CBinaryOperator.Type.Equals
      ExprType.Notequal => op = c.CBinaryOperator.Type.NotEquals
      ExprType.Equals => op = c.CBinaryOperator.Type.Assign

      default => {
        // Float arithmetic maps to plain C operators; there is no overflow
        // detection for floating point.
        isFloat = false
        if !isnull(left.typedValue) {
          lty = builder.typechecker.resolve(left.typedValue!)
          isFloat = lty.type == types.Type.TypeClass.Float
        }
        if isFloat {
          switch self.type {
            ExprType.Add => fop = c.CBinaryOperator.Type.Plus
            ExprType.Sub => fop = c.CBinaryOperator.Type.Minus
            ExprType.Mul => fop = c.CBinaryOperator.Type.Times
            ExprType.Div => fop = c.CBinaryOperator.Type.Divides
            default => raise Status.Unimplemented, "Float operator not yet supported by C backend: ", getExprTypeName(self.type)
          }
          return builder.cBinaryOperator(self.location, fop, left.typedValue, l, r)
        }
        switch self.type {
          ExprType.Add => {
            if left.typedValue == types.STRING() {
              // s1 + s2 concatenates into a fresh heap string.
              catArgs = c.CExprList()
              catArgs.appendCExpr(builder.cStringLiteral("%s%s", printf=true))
              catArgs.appendCExpr(l)
              catArgs.appendCExpr(r)
              return builder.cCall(self.location, c.CRuntimeFunction.StringSprintf,
                  c.CExpr(catArgs))
            } else if left.typedValue.type == types.Type.TypeClass.Array {
              fn = c.CRuntimeFunction.ArrayConcat
            } else {
              fn = c.CRuntimeFunction.AddWithOverflowDetect
            }
          }
          ExprType.Mul => fn = c.CRuntimeFunction.MulWithOverflowDetect
          ExprType.Sub => fn = c.CRuntimeFunction.SubWithOverflowDetect
          ExprType.Div => fn = c.CRuntimeFunction.DivWithOverflowDetect
          ExprType.Exp => fn = c.CRuntimeFunction.Exponentiate
          ExprType.Rotl => fn = c.CRuntimeFunction.RotateLeft
          ExprType.Rotr => fn = c.CRuntimeFunction.RotateRight
          default => {
            self.location.error("Binary expression operator not yet supported by C backend: " + getExprTypeName(self.type))
            raise Status.Unimplemented, "Binary expression operator not yet supported by C backend: ", getExprTypeName(self.type)
          }
        }
        // Unsafe mode: for fixed-width integer add/sub/mul, emit plain C
        // arithmetic instead of the overflow-checked intadd/intsub/intmul (and
        // unsigned) helpers whose guards cost an integer divide per multiply.
        // Wide (>64-bit) operands already returned via genCWideBinaryOp above,
        // and string/array Add, Div, Exp and the rotates keep their helpers, so
        // this only affects the fixed-width checked arithmetic.
        if getRoot().unsafeMode {
          unsafeCOp = c.CBinaryOperator.Type.Plus
          isCheckedArith = false
          if fn == c.CRuntimeFunction.AddWithOverflowDetect {
            unsafeCOp = c.CBinaryOperator.Type.Plus
            isCheckedArith = true
          } else if fn == c.CRuntimeFunction.SubWithOverflowDetect {
            unsafeCOp = c.CBinaryOperator.Type.Minus
            isCheckedArith = true
          } else if fn == c.CRuntimeFunction.MulWithOverflowDetect {
            unsafeCOp = c.CBinaryOperator.Type.Times
            isCheckedArith = true
          }
          if isCheckedArith {
            return builder.cBinaryOperator(self.location, unsafeCOp, self.typedValue, l, r)
          }
        }
        // Can Rune do arbitrary length calls?
        list = c.CExprList()
        list.appendCExpr(l)
        list.appendCExpr(r)
        // The expression's own type carries the width; the operand
        // CExprs (e.g. field accesses) may not know theirs.
        return builder.cCall(self.location, fn, c.CExpr(list), self.typedValue)
      }
    }
    return builder.cBinaryOperator(self.location, op, left.typedValue, l, r)
  }

  // True if |e| is a recursive call to the wide-resulted function instance
  // currently being emitted (its snapshot type may be stale).
  func exprIsRecursiveWideCall(self, builder: c.CBuilder, e: Expr) -> bool {
    if e.type != ExprType.Call {
      return false
    }
    if isnull(builder.currentEmittingFn) {
      return false
    }
    target = e.firstChildExpr
    if isnull(target) {
      return false
    }
    if target.type != ExprType.Ident {
      return false
    }
    callee = builder.findFunction(target.val.symVal.name)
    if isnull(callee) {
      return false
    }
    if callee! != builder.currentEmittingFn! {
      return false
    }
    return builder.currentEmittingResultWide > 0u32
  }

  // Binary operators on integers wider than 64 bits map to wide_* runtime
  // helpers.  Shift and exponent right-hand sides stay 64-bit scalars.
  func genCWideBinaryOp(self, builder: c.CBuilder, l: c.CExpr, r: c.CExpr,
                        left: Expr, right: Expr, wideW: u32) -> c.CExpr {
    scalarRhs = (self.type == ExprType.Shl || self.type == ExprType.Shr ||
        self.type == ExprType.Rotl || self.type == ExprType.Rotr ||
        self.type == ExprType.Exp)
    wl = l
    wr = r
    leftWideAnyway = self.exprIsRecursiveWideCall(builder, left)
    rightWideAnyway = self.exprIsRecursiveWideCall(builder, right)
    // Whether each operand's emitted value is already wide is decided by the
    // same subtree scan its own genC uses, not by the node's resolved type:
    // in a generic body a wide operand's type can resolve to a scalar
    // default, and re-wrapping the wide value as a scalar is a type error.
    if !left.emittedWide(builder) && !leftWideAnyway {
      wl = builder.cWideFromU64(self.location, l, wideW,
          builder.wideSigned(right.typedValue))
    }
    if scalarRhs {
      if right.emittedWide(builder) {
        toArgs = c.CExprList()
        toArgs.appendCExpr(r)
        wr = builder.cWideCall(self.location, "wide_to_u64", toArgs)
      }
    } else if !right.emittedWide(builder) && !rightWideAnyway {
      wr = builder.cWideFromU64(self.location, r, wideW,
          builder.wideSigned(left.typedValue))
    }
    args = c.CExprList()
    args.appendCExpr(wl)
    args.appendCExpr(wr)
    extraFlag = -1i32
    cmpOp = c.CBinaryOperator.Type.LessThan
    isCmp = false
    switch self.type {
      ExprType.Add => wideName = "wide_add"
      ExprType.Sub => wideName = "wide_sub"
      ExprType.AddTrunc => wideName = "wide_addtrunc"
      ExprType.SubTrunc => wideName = "wide_subtrunc"
      ExprType.Mul => {
        wideName = "wide_mul"
        extraFlag = 0i32
      }
      ExprType.MulTrunc => {
        wideName = "wide_mul"
        extraFlag = 1i32
      }
      ExprType.Div => wideName = "wide_div"
      ExprType.Mod => wideName = "wide_rem"
      ExprType.Exp => wideName = "wide_exp"
      ExprType.Shl => wideName = "wide_shl"
      ExprType.Shr => wideName = "wide_shr"
      ExprType.Rotl => wideName = "wide_rotl"
      ExprType.Rotr => wideName = "wide_rotr"
      ExprType.Bitand => {
        wideName = "wide_bitop"
        extraFlag = 0i32
      }
      ExprType.Bitor => {
        wideName = "wide_bitop"
        extraFlag = 1i32
      }
      ExprType.Bitxor => {
        wideName = "wide_bitop"
        extraFlag = 2i32
      }
      ExprType.Equal => {
        return builder.cWideCall(self.location, "wide_eq", args)
      }
      ExprType.Notequal => {
        eqCall = builder.cWideCall(self.location, "wide_eq", args)
        return c.CExpr(c.CPrefixOperator(self.location,
            c.CPrefixOperator.Type.LogNot, eqCall))
      }
      ExprType.Lt, ExprType.Le, ExprType.Gt, ExprType.Ge => {
        isCmp = true
        wideName = "wide_cmp"
        switch self.type {
          ExprType.Lt => cmpOp = c.CBinaryOperator.Type.LessThan
          ExprType.Le => cmpOp = c.CBinaryOperator.Type.LessThanEqual
          ExprType.Gt => cmpOp = c.CBinaryOperator.Type.GreaterThan
          default => cmpOp = c.CBinaryOperator.Type.GreaterThanEqual
        }
      }
      default => raise Status.Unimplemented, "Wide integer operator not supported: ", getExprTypeName(self.type)
    }
    if extraFlag >= 0i32 {
      args.appendCExpr(c.CExpr(c.CLiteral(Bigint(<u64>extraFlag), false)))
    }
    wideCall = builder.cWideCall(self.location, wideName, args)
    if isCmp {
      // wide_cmp returns a signed int; compare against a signed 0 so a
      // negative result is not converted to a large unsigned value, which
      // would make `>= 0` always true and `< 0` always false (0i32 emits "0").
      zeroLit = c.CExpr(c.CLiteral(Bigint(0i32), false))
      return c.CExpr(c.CBinaryOperator(self.location, cmpOp,
          null(c.CTypeExpr), wideCall, zeroLit))
    }
    return wideCall
  }

  func genCArrayOf(self, builder: c.CBuilder) -> c.CExpr {
    left = self.firstChildExpr!
    elements = arrayof(c.CExpr)
    return builder.cArray(self.location, left.typedValue!, elements)
  }

  func genCArray(self, builder: c.CBuilder) -> c.CExpr {
    left = self.firstChildExpr!
    elements = arrayof(c.CExpr)
    for child in self.childExprs() {
      elements.append(child.genC(builder))
    }
    // The element C type comes from the FIRST element's slot; an
    // adaptable AnyInt rendering (a spec's round left it u64) would build
    // a uint64 array holding narrower values.  Recover the concrete
    // per-spec element type ([a0,a1,a2] of u17 in gf2ModVect's u17 spec).
    elemTy = left.typedValue!
    if builder.typechecker.containsAdaptableType(
        builder.typechecker.resolve(elemTy)) {
      elemRec = left.resolvedArgType(builder)
      if (!builder.typechecker.hasFreeVars(elemRec) &&
          !builder.typechecker.containsAdaptableType(elemRec)) {
        elemTy = elemRec
      }
    }
    return builder.cArray(self.location, elemTy, elements)
  }

  func genCTuple(self, builder: c.CBuilder) -> c.CExpr {
    elements = c.CExprList()
    for child in self.childExprs() {
      cexpr = child.genC(builder)
      elements.appendCExpr(child.genC(builder))
    }
    // Tuple types should not be null (if they are, they contain an expression not yet
    // supported by the typechecker, and therefore not the c backend either).
    // self.typedValue should have been set by the typechecker before C generation
    // begins.
    tupTy = self.typedValue
    if !isnull(tupTy) {
      tupRes = builder.typechecker.resolve(tupTy!)
      if builder.typechecker.containsAdaptableType(tupRes) {
        // The slot is one walk round's AnyInt rendering; the live element
        // recovery names the concrete per-spec tuple (gf2ModVect's
        // return (a0,a1,a2) in the u32 spec).
        tupEls = arrayof(types.Type)
        tupOk = true
        for tupChild in self.childExprs() {
          tupR = tupChild.resolvedArgType(builder)
          if (builder.typechecker.hasFreeVars(tupR) ||
              builder.typechecker.containsAdaptableType(tupR)) {
            tupOk = false
          }
          tupEls.append(tupR)
        }
        if tupOk && tupEls.length() > 0u64 {
          tupTy = types.Type(types.TupleType(tupEls))
        }
      }
    }
    return builder.cTuple(self.location, tupTy, elements)
  }

  // The type of this expression as a call argument, re-derived under the
  // active instantiation rather than read from the node's frozen
  // typedValue.  A deferred function's body is retypechecked exactly once
  // (under its first concrete instantiation), so every body node's
  // typedValue is stuck at that instantiation -- but the *parameter
  // variable* is rebound by `instantiate` at each emission, so resolving a
  // parameter reference through the emitting function's live variable, and
  // an index through its re-derived indexee, yields the correct
  // per-instantiation argument type (e.g. depth(x[0]) shrinking ((),) to ()).
  // |scopeBlock| roots the local-declaration chase when no function is
  // being emitted (module-level statements, e.g. an inlined iterator in
  // the top-level code).
  func resolvedArgType(self, builder: c.CBuilder, depth: u32 = 0u32,
      scopeBlock: Block? = null(Block)) -> types.Type {
    if self.type == ExprType.Ident && !isnull(builder.currentEmittingFn) {
      raIdx = 0u64
      for v in builder.currentEmittingFn.variables() {
        if v.isParam && v.sym.name == self.val.symVal.name && !isnull(v.typedValue) {
          // The spec being emitted publishes its GROUND param tuple; the
          // variable's own slot holds one spec's snapshot and lies for
          // every other specialization of the same body.
          if !isnull(builder.currentEmittingParamFn) && !isnull(builder.currentEmittingParamTuple) {
            if builder.currentEmittingParamFn! == builder.currentEmittingFn! {
              rapTuple = builder.currentEmittingParamTuple!
              if rapTuple.type == types.Type.TypeClass.Tuple {
                if raIdx < rapTuple.tuple.elements.length() {
                  return builder.typechecker.resolve(rapTuple.tuple.elements[raIdx])
                }
              }
            }
          }
          // A relation method's unconstrained parameter (a _compare's
          // children) resolves to a bare class knot; adopt the class's
          // concrete instantiation like the C type generator does.
          return adoptConcreteBaseTy(builder,
              builder.typechecker.resolve(v.typedValue!))
        }
        raIdx += 1u64
      }
    } else if self.type == ExprType.Notnull {
      // x! carries its operand's type.
      return self.firstChildExpr.resolvedArgType(builder, depth + 1u32,
          scopeBlock)
    } else if self.type == ExprType.Index {
      idxIndexee = self.firstChildExpr!
      idxNode = idxIndexee.nextExprChildExpr!
      rIndexee = idxIndexee.resolvedArgType(builder, depth + 1u32, scopeBlock)
      if rIndexee.type == types.Type.TypeClass.Tuple {
        if idxNode.type == ExprType.Constant && idxNode.val.type == DatatypeType.Uint {
          slot = idxNode.val.intVal.uint64()
          if slot < rIndexee.tuple.elements.length() {
            return builder.typechecker.resolve(rIndexee.tuple.elements[slot])
          }
        }
      } else if rIndexee.type == types.Type.TypeClass.Array {
        return builder.typechecker.resolve(rIndexee.array.elementType!)
      }
    } else if self.type == ExprType.Add || self.type == ExprType.Sub ||
        self.type == ExprType.Mul || self.type == ExprType.Div {
      // A USER-OVERLOADED binary op on class operands: the expression
      // slot holds the typecheck-time guess; the EMITTED spec's
      // recorded result is authoritative (Integer's op + returns an
      // Integer(u8,..) instance regardless of operand widths).
      boL = self.firstChildExpr!
      boR = boL.nextExprChildExpr!
      boLT = boL.resolvedArgType(builder, depth + 1u32, scopeBlock)
      boRT = boR.resolvedArgType(builder, depth + 1u32, scopeBlock)
      if (!builder.typechecker.hasFreeVars(boLT) &&
          !builder.typechecker.hasFreeVars(boRT) &&
          (builder.isClassType(boLT) || builder.isClassType(boRT))) {
        boName = ""
        if self.type == ExprType.Add {
          boName = "op_add"
        } else if self.type == ExprType.Sub {
          boName = "op_sub"
        } else if self.type == ExprType.Mul {
          boName = "op_mul"
        } else {
          boName = "op_div"
        }
        boTuple = types.Type(types.TupleType([boLT, boRT]))
        boSpec = boTuple.genSpecializationName(boName)
        boRes = builder.lookupSpecResult(boSpec)
        if isnull(boRes) {
          // Not emitted yet (ordering): derive the op's result by
          // walking ITS body under these ground operand types — the
          // same read-only fixpoint emittedCallResult uses for calls.
          boTc = builder.typechecker
          for boI in range(boTc.operatorFns.length()) {
            if isnull(boRes) && boTc.operatorFns[boI].opType == self.type {
              boFn = boTc.operatorFns[boI]
              if !isnull(boFn.subBlock) && builder.deriveDepth < 24u32 {
                boPrevTuple = builder.currentEmittingParamTuple
                boPrevPFn = builder.currentEmittingParamFn
                boPrevFn = builder.currentEmittingFn
                builder.currentEmittingParamTuple = boTuple
                builder.currentEmittingParamFn = boFn
                builder.currentEmittingFn = boFn
                builder.deriveDepth += 1u32
                boDer = boFn.deriveSpecResult(builder, boFn.subBlock!)
                builder.deriveDepth -= 1u32
                builder.currentEmittingParamTuple = boPrevTuple
                builder.currentEmittingParamFn = boPrevPFn
                builder.currentEmittingFn = boPrevFn
                if !isnull(boDer) {
                  if !boTc.hasFreeVars(boDer!) {
                    builder.recordSpecResult(boSpec, boDer!)
                    boRes = boDer
                  }
                }
              }
            }
          }
        }
        if !isnull(boRes) {
          return boRes!
        }
      }
    } else if (self.type == ExprType.Bitand || self.type == ExprType.Bitor ||
        self.type == ExprType.Bitxor || self.type == ExprType.Shl ||
        self.type == ExprType.Shr) {
      // Int-preserving ops: the result type IS the left operand's type.
      // The slot defaults adaptable AnyInt to 64 bits and hides a WIDE
      // operand (a u65 spec's a0 & test).
      bwSlotSoft = isnull(self.typedValue)
      if !bwSlotSoft {
        bwSlotSoft = builder.typechecker.containsAdaptableType(
            builder.typechecker.resolve(self.typedValue!))
      }
      if bwSlotSoft {
        bwL = self.firstChildExpr!
        bwRec = bwL.resolvedArgType(builder, depth + 1u32, scopeBlock)
        if (bwRec.type == types.Type.TypeClass.Int &&
            !builder.typechecker.hasFreeVars(bwRec)) {
          return bwRec
        }
      }
    } else if self.type == ExprType.Cast || self.type == ExprType.CastTrunc {
      // <T>value: the TYPE child carries the result type.  Its SLOT is
      // right for ordinary casts (<u32>x); only chase the declaration
      // (a typeof-typed local) when the slot is under-resolved —
      // recovering a type IDENT like u32 as a variable poisons
      // everything.
      castTC = self.firstChildExpr!
      if !isnull(castTC.typedValue) {
        castTy = builder.typechecker.resolve(castTC.typedValue!)
        // An ADAPTABLE slot falls through to the Ident chase like the
        // general Ident arm: a typeof-cast's type child (<arow>x) can
        // wear a stale walk round's AnyInt rendering.
        if (!argTypeUnderResolved(builder, castTy) &&
            !builder.typechecker.containsAdaptableType(castTy) &&
            castTy.type != types.Type.TypeClass.Polymorphic) {
          return castTy
        }
      }
      if ((castTC.type == ExprType.Ident || castTC.type == ExprType.Typeof) &&
          !isnull(castTC.typedValue)) {
        castRec = castTC.resolvedArgType(builder, depth + 1u32, scopeBlock)
        if (!builder.typechecker.hasFreeVars(castRec) &&
            castRec.type != types.Type.TypeClass.Polymorphic) {
          return castRec
        }
      }
    } else if self.type == ExprType.Typeof {
      // typeof(expr): the value IS the operand's type.
      return self.firstChildExpr.resolvedArgType(builder, depth + 1u32,
          scopeBlock)
    } else if self.type == ExprType.Funcaddr {
      // &fn(args): the value's type is the CONCRETE fn type of the
      // specialization the args select — the expression slot holds the
      // callee's whole generalized poly, which has no C representation.
      faC = self.firstChildExpr!
      if faC.type == ExprType.Call {
        faCallee = faC.firstChildExpr!
        faArgsN = faCallee.nextExprChildExpr
        if !isnull(faArgsN) {
          faTypes = arrayof(types.Type)
          if faArgsN.type == ExprType.List || faArgsN.type == ExprType.Tuple {
            for faA in faArgsN.childExprs() {
              faTypes.append(faA.resolvedArgType(builder, depth + 1u32, scopeBlock))
            }
          } else {
            faTypes.append(faArgsN.resolvedArgType(builder, depth + 1u32, scopeBlock))
          }
          faOk = true
          for faT in faTypes {
            if builder.typechecker.hasFreeVars(faT) {
              faOk = false
            }
          }
          faRes = faC.resolvedArgType(builder, depth + 1u32, scopeBlock)
          if faOk && !builder.typechecker.hasFreeVars(faRes) {
            if faTypes.length() == 1u64 {
              faParams = faTypes[0u64]
            } else {
              faParams = types.Type(types.TupleType(faTypes))
            }
            return types.Type(types.FunctionType(faParams, faRes))
          }
        }
      }
    } else if self.type == ExprType.Tuple {
      // Rebuild from the children: the tuple's own slot bound once and
      // lies for other specs (equalsParens' (a, b) scrutinee).
      ratElems = arrayof(types.Type)
      ratAllGround = true
      for ratChild in self.childExprs() {
        ratEl = ratChild.resolvedArgType(builder, depth + 1u32, scopeBlock)
        if builder.typechecker.hasFreeVars(ratEl) {
          ratAllGround = false
        }
        ratElems.append(ratEl)
      }
      if ratAllGround {
        return types.Type(types.TupleType(ratElems))
      }
    }
    ratNoSlot = isnull(self.typedValue)
    if ratNoSlot && self.type == ExprType.Constant {
      // A never-stamped literal types from its VALUE — but only when
      // exact (a width-suffixed number, bool, string, float); an
      // adaptable literal would compose a wrong spec name.
      if (self.val.type == DatatypeType.Bool ||
          self.val.type == DatatypeType.String ||
          self.val.type == DatatypeType.Float ||
          ((self.val.type == DatatypeType.Int ||
            self.val.type == DatatypeType.Uint) && !self.val.widthUnspecified)) {
        ratCTy = builder.typechecker.value(self.val)
        if !isnull(ratCTy) {
          return ratCTy!
        }
      }
      return types.NONETY()
    }
    if (ratNoSlot && self.type != ExprType.Ident &&
        self.type != ExprType.Call && self.type != ExprType.Dot) {
      return types.NONETY()
    }
    rty = types.NONETY()
    if !ratNoSlot {
      rty = builder.typechecker.resolve(self.typedValue!)
    }
    if depth > 8u32 {
      return rty
    }
    // A never-stamped expression (an op body walked by the derivation
    // before any emission) has no slot to trust; the recovery arms
    // below reconstruct from children.
    ratSlotTrust = !ratNoSlot
    if self.type == ExprType.Call && !isnull(builder.currentEmittingFn) {
      if !isnull(builder.currentEmittingParamFn) {
        if builder.currentEmittingParamFn! == builder.currentEmittingFn! {
          // Inside a specialized emission a Call expression's slot holds
          // ONE round's binding and lies for every other spec of the
          // same body; recompute from the live callee specs (the arm
          // below falls back to the slot when it finds nothing).
          ratSlotTrust = false
        }
      }
    }
    if ratSlotTrust && self.type == ExprType.Call {
      // A ROUND-MANAGED callee's call slots hold whichever round bound
      // them (module-level printlns of recursive-family results).
      ratCal = self.firstChildExpr
      if !isnull(ratCal) {
        if ratCal.type == ExprType.Ident {
          ratFn = builder.findFunction(ratCal.val.symVal.name)
          if !isnull(ratFn) {
            if ratFn.lastMaterializedSpec != "" {
              ratSlotTrust = false
            }
          }
        }
      }
    }
    if ratSlotTrust && self.type == ExprType.Ident &&
        rty.type == types.Type.TypeClass.Typename {
      if rty.tyname.name.name == "none" {
        // A LOCAL can't hold a none value: the slot is a stale round's
        // leftover (the op body's last typecheck round was generic).
        // Distrust it and chase the declaration below.
        ratSlotTrust = false
      }
    }
    if (ratSlotTrust &&
        (self.type == ExprType.Ident || self.type == ExprType.Call) &&
        builder.typechecker.containsAdaptableType(rty)) {
      // An ADAPTABLE slot (AnyInt pieces) is one walk round's rendering
      // of an unsuffixed literal; under a concrete emission the chase
      // below concretizes through the published param tuple (gf2exteuc's
      // `return brow` derived (Uint,Uint,Uint) in the u32 spec).  The
      // slot still returns at the end when the chase finds nothing.
      ratSlotTrust = false
    }
    if ratSlotTrust && !argTypeUnderResolved(builder, rty) {
      return rty
    }
    if self.type == ExprType.Ident {
      // A local whose own type snapshot stayed a free variable (or a bare
      // knot) declares through its first assignment; the right-hand side
      // carries its type.
      chaseRoot = scopeBlock
      if !isnull(builder.currentEmittingFn) {
        chaseRoot = builder.currentEmittingFn.subBlock
      }
      if !isnull(chaseRoot) {
        declRhs = findLocalDecl(chaseRoot, self.val.symVal.name)
        if !isnull(declRhs) {
          declTy = adoptConcreteBaseTy(builder,
              declRhs.resolvedArgType(builder, depth + 1u32, scopeBlock))
          if !argTypeUnderResolved(builder, declTy) {
            return declTy
          }
        }
      }
    }
    if self.type == ExprType.Call {
      // A PLAIN-FUNCTION call whose result variable stayed free (a
      // recursive call inside a materialized body: the round parks the
      // demand and the drain binds the RECORDED slot, but this expression
      // holds a fresh per-round variable): recover the result from the
      // callee's recorded instantiation whose parameters match this
      // call's recovered argument types.
      pcCallee = self.firstChildExpr!
      if pcCallee.type == ExprType.Ident {
        pcFn = builder.findFunction(pcCallee.val.symVal.name)
        if isnull(pcFn) {
          // A call through a LOCAL holding a function VALUE (no such
          // named function): the local's recovered type is the
          // concrete fn type; the call's result is ITS result.  Only
          // for TRUE locals — interned syms share names with methods.
          pcLocalTy = pcCallee.resolvedArgType(builder, depth + 1u32, scopeBlock)
          if pcLocalTy.type == types.Type.TypeClass.Function {
            pcLRes = builder.typechecker.resolve(pcLocalTy.function.result!)
            if !builder.typechecker.hasFreeVars(pcLRes) {
              return pcLRes
            }
          }
        }
        if !isnull(pcFn) {
          if pcFn.type == FuncType.Constructor {
            // A constructor call's result is the class INSTANCE type.
            // Prefer the slot when it resolves to a ground Typename;
            // otherwise rebuild it positionally from the recovered
            // argument types (Integer(0u8, a.width) -> Integer(u8,
            // u32)) — guarded by class-param arity and groundness.
            if !isnull(self.typedValue) {
              pcCSlot = builder.typechecker.resolve(self.typedValue!)
              if pcCSlot.type == types.Type.TypeClass.Typename {
                if !builder.typechecker.hasFreeVars(pcCSlot) {
                  return pcCSlot
                }
              }
            }
            pcCInfo = builder.typechecker.lookupClass(pcFn.sym)
            pcCArgs = pcCallee.nextExprChildExpr
            if !isnull(pcCInfo) && !isnull(pcCArgs) {
              pcCTys = arrayof(types.Type)
              if pcCArgs.type == ExprType.List || pcCArgs.type == ExprType.Tuple {
                for pcCA in pcCArgs.childExprs() {
                  pcCTys.append(pcCA.resolvedArgType(builder, depth + 1u32,
                      scopeBlock))
                }
              } else {
                pcCTys.append(pcCArgs.resolvedArgType(builder, depth + 1u32,
                    scopeBlock))
              }
              pcCOk = pcCTys.length() == pcCInfo.paramVars.length()
              for pcCT in pcCTys {
                if builder.typechecker.hasFreeVars(pcCT) {
                  pcCOk = false
                }
              }
              if pcCOk {
                return types.Type(types.TypeName(pcFn.sym,
                    types.TupleType(pcCTys)))
              }
            }
          }
          pcTy = pcFn.typedValue
          if !isnull(pcTy) {
            if pcTy.type == types.Type.TypeClass.Polymorphic {
              pcArgsNode = pcCallee.nextExprChildExpr
              if !isnull(pcArgsNode) {
                pcWant = arrayof(types.Type)
                pcOk = true
                if pcArgsNode.type == ExprType.Tuple || pcArgsNode.type == ExprType.List {
                  for pcArg in pcArgsNode.childExprs() {
                    pcAT = pcArg.resolvedArgType(builder, depth + 1u32, scopeBlock)
                    if argTypeUnderResolved(builder, pcAT) {
                      pcOk = false
                    }
                    pcWant.append(pcAT)
                  }
                } else {
                  pcAT = pcArgsNode.resolvedArgType(builder, depth + 1u32, scopeBlock)
                  if argTypeUnderResolved(builder, pcAT) {
                    pcOk = false
                  }
                  pcWant.append(pcAT)
                }
                if pcOk {
                  pcFound = null(types.Type)
                  pcWantStr = types.Type(types.TupleType(pcWant)).toString()
                  // A single-parameter function's type carries the BARE
                  // parameter type, not a one-element tuple.
                  pcWantStr1 = ""
                  if pcWant.length() == 1u64 {
                    pcWantStr1 = pcWant[0u64].toString()
                  }
                  pcConflict = false
                  // An already-EMITTED spec's result is authoritative:
                  // recorded instantiations multiply as emission rounds
                  // re-open the same polys, and a late round's recording
                  // can carry an unshrunk result for the same params.
                  pcMapRes = pcFn.emittedCallResult(builder, self)
                  if !isnull(pcMapRes) {
                    return pcMapRes!
                  }
                  pcPi = pcTy.poly.instantiations
                  if !isnull(pcPi) {
                    for pcInst in pcPi {
                      pcIt = pcInst.type
                      if !isnull(pcIt) {
                        pcRIt = builder.typechecker.resolve(pcIt!)
                        if pcRIt.type == types.Type.TypeClass.Function {
                          pcParams = builder.typechecker.resolve(pcRIt.function.params!)
                          pcParamsStr = pcParams.toString()
                          if pcParamsStr == pcWantStr {
                            pcRes = builder.typechecker.resolve(pcRIt.function.result!)
                            if !argTypeUnderResolved(builder, pcRes) {
                              if isnull(pcFound) {
                                pcFound = pcRes
                              } else {
                                // Two matching instantiations disagreeing on
                                // the result = at least one resolved through
                                // a stale frame; trust neither.
                                if pcFound.toString() != pcRes.toString() {
                                  pcConflict = true
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                  if pcConflict {
                    pcFound = null(types.Type)
                  }
                  if isnull(pcFound) && depth < 6u32 {
                    // No recorded instantiation matches: synthesize one by
                    // opening the poly and materializing under it (safe
                    // under an active emission frame since the
                    // frame-stack instantiate conversion).
                    pcOpened = pcTy.poly!.open(builder.typechecker.unifier,
                        &builder.typechecker.unifier.newVar())
                    if pcOpened.type == types.Type.TypeClass.Function {
                      pcWTy = types.Type(types.TupleType(pcWant))
                      if pcWant.length() == 1u64 {
                        pcWTy = pcWant[0u64]
                      }
                      pcTe = builder.typechecker.unify(pcOpened.function.params!, pcWTy)
                      if isnull(pcTe) {
                        pcSyn = pcTy.poly.instantiations.lastTyvarInstantiation
                        if !isnull(pcSyn) {
                          builder.resolveInstantiation(pcSyn!)
                          builder.instantiate(pcTy.poly!, pcSyn!)
                          pcKey = pcWTy.genSpecializationName(pcFn.sym.name)
                          // A key-hit would skip the retypecheck and leave
                          // the just-opened result var unbound; force a
                          // real round for THIS opening.
                          if pcFn.lastMaterializedSpec == pcKey {
                            pcFn.lastMaterializedSpec = ""
                          }
                          builder.typechecker.materializeSpec(pcFn!, pcKey)
                          pcSRes = builder.typechecker.resolve(pcOpened.function.result!)
                          builder.resolveInstantiation(pcSyn!)
                          builder.deInstantiate(pcTy.poly!)
                          if !argTypeUnderResolved(builder, pcSRes) {
                            pcFound = pcSRes
                          }
                        }
                      }
                    }
                  }
                  if !isnull(pcFound) {
                    return pcFound!
                  }
                }
              }
            }
          }
        }
      }
      // A method call whose return type variable escaped the bindings
      // (heapq.pop() chained to the class's template variable): recover
      // the return type from the method's definition, with the class's
      // template variables substituted by the receiver's concrete
      // parameters.
      callee = self.firstChildExpr!
      if callee.type == ExprType.Dot {
        cBase = callee.firstChildExpr!
        cMember = cBase.nextExprChildExpr!
        if cMember.type == ExprType.Ident {
          cBaseTy = adoptConcreteBaseTy(builder,
              cBase.resolvedArgType(builder, depth + 1u32, scopeBlock))
              cBaseTy.toString()
          if cBaseTy.type == types.Type.TypeClass.Typename {
            cinfo = builder.typechecker.lookupClass(cBaseTy.tyname.name)
            if !isnull(cinfo) {
              if !isnull(cinfo.fn) {
                for cChild in cinfo.fn.childFunctions() {
                  if cChild.sym.name == cMember.val.symVal.name {
                    cmty = cChild.typedValue
                    if !isnull(cmty) {
                      cScope = cmty!
                      if cScope.type == types.Type.TypeClass.Polymorphic {
                        cScope = cScope.poly.scope
                      }
                      if cScope.type == types.Type.TypeClass.Function {
                        cResTy = builder.typechecker.substituteClassVars(
                            cinfo!, cBaseTy, cScope.function.result!)
                        if !argTypeUnderResolved(builder, cResTy) {
                          return cResTy
                        }
                      }
                      // The definition sweep bakes recorded instantiations;
                      // adopt the result of the one whose self parameter is
                      // this receiver.
                      if cmty.type == types.Type.TypeClass.Polymorphic {
                        cpi = cmty.poly.instantiations
                        if !isnull(cpi) {
                          for cInst in cpi {
                            cIt = cInst.type
                            if !isnull(cIt) {
                              if cIt.type == types.Type.TypeClass.Function {
                                cParams = builder.typechecker.resolve(cIt.function.params!)
                                cSelfMatch = false
                                if cParams.type == types.Type.TypeClass.Tuple {
                                  if cParams.tuple.elements.length() > 0 {
                                    cSelfTy = builder.typechecker.resolve(
                                        cParams.tuple.elements[0])
                                    if cSelfTy.type == types.Type.TypeClass.Typename {
                                      if builder.classCName(cSelfTy) ==
                                          builder.classCName(cBaseTy) {
                                        cSelfMatch = true
                                      }
                                    }
                                  }
                                }
                                if cSelfMatch {
                                  cInstRes = builder.typechecker.resolve(
                                      cIt.function.result!)
                                  if !argTypeUnderResolved(builder, cInstRes) {
                                    return cInstRes
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                      // Chase the method's own return expression, rooted in
                      // its body (pop returns element.value, whose type
                      // recovers through element's declaring assignment).
                      if !isnull(cChild.subBlock) {
                        cRetExpr = findReturnExpr(cChild.subBlock!)
                        if !isnull(cRetExpr) {
                          cRetTy = cRetExpr.resolvedArgType(builder,
                              depth + 1u32, cChild.subBlock)
                          if !argTypeUnderResolved(builder, cRetTy) {
                            return cRetTy
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
    if self.type == ExprType.Tuple || self.type == ExprType.List {
      // A tuple literal's snapshot can hold popped variables even when
      // every element recovers; rebuild it from the children.
      tElems = arrayof(types.Type)
      tAllGood = true
      for tChild in self.childExprs() {
        tElem = tChild.resolvedArgType(builder, depth + 1u32, scopeBlock)
        if argTypeUnderResolved(builder, tElem) {
          tAllGood = false
        }
        tElems.append(tElem)
      }
      if tAllGood {
        return types.Type(types.TupleType(tElems))
      }
    }
    if self.type == ExprType.Dot {
      // A field select whose type variable escaped the active
      // instantiation's bindings (e.g. a hoisted relation body emitted
      // under a different instantiation than the one that typechecked it):
      // recover the type from the base class's field declaration, with the
      // class's template variables substituted by the base's concrete
      // parameters.
      dotBase = self.firstChildExpr!
      dotMember = dotBase.nextExprChildExpr!
      if dotMember.type == ExprType.Ident {
        baseTy = adoptConcreteBaseTy(builder,
            dotBase.resolvedArgType(builder, depth + 1u32, scopeBlock))
        if baseTy.type == types.Type.TypeClass.Typename {
          dinfo = builder.typechecker.lookupClass(baseTy.tyname.name)
          if !isnull(dinfo) {
            if !isnull(dinfo.strct) {
              for fi in range(dinfo.strct.fieldnames.length()) {
                if dinfo.strct.fieldnames[fi].name == dotMember.val.symVal.name {
                  fty = builder.typechecker.substituteClassVars(dinfo!, baseTy,
                      dinfo.strct.fieldtypes[fi])
                  if !argTypeUnderResolved(builder, fty) {
                    return fty
                  }
                }
              }
            }
          }
        }
      }
    }
    return rty
  }

  func genCIndex(self, builder: c.CBuilder) -> c.CExpr {
    indexee = self.firstChildExpr!
    index = indexee.nextExprChildExpr!
    // We know from typechecking that index is a u64.  The indexee's raw
    // type may be a variable bound to the array (deferred re-typecheck).
    rIndexeeTy = builder.typechecker.resolve(indexee.typedValue!)
    left = indexee.genC(builder)
    if rIndexeeTy.type == types.Type.TypeClass.Array {
      right = index.genC(builder)
      return builder.cIndex(self.location, rIndexeeTy, left, right)
    }
    if builder.typechecker.isStringType(rIndexeeTy) {
      // Strings index directly as C char buffers.
      right = index.genC(builder)
      return c.CExpr(c.CIndexExpr(self.location, left, right))
    }
    assert index.type == ExprType.Constant && index.val.type == DatatypeType.Uint
    i = index.val.intVal.uint64()
    return builder.cIndex(self.location, rIndexeeTy, left, i)
  }

  // <left> mod <m>: emit the left expression tree with every arithmetic
  // operator mapped to a modular runtime helper and every leaf reduced into
  // [0, m).  The modulus expression re-generates per use site (it appears as
  // an argument of each helper call); a C expression object can only sit in
  // one argument list.
  func genCModint(self, builder: c.CBuilder) -> c.CExpr {
    left = self.firstChildExpr!
    modulus = left.nextExprChildExpr!
    return left.genCModular(builder, modulus)
  }

  // First wide (>64-bit) width found on any node of this subtree, or 0.
  // Modular expressions reduce every operand to the modulus width, so any
  // wide node means the whole reduction is wide.
  func findWideWidth(self, builder: c.CBuilder) -> u32 {
    w = builder.wideWidth(self.typedValue)
    if w > 0u32 {
      return w
    }
    for child in self.childExprs() {
      w = child.findWideWidth(builder)
      if w > 0u32 {
        return w
      }
    }
    return 0u32
  }

  // True if the C value this expression emits is wide.  Besides a wide node
  // type anywhere in the subtree, a bare reference to a local that was
  // declared wide also emits a wide value, even when the reference's own
  // type resolved to a scalar default (a generic body generalizes a local's
  // type variable independently of the parameters it depends on).
  func emittedWide(self, builder: c.CBuilder) -> bool {
    if self.findWideWidth(builder) > 0u32 {
      return true
    }
    if self.type == ExprType.Ident {
      return builder.localWide(self.val.symVal!)
    }
    // An ADAPTABLE slot hides wideness the live recovery knows (a u65
    // spec's a0 & test emits wide_bitop; rrow.el0 reads an rn_wide
    // tuple element) — without this the wide caller re-wraps the value.
    ewSoft = isnull(self.typedValue)
    if !ewSoft {
      ewSoft = builder.typechecker.containsAdaptableType(
          builder.typechecker.resolve(self.typedValue!))
    }
    if ewSoft {
      return builder.wideWidth(self.resolvedArgType(builder)) > 0u32
    }
    return false
  }

  // True if any node anywhere in this expression emits a wide value — like
  // emittedWide but recursing so that a wide-declared local nested in the
  // subtree (e.g. a wide argument of a call whose result type is still an
  // open variable) is found.
  func subtreeWide(self, builder: c.CBuilder) -> bool {
    if self.emittedWide(builder) {
      return true
    }
    for child in self.childExprs() {
      if child.subtreeWide(builder) {
        return true
      }
    }
    return false
  }

  func genCModular(self, builder: c.CBuilder, modulus: Expr) -> c.CExpr {
    modW = builder.wideWidth(modulus.typedValue)
    if modW == 0u32 {
      // Deferral rollbacks can leave nodes untyped; any typed node in the
      // reduction or the modulus subtree decides the width.
      modW = self.findWideWidth(builder)
    }
    if modW == 0u32 {
      modW = modulus.findWideWidth(builder)
    }
    if modW > 0u32 {
      return self.genCModularWide(builder, modulus)
    }
    switch self.type {
      ExprType.Add, ExprType.Sub, ExprType.Mul, ExprType.Div => {
        l = self.firstChildExpr!
        r = l.nextExprChildExpr!
        switch self.type {
          ExprType.Add => modfn = c.CRuntimeFunction.ModAdd
          ExprType.Sub => modfn = c.CRuntimeFunction.ModSub
          ExprType.Mul => modfn = c.CRuntimeFunction.ModMul
          default => modfn = c.CRuntimeFunction.ModDiv
        }
        args = c.CExprList()
        args.appendCExpr(l.genCModular(builder, modulus))
        args.appendCExpr(r.genCModular(builder, modulus))
        args.appendCExpr(modulus.genC(builder))
        return builder.cCall(self.location, modfn, c.CExpr(args))
      }
      ExprType.Exp => {
        // The base reduces mod m; the exponent is an ordinary integer.
        b = self.firstChildExpr!
        e = b.nextExprChildExpr!
        expArgs = c.CExprList()
        expArgs.appendCExpr(b.genCModular(builder, modulus))
        expArgs.appendCExpr(e.genC(builder))
        expArgs.appendCExpr(modulus.genC(builder))
        return builder.cCall(self.location, c.CRuntimeFunction.ModExp, c.CExpr(expArgs))
      }
      ExprType.Negate, ExprType.NegateTrunc => {
        negChild = self.firstChildExpr!
        negArgs = c.CExprList()
        negArgs.appendCExpr(negChild.genCModular(builder, modulus))
        negArgs.appendCExpr(modulus.genC(builder))
        return builder.cCall(self.location, c.CRuntimeFunction.ModNegate, c.CExpr(negArgs))
      }
      ExprType.Equal, ExprType.Notequal, ExprType.Lt, ExprType.Le, ExprType.Gt, ExprType.Ge => {
        // Compare values after reduction.
        l = self.firstChildExpr!
        r = l.nextExprChildExpr!
        switch self.type {
          ExprType.Equal => cmpop = c.CBinaryOperator.Type.Equals
          ExprType.Notequal => cmpop = c.CBinaryOperator.Type.NotEquals
          ExprType.Lt => cmpop = c.CBinaryOperator.Type.LessThan
          ExprType.Le => cmpop = c.CBinaryOperator.Type.LessThanEqual
          ExprType.Gt => cmpop = c.CBinaryOperator.Type.GreaterThan
          default => cmpop = c.CBinaryOperator.Type.GreaterThanEqual
        }
        // Reduced values are uint64; equality emits isequal_uint64_t.
        return c.CExpr(c.CBinaryOperator(self.location, cmpop,
            builder.cIntType(self.location, false, 64u32),
            l.genCModular(builder, modulus), r.genCModular(builder, modulus)))
      }
      default => {
        // A leaf value: reduce it into [0, m), respecting its sign.
        leafIsSigned = false
        if !isnull(self.typedValue) {
          leafTy = builder.typechecker.resolve(self.typedValue!)
          if leafTy.type == types.Type.TypeClass.Int {
            leafIsSigned = leafTy.int.isSigned
          } else if leafTy.type == types.Type.TypeClass.AnyInt {
            leafIsSigned = leafTy.anyInt.isSigned
          }
        }
        leafArgs = c.CExprList()
        leafArgs.appendCExpr(self.genC(builder))
        leafArgs.appendCExpr(modulus.genC(builder))
        if leafIsSigned {
          return builder.cCall(self.location, c.CRuntimeFunction.ModReduceSigned, c.CExpr(leafArgs))
        }
        return builder.cCall(self.location, c.CRuntimeFunction.ModReduce, c.CExpr(leafArgs))
      }
    }
  }

  // Modular arithmetic with a modulus wider than 64 bits: every operand
  // becomes a wide value and the wide_mod* helpers keep results in [0, m).
  func genCWideModOperand(self, builder: c.CBuilder, modulus: Expr) -> c.CExpr {
    mW = builder.wideWidth(modulus.typedValue)
    if mW == 0u32 {
      mW = modulus.findWideWidth(builder)
    }
    v = self.genC(builder)
    // A generic body's node types can resolve to a scalar default even when
    // the value is wide; if any wide node is in this operand's subtree, or
    // it is a bare reference to a wide-declared local, the emitted value is
    // already wide and must not be re-wrapped as a scalar.
    if !self.emittedWide(builder) {
      leafSigned = false
      leafTy = builder.typechecker.resolve(self.typedValue!)
      if leafTy.type == types.Type.TypeClass.Int {
        leafSigned = leafTy.int.isSigned
      } else if leafTy.type == types.Type.TypeClass.AnyInt {
        leafSigned = leafTy.anyInt.isSigned
      }
      v = builder.cWideFromU64(self.location, v, mW, leafSigned)
    }
    return v
  }

  func genCModularWide(self, builder: c.CBuilder, modulus: Expr) -> c.CExpr {
    switch self.type {
      ExprType.Add, ExprType.Sub, ExprType.Mul, ExprType.Div => {
        l = self.firstChildExpr!
        r = l.nextExprChildExpr!
        switch self.type {
          ExprType.Add => wmName = "wide_modadd"
          ExprType.Sub => wmName = "wide_modsub"
          ExprType.Mul => wmName = "wide_modmul"
          default => wmName = "wide_moddiv"
        }
        args = c.CExprList()
        args.appendCExpr(l.genCModularWide(builder, modulus))
        args.appendCExpr(r.genCModularWide(builder, modulus))
        args.appendCExpr(modulus.genC(builder))
        return builder.cWideCall(self.location, wmName, args)
      }
      ExprType.Exp => {
        b = self.firstChildExpr!
        e = b.nextExprChildExpr!
        expArgs = c.CExprList()
        expArgs.appendCExpr(b.genCModularWide(builder, modulus))
        expArgs.appendCExpr(e.genCWideModOperand(builder, modulus))
        expArgs.appendCExpr(modulus.genC(builder))
        return builder.cWideCall(self.location, "wide_modexp", expArgs)
      }
      ExprType.Negate, ExprType.NegateTrunc => {
        negChild = self.firstChildExpr!
        negArgs = c.CExprList()
        negArgs.appendCExpr(negChild.genCModularWide(builder, modulus))
        negArgs.appendCExpr(modulus.genC(builder))
        return builder.cWideCall(self.location, "wide_modneg", negArgs)
      }
      ExprType.Equal, ExprType.Notequal, ExprType.Lt, ExprType.Le, ExprType.Gt, ExprType.Ge => {
        l = self.firstChildExpr!
        r = l.nextExprChildExpr!
        cmpArgs = c.CExprList()
        cmpArgs.appendCExpr(l.genCModularWide(builder, modulus))
        cmpArgs.appendCExpr(r.genCModularWide(builder, modulus))
        if self.type == ExprType.Equal {
          return builder.cWideCall(self.location, "wide_eq", cmpArgs)
        }
        if self.type == ExprType.Notequal {
          wEqCall = builder.cWideCall(self.location, "wide_eq", cmpArgs)
          return c.CExpr(c.CPrefixOperator(self.location,
              c.CPrefixOperator.Type.LogNot, wEqCall))
        }
        switch self.type {
          ExprType.Lt => wCmpOp = c.CBinaryOperator.Type.LessThan
          ExprType.Le => wCmpOp = c.CBinaryOperator.Type.LessThanEqual
          ExprType.Gt => wCmpOp = c.CBinaryOperator.Type.GreaterThan
          default => wCmpOp = c.CBinaryOperator.Type.GreaterThanEqual
        }
        wCmpCall = builder.cWideCall(self.location, "wide_cmp", cmpArgs)
        return c.CExpr(c.CBinaryOperator(self.location, wCmpOp,
            null(c.CTypeExpr), wCmpCall, c.CExpr(c.CLiteral(Bigint(0i32), false))))
      }
      default => {
        // A leaf value: reduce it into [0, m).
        redArgs = c.CExprList()
        redArgs.appendCExpr(self.genCWideModOperand(builder, modulus))
        redArgs.appendCExpr(modulus.genC(builder))
        return builder.cWideCall(self.location, "wide_modreduce", redArgs)
      }
    }
  }

  func genCSlice(self, builder: c.CBuilder) -> c.CExpr {
    base = self.firstChildExpr!
    lower = base.nextExprChildExpr!
    upper = lower.nextExprChildExpr!
    args = c.CExprList()
    args.appendCExpr(base.genC(builder))
    args.appendCExpr(lower.genC(builder))
    args.appendCExpr(upper.genC(builder))
    if builder.typechecker.isStringType(self.typedValue) {
      return builder.cCall(self.location, c.CRuntimeFunction.StringSlice, c.CExpr(args))
    }
    return builder.cCall(self.location, c.CRuntimeFunction.ArraySlice, c.CExpr(args),
        self.typedValue)
  }

  func genCFieldSel(self, builder: c.CBuilder) -> c.CExpr {
    strct = self.firstChildExpr!
    field = strct.nextExprChildExpr!
    if strct.type == ExprType.Ident {
      // Enum member accesses are inlined as integer constants.
      einfo = builder.typechecker.lookupEnum(strct.val.symVal!)
      if !isnull(einfo) {
        value = einfo.memberValue(field.toString())
        bigValue = Bigint(value)
        return builder.cIntLiteral(bigValue)
      }
      // The except-clause exception variable: its fields read locals bound
      // at handler entry (see Statement.genCExcept), e.g. e_errorMessage.
      if !isnull(strct.typedValue) {
        excTy = builder.typechecker.resolve(strct.typedValue!)
        if excTy.type == types.Type.TypeClass.Typename &&
            excTy.tyname.name.name == "Exception" {
          fieldSym = Sym.new(strct.val.symVal.name + "_" + field.toString())
          return c.CExpr(c.CIdentifier(fieldSym, null(c.CTypeExpr), false, false, false))
        }
      }
    }
    // Array length as a property (`a.length`, no call) maps to the runtime
    // length helper, like the call form does in genCCall.
    if !isnull(strct.typedValue) && field.toString() == "length" {
      baseTy = builder.typechecker.resolve(strct.typedValue!)
      if baseTy.type == types.Type.TypeClass.Array {
        lenArgs = c.CExprList()
        lenArgs.appendCExpr(strct.genC(builder))
        return builder.cCall(self.location, c.CRuntimeFunction.ArrayLength,
            c.CExpr(lenArgs))
      }
    }
    left = strct.genC(builder)
    if builder.isClassType(strct.typedValue) {
      // Class instances are pointers; use -> to access data members.
      return c.CExpr(c.CDotExpr(self.location, left, field.toString(), true))
    }
    return builder.cFieldSelect(self.location, left, field.val.symVal!)
  }

  // &foo(...): emit the callee's C name.  In C a function name decays to a
  // function pointer, so the bare name is the address.  Naming goes through
  // the same identifier path as a monomorphic call's callee, so the reference
  // agrees with the emitted definition.
  func genCFuncaddr(self, builder: c.CBuilder) -> c.CExpr {
    faCall = self.firstChildExpr!
    faCallee = faCall.firstChildExpr!
    // The address of a generic function is the address of ONE
    // specialization: compose the specialized name from the call's
    // recovered argument types (the args exist exactly to select it).
    if faCallee.type == ExprType.Ident {
      gfArgsN = faCallee.nextExprChildExpr
      gfFn = builder.findFunction(faCallee.val.symVal.name)
      if !isnull(gfArgsN) && !isnull(gfFn) {
        gfTypes = arrayof(types.Type)
        if gfArgsN.type == ExprType.List || gfArgsN.type == ExprType.Tuple {
          for gfA in gfArgsN.childExprs() {
            gfTypes.append(gfA.resolvedArgType(builder))
          }
        } else {
          gfTypes.append(gfArgsN.resolvedArgType(builder))
        }
        gfOk = true
        for gfT in gfTypes {
          if builder.typechecker.hasFreeVars(gfT) {
            gfOk = false
          }
        }
        if gfOk {
          gfName = types.Type(types.TupleType(gfTypes)).genSpecializationName(
              faCallee.val.symVal.name)
          if !builder.alreadyEmitted(gfName) {
            // The referenced specialization may never be CALLED by
            // name (only through the pointer): synthesize + emit it,
            // with the speculative unify TRAILED so a failure leaves
            // no bindings (an untrailed version froze dicttest and
            // genericFactorial).
            gfTy = gfFn.typedValue
            if !isnull(gfTy) {
              if gfTy.type == types.Type.TypeClass.Polymorphic {
                builder.typechecker.unifier.beginBindTrail()
                gfOpened = builder.typechecker.openPoly(gfTy.poly!)
                gfEmitted = false
                if gfOpened.type == types.Type.TypeClass.Function {
                  if gfTypes.length() == 1u64 {
                    gfWTy = gfTypes[0u64]
                  } else {
                    gfWTy = types.Type(types.TupleType(gfTypes))
                  }
                  gfTe = builder.typechecker.unify(gfOpened.function.params!, gfWTy)
                  if isnull(gfTe) {
                    gfInst = gfTy.poly.instantiations.lastTyvarInstantiation
                    if !isnull(gfInst) {
                      builder.typechecker.unifier.commitBindTrail()
                      gfEmitted = true
                      builder.resolveInstantiation(gfInst!)
                      gfFn.genCPolyInstantiation(builder, gfInst!)
                    }
                  }
                }
                if !gfEmitted {
                  builder.typechecker.unifier.rollbackBindTrail()
                }
              }
            }
          }
          builder.noteDependency(gfName)
          return c.CExpr(c.CIdentifier(Sym.new(gfName), null(c.CTypeExpr),
              false, false, false))
        }
      }
    }
    return faCallee.genC(builder)
  }

  func genCCall(self, builder: c.CBuilder) -> c.CExpr {
    left0 = self.firstChildExpr
    badCall = isnull(left0)
    if !badCall {
      if isnull(left0.nextExprChildExpr) {
        badCall = true
      }
    }
    if badCall {
      raise Status.Internal, "malformed call expression"
    }
    left = left0!
    right = left.nextExprChildExpr!
    fntype = left.typedValue
    if isnull(fntype) {
      self.location.error("internal: call emitted without a type")
      raise Status.Internal, "call emitted without a type"
    }

    if left.type == ExprType.Dot {
      base = left.firstChildExpr!
      // Static method calls through the class name (e.g. Bar.new(...)).
      if base.type == ExprType.Ident {
        staticInfo = builder.typechecker.lookupClass(base.val.symVal!)
        if !isnull(staticInfo) {
          staticMethodExpr = base.nextExprChildExpr!
          staticFn = null(Function)
          for childfunc in staticInfo.fn.childFunctions() {
            if (childfunc.sym.name == staticMethodExpr.toString() &&
                childfunc.type == FuncType.Plain) {
              staticFn = childfunc
            }
          }
          if !isnull(staticFn) && !isnull(staticFn.typedValue) {
            sk = builder.typechecker.resolve(staticFn.typedValue!)
            if sk.type == types.Type.TypeClass.Function {
              sname = builder.methodDefCName(sk, staticMethodExpr.toString())
              if !builder.alreadyEmitted(sname) {
                staticFn.genCMethod(builder)
              }
              sargs = c.CExprList()
              if right.typedValue.type == types.Type.TypeClass.Tuple {
                for child in right.childExprs() {
                  sargs.appendCExpr(child.genC(builder))
                }
              } else {
                sargs.appendCExpr(right.genC(builder))
              }
              return builder.cCall(self.location, sname, c.CExpr(sargs))
            }
          }
        }
      }
      // Handle method calls on class instances.
      if builder.isClassType(base.typedValue) {
        method = base.nextExprChildExpr!
        nestedInfo = builder.typechecker.lookupClass(Sym.new(method.toString()))
        if !isnull(nestedInfo) {
          // instance.B(...): construct the (hoisted) nested class.
          ncName = builder.classCName(builder.typechecker.resolve(self.typedValue!))
          if !builder.alreadyEmitted(ncName) {
            ncFn = nestedInfo.fn
            ncFty = ncFn.typedValue
            if !isnull(ncFty) {
              if ncFty.type == types.Type.TypeClass.Polymorphic {
                ncPi = ncFty.poly.instantiations
                if !isnull(ncPi) {
                  for ncInst in ncPi {
                    if !builder.alreadyEmitted(ncName) {
                      builder.resolveInstantiation(ncInst)
                      if builder.instantiationIsConcrete(ncInst) {
                        builder.instantiate(ncFty.poly!, ncInst)
                        ncSelf = builder.typechecker.resolve(nestedInfo.selfType!)
                        if builder.classCName(ncSelf) == ncName {
                          ncFn.genCConstructorInstance(builder, nestedInfo!)
                        }
                        builder.deInstantiate(ncFty.poly!)
                      }
                    }
                  }
                }
                if !builder.alreadyEmitted(ncName) {
                  // The recorded instantiation only resolves under an
                  // outer binding; synthesize from this call's arguments.
                  ncOpened = ncFty.poly!.open(builder.typechecker.unifier,
                      &builder.typechecker.unifier.newVar())
                  if ncOpened.type == types.Type.TypeClass.Function {
                    // The call's own resolved type names the wanted
                    // instance; bind the opened variables through the
                    // result rather than the (less reliable) arguments.
                    ncTe = builder.typechecker.unify(ncOpened.function.result!,
                        builder.typechecker.resolve(self.typedValue!))
                    if isnull(ncTe) {
                      // open() recorded this instantiation; bind it to
                      // resolve the class's own type variables.
                      ncNewInst = ncFty.poly.instantiations.lastTyvarInstantiation
                      if !isnull(ncNewInst) {
                        builder.resolveInstantiation(ncNewInst!)
                        if builder.instantiationIsConcrete(ncNewInst!) {
                          builder.instantiate(ncFty.poly!, ncNewInst!)
                          ncSelf2 = builder.typechecker.resolve(nestedInfo.selfType!)
                          if builder.classCName(ncSelf2) == ncName {
                            ncFn.genCConstructorInstance(builder, nestedInfo!)
                          }
                          builder.deInstantiate(ncFty.poly!)
                        }
                      }
                    }
                  }
                }
              }
            }
          }
          ncArgs = c.CExprList()
          if right.typedValue.type == types.Type.TypeClass.Tuple {
            for child in right.childExprs() {
              ncArgs.appendCExpr(child.genC(builder))
            }
          } else if right.type == ExprType.List {
            for child in right.childExprs() {
              ncArgs.appendCExpr(child.genC(builder))
            }
          } else {
            ncArgs.appendCExpr(right.genC(builder))
          }
          return builder.cCall(self.location, ncName, c.CExpr(ncArgs))
        }
        if method.toString() == "show" {
          // The auto-generated show(): Class_show(self) prints the
          // object and returns none.
          shTy = builder.typechecker.resolve(base.typedValue!)
          shName = builder.classCName(shTy) + "_show"
          builder.noteDependency(shName)
          shArgs = c.CExprList()
          shArgs.appendCExpr(base.genC(builder))
          return builder.cCall(self.location, shName, c.CExpr(shArgs))
        }
        if method.toString() == "toString" {
          // The auto-generated toString captures the print helper's
          // output, unless the class defines its own.
          tsTy = builder.typechecker.resolve(base.typedValue!)
          tsInfo = builder.typechecker.lookupClass(tsTy.tyname.name)
          tsUser = null(Function)
          if !isnull(tsInfo) {
            for tsChild in tsInfo.fn.childFunctions() {
              if tsChild.sym.name == "toString" && tsChild.type == FuncType.Plain {
                tsUser = tsChild
              }
            }
          }
          if isnull(tsUser) {
            tsArgs = c.CExprList()
            tsInner = c.CExprList()
            tsInner.appendCExpr(base.genC(builder))
            tsArgs.appendCExpr(builder.cCall(self.location,
                "tostring_%s_t" % builder.classCName(tsTy), c.CExpr(tsInner)))
            return builder.cCall(self.location, "RN_TOSTRING_RET", c.CExpr(tsArgs))
          }
        }
        // Inside a specialized emission the receiver's slot holds one
        // signature's binding (a: Integer(u32,..) baked into the u64 op
        // body's a.toHex()); recover the live per-spec type.
        mcBaseTy = base.typedValue
        mcTry = false
        if !isnull(builder.currentEmittingParamFn) && !isnull(builder.currentEmittingFn) {
          if builder.currentEmittingParamFn! == builder.currentEmittingFn! {
            mcTry = true
          }
        }
        if (base.type == ExprType.Add || base.type == ExprType.Sub ||
            base.type == ExprType.Mul || base.type == ExprType.Div) {
          // A method on a user-operator RESULT: the emitted op spec's
          // recorded result is authoritative at ANY level (Integer's
          // op + returns Integer(u8,..) whatever the operands).
          mcTry = true
        }
        if mcTry {
          mcRec = base.resolvedArgType(builder)
          if (!builder.typechecker.hasFreeVars(mcRec) &&
              builder.isClassType(mcRec)) {
            mcBaseTy = mcRec
          }
        }
        name = builder.methodCallCName(mcBaseTy!, method.toString(), right.typedValue)
        if !builder.alreadyEmitted(name) {
          builder.emitMethodOnDemand(mcBaseTy!, method.toString(), name,
              right.typedValue)
        }
        // The enclosing function depends on this method; the C emitter uses it
        // to order definitions (and emit a prototype when they are mutually
        // recursive, e.g. cascade destroy_Foo <-> destroy_Bar).
        builder.noteDependency(name)
        args = c.CExprList()
        args.appendCExpr(base.genC(builder))
        // The args list may have no type when the enclosing method was
        // re-typechecked on demand; emit the children positionally.
        isTupleArgs = false
        if !isnull(right.typedValue) {
          isTupleArgs = right.typedValue.type == types.Type.TypeClass.Tuple
        }
        if isTupleArgs {
          for child in right.childExprs() {
            args.appendCExpr(child.genC(builder))
          }
        } else if right.type == ExprType.List {
          for child in right.childExprs() {
            args.appendCExpr(child.genC(builder))
          }
        } else {
          args.appendCExpr(right.genC(builder))
        }
        return builder.cCall(self.location, name, c.CExpr(args))
      }
      // Built-in methods on strings.
      strBase = left.firstChildExpr!
      if builder.typechecker.isStringType(strBase.typedValue) {
        field = strBase.nextExprChildExpr!
        if field.toString() == "toUint" {
          // result = (T)rn_string_touint(s, &ok)
          tuArgs = c.CExprList()
          tuArgs.appendCExpr(strBase.genC(builder))
          tuOk = right.firstChildExpr.nextExprChildExpr
          if !isnull(tuOk) {
            tuArgs.appendCExpr(c.CExpr(c.CPrefixOperator(self.location,
                c.CPrefixOperator.Type.AddressOf, tuOk.genC(builder))))
          }
          return builder.cCall(self.location, "rn_string_touint",
              c.CExpr(tuArgs))
        }
        if field.toString() == "toUintLE" {
          // <T>: wide_from_le_bytes(s, string_length(s), width, signed)
          tuleTy = builder.typechecker.resolve(self.typedValue!)
          tuleWidth = 64u64
          tuleSigned = false
          if tuleTy.type == types.Type.TypeClass.Int {
            tuleWidth = <u64>tuleTy.int.width
            tuleSigned = tuleTy.int.isSigned
          }
          lenArgs = c.CExprList()
          lenArgs.appendCExpr(strBase.genC(builder))
          tuleArgs = c.CExprList()
          tuleArgs.appendCExpr(strBase.genC(builder))
          tuleArgs.appendCExpr(builder.cCall(self.location,
              c.CRuntimeFunction.StringLength, c.CExpr(lenArgs)))
          tuleArgs.appendCExpr(builder.cIntLiteral(Bigint(tuleWidth)))
          tuleArgs.appendCExpr(builder.cIntLiteral(
              Bigint(tuleSigned ? 1u64 : 0u64)))
          return builder.cWideCall(self.location, "wide_from_le_bytes", tuleArgs)
        }
        switch field.toString() {
          "length" => strfn = c.CRuntimeFunction.StringLength
          "append" => strfn = c.CRuntimeFunction.StringAppendChar
          "concat" => strfn = c.CRuntimeFunction.StringConcat
          "find" => strfn = c.CRuntimeFunction.StringFind
          "rfind" => strfn = c.CRuntimeFunction.StringRfind
          "toHex" => strfn = c.CRuntimeFunction.StringToHex
          "fromHex" => strfn = c.CRuntimeFunction.StringFromHex
          "resize" => strfn = c.CRuntimeFunction.StringResize
          "reverse" => strfn = c.CRuntimeFunction.StringReverse
          default => raise Status.Unimplemented, "Unknown string builtin method: \"", field, "\""
        }
        strArgs = c.CExprList()
        strArgs.appendCExpr(strBase.genC(builder))
        argCount = 0
        if right.typedValue.type == types.Type.TypeClass.Tuple {
          for child in right.childExprs() {
            strArgs.appendCExpr(child.genC(builder))
            argCount += 1
          }
        } else {
          strArgs.appendCExpr(right.genC(builder))
          argCount += 1
        }
        if field.toString() == "find" || field.toString() == "rfind" {
          // The C helpers take a fixed offset parameter; default it to 0.
          if argCount < 2 {
            zeroOffset = Bigint(0u64)
            strArgs.appendCExpr(builder.cIntLiteral(zeroOffset))
          }
        }
        return builder.cCall(self.location, strfn, c.CExpr(strArgs))
      }

      // Built-in methods on bool and integer values.
      scalarBase = left.firstChildExpr!
      if !isnull(scalarBase.typedValue) {
        bty = builder.typechecker.resolve(scalarBase.typedValue!)
        if bty.type == types.Type.TypeClass.Typename && bty.tyname.name.name == "bool" {
          bArgs = c.CExprList()
          bArgs.appendCExpr(scalarBase.genC(builder))
          return builder.cCall(self.location, c.CRuntimeFunction.BoolToString, c.CExpr(bArgs))
        }
        if bty.type == types.Type.TypeClass.Int || bty.type == types.Type.TypeClass.AnyInt {
          field = scalarBase.nextExprChildExpr!
          if bty.type == types.Type.TypeClass.Int {
            intSigned = bty.int.isSigned
            intWidth = bty.int.width
          } else {
            intSigned = bty.anyInt.isSigned
            intWidth = 64u32
          }
          if intWidth > 64u32 {
            if field.toString() == "toString" {
              // Wide integers stringify through the wide runtime.
              wtArgs = c.CExprList()
              wtArgs.appendCExpr(scalarBase.genC(builder))
              wtArgCount = 1
              if right.typedValue.type == types.Type.TypeClass.Tuple {
                for child in right.childExprs() {
                  wtArgs.appendCExpr(child.genC(builder))
                  wtArgCount += 1
                }
              } else if right.type == ExprType.List && !isnull(right.firstChildExpr) {
                wtArgs.appendCExpr(right.firstChildExpr.genC(builder))
                wtArgCount += 1
              }
              if wtArgCount < 2 {
                wtArgs.appendCExpr(builder.cIntLiteral(Bigint(10u64)))
              }
              return builder.cWideCall(self.location, "wide_tostring_base", wtArgs)
            }
            if field.toString() == "toStringLE" {
              // Wide toStringLE: the low width/8 bytes little-endian as a
              // length-headed (binary-safe) string.
              wleArgs = c.CExprList()
              wleArgs.appendCExpr(scalarBase.genC(builder))
              wleArgs.appendCExpr(builder.cIntLiteral(
                  Bigint(<u64>(intWidth / 8u32))))
              return builder.cWideCall(self.location, "wide_tostring_le", wleArgs)
            }
          }
          switch field.toString() {
            "toString" => {
              if intSigned {
                intfn = c.CRuntimeFunction.IntToString
              } else {
                intfn = c.CRuntimeFunction.UintToString
              }
            }
            "toStringLE" => intfn = c.CRuntimeFunction.IntToStringLE
            "toStringBE" => intfn = c.CRuntimeFunction.IntToStringBE
            default => raise Status.Unimplemented, "Unknown integer builtin method: \"", field, "\""
          }
          iArgs = c.CExprList()
          iArgs.appendCExpr(scalarBase.genC(builder))
          iArgCount = 1
          if right.typedValue.type == types.Type.TypeClass.Tuple {
            for child in right.childExprs() {
              iArgs.appendCExpr(child.genC(builder))
              iArgCount += 1
            }
          } else {
            iArgs.appendCExpr(right.genC(builder))
            iArgCount += 1
          }
          if field.toString() == "toString" {
            // The C helpers take a fixed base parameter; default it to 10.
            if iArgCount < 2 {
              iArgs.appendCExpr(builder.cIntLiteral(Bigint(10u64)))
            }
          } else {
            // toStringLE/toStringBE need the receiver's width in bytes.
            iArgs.appendCExpr(builder.cIntLiteral(Bigint(<u64>(intWidth / 8u32))))
          }
          return builder.cCall(self.location, intfn, c.CExpr(iArgs))
        }
      }

      // Built-in methods on arrays.
      array = left.firstChildExpr!
      if array.typedValue.type == types.Type.TypeClass.Tuple {
        tField = array.nextExprChildExpr!
        if tField.toString() == "toString" {
          // Capture the tuple print helper's output as a string.
          tTy = builder.typechecker.resolve(array.typedValue!)
          builder.ensureTupleDeclared(self.location, tTy)
          tDef = builder.typeGenerator.genCTuple(tTy.tuple!)
          ttsArgs = c.CExprList()
          ttsInner = c.CExprList()
          ttsInner.appendCExpr(array.genC(builder))
          ttsArgs.appendCExpr(builder.cCall(self.location,
              "tostring_%s_t" % tDef.name, c.CExpr(ttsInner)))
          return builder.cCall(self.location, "RN_TOSTRING_RET", c.CExpr(ttsArgs))
        }
      }
      if array.typedValue.type == types.Type.TypeClass.Array {
        field = array.nextExprChildExpr!
        if field.toString() == "toString" {
          // Capture the array print helper's output as a string.
          aTy = builder.typechecker.resolve(array.typedValue!)
          aDef = builder.ensureArrayDeclared(self.location, aTy.array.elementType!)
          atsArgs = c.CExprList()
          atsInner = c.CExprList()
          atsInner.appendCExpr(array.genC(builder))
          atsArgs.appendCExpr(builder.cCall(self.location,
              "tostring_%s_t" % aDef.typeName, c.CExpr(atsInner)))
          return builder.cCall(self.location, "RN_TOSTRING_RET", c.CExpr(atsArgs))
        }
        switch field.toString() {
          "append" => fn = c.CRuntimeFunction.ArrayAppend
          "concat" => fn = c.CRuntimeFunction.ArrayConcat
          "resize" => fn = c.CRuntimeFunction.ArrayResize
          "items" => fn = c.CRuntimeFunction.ArrayItems
          "length" => fn = c.CRuntimeFunction.ArrayLength
          "reverse" => fn = c.CRuntimeFunction.ArrayReverse
          "values" => fn = c.CRuntimeFunction.ArrayValues
          default => raise Status.Unimplemented, "Unknown array builtin operator: \"", field, "\""
        }
        args = c.CExprList()
        args.append(array.genC(builder))
        // No-arg methods like length() must not emit an empty tuple object.
        emptyArgs = ((right.type == ExprType.List || right.type == ExprType.Tuple) &&
            isnull(right.firstChildExpr))
        if !emptyArgs {
          args.append(right.genC(builder))
        }
        return builder.cCall(self.location, fn, c.CExpr(args), right.typedValue)
      }
    }

    // Process and byte-level IO builtins map to runtime helpers.
    if left.type == ExprType.Ident {
      builtinName = left.val.symVal.name
      if builtinName == "secret" || builtinName == "reveal" {
        // The bootstrap has no constant-time mode; secrecy wrappers are
        // identity functions.
        inner = right
        if right.type == ExprType.List && !isnull(right.firstChildExpr) {
          inner = right.firstChildExpr!
        }
        return inner.genC(builder)
      }
      if builtinName == "readln" && isnull(builder.findFunction("readln")) {
        return builder.cCall(self.location, c.CRuntimeFunction.ReadLn, null(c.CExpr))
      }
      if builtinName == "f64tostring" || builtinName == "f32tostring" {
        floatCallee = builder.findFunction(builtinName)
        if !isnull(floatCallee) {
          if floatCallee.isExtern {
            // The legacy extern writes into its string argument; our
            // strings are plain char*, so emit dest = rn_..._ret(value).
            fDest = right.firstChildExpr!
            fVal = fDest.nextExprChildExpr!
            fArgs = c.CExprList()
            fArgs.appendCExpr(fVal.genC(builder))
            fHelper = "f64tostring_ret"
            if builtinName == "f32tostring" {
              fHelper = "f32tostring_ret"
            }
            fHelperFn = c.CExpr(c.CIdentifier(Sym.new(fHelper),
                null(c.CTypeExpr), false, false, false))
            fCall = c.CExpr(c.CCall(self.location, c.CRuntimeFunction.ExternC,
                c.CExpr(fArgs), fHelperFn, null(c.CTypeExpr)))
            return c.CExpr(c.CBinaryOperator(self.location,
                c.CBinaryOperator.Type.Assign, null(c.CTypeExpr),
                fDest.genC(builder), fCall))
