        specializedName = nameTy.genSpecializationName(left.val.symVal.name)
      }
      // A recursive call inside the instance being emitted is usually a call
      // to that same instance; its argument snapshots may chain to stale
      // definition-time bindings and compose the wrong name, so force the
      // current instance's name.  BUT argTypes above is live-resolved under
      // the active instantiation, so when it is fully concrete the arg-based
      // name is already correct -- and a recursive call whose concrete arg
      // types DIFFER from the current instance is a genuinely different
      // instantiation (type-shrinking recursion like depth(x[0]), or
      // manySignatures' rotated params) that must keep its own name so that
      // instantiation gets emitted.  Only override when argTypes is not
      // concrete (its snapshot is unreliable).
      if !isnull(builder.currentEmittingFn) {
        recCallee = builder.findFunction(left.val.symVal.name)
        if !isnull(recCallee) {
          if recCallee! == builder.currentEmittingFn! {
            if builder.typechecker.containsAdaptableType(argTypes) {
              specializedName = builder.currentEmittingName
            }
          }
        }
      }
      if !builder.alreadyEmitted(specializedName) {
        // The definition-side sweep skips instantiations whose bindings only
        // resolve under an outer instantiation (e.g. a call from a
        // polymorphic class constructor).  Emit the specialization now,
        // while that binding is active.
        callee = builder.findFunction(left.val.symVal.name)
        if !isnull(callee) {
          // Hand the composed name, its GROUND arg types, and the call's
          // recovered result to the definition side: recorded
          // instantiations' own slots re-resolve under outer frames and
          // can bake another spec's types into the signature.  Only a
          // reliable composition may be handed off (adaptable-int specs
          // name by VALUE; their recovered types cannot rebuild names).
          // Only a reliable composition may be handed off: ground,
          // non-adaptable, and NOT a value-named spec family (a
          // definition whose params are VALUE-typed ints names specs by
          // VALUE; recovered arg types carry widths and would compose
          // names in the wrong name space).
          wsReliable = (!builder.typechecker.hasFreeVars(argTypes) &&
              !builder.typechecker.containsAdaptableType(argTypes))
          if wsReliable {
            wsScope = builder.typechecker.resolve(callee.typedValue!)
            if wsScope.type == types.Type.TypeClass.Polymorphic {
