use sym

use root
use datatype
use filepath
use location
use bigint
use block
use expr
use rel
use value

import cbackend as c
import types

enum StateType {
  Assert
  If
  ElseIf
  Else
  Switch
  Typeswitch
  Case
  Default
  Do
  While
  For
  Assign
  Call
  Panic
  Print  // print "Hello, World!\n"
  Println  // println "Hello, World!"
  Try
  Except
  Raise
  Return
  Transform
  Relation
  Appendcode
  Prependcode
  Use
  Import
  ImportLib
  ImportRpc
  Foreach
  Yield
  Ref  // These two are used by transformers to manage reference counts.
  Unref
  // Holds statements spliced in by iterator inlining; has no source keyword.
  InlinedBlock
}

// Get the statement type keyword.
export func statementTypeGetKeyword(type: StateType) {
  switch type {
    StateType.Assert => return "assert"
    StateType.If => return "if"
    StateType.ElseIf => return "else if"
    StateType.Else => return "else"
    StateType.Do => return "do"
    StateType.While => return "while"
    StateType.For => return "for"
    StateType.Foreach => return "foreach"
    StateType.Assign => return "assignment"
    StateType.Call => return "call"
    StateType.Panic => return "panic"
    StateType.Print => return "print"
    StateType.Println => return "println"
    StateType.Try => return "try"
    StateType.Except => return "except"
    StateType.Raise => return "raise"
    StateType.Return => return "return"
    StateType.Switch => return "switch"
    StateType.Typeswitch => return "typeswitch"
    StateType.Case => return "case"
    StateType.Default => return "default"
    StateType.Relation => return "relation"
    StateType.Transform => return "transform"
    StateType.Appendcode => return "appendcode"
    StateType.Prependcode => return "prependcode"
    StateType.Use => return "use"
    StateType.Import => return "import"
    StateType.ImportLib => return "importlib"
    StateType.ImportRpc => return "importrpc"
    StateType.Yield => return "yield"
    StateType.Ref => return "ref"
    StateType.Unref => return "unref"
    StateType.InlinedBlock => return "inlined block"
  }
}

// Represents all statements in Rune.
class Statement(self, block: Block, type: StateType, location: Location) {
  self.type = type
  self.location = location
  self.instantiated = false
  self.executed = false  // Only for relation statements, so we don't execute them twice.
  self.generated = false // This statement was generated by a transformer or iterator.
  self.isFirstAssignment = false  // True if this is the first assignment to a variable, at top level.
  // For typeswitch: the index of the case selected at typecheck time, or
  // the sentinel when selection is deferred to per-instantiation codegen.
  self.selectedCaseIndex = 0xffffffffu32
  block.appendStatement(self)

  // Dump a statement to |text| without its sub-block.
  func dumpNoSubBlock(self:Statement, var text: string) {
    getRoot().indent(text)
    needSpace = false
    if self.type != StateType.Assign && self.type != StateType.Call {
      text.concat(statementTypeGetKeyword(self.type))
      needSpace = true
    }
    expr = self.expr
    if !isnull(expr) {
      if needSpace {
        text.append(' ')
      }
      expr.dumpToString(text)
    }
  }

  // Dump the statement to the end of |text| for debugging purposes.
  func dumpToString(self, var text: string) {
    self.dumpNoSubBlock(text)
    block = self.subBlock
    if !isnull(block) {
      text += " {\n"
      getRoot().incrementIndent()
      block.dumpToString(text)
      getRoot().decrementIndent()
      getRoot().indent(text)
      text += "}\n"
    } else {
      text += "\n"
    }
  }

  // Dump the statement to stdout for debugging purposes.
  func dump(self) {
    text = ""
    self.dumpToString(text)
    println text
  }

  // Copy a statement's expression and sub-block to the new statement.
  func copyExprAndSubBlock(self, newStatement: Statement) {
    expr = self.expr
    if !isnull(expr) {
      newExpr = expr.copy()
      newStatement.insertExpr(newExpr)
    }
    subBlock = self.subBlock
    if !isnull(subBlock) {
      newSubBlock = subBlock.copy()
      newStatement.insertSubBlock(newSubBlock)
    }
  }

  // Append a deep copy of the statement to destBlock.
  func appendCopy(self, destBlock: Block) -> Statement {
    newStatement = Statement(destBlock, self.type, self.location)
    self.copyExprAndSubBlock(newStatement)
    newStatement.instantiated = self.instantiated
    newStatement.executed = self.executed
    newStatement.generated = self.generated
    return newStatement
  }

  // Prepend a deep copy of the statement to destBlock.
  func prependCopy(self, destBlock: Block) -> Statement {
    newStatement = self.appendCopy(destBlock)
    // Move the statement to the start of the block.
    destBlock.removeStatement(newStatement)
    destBlock.insertStatement(newStatement)
    return newStatement
  }

  // Append a deep copy of the statement to destStatement's block, right after
  // |destStatement|.
  func appendCopyAfterStatement(self, destStatement: Statement) -> Statement {
    destBlock = destStatement.block!
    newStatement = self.appendCopy(destBlock)
    destBlock.removeStatement(newStatement)
    destBlock.insertAfterStatement(destStatement, newStatement)
    return newStatement
  }

  // C Generator .................................................

  func genC(self, builder: c.CBuilder) {
    switch self.type {
      StateType.Assign => self.genCAssign(builder)
      StateType.Print => self.genCPrint(builder, newline=false)
      StateType.Println => self.genCPrint(builder, newline=true)
      StateType.If => self.genCIf(builder)
      StateType.Else => self.genElse(builder)
      StateType.ElseIf => self.genElseIf(builder)
      StateType.For => self.genCFor(builder)
      StateType.Return => self.genCReturn(builder)
      StateType.Call => builder.addStatement(self.location, self.expr.genC(builder))
      StateType.While => self.genCWhile(builder)
      StateType.Do => self.genCDo(builder)
      StateType.Assert => self.genCAssert(builder)
      StateType.Foreach => self.genCForeach(builder)
      StateType.Switch => self.genCSwitch(builder)
      StateType.Typeswitch => self.genCTypeswitch(builder)
      StateType.Raise => self.genCRaise(builder)
      StateType.Try => self.genCTry(builder)
      StateType.Except => {
        // The preceding try statement generates the except handler.
        prev = self.prevBlockStatement
        assert !isnull(prev) && prev.type == StateType.Try
      }
      StateType.InlinedBlock => self.genCInlinedBlock(builder)
      // Module loading happens before typechecking; the statements
      // themselves emit nothing.
      StateType.Import => return
      StateType.ImportLib => return
      StateType.ImportRpc => return
      StateType.Use => return
      default => raise Status.Unimplemented, "Statement type not yet supported by C backend builder ", self.type
    }
  }

  // Statements spliced in by iterator inlining; they emit directly into the
  // enclosing C block.
  func genCInlinedBlock(self, builder: c.CBuilder) {
    // Pre-declare the foreach loop variable here: its first assignment is
    // inside the inlined iterator's loop, which would otherwise scope the C
    // declaration to that loop's body.
    loopVarExpr = self.expr.firstChildExpr!
    if loopVarExpr.type == ExprType.Ident {
      builder.cIdentifier(loopVarExpr.val.symVal!, true)
    }
    for s in self.subBlock.statements() {
      s.genC(builder)
    }
  }

  func genCAssign(self, builder: c.CBuilder) {
    assert isnull(self.subBlock)
    assert !isnull(self.expr)
    if self.expr.type == ExprType.Equals && self.expr.lastChildExpr.isType {
      // Type-valued assignments like t = u32 exist only at compile time.
      return
    }
    // Overwriting an object reference destroys the previous object:
    // if (lhs) { Class_final(lhs); }
    if self.expr.type == ExprType.Equals {
      assignLhs = self.expr.firstChildExpr!
      if assignLhs.type == ExprType.Ident {
        finalName = builder.classFinalName(assignLhs.typedValue)
        if finalName != "" {
          lhsSym = assignLhs.val.symVal!
          condRef = c.CExpr(c.CIdentifier(lhsSym, null(c.CTypeExpr),
              false, false, false))
          callRef = c.CExpr(c.CIdentifier(lhsSym, null(c.CTypeExpr),
              false, false, false))
          finalArgs = c.CExprList()
          finalArgs.appendCExpr(callRef)
          builder.openBlock(self.location)
          builder.addStatement(self.location,
              builder.cCall(self.location, finalName, c.CExpr(finalArgs)))
          finalBody = builder.closeBlock()
          builder.addStatement(self.location,
              c.CStatement(self.location, c.CStatementType.If, condRef, finalBody))
          if isnull(builder.currentBlock) {
            builder.registerMainFinal(lhsSym, finalName)
          }
        }
      }
    }
    cexpr = self.expr.genC(builder)
    builder.addStatement(self.location, c.CStatement(self.location, c.CStatementType.Assignment, cexpr))
  }

  func genCCall(self, builder: c.CBuilder, fn: c.CExpr | c.CRuntimeFunction, args: c.CExpr?) {
    builder.addStatement(self.location, builder.cCall(self.location, fn, args))
  }

  func genCPrint(self, builder: c.CBuilder, newline: bool) {
    assert isnull(self.subBlock)
    assert !isnull(self.expr)

    // Println can write a list of expressions to standard out. Each
    // expression is printed immediately after one another. It is able to
    // generate string representations of many expressions, in particular
    // the values of built-in types and tuples.
    //
    // A special case is where the expression is an instance of the modulus
    // operator where the first argument is a string: in this case, it is
    // a printf-like expression, and we should generate an individual
    // printf format string.

    assert self.expr.type == ExprType.List

    self.genCCall(builder, c.CRuntimeFunction.GlobalStringWriterReset, null(c.CExpr))

    // Special case -- when argument is a single string.
    if (self.expr.countChildExprs() == 1
        && self.expr.indexChildExpr(0).type == ExprType.Constant
        && self.expr.indexChildExpr(0).val.type == DatatypeType.String) {
      // println/print with a single string should just printf that string.
      args = c.CExprList()
      args.appendCExpr(self.expr.indexChildExpr(0).genC(builder))
      cexpr = c.CExpr(args)
      call = builder.cCall(self.location, "tostring_string_t", cexpr)
      builder.addStatement(self.location, call)
    } else {
      for expr in self.expr.childExprs() {
        cexpr = null(c.CExpr)
        if expr.isType {
          // Type values have no runtime representation; print the type's
          // Rune spelling (e.g. "u32" or "(u32, string)") as a literal.
          typeArgs = c.CExprList()
          typeArgs.append(builder.cStringLiteral("%s"))
          typeArgs.append(builder.cStringLiteral(
              builder.typechecker.resolve(expr.typedValue!).runeString()))
          cexpr = c.CExpr(typeArgs)
          typeCall = builder.cCall(self.location, "tostring_string_t", cexpr!)
          builder.addStatement(self.location, typeCall)
        } else if expr.type == ExprType.Mod {
          left = expr.firstChildExpr!
          right = left.nextExprChildExpr!
          if (left.type == ExprType.Constant && left.val.type == DatatypeType.String &&
              left.val.stringVal.length() >= 3 && left.val.stringVal[0] == '%' &&
              left.val.stringVal[1] == '[' &&
              left.val.stringVal[left.val.stringVal.length() - 1] == ']') {
            // A format that is one whole array directive, e.g. "%[u]" or
            // "%[[s]]": print the array argument like a bare println would.
            fmtArr = right
            if right.type == ExprType.Tuple && !isnull(right.firstChildExpr) {
              fmtArr = right.firstChildExpr!
            }
            arrCExpr = fmtArr.genC(builder)
            arrCType = builder.genCType(fmtArr.typedValue)
            if !isnull(arrCType) {
              arrCall = builder.cCall(self.location,
                  "tostring_%s_t" % arrCType.toString(), arrCExpr)
              builder.addStatement(self.location, arrCall)
              cexpr = arrCExpr
            }
          } else if left.type == ExprType.Constant && left.val.type == DatatypeType.String {
            args = c.CExprList()
            args.appendCExpr(builder.cStringLiteral(left.val.stringVal, printf=true))
            // Tuple arguments spread into the vararg list; integers widen
            // to 64 bits to match the PRI*64 format directives.
            if right.type == ExprType.Tuple {
              for fmtChild in right.childExprs() {
                args.appendCExpr(builder.cFormatArg(self.location,
                    fmtChild.genC(builder), fmtChild.typedValue))
              }
            } else {
              args.appendCExpr(builder.cFormatArg(self.location,
                  right.genC(builder), right.typedValue))
            }
            cexpr = c.CExpr(args)
            self.genCCall(builder, c.CRuntimeFunction.GlobalStringWriterWrite, cexpr)
          }
        }
        if isnull(cexpr) {
          cexpr = expr.genC(builder)
          ctype = builder.genCType(expr.typedValue)
          assert !isnull(ctype)
          ctypename = ctype.toString()

          if ctypename == "string" {
            // String values need to be emitted with quotes.
            printfArgs = c.CExprList()
            printfArgs.append(builder.cStringLiteral("%s"))
            printfArgs.append(cexpr!)
            call = builder.cCall(self.location, "tostring_string_t", c.CExpr(printfArgs))
          } else {
            call = builder.cCall(self.location, "tostring_%s_t" % ctypename, cexpr)
          }
          builder.addStatement(self.location, call)
        }
      }
    }
    if newline {
      self.genCCall(builder, c.CRuntimeFunction.GlobalStringWriterWrite,
                    builder.cStringLiteral("\n"))
    }
    // Finally generate the call to printf: printf("%s", GlobalStringWriterString())
    printfArgs = c.CExprList()
    printfArgs.append(builder.cStringLiteral("%s"))
    printfArgs.append(
        builder.cCall(self.location, c.CRuntimeFunction.GlobalStringWriterString,
                      null(c.CExpr)))
    self.genCCall(builder, c.CRuntimeFunction.Printf, c.CExpr(printfArgs))
  }

  // raise Status.Foo, msg... composes the message in the global string
  // writer, records the code path text, and unwinds to the innermost try
  // frame via the raise_with_code() runtime helper (aborting if there is
  // no enclosing try).
  func genCRaise(self, builder: c.CBuilder) {
    assert !isnull(self.expr)
    self.genCCall(builder, c.CRuntimeFunction.GlobalStringWriterReset, null(c.CExpr))
    codeText = ""
    rfirst = true
    for expr in self.expr.childExprs() {
      if rfirst {
        // The error code path (e.g. Status.Foo) is matched by except cases
        // and prefixed to the uncaught-abort message; it is not a value.
        codeText = expr.toString() + " "
      } else {
        cexpr = expr.genC(builder)
        ctype = builder.genCType(expr.typedValue)
        if !isnull(ctype) {
          ctypename = ctype.toString()
          if ctypename == "string" {
            sArgs = c.CExprList()
            sArgs.append(builder.cStringLiteral("%s"))
            sArgs.append(cexpr!)
            call = builder.cCall(self.location, "tostring_string_t", c.CExpr(sArgs))
          } else {
            call = builder.cCall(self.location, "tostring_%s_t" % ctypename, cexpr)
          }
          builder.addStatement(self.location, call)
        }
      }
      rfirst = false
    }
    raiseArgs = c.CExprList()
    raiseArgs.append(builder.cStringLiteral(codeText))
    raiseArgs.append(
        builder.cCall(self.location, c.CRuntimeFunction.GlobalStringWriterString,
                      null(c.CExpr)))
    self.genCCall(builder, c.CRuntimeFunction.RaiseWithCode, c.CExpr(raiseArgs))
  }

  // try { B } except e { cases } compiles to a setjmp/longjmp frame:
  //   uint32_t try_frame_N = rn_try_depth;
  //   if (RN_TRY()) { B; rn_try_depth = try_frame_N; }
  //   else { <bind e; dispatch except cases> }
  // RN_TRY() pushes a frame on the runtime try stack and setjmps it;
  // raise_with_code() longjmps to the innermost frame.  A return inside B
  // pops this function's frames first (see genCReturn).
  func genCTry(self, builder: c.CBuilder) {
    assert !isnull(self.subBlock)
    exceptStatement = self.nextBlockStatement
    assert !isnull(exceptStatement) && exceptStatement.type == StateType.Except

    // Save the frame depth at entry in a local so normal exit and returns
    // can pop every frame this try (and any nested in it) pushed.
    frameSym = Sym.new("try_frame_%u" % self.location.line)
    u32type = c.CTypeExpr(c.CPrimitiveType(c.CPrimitiveType.Type.Uint32))
    frameRef = builder.declareLocal(frameSym, u32type)
    depthRef = c.CExpr(c.CIdentifier(Sym.new("rn_try_depth"),
                                     null(c.CTypeExpr), false, false, false))
    saveAssign = c.CExpr(c.CBinaryOperator(self.location, c.CBinaryOperator.Type.Assign,
                                           null(c.CTypeExpr), frameRef, depthRef))
    builder.addStatement(self.location,
        c.CStatement(self.location, c.CStatementType.Assignment, saveAssign))
    if builder.tryFrameDepth == builder.tryFrameSyms.length() {
      builder.tryFrameSyms.append(frameSym)
    } else {
      builder.tryFrameSyms[builder.tryFrameDepth] = frameSym
    }
    builder.tryFrameDepth += 1u64

    cond = builder.cCall(self.location, c.CRuntimeFunction.TryEnter, null(c.CExpr))
    builder.openBlock(self.location)
    for s in self.subBlock.statements() {
      s.genC(builder)
    }
    // Pop the frame on normal exit from the try body.
    depthRef2 = c.CExpr(c.CIdentifier(Sym.new("rn_try_depth"),
                                      null(c.CTypeExpr), false, false, false))
    frameRef2 = c.CExpr(c.CIdentifier(frameSym, null(c.CTypeExpr), false, false, false))
    popAssign = c.CExpr(c.CBinaryOperator(self.location, c.CBinaryOperator.Type.Assign,
                                          null(c.CTypeExpr), depthRef2, frameRef2))
    builder.addStatement(self.location,
        c.CStatement(self.location, c.CStatementType.Assignment, popAssign))
    tryBody = builder.closeBlock()
    builder.addStatement(self.location,
        c.CStatement(self.location, c.CStatementType.If, cond, tryBody))

    exceptStatement.genCExcept(builder)
    builder.tryFrameDepth -= 1u64
  }

  // The else-branch of a try's setjmp: bind the exception variable's
  // errorMessage and dispatch the except cases on the raised code text.
  func genCExcept(self, builder: c.CBuilder) {
    assert !isnull(self.expr)
    assert !isnull(self.subBlock)
    builder.openBlock(self.location)
    // Copy the message out of the global string writer before the handler's
    // own tostring calls clobber it.  Nested handlers reusing the same
    // variable name shadow correctly: each declaration lands in its own
    // C block.
    eName = self.expr.val.symVal.name
    msgSym = Sym.new(eName + "_errorMessage")
    strType = c.CTypeExpr(c.CDefinedType("string"))
    msgRef = builder.declareLocal(msgSym, strType)
    dupArgs = c.CExprList()
    dupArgs.append(c.CExpr(c.CIdentifier(Sym.new("rn_raised_message"),
                                         null(c.CTypeExpr), false, false, false)))
    dupCall = builder.cCall(self.location, c.CRuntimeFunction.StringDup, c.CExpr(dupArgs))
    msgAssign = c.CExpr(c.CBinaryOperator(self.location, c.CBinaryOperator.Type.Assign,
                                          null(c.CTypeExpr), msgRef, dupCall))
    builder.addStatement(self.location,
        c.CStatement(self.location, c.CStatementType.Assignment, msgAssign))
    // Case dispatch, like genCSwitch: each case lists raise code paths
    // (e.g. Status.Foo) matched as text against the raised code.
    first = true
    for caseStatement in self.subBlock.statements() {
      assert !isnull(caseStatement.subBlock)
      body = caseStatement.subBlock.genC(builder)
      if caseStatement.type == StateType.Case {
        cond = null(c.CExpr)
        for valExpr in caseStatement.expr.childExprs() {
          mArgs = c.CExprList()
          mArgs.append(builder.cStringLiteral(valExpr.toString() + " "))
          cmp = builder.cCall(valExpr.location, "rn_code_matches", c.CExpr(mArgs))
          if isnull(cond) {
            cond = cmp
          } else {
            cond = c.CExpr(c.CBinaryOperator(valExpr.location, c.CBinaryOperator.Type.LogOr,
                                             null(c.CTypeExpr), cond!, cmp))
          }
        }
        stmtType = first ? c.CStatementType.If : c.CStatementType.ElseIf
        builder.addStatement(caseStatement.location,
            c.CStatement(caseStatement.location, stmtType, cond!, body))
      } else {
        // The default case.  If it is the only case, guard it with if (1).
        if first {
          one = c.CExpr(c.CLiteral(Bigint(1u32), false))
          builder.addStatement(caseStatement.location,
              c.CStatement(caseStatement.location, c.CStatementType.If, one, body))
        } else {
          builder.addStatement(caseStatement.location,
              c.CStatement(caseStatement.location, c.CStatementType.Else, null(c.CExpr), body))
        }
      }
      first = false
    }
    handlerBody = builder.closeBlock()
    builder.addStatement(self.location, builder.cElseStatement(self.location, handlerBody))
  }

  func genElse(self, builder: c.CBuilder) {
    assert isnull(self.expr)
    assert !isnull(self.subBlock)
    elseStmt = builder.cElseStatement(self.location, self.subBlock.genC(builder))
    builder.addStatement(self.location, elseStmt)
  }

  func genElseIf(self, builder: c.CBuilder) {
    assert !isnull(self.expr)
    assert !isnull(self.subBlock)
    elseIfStmt = builder.cElseIfStatement(
       self.location, self.expr.genC(builder), self.subBlock.genC(builder))
    builder.addStatement(self.location, elseIfStmt)
  }

  func genCFor(self, builder: c.CBuilder) {
    assert !isnull(self.expr)
    assert !isnull(self.subBlock)
    // Generate the cexpr first so that the iterator variable is declared in
    // the enclosing scope.
    cexpr = self.expr.genC(builder)
    cbody = self.subBlock.genC(builder)
    forStmt = builder.cForStatement(self.location, cexpr, cbody)
    builder.addStatement(self.location, forStmt)
  }

  func genCIf(self, builder: c.CBuilder) {
    assert !isnull(self.expr)
    assert !isnull(self.subBlock)
    ifStmt = builder.cIfStatement(
       self.location, self.expr.genC(builder), self.subBlock.genC(builder))
    builder.addStatement(self.location, ifStmt)
  }

  func genCReturn(self, builder: c.CBuilder) {
    assert isnull(self.subBlock)
    if builder.tryFrameDepth > builder.tryFrameBase {
      // This return is inside a try block: pop every frame this function's
      // try statements pushed before leaving (the outermost frame local of
      // this function holds the depth at function entry).
      frameRef = c.CExpr(c.CIdentifier(builder.tryFrameSyms[builder.tryFrameBase],
                                       null(c.CTypeExpr), false, false, false))
      depthRef = c.CExpr(c.CIdentifier(Sym.new("rn_try_depth"),
                                       null(c.CTypeExpr), false, false, false))
      restore = c.CExpr(c.CBinaryOperator(self.location, c.CBinaryOperator.Type.Assign,
                                          null(c.CTypeExpr), depthRef, frameRef))
      builder.addStatement(self.location,
          c.CStatement(self.location, c.CStatementType.Assignment, restore))
    }
    cexpr = null(c.CExpr)
    if !isnull(self.expr) {
      cexpr = self.expr.genC(builder)
    }
    returnStmt = builder.cReturnStatement(self.location, cexpr)
    builder.addStatement(self.location, returnStmt)
  }

  func genCWhile(self, builder: c.CBuilder) {
    prev = self.prevBlockStatement
    if !isnull(prev) && prev.type == StateType.Do {
      // This while terminates a do-while loop; the do statement generates it.
      return
    }
    assert !isnull(self.expr)
    assert !isnull(self.subBlock)
    cexpr = self.expr.genC(builder)
    cbody = self.subBlock.genC(builder)
    builder.addStatement(self.location,
        c.CStatement(self.location, c.CStatementType.While, cexpr, cbody))
  }

  func genCDo(self, builder: c.CBuilder) {
    assert !isnull(self.subBlock)
    whileStatement = self.nextBlockStatement
    assert !isnull(whileStatement) && whileStatement.type == StateType.While
    if isnull(whileStatement.subBlock) {
      // Plain do-while: do { ... } while cond
      body = self.subBlock.genC(builder)
      cond = whileStatement.expr.genC(builder)
      builder.addStatement(self.location,
          c.CStatement(self.location, c.CStatementType.Do, cond, body))
    } else {
      // Generalized loop with a while body:
      //   while (1) { <do-body>; if (!cond) break; <while-body>; }
      builder.openBlock(self.location)
      for s in self.subBlock.statements() {
        s.genC(builder)
      }
      cond = whileStatement.expr.genC(builder)
      notCond = c.CExpr(c.CPrefixOperator(self.location,
          c.CPrefixOperator.Type.LogNot, cond))
      builder.openBlock(self.location)
      builder.addStatement(self.location,
          c.CStatement(self.location, c.CStatementType.Break))
      breakBody = builder.closeBlock()
      builder.addStatement(self.location,
          c.CStatement(self.location, c.CStatementType.If, notCond, breakBody))
      for s in whileStatement.subBlock.statements() {
        s.genC(builder)
      }
      body = builder.closeBlock()
      one = c.CExpr(c.CLiteral(Bigint(1u32), false))
      builder.addStatement(self.location,
          c.CStatement(self.location, c.CStatementType.While, one, body))
    }
  }

  func genCForeach(self, builder: c.CBuilder) {
    assert !isnull(self.expr)
    assert !isnull(self.subBlock)
    loopVarExpr = self.expr.firstChildExpr!
    iterExpr = loopVarExpr.nextExprChildExpr!
    if iterExpr.type == ExprType.Call {
      target = iterExpr.firstChildExpr!
      argExpr = target.nextExprChildExpr
      if target.type == ExprType.Ident && target.val.symVal.name == "range" {
        self.genCForeachRange(builder, loopVarExpr, argExpr!)
        return
      }
      if target.type == ExprType.Dot {
        base = target.firstChildExpr!
        methodName = base.nextExprChildExpr.toString()
        if methodName == "values" {
          self.genCForeachArray(builder, loopVarExpr, base, false)
          return
        }
        if methodName == "items" {
          self.genCForeachArray(builder, loopVarExpr, base, true)
          return
        }
      }
    }
    // Plain array iteration: for x in arr.
    self.genCForeachArray(builder, loopVarExpr, iterExpr, false)
  }

  // Emit: for (i = start; i < end; i = i + 1) { ... }
  func genCForeachRange(self, builder: c.CBuilder, loopVarExpr: Expr, argExpr: Expr) {
    loopSym = loopVarExpr.val.symVal!
    if argExpr.type == ExprType.Tuple {
      first = argExpr.firstChildExpr!
      second = first.nextExprChildExpr!
      cstart = first.genC(builder)
      cend = second.genC(builder)
    } else {
      zero = Bigint(0u64)
      cstart = builder.cIntLiteral(zero)
      cend = argExpr.genC(builder)
    }
    initRef = builder.cIdentifier(loopSym, true)
    init = c.CExpr(c.CBinaryOperator(self.location, c.CBinaryOperator.Type.Assign,
                                     null(c.CTypeExpr), initRef, cstart))
    cond = c.CExpr(c.CBinaryOperator(self.location, c.CBinaryOperator.Type.LessThan,
                                     null(c.CTypeExpr), builder.cIdentifier(loopSym, false), cend))
    oneVal = Bigint(1u64)
    plus = c.CExpr(c.CBinaryOperator(self.location, c.CBinaryOperator.Type.Plus,
                                     null(c.CTypeExpr), builder.cIdentifier(loopSym, false),
                                     builder.cIntLiteral(oneVal)))
    incr = c.CExpr(c.CBinaryOperator(self.location, c.CBinaryOperator.Type.Assign,
                                     null(c.CTypeExpr), builder.cIdentifier(loopSym, false), plus))
    list = c.CExprList()
    list.appendCExpr(init)
    list.appendCExpr(cond)
    list.appendCExpr(incr)
    body = self.subBlock.genC(builder)
    builder.addStatement(self.location,
        c.CStatement(self.location, c.CStatementType.For, c.CExpr(list), body))
  }

  // Emit: for (idx = 0; idx < array_length(arr); idx = idx + 1) {
  //         x = arr[idx];  (or x = (idx, arr[idx]) for items())
  //         ...
  //       }
  func genCForeachArray(self, builder: c.CBuilder, loopVarExpr: Expr, arrayExpr: Expr,
                        isItems: bool) {
    loopSym = loopVarExpr.val.symVal!
    idxSym = Sym.new("%s_index" % loopSym.name)
    u64type = builder.cIntType(self.location, false, 64u32)
    idxDecl = builder.declareLocal(idxSym, u64type)

    zero = Bigint(0u64)
    init = c.CExpr(c.CBinaryOperator(self.location, c.CBinaryOperator.Type.Assign,
                                     null(c.CTypeExpr), idxDecl, builder.cIntLiteral(zero)))
    if builder.typechecker.isStringType(arrayExpr.typedValue) {
      lenCall = builder.cCall(self.location, c.CRuntimeFunction.StringLength,
                              arrayExpr.genC(builder))
    } else {
      lenCall = builder.cCall(self.location, c.CRuntimeFunction.ArrayLength,
                              arrayExpr.genC(builder))
    }
    idxRef1 = c.CExpr(c.CIdentifier(idxSym, null(c.CTypeExpr), false, false, false))
    cond = c.CExpr(c.CBinaryOperator(self.location, c.CBinaryOperator.Type.LessThan,
                                     null(c.CTypeExpr), idxRef1, lenCall))
    oneVal = Bigint(1u64)
    idxRef2 = c.CExpr(c.CIdentifier(idxSym, null(c.CTypeExpr), false, false, false))
    idxRef3 = c.CExpr(c.CIdentifier(idxSym, null(c.CTypeExpr), false, false, false))
    plus = c.CExpr(c.CBinaryOperator(self.location, c.CBinaryOperator.Type.Plus,
                                     null(c.CTypeExpr), idxRef2, builder.cIntLiteral(oneVal)))
    incr = c.CExpr(c.CBinaryOperator(self.location, c.CBinaryOperator.Type.Assign,
                                     null(c.CTypeExpr), idxRef3, plus))
    list = c.CExprList()
    list.appendCExpr(init)
    list.appendCExpr(cond)
    list.appendCExpr(incr)

    builder.openBlock(self.location)
    idxRef4 = c.CExpr(c.CIdentifier(idxSym, null(c.CTypeExpr), false, false, false))
    element = c.CExpr(c.CIndexExpr(self.location, arrayExpr.genC(builder), idxRef4))
    if isItems {
      idxRef5 = c.CExpr(c.CIdentifier(idxSym, null(c.CTypeExpr), false, false, false))
      pairArgs = c.CExprList()
      pairArgs.appendCExpr(idxRef5)
      pairArgs.appendCExpr(element)
      element = builder.cTuple(self.location, loopVarExpr.typedValue, pairArgs)
    }
    loopRef = builder.cIdentifier(loopSym, true)
    assign = c.CExpr(c.CBinaryOperator(self.location, c.CBinaryOperator.Type.Assign,
                                       null(c.CTypeExpr), loopRef, element))
    builder.addStatement(self.location, assign)
    for s in self.subBlock.statements() {
      s.genC(builder)
    }
    body = builder.closeBlock()
    builder.addStatement(self.location,
        c.CStatement(self.location, c.CStatementType.For, c.CExpr(list), body))
  }

  // Lower a switch statement to an if/else-if/else chain.  The scrutinee is
  // evaluated once into a hidden local; each case compares against it, with
  // multiple match values joined by ||.
  func genCSwitch(self, builder: c.CBuilder) {
    assert !isnull(self.expr)
    assert !isnull(self.subBlock)
    ctype = builder.typeGenerator.genCType(self.expr.typedValue!)
    tmpSym = Sym.new("switch_value_%u" % self.location.line)
    tmpRef = builder.declareLocal(tmpSym, ctype)
    assign = c.CExpr(c.CBinaryOperator(self.location, c.CBinaryOperator.Type.Assign,
                                       null(c.CTypeExpr), tmpRef, self.expr.genC(builder)))
    builder.addStatement(self.location, assign)
    first = true
    for caseStatement in self.subBlock.statements() {
      assert !isnull(caseStatement.subBlock)
      body = caseStatement.subBlock.genC(builder)
      if caseStatement.type == StateType.Case {
        cond = null(c.CExpr)
        for valExpr in caseStatement.expr.childExprs() {
          valRef = c.CExpr(c.CIdentifier(tmpSym, null(c.CTypeExpr), false, false, false))
          cmp = c.CExpr(c.CBinaryOperator(valExpr.location, c.CBinaryOperator.Type.Equals,
                                          ctype, valRef, valExpr.genC(builder)))
          if isnull(cond) {
            cond = cmp
          } else {
            cond = c.CExpr(c.CBinaryOperator(valExpr.location, c.CBinaryOperator.Type.LogOr,
                                             null(c.CTypeExpr), cond!, cmp))
          }
        }
        stmtType = first ? c.CStatementType.If : c.CStatementType.ElseIf
        builder.addStatement(caseStatement.location,
            c.CStatement(caseStatement.location, stmtType, cond!, body))
      } else {
        // The default case.  If it is the only case, guard it with if (1).
        if first {
          one = c.CExpr(c.CLiteral(Bigint(1u32), false))
          builder.addStatement(caseStatement.location,
              c.CStatement(caseStatement.location, c.CStatementType.If, one, body))
        } else {
          builder.addStatement(caseStatement.location,
              c.CStatement(caseStatement.location, c.CStatementType.Else, null(c.CExpr), body))
        }
      }
      first = false
    }
  }

  // Typeswitch is compile-time dispatch: only the selected case's body is
  // emitted, inline, with no runtime condition.  When the scrutinee type was
  // polymorphic at typecheck time, the case is selected here under the
  // current instantiation.
  func genCTypeswitch(self, builder: c.CBuilder) {
    assert !isnull(self.subBlock)
    index = self.selectedCaseIndex
    if index == 0xffffffffu32 {
      index = builder.typechecker.selectTypeswitchCase(self, false)
    }
    i = 0u32
    for caseStatement in self.subBlock.statements() {
      if i == index {
        for s in caseStatement.subBlock.statements() {
          s.genC(builder)
        }
      }
      i += 1u32
    }
  }

  func genCAssert(self, builder: c.CBuilder) {
    assert !isnull(self.expr)
    // The expression is a list; the first element is the condition.
    cond = self.expr.firstChildExpr!
    ccond = cond.genC(builder)
    notCond = c.CExpr(c.CPrefixOperator(self.location,
        c.CPrefixOperator.Type.LogNot, ccond))
    builder.openBlock(self.location)
    args = c.CExprList()
    args.appendCExpr(builder.cStringLiteral("Assertion failed"))
    raiseCall = builder.cCall(self.location, c.CRuntimeFunction.Raise, c.CExpr(args))
    builder.addStatement(self.location, raiseCall)
    body = builder.closeBlock()
    builder.addStatement(self.location,
        c.CStatement(self.location, c.CStatementType.If, notCond, body))
  }
}

relation DoublyLinked Block Statement cascade
relation DoublyLinked Relation:"Generated" Statement:"Generated" cascade
relation OneToOne Root:"LastInitializer" Statement:"LastInitializer"

unittest basicStatementTest {
  filepath = Filepath.new("test_filepath", null(Filepath), false)
  location = Location(filepath, 0u32, 0u32, 0u32)
  block = Block(location);
  statement =  Statement(block, StateType.Print, location)
  expr = Expr.newConstant(Value("Hello, World!\n"), location)
  statement.insertExpr(expr)
  statement.dump()
}
