//
// Based on the Hindley-Milner algorithm, see
// https://en.wikipedia.org/wiki/Hindley%E2%80%93Milner_type_system
// for an introduction.
//
// To see how it works, consider the following expression:
//
//   1 + (2 * 3)
//
// with (a simplified representation of the AST for this comment):
//   root: BinaryOp(PLUS,
//     n0:   Uint64(1),
//     n1:   BinaryOp(TIMES,
//    n10:    Uint64(2),
//    n11:    Uint64(3)
//           )
//         )
//
// The algorithm is 'syntax-directed': it builds a type for a node
// directly from the types of its children. The algorithm starts
// at the root:
//
//     1. It is the binary operator PLUS, look up its type:
//           BPOLY(1, [STR, NUM], FN(TUPLE([v, v]), v))
//             (in symbols: forall v1:string|num. (v1, v1) -> v1))
//
//           (this is a "bounded polymorphic function" that takes one
//            type variable 'v1'. The type variable is 'bound' in that
//            it is limited to be either a string (STR) or a numeric (NUM)
//            type. (NUM here means Int | Uint | f32 | f64.))
//
//     2. Recursively typecheck the children:
//           n0 has type Uint64
//           n1 has type Uint64
//
//     3. Apply the type in (2) to the children. This involves
//
//          (a) "opening" the bounded polymorphic type. That is,
//              i. generate a new type variable, 'x', where x is a
//                 hitherto unused type variable number. Note that in our
//                 algorithm, variables generated by opening polymorphic
//                 types have negative numbers, while those inferred for
//                 functions are positive.
//             ii. attach the type constraint [STR, NUM] to the new variable
//            iii. instantiate the body to become:
//                   (vx:str|num, vx:str|num) -> vx:str|num
//
//          (b) "apply" this new function type to the types in (3):
//              i. unify argument type (vx:str|num, vx:str|num)
//                 to (typeof(n0), typeof(n1))
//
//                 unification of tuple types is just sequential unification
//                 of child types. So
//
//             ii. unify the left side of the fn param tuple, vx:str|num
//                 against the left size of the arg tuple, typeof(n0)=Uint64
//                 vx is not instantiated, but it does have the constraint
//                 str|num.  Uint64 belongs to 'num' so the constraint succeeds,
//                 which means vx is now bound to concrete type Uint64.
//
//            iii. unify the right side of the fn param tuple, vx:str|num=Uint64
//                 against the right side of the arg tuple, typeof(n1)=Uint64.
//                 Since vx is already bound, this becomes
//                 unify Uint64 with Uint64, which succeeds because they are
//                 identical types.
//
//             iv. Finally, we return the 'result type' of the function, which
//                 is just vx:str|num=Uint64.
//
// This simple example shows what happens with an ill-formed expression.
// Consider
//
//    1 + "Hello, world!"
//
// or
//    root: BinaryOp(PLUS,
//      n0:   Uint64(1),
//      n1:   String("Hello, world!")
//          )
//
// Following the above typechecking process, we fail at step 3(b).iii above:
//
//   The type variable vx:str|num will have been bound to type Uint64 in
//   step 3(b).ii. When we come to apply the right hand side of the fn param
//   tuple, vx:str|num=Uint64 against the right hand side of the arg tuple,
//   typeof(n1)=string, we end up trying to unify type Uint64 against type
//   string, which fails because they are not equal.
//
// Inferring polymorphic types for definitions.
//
// The above algorithm instantiates existing types. However, we also need to
// infer new polymorphic types for user-defined functions. Consider the function
//
//     func id (x) {
//         return x
//     }
//
// We intuitively know that it is polymorphic in the argument x.  It should have
// type POLY(1, FN(v, v))  -- in symbols:  forall v1.(v1 -> v1).
//
// Type generalization occurs at definitions. We start by generating type variables
// for the parameters, here, x has type v1.  Then, using the above algorithm we
// typecheck the body of the function -- it returns a value of type v1.
//
// Since this is a func, we can infer its type to be
//
//    <typeof parameters> -> <typeof result>
//
// In this example, this boils down to  v1 -> v1.  Since we know that the variable
// v1 was introduced in this function definition (we generated it for parameter x),
// we know that we can bind it to become forall v1.(v1 -> v1).


import database as db
use sym
use builtins
use typeclasses
use typeunifier
use typebuilder
use typeerror

TypeLoggingPrefix = ": "

// Demand-driven materialization budget: a call chain of polymorphic bodies
// each demanding its callee's materialization (find -> findEntry -> ...).
// Bounds pathological cycles that the per-function reentrancy flag does not
// catch; must trip below resolveDepth's 64 chain bound.
MaterializeRecursionLimit = 48u32

STR = STRING()
BOOL = BOOLEAN()
INT = INTEGER()
UINT = UINTEGER()
ANYINT = ANYINTEGER()
NUM = NUMBER()

// Associates a given tyname with its definition.
// Note that this is probably too simple -- it may be that
// we will want typename variables, and when that happens
// we will need a unique tyname identifier.
class TynameDefinition(self, tyname: Sym, ty:Type?) {
  self.tyname = tyname
  self.value = ty

  func hash(self) -> u64 {
    return hashValue(self.tyname.name)
  }

  func equals(self, other: TynameDefinition) -> bool {
    return self.tyname == other.tyname
  }
}

// Associates a given program variable with its type.
class SymbolMapping(self, key: Sym, ty: Type?) {
  self.key = key
  self.value = ty

  func hash(self) -> u64 {
    return hashValue(self.key.name)
  }

  func equals(self, other: SymbolMapping) -> bool {
    return self.key == other.key
  }
}

relation DoublyLinked BindingScope SymbolMapping cascade

class BindingScope(self) {
  func add(self, sm: SymbolMapping) {
    self.appendSymbolMapping(sm)
  }
}

// Records the members of an enum and their integer values.
class EnumInfo(self, sym: Sym) {
  self.sym = sym
  self.memberNames = arrayof(Sym)
  self.memberValues = arrayof(u32)
  // Width of explicitly typed member values (red = 1u8 -> 8); 0 when the
  // members are untyped.  Composite printing suffixes values with it.
  self.valueWidth = 0u32

  func hash(self) -> u64 {
    return hashValue(self.sym.name)
  }

  func equals(self, other: EnumInfo) -> bool {
    return self.sym == other.sym
  }

  // Returns the value of the named member, or u32 max if not found.
  func memberValue(self, name: string) -> u32 {
    for i in range(self.memberNames.length()) {
      if self.memberNames[i].name == name {
        return self.memberValues[i]
      }
    }
    return ~0u32
  }

  func hasMember(self, name: string) -> bool {
    for i in range(self.memberNames.length()) {
      if self.memberNames[i].name == name {
        return true
      }
    }
    return false
  }
}

// Records typechecking information about a class: its constructor function,
// the struct type holding its data members, and the type variables of its
// constructor parameters (in declaration order).
// One specialization's resolved field types, captured while the
// constructor's materialization bindings were active.  The canonical
// strct.fieldtypes additionally get the legacy in-place bake (single-
// signature emission paths read them); multi-signature struct emission
// prefers the snapshot matching its instance type.
class FieldBake(self, spec: string) {
  self.spec = spec
  self.types = arrayof(Type)
}

// One enclosing call's callee bookkeeping for demand-driven
// materialization: classMemberType records the method and the
// instantiation its open just appended; the Call arm consumes the record
// after apply (see demandCallResult).  A stack because argument
// typechecking nests further calls.
class CalleeRecord(self) {
  self.fn = null(db.Function)
  self.inst = null(TyvarInstantiation)
  self.viaExpr = null(db.Expr)
}

relation DoublyLinked ClassInfo FieldBake cascade

class ClassInfo(self, sym: Sym) {
  self.sym = sym
  self.fn = null(db.Function)
  self.strct = null(StructType(arrayof(Sym), arrayof(Type)))
  self.selfType = null(Type)
  self.paramVars = arrayof(Type)
  // The final instance-type arity (count of non-self constructor parameters),
  // recorded before the param loop fills paramVars one-by-one.  null(ThisClass)
  // evaluated re-entrantly mid-construction reads this so it does not mint a
  // too-short instance from a half-filled paramVars.  -1 = not yet recorded.
  self.expectedParamArity = -1i64
  // True while this class's constructorFunction is on the stack (fields not yet
  // fully recorded).  A destroy cross-called during this window (a mutual
  // cascade peer) is given a provisional type instead of being walked in the
  // incomplete context; the eager-destroy pass walks it once construction is
  // complete.  See methodCallType.
  self.constructing = false
  // Fields created by relation-instantiated code (back-pointers, link
  // fields): kept in the struct but skipped by the print helper, which
  // would otherwise recurse through the relation cycle.
  self.generatedFieldNames = arrayof(string)

  func hash(self) -> u64 {
    return hashValue(self.sym.name)
  }

  func equals(self, other: ClassInfo) -> bool {
    return self.sym == other.sym
  }
}

// Maps a function name to its definition, so call sites can look up
// parameter names and default values.
class FunctionDef(self, sym: Sym) {
  self.sym = sym
  self.fn = null(db.Function)

  func hash(self) -> u64 {
    return hashValue(self.sym.name)
  }

  func equals(self, other: FunctionDef) -> bool {
    return self.sym == other.sym
  }
}


// An iterator (or method) added to the builtin Array type via `appendcode
// Array { ... }`.  Arrays have no ClassInfo, so these are kept in a registry on
// the typechecker and dispatched when a `.method()` call's base is an array.
class ArrayExtMethod(self, fn: db.Function) {
  self.fn = fn
}

// === Named-blocker groundwork (Stage 0 of the binding fix; see
// bootstrap/research/IMPLEMENTATION_PLAN.md). ===
// A binding can stall for exactly three reasons, mirroring the legacy C
// binder's three deEvent kinds (UNDEFINED / SIGNATURE / VARIABLE).  Rune
// enums carry no payload, so the design doc's payload-carrying `Blocker`
// enum is split into a discriminator (BlockerKind) plus a Blocker class.
enum BlockerKind {
  ClassRegistered  // waiting for a class Sym to be registered/typechecked
  SignatureKnown   // waiting for a function's signature to become known
  VarBound         // waiting for a type variable to be bound
}

// The reason a binding is stuck, recorded alongside the existing once-deferral
// flag (sawStructuralGenericError).  Payload fields are populated per kind; the
// others keep their null/zero defaults.
class Blocker(self, kind: BlockerKind) {
  self.kind = kind
  self.className = null(Sym)  // ClassRegistered: the awaited class
  self.spec = ""              // SignatureKnown: the awaited function's name
  self.tyvarId = 0i32         // VarBound: the awaited type variable id (i32)
}

// A parked binding plus the reason it waits.  The Function may be null when the
// stall is recorded deep in expression typechecking, where the enclosing
// function is not threaded through.  Consumed by the deferral fixpoint
// (Stage 1+) and per-signature class materialization (Stage 2+).
class Deferred(self, fn: db.Function?, blocker: Blocker) {
  self.fn = fn
  self.blocker = blocker
}

relation HashedClass TypeChecker SymbolMapping cascade
relation HashedClass TypeChecker TynameDefinition cascade
relation HashedClass TypeChecker ClassInfo cascade
relation HashedClass TypeChecker EnumInfo cascade
relation HashedClass TypeChecker FunctionDef cascade
relation DoublyLinked TypeChecker BindingScope cascade
relation DoublyLinked TypeChecker TypeError cascade
// DoublyLinked, not HashedClass: the latter's startup bucket pool trips the
// legacy runtime's array-resize bug (see the funcptr / phantom-mask notes).
relation DoublyLinked TypeChecker ArrayExtMethod cascade

class TypeChecker(self) {
  self.unifier = TypeUnifier()
  self.nextTyvarId = 1i32
  self.numTypeErrorsReported = 0
  // Set while typechecking a class constructor or its methods.
  self.currentClassInfo = null(ClassInfo)
  self.currentSelfType = null(Type)
  self.classBoundVars = arrayof(Type)
  // Overloaded operator functions and their types, in definition order.
  self.operatorFns = arrayof(db.Function)
  self.operatorTypes = arrayof(Type)
  // While typechecking an operator's own body, the operator is hidden from
  // operatorChoices so a field comparison inside it (e.g. element1.age <
  // element2.age) cannot re-dispatch back to itself and knot the operand's
  // type-args to the bare class name.
  self.suppressedOperatorFn = null(db.Function)
  // State for iterator inlining: a counter making inlined variable names
  // unique, and the rename map (old name -> new Sym) for the current inline.
  self.iteratorInlineCounter = 0u32
  // True while typechecking a statement instantiated by a transformer.
  self.currentStatementGenerated = false
  // Set when a body errors on member access or indexing of an
  // unconstrained variable: the signature per-instantiation
  // typechecking (deferral) can fix.
  self.sawStructuralGenericError = false
  // Named-blocker groundwork (Stage 0): parked bindings + their reasons,
  // recorded alongside sawStructuralGenericError.  Not yet consumed, so
  // behaviour is unchanged; the deferral fixpoint (Stage 1+) and per-signature
  // class materialization (Stage 2+) read these.
  self.deferredWorklist = arrayof(Deferred)
  self.definedSignatures = arrayof(string)  // dedup keys (Stage 2 materializeInner)
  self.boundTyvarIds = arrayof(i32)         // tyvars known bound (Stage 3)
  // Demand-driven materialization state (see demandCallResult).
  self.calleeStack = arrayof(CalleeRecord)
  self.materializeDepth = 0u32
  // Nested-instantiate frame stack (replaces the flat per-poly
  // bookkeeping, which an inner instantiate of the SAME poly overwrote):
  // instantiate() pushes a frame recording exactly what to undo;
  // deInstantiate() pops it.  Enables recursion-frame draining while an
  // emission's instantiate is active.
  self.instUnbindVars = arrayof(TypeVar)
  self.instChainVars = arrayof(TypeVar)
  self.instRebindVars = arrayof(TypeVar)
  self.instRebindVals = arrayof(Type)
  self.instUnbindBase = arrayof(u64)
  self.instChainBase = arrayof(u64)
  self.instRebindBase = arrayof(u64)
  // C3 worklist: demands skipped because their callee frame was ACTIVE
  // (recursion with differing signatures) are parked here and drained
  // when the outermost demand completes.
  self.pendingDemands = arrayof(CalleeRecord)
  // Var ids currently bound by an ACTIVE instantiate() frame: a
  // pre-existing binding on one of these belongs to an enclosing frame
  // and must be kept; a pre-existing binding on a NON-active var is a
  // stale bake that instantiate() overrides (with restore).
  self.activeTrailIds = arrayof(i32)
  // The unifier's fresh-var counter at the innermost round's entry: a
  // variable with id <= this watermark was minted DURING the round (ids
  // are negative, decreasing) — e.g. the round's own recursive-call
  // result slots — and is safe to embed in a result binding.  Older
  // (id > watermark) frees belong to other templates and must not be
  // linked (the dicttest corruption).
  self.roundVarWatermark = 0i32
  // True while the innermost retypecheckDeferred round is a CONSTRUCTOR's
  // (methods' rounds must read per-spec field snapshots, not the shared
  // canonical slots).
  self.roundIsCtor = false
  // Nesting depth of retypecheckDeferred: >0 while a body re-typechecks
  // under concrete instantiation bindings.  substituteClassVars must not
  // hand out FREE canonical field slots there (a concrete unify would
  // poison the shared template); the template pass keeps them (the
  // intentional template-class knot).
  self.retypecheckNesting = 0u32
  self.renamePrefix = ""
  self.renameOld = arrayof(string)
  self.renameNew = arrayof(Sym)
  self.openScope()
  // Builtin values whose types cannot be inferred from use: readln() reads
  // a line from stdin, chr(i) makes a one-byte string, argv is the program's
  // argument list.
  noArgTypes = arrayof(Type)
  self.newSymbol(Sym.new("readln"), FN(TUPLE(noArgTypes), STRING()))
  chrVar = V(1)
  chrConstraint = [ANYINTEGER()]
  self.newSymbol(Sym.new("chr"), BPOLY(1, chrConstraint, FN(chrVar, STRING())))
  self.newSymbol(Sym.new("argv"), ARRAY(STRING()))
  self.newSymbol(Sym.new("randString"), FN(U(64), STRING()))
  rrVar = V(2)
  rrConstraint = [ANYINTEGER()]
  self.newSymbol(Sym.new("randRange"), BPOLY(2, rrConstraint, FN(rrVar, rrVar)))

  func typeError(self, msg: string, location: db.Location?) {
    self.appendTypeError(TypeError(msg, location))
  }

  func popTypeError(self) {
    if !isnull(self.lastTypeError) {
      self.removeTypeError(self.lastTypeError!)
    }
  }

  func dumpTypeErrors(self, dumpText: bool = true, prefix: string = "") {
    count = self.countTypeErrors()
    pos = self.numTypeErrorsReported

    while pos < count {
      te = self.indexTypeError(pos)
      if !isnull(te.location) {
        te.location.error(te.msg, dumpText, prefix)
      } else {
        println prefix + "Type error: %s" % te.msg
      }
      self.numTypeErrorsReported += 1
      pos += 1
    }
  }

  func openScope(self) {
    self.appendBindingScope(BindingScope())
  }

  func closeScope(self) -> BindingScope {
    scope = self.lastBindingScope!
    self.removeBindingScope(scope)
    // Drop the scope's bindings from the lookup hash; an equal-keyed
    // mapping from an outer scope (shadowed until now) becomes visible
    // again.  The mappings stay on the scope for generalization, and
    // sym.typedValue keeps its last-bound value for the C backend.
    for sm in scope.symbolMappings() {
      self.removeSymbolMapping(sm)
    }
    return scope
  }

  func newSymbol(self, symbol: Sym, ty: Type?) -> Type? {
    // TODO: there may already exist a symbol mapping, if we are creating
    // a symbol with the same name as another in an outer scope.
    if isnull(ty) {
      type = Type(self.newTyvar())
    } else {
      type = ty
    }
    sm = SymbolMapping(symbol, type)
    self.insertSymbolMapping(sm)
    self.lastBindingScope.add(sm)
    symbol.typedValue = type
    return type
  }

  // Bind a definition name (function, class, struct, enum) in the global
  // scope: definitions are module-scoped even when typechecked on demand
  // from inside another function's scope.
  func newSymbolGlobal(self, symbol: Sym, ty: Type?) -> Type? {
    if isnull(ty) {
      type = Type(self.newTyvar())
    } else {
      type = ty
    }
    sm = SymbolMapping(symbol, type)
    self.insertSymbolMapping(sm)
    self.firstBindingScope.add(sm)
    symbol.typedValue = type
    return type
  }

  func newTyvar(self) -> TypeVar {
    tyvar = TypeVar(self.nextTyvarId, null(Type))
    self.nextTyvarId += 1
    return tyvar
  }

  func newConstrainedTyvar(self, constraint: Type) -> TypeVar {
    tyvar = TypeVar(self.nextTyvarId, constraint)
    self.nextTyvarId += 1
    return tyvar
  }

  func newTyname(self, tyname: Sym, def: Type) {
    td = TynameDefinition(tyname, def)
    self.insertTynameDefinition(td)
    if db.getRoot().traceTypes {
       println "%sDefine tyname %s = %s." % (TypeLoggingPrefix, tyname.name, def.toString())
    }
  }

  // Look up the typechecking information for a class by name.  Returns null
  // if the name does not refer to a class.
  func lookupClass(self, sym: Sym) -> ClassInfo? {
    return self.findClassInfo(ClassInfo(sym))
  }

  // Find the single class that defines the named method or data member,
  // for duck-typing member access on unconstrained values.  Returns null
  // when no class or more than one class has the member.
  func findClassByMember(self, name: string) -> ClassInfo? {
    found = null(ClassInfo)
    count = 0
    for info in self.classInfos() {
      has = !isnull(self.findMethod(info, name))
      if !has && !isnull(info.strct) {
        for fieldSym in info.strct.fieldnames {
          if fieldSym.name == name {
            has = true
          }
        }
      }
      if has {
        count += 1
        found = info
      }
    }
    if count == 1 {
      return found
    }
    return null(ClassInfo)
  }

  // When a member is defined as a data field by more than one class but every
  // such class gives it the SAME concrete type, that type is the member's type
  // regardless of which class the receiver turns out to be.  Lets an ambiguous
  // duck-typed access like `child.hash` (both Foo and Bar declare hash: u64)
  // resolve to u64 instead of leaking a disconnected variable.  Returns null if
  // no class defines the field, the types disagree, or any is non-concrete.
  func commonMemberFieldType(self, name: string) -> Type? {
    result = null(Type)
    for info in self.classInfos() {
      if !isnull(info.strct) {
        fty = info.strct.select(name)
        if !isnull(fty) {
          rfty = self.resolve(fty!)
          if self.hasFreeVars(rfty) {
            return null(Type)
          }
          if isnull(result) {
            result = rfty
          } else if result.toString() != rfty.toString() {
            return null(Type)
          }
        }
      }
    }
    return result
  }

  // An instance type of the class suitable for unification: polymorphic
  // classes parameterize with fresh type variables.
  func classInstanceType(self, info: ClassInfo) -> Type {
    if info.paramVars.length() > 0 {
      cparams = arrayof(Type)
      for pv in info.paramVars {
        cparams.append(Type(self.newTyvar()))
      }
      return Type(TypeName(info.sym, TupleType(cparams)))
    }
    if isnull(info.selfType) {
      // The class's constructor has not been typechecked yet -- a mutually
      // recursive cascade relation can duck-type a field selection onto a peer
      // class before its selfType is established.  Build the monomorphic
      // instance type on demand, the same form constructorFunction records.
      info.selfType = Type(TypeName(info.sym, TupleType(info.paramVars)))
    }
    return info.selfType!
  }


  // Record the typedValue of every sym bound in an open scope.  An
  // on-demand typecheck (demandClass/demandMethod) interrupts the function
  // being typechecked; the nested typecheck rebinds shared interned syms
  // (notably "self"), so the demand site restores them afterward.
  func snapshotBindings(self, var syms: [Sym], var vals: [Type]) {
    for scope in self.bindingScopes() {
      for sm in scope.symbolMappings() {
        if !isnull(sm.key.typedValue) {
          syms.append(sm.key)
          vals.append(sm.key.typedValue!)
        }
      }
    }
  }

  func restoreBindings(self, syms: [Sym], vals: [Type]) {
    for bindingIndex in range(syms.length()) {
      syms[bindingIndex].typedValue = vals[bindingIndex]
    }
  }

  // Stage 0 groundwork: record that the current binding stalled on an unbound
  // type variable, next to the sawStructuralGenericError flag.  Additive and
  // not yet consumed, so behaviour is unchanged.
  func recordVarBlocker(self, ty: Type?) {
    if isnull(ty) {
      return
    }
    rvb = self.resolve(ty!)
    vid = 0i32
    if rvb.type == Type.TypeClass.Var {
      vid = rvb.tyvar!.id
    }
    blocker = Blocker(BlockerKind.VarBound)
    blocker.tyvarId = vid
    self.deferredWorklist.append(Deferred(null(db.Function), blocker))
  }

  // Stage 0 groundwork: record that the current binding stalled on a function
  // whose signature is not yet known (e.g. a deferred constructor).
  func recordSignatureBlocker(self, fn: db.Function?, name: string) {
    blocker = Blocker(BlockerKind.SignatureKnown)
    blocker.spec = name
    self.deferredWorklist.append(Deferred(fn, blocker))
  }

  // Typecheck a class method on demand, in its class's context.
  func demandMethod(self, info: ClassInfo, method: db.Function) {
    if (method.type != db.FuncType.Plain &&
        method.type != db.FuncType.Operator &&
        method.type != db.FuncType.Final) {
      return
    }
    snapSyms = arrayof(Sym)
    snapVals = arrayof(Type)
    self.snapshotBindings(snapSyms, snapVals)
    prevClassInfo = self.currentClassInfo
    prevSelfType = self.currentSelfType
    prevClassBoundVars = self.classBoundVars
    self.currentClassInfo = info
    self.currentSelfType = info.selfType
    self.classBoundVars = info.paramVars
    self.plainFunction(method)
    self.currentClassInfo = prevClassInfo
    self.currentSelfType = prevSelfType
    self.classBoundVars = prevClassBoundVars
    self.restoreBindings(snapSyms, snapVals)
  }

  // Typecheck a class on demand: references can precede the class's own
  // typechecking (e.g. methods a relation added to an earlier class).  A
  // class already registered (done or in progress) is left alone.
  // Record the class names a user operator's parameters are declared
  // with, so the unifier accepts them where a builtin operator's
  // adaptable constraint would reject them.
  func registerUserOpClasses(self, opfn: db.Function) {
    for ruoVar in opfn.variables() {
      ruoTe = ruoVar.typeExpr
      if !isnull(ruoTe) {
        // A nested-class annotation is a Dot (Heapq.Element); its class
        // is the last component.
        if ruoTe.type == db.ExprType.Dot {
          ruoLast = ruoTe.firstChildExpr.nextExprChildExpr
          if !isnull(ruoLast) {
            ruoTe = ruoLast
          }
        }
        if ruoTe.type == db.ExprType.Ident {
          ruoName = ruoTe.val.symVal.name
          if !isnull(self.lookupClass(ruoTe.val.symVal!)) {
            ruoSeen = false
            for ruoC in self.unifier.userOpClasses {
              if ruoC == ruoName {
                ruoSeen = true
              }
            }
            if !ruoSeen {
              self.unifier.userOpClasses.append(ruoName)
            }
          }
        }
      }
    }
  }

  func demandClass(self, sym: Sym) {
    if !isnull(self.lookupClass(sym)) {
      return
    }
    classFn = self.findClassFunction(sym.name)
    if !isnull(classFn) {
      snapSyms = arrayof(Sym)
      snapVals = arrayof(Type)
      self.snapshotBindings(snapSyms, snapVals)
      self.function(classFn!)
      self.restoreBindings(snapSyms, snapVals)
    }
  }

  // Re-typecheck a deferred function's body under a concrete
  // instantiation's bindings.  Runs BEFORE emission so any statement
  // rewriting (iterator inlining) completes first.
  func retypecheckDeferred(self, fn: db.Function) {
    self.retypecheckNesting += 1u32
    prevRoundIsCtor = self.roundIsCtor
    self.roundIsCtor = fn.type == db.FuncType.Constructor
    prevWatermark = self.roundVarWatermark
    self.roundVarWatermark = self.unifier.nextFreshVar
    prevClassInfo = self.currentClassInfo
    prevSelfType = self.currentSelfType
    prevClassBoundVars = self.classBoundVars
    if fn.type == db.FuncType.Constructor {
      // A deferred constructor re-discovers its fields concretely.
      cinfo = self.lookupClass(fn.sym)
      if !isnull(cinfo) {
        self.currentClassInfo = cinfo
        self.currentSelfType = cinfo.selfType
        self.classBoundVars = cinfo.paramVars
        // Reset every canonical slot to a fresh variable: a previous
        // round's in-place bake (or its minted null()-vars) cannot
        // re-derive under THIS round's bindings — the unify against
        // another signature's concrete just errors and leaves the round
        // half-derived.  The body walk re-discovers every slot.
        for rfti in range(cinfo.strct.fieldtypes.length()) {
          cinfo.strct.fieldtypes[rfti] = Type(self.newTyvar())
        }
      }
    } else if !isnull(fn.parentFunction) {
      if fn.parentFunction.type == db.FuncType.Constructor {
        dinfo = self.lookupClass(fn.parentFunction.sym)
        if !isnull(dinfo) {
          self.currentClassInfo = dinfo
          self.currentSelfType = dinfo.selfType
          self.classBoundVars = dinfo.paramVars
        }
      }
    }
    self.openScope()
    for variable in fn.variables() {
      if variable.isParam && !isnull(variable.typedValue) {
        self.newSymbol(variable.sym, variable.typedValue)
      }
    }
    if !isnull(fn.subBlock) {
      bodySnapshot = arrayof(db.Statement)
      for s in fn.subBlock.statements() {
        bodySnapshot.append(s)
      }
      for s in bodySnapshot {
        self.statement(s, fn.subBlock!)
      }
      self.connectResultType(fn)
    }
    if fn.type == db.FuncType.Constructor {
      // Bake the re-discovered field types while the instantiation's
      // bindings are still active: they bind through the instantiation
      // variables and would revert to unbound after deInstantiate.
      // Additionally snapshot them per specialization (with this round's
      // knot pinning applied): the in-place bake can only hold ONE
      // signature, and multi-signature struct emission reads the
      // snapshot for its own instance type.
      if !isnull(self.currentClassInfo) {
        bakeInfo = self.currentClassInfo!
        for bfi in range(bakeInfo.strct.fieldtypes.length()) {
          bakeInfo.strct.fieldtypes[bfi] = self.resolve(bakeInfo.strct.fieldtypes[bfi])
        }
        if !isnull(bakeInfo.selfType) {
          bakeSelfR = self.resolve(bakeInfo.selfType!)
          if !self.hasFreeVars(bakeSelfR) {
            bakeSpec = bakeSelfR.toString()
            bake = null(FieldBake)
            for fb in bakeInfo.fieldBakes() {
              if fb.spec == bakeSpec {
                bake = fb
              }
            }
            if isnull(bake) {
              bake = FieldBake(bakeSpec)
              bakeInfo.appendFieldBake(bake!)
            }
            emptyBakeTypes = arrayof(Type)
            bake.types = emptyBakeTypes
            for bfi2 in range(bakeInfo.strct.fieldtypes.length()) {
              bake.types.append(self.pinSnapshotSlot(self.concretizeKnots(
                  self.resolve(bakeInfo.strct.fieldtypes[bfi2]), 0u32), bakeSelfR))
            }
          }
        }
      }
    }
    self.closeScope()
    // closeScope leaves sym.typedValue at its last-bound value; for the
    // parameters that means the TEMPLATE variables this round just
    // re-bound.  A later same-named module variable (dicttest's `value`
    // vs insert's `value` parameter) would pick that variable up through
    // symbol()'s forward-reference path and unify it with its own type —
    // a bind outside any poly's bookkeeping that permanently
    // monomorphizes the template slot.  Clear them like functionType's
    // generalization epilogue does.
    // Check the RAW type object, not its resolution: this runs while the
    // caller's instantiation bindings are still active, so the template
    // variable resolves concrete here and a resolve-based check would
    // skip exactly the vars that need clearing.
    for retcClearParam in fn.variables() {
      if retcClearParam.isParam && !isnull(retcClearParam.sym.typedValue) {
        if retcClearParam.sym.typedValue.type == Type.TypeClass.Var {
          retcClearParam.sym.typedValue = null(Type)
        }
      }
    }
    self.currentClassInfo = prevClassInfo
    self.currentSelfType = prevSelfType
    self.classBoundVars = prevClassBoundVars
    self.roundIsCtor = prevRoundIsCtor
    self.roundVarWatermark = prevWatermark
    self.retypecheckNesting -= 1u32
  }

  // Materialize a polymorphic body for one specialization: re-typecheck it
  // under the caller's active instantiation bindings, unless the body's
  // shared expression types are already current for this key.  On a key
  // hit, still connect the result: each recorded instantiation of a
  // signature carries its own result variable.  A retypecheck that fails
  // under the active bindings (an unreachable typeswitch arm) keeps the
  // previous baking; its errors are popped because the body already
  // typechecked cleanly once.
  func materializeSpec(self, fn: db.Function, specKey: string) {
    if isnull(fn.subBlock) {
      return
    }
    matzPreErrs = self.countTypeErrors()
    if fn.lastMaterializedSpec == specKey {
      self.connectResultType(fn)
    } else {
      fn.lastMaterializedSpec = specKey
      // Log the polys this round opens and bake those instantiations
      // while the round's bindings are still active: a recording left
      // half-raw (its self/class slots still chaining through the class's
      // template variables) would re-resolve under a LATER round's
      // bindings into a cross-signature Frankenstein.
      matzPrevLogging = self.unifier.openLogging
      matzLogBase = self.unifier.openLog.length()
      matzPendBase = self.pendingDemands.length()
      self.unifier.openLogging = true
      self.retypecheckDeferred(fn)
      fn.deferredRetypechecked = true
      if self.countTypeErrors() > matzPreErrs {
        // The round failed (an unreachable typeswitch arm's recorded
        // instantiation).  Discard its artifacts: parked demands from
        // inside the arm chase a growing recursion forever
        // (addParens_none_<65-level tuple>), and its recordings stay
        // UNBAKED so the sweeps skip them.  Remember the key so emission
        // skips this specialization, and clear the cache so a LATER,
        // valid signature re-materializes from scratch.
        self.pendingDemands.resize(matzPendBase)
        matzFailedSeen = false
        for matzFs in fn.failedSpecs {
          if matzFs == specKey {
            matzFailedSeen = true
          }
        }
        if !matzFailedSeen {
          fn.failedSpecs.append(specKey)
        }
        fn.lastMaterializedSpec = ""
      } else {
        matzI = matzLogBase
        while matzI < self.unifier.openLog.length() {
          matzInst = self.unifier.openLog[matzI]
          for matzJ in range(matzInst.varBindings.length()) {
            matzInst.varBindings[matzJ] = self.resolve(matzInst.varBindings[matzJ])
          }
          matzInst.type = self.resolve(matzInst.type)
          matzI += 1
        }
      }
      self.unifier.openLog.resize(matzLogBase)
      self.unifier.openLogging = matzPrevLogging
    }
    while self.countTypeErrors() > matzPreErrs {
      self.popTypeError()
    }
    if self.materializeDepth == 0u32 && self.retypecheckNesting == 0u32 {
      // An EMISSION-side round (no demand frame active) can park its own
      // recursive demands; drain them now so the recorded slots bind
      // before the body's call names are composed.
      self.drainPendingDemands()
    }
  }

  // Demand-driven monomorphization: a call whose result type stays a free
  // variable under concrete arguments (the callee's return only resolves
  // through ITS callees or its class's field types) materializes the
  // callee under this call's just-recorded instantiation, binding the
  // call's own result variable through the instantiation chain.  The
  // template pass never fires here (its arguments are not concrete), so
  // single-signature behavior is unchanged.
  func demandCallResult(self, rec: CalleeRecord, openedFnTy: Type, result: Type) {
    if isnull(rec.fn) || isnull(rec.inst) {
      return
    }
    // Materialize when the call's result stays free — or, for a method of
    // a GENERIC class, even when it does not (a void insert's body is what
    // records the nested class's concrete constructor instantiations, and
    // the round-BAKED recordings are the only ones multi-signature sweeps
    // trust).  The per-spec cache bounds the work.
    dmNeed = self.hasFreeVars(self.resolve(result))
    if !dmNeed {
      if !isnull(rec.fn.parentFunction) {
        if rec.fn.parentFunction.type == db.FuncType.Constructor {
          dmInfo = self.lookupClass(rec.fn.parentFunction.sym)
          if !isnull(dmInfo) {
            if dmInfo.paramVars.length() > 0 {
              dmNeed = true
            }
          }
        }
      }
    }
    if !dmNeed {
      return
    }
    callee = rec.fn!
    if callee.materializeActive {
      // Recursion into an active frame: park the demand; the outermost
      // demand drains it once the frame closes (the C3 fixpoint
      // worklist — a recursive call with DIFFERING resolved arg types is
      // a genuinely new instantiation that must materialize on its own).
      parked = CalleeRecord()
      parked.fn = rec.fn
      parked.inst = rec.inst
      parked.viaExpr = rec.viaExpr
      self.pendingDemands.append(parked)
      return
    }
    if isnull(callee.subBlock) {
      return
    }
    cty = callee.typedValue
    if isnull(cty) {
      return
    }
    if cty.type != Type.TypeClass.Polymorphic {
      return
    }
    oft = self.resolve(openedFnTy)
    if oft.type != Type.TypeClass.Function {
      return
    }
    if self.hasFreeVars(oft.function.params!) {
      return
    }
    if self.hasBareGenericKnot(oft.function.params!) {
      // A bare class knot in the arguments would materialize the callee
      // under an under-resolved (and possibly cross-signature) frame and
      // record garbage instantiations; leave those to emission recovery.
      return
    }

    if self.materializeDepth >= MaterializeRecursionLimit {
      return
    }
    self.materializeDepth += 1u32
    callee.materializeActive = true
    self.instantiate(cty.poly!, rec.inst!)
    dmScope = self.resolve(cty.poly.scope)
    if dmScope.type == Type.TypeClass.Function {
      dmParams = self.resolve(dmScope.function.params!)
      dmKey = dmParams.genSpecializationName(callee.sym.name)
      self.materializeSpec(callee, dmKey)
    }
    // Bake the materialized resolution into the instantiation while its
    // bindings are active, so emission and recovery read concrete slots.
    for dmi in range(rec.inst.varBindings.length()) {
      rec.inst.varBindings[dmi] = self.resolve(rec.inst.varBindings[dmi])
    }
    rec.inst.type = self.resolve(rec.inst.type)
    self.deInstantiate(cty.poly!)
    callee.materializeActive = false
    self.materializeDepth -= 1u32
    if self.materializeDepth == 0u32 {
      self.drainPendingDemands()
    }
  }

  // Drain parked recursive demands to a fixpoint (bounded: each drained
  // demand either materializes a new specialization — the per-spec cache
  // prevents repeats — or bails immediately).  Safe under an active
  // emission instantiate since the frame-stack conversion.
  func drainPendingDemands(self) {
    drainGuard = 0u32
    while self.pendingDemands.length() > 0u64 && drainGuard < 64u32 {
      drainGuard += 1u32
      drainRec = self.pendingDemands[self.pendingDemands.length() - 1u64]
      self.pendingDemands.resize(self.pendingDemands.length() - 1u64)
      if !isnull(drainRec.inst) {
        if !isnull(drainRec.inst.type) {
          drainTy = self.resolve(drainRec.inst.type!)
          if drainTy.type == Type.TypeClass.Function {
            self.demandCallResult(drainRec, drainRec.inst.type!,
                drainTy.function.result!)
          }
        }
      }
    }
  }

  // A snapshot slot still carrying free variables (a relation back-pointer
  // only ever assigned by METHODS, e.g. Entry.dict = null(Dict) in the
  // appendcode) pins to the concrete instance of the same class found in
  // the anchor (the specialization's own instance type or one of its type
  // arguments): Entry(Dict(string,u32),...)'s dict slot can only be that
  // Dict.  Ambiguity or no match leaves the slot unchanged.
  func pinSnapshotSlot(self, slotTy: Type, anchor: Type) -> Type {
    if !self.hasFreeVars(slotTy) {
      return slotTy
    }
    rSlot = self.resolve(slotTy)
    if rSlot.type != Type.TypeClass.Typename {
      return rSlot
    }
    if isnull(rSlot.tyname.params) {
      return rSlot
    }
    rAnchor = self.resolve(anchor)
    if rAnchor.type != Type.TypeClass.Typename {
      return rSlot
    }
    pinFound = null(Type)
    pinDistinct = arrayof(string)
    pinCands = arrayof(Type)
    pinCands.append(rAnchor)
    if !isnull(rAnchor.tyname.params) {
      for pinArg in rAnchor.tyname.params.elements {
        pinCands.append(pinArg)
      }
    }
    for pinC in pinCands {
      rPinC = self.resolve(pinC)
      if rPinC.type == Type.TypeClass.Typename {
        if rPinC.tyname.name.name == rSlot.tyname.name.name {
          if !self.hasFreeVars(rPinC) {
            pinStr = rPinC.toString()
            pinSeen = false
            for pd in pinDistinct {
              if pd == pinStr {
                pinSeen = true
              }
            }
            if !pinSeen {
              pinDistinct.append(pinStr)
              pinFound = rPinC
            }
          }
        }
      }
    }
    if pinDistinct.length() == 1 {
      pinTe = self.unify(rSlot, pinFound!)
      if isnull(pinTe) {
        return self.resolve(rSlot)
      }
    }
    return rSlot
  }

  // The number of DISTINCT concrete instance types among a class's
  // recorded constructor instantiations (typechecker-side mirror of the
  // builder's classConcreteSigCount).
  func classSigCount(self, info: ClassInfo) -> u64 {
    if isnull(info.fn) {
      return 0u64
    }
    cscTy = info.fn.typedValue
    if isnull(cscTy) {
      return 0u64
    }
    if cscTy.type != Type.TypeClass.Polymorphic {
      return 0u64
    }
    cscSigs = arrayof(string)
    cscPi = cscTy.poly.instantiations
    if !isnull(cscPi) {
      for cscInst in cscPi {
        if !isnull(cscInst.type) {
          cscR = self.resolve(cscInst.type!)
          if cscR.type == Type.TypeClass.Function {
            cscRes = self.resolve(cscR.function.result!)
            if cscRes.type == Type.TypeClass.Typename && !self.hasFreeVars(cscRes) {
              cscStr = cscRes.toString()
              cscSeen = false
              for cscS in cscSigs {
                if cscS == cscStr {
                  cscSeen = true
                }
              }
              if !cscSeen {
                cscSigs.append(cscStr)
              }
            }
          }
        }
      }
    }
    return cscSigs.length()
  }

  // Connect the body's return type to the function's result variable so
  // the call site's type resolves under the active instantiation.  Also
  // used on its own when a signature is already materialized: each
  // recorded instantiation of that signature carries its own result
  // variable (opened at a different call site), and only unification can
  // bind it.
  func connectResultType(self, fn: db.Function) {
    drfty = fn.typedValue
    if isnull(drfty) {
      return
    }
    if drfty.type != Type.TypeClass.Polymorphic {
      return
    }
    if isnull(fn.subBlock) {
      return
    }
    if !isnull(fn.subBlock.returnType) {
      // Resolve first: the body's type binds through instantiation
      // variables that deInstantiate will pop.  Bind only when the
      // resolution is CONCRETE: if it still ends in a variable belonging
      // to another function's template (insert's <value> chained through
      // a shared field slot), unifying would link that variable toward
      // this round's result var — a bind outside this poly's bookkeeping
      // that survives deInstantiate and permanently corrupts the other
      // template (dicttest's second signature saw value=u32 forever).
      crtRes = self.resolve(fn.subBlock.returnType!)
      crtBind = !self.hasFreeVars(crtRes)
      if !crtBind && crtRes.type == Type.TypeClass.Var {
        // A BARE round-minted variable is the round's own recursive
        // call's opened result (return addParens(...)); linking the
        // result slot to it lets the worklist bind bottom-up.  An OLDER
        // bare var chains into another template — never link those.
        crtBind = crtRes.tyvar.id <= self.roundVarWatermark
      }
      if !crtBind && crtRes.type != Type.TypeClass.Var {
        // A STRUCTURE with embedded frees (a growing recursion's tuple
        // around its recursive result, e.g. the turing test's addParens)
        // binds safely IF every free was minted during THIS round: those
        // are the round's own recursion slots, resolved bottom-up by the
        // worklist.  Any older free chains into another template and
        // binding would corrupt it.
        crtFrees = arrayof(Type)
        crtFrees = self.collectFreeTyvars(crtRes, crtFrees)
        crtAllRound = true
        for crtF in crtFrees {
          if crtF.tyvar.id > self.roundVarWatermark {
            crtAllRound = false
          }
        }
        crtBind = crtAllRound
      }
      if crtBind {
        self.unify(drfty.poly.scope.function.result!, crtRes)
      }
    } else {
      // No TRACKED return type.  A body with return statements can still
      // land here (typeswitch arm tracking loses the type when a later
      // arm errors); binding none then poisons every caller — the turing
      // test's decParens((())) bound none and spawned an unreachable
      // addParens(none, ...) family.  Recover through the first return
      // expression; bind none only for a genuinely return-less body.
      crtRetE = db.findReturnExpr(fn.subBlock!)
      if isnull(crtRetE) {
        drres = self.resolve(drfty.poly.scope.function.result!)
        if drres.type == Type.TypeClass.Var {
          self.unify(drres, Type(TypeName(Sym.new("none"))))
        }
      } else {
        crtRTv = crtRetE.typedValue
        if !isnull(crtRTv) {
          crtR2 = self.resolve(crtRTv!)
          crtBind2 = !self.hasFreeVars(crtR2)
          if !crtBind2 && crtR2.type == Type.TypeClass.Var {
            crtBind2 = crtR2.tyvar.id <= self.roundVarWatermark
          }
          if crtBind2 {
            self.unify(drfty.poly.scope.function.result!, crtR2)
          }
        }
      }
    }
  }

  func clearExprTypes(self, block: db.Block) {
    for statement in block.statements() {
      if !isnull(statement.expr) {
        self.clearExprTypesIn(statement.expr!)
      }
      if !isnull(statement.subBlock) {
        self.clearExprTypes(statement.subBlock!)
      }
    }
  }

  func clearExprTypesIn(self, expr: db.Expr) {
    expr.typedValue = null(Type)
    for child in expr.childExprs() {
      self.clearExprTypesIn(child)
    }
  }

  // Resolve every expression type in |block| in place.  An inlined
  // iterator's copy belongs to one call site, and its unification chains
  // run through the iterator's opened method variables, which
  // deInstantiate/generalization pops before emission; baking keeps the
  // structure (nested variables still re-resolve under emission bindings)
  // while dropping the fragile chain middles.
  func bakeExprTypes(self, block: db.Block) {
    for statement in block.statements() {
      if !isnull(statement.expr) {
        self.bakeExprTypesIn(statement.expr!)
      }
      if !isnull(statement.subBlock) {
        self.bakeExprTypes(statement.subBlock!)
      }
    }
  }

  func bakeExprTypesIn(self, expr: db.Expr) {
    if !isnull(expr.typedValue) {
      expr.typedValue = self.resolve(expr.typedValue!)
    }
    for child in expr.childExprs() {
      self.bakeExprTypesIn(child)
    }
  }

  func collectIdentNames(self, expr: db.Expr, var names: [string]) {
    if expr.type == db.ExprType.Ident {
      names.append(expr.val.symVal.name)
    }
    for child in expr.childExprs() {
      self.collectIdentNames(child, names)
    }
  }

  func registerFunctionDef(self, fn: db.Function) {
    fd = FunctionDef(fn.sym)
    fd.fn = fn
    self.insertFunctionDef(fd)
  }


  // The function type to apply for an operator expression: user-defined
  // overloads first, then the builtin operator type.  Overloads must come
  // first: builtins like == accept operands of any type, so they would
  // always win and the overload would never record an instantiation.
  func operatorChoices(self, op: db.ExprType, builtin: Type?) -> Type? {
    found = arrayof(Type)
    for i in range(self.operatorFns.length()) {
      if self.operatorFns[i].opType == op {
        if isnull(self.suppressedOperatorFn) ||
            self.operatorFns[i] != self.suppressedOperatorFn {
          found.append(self.operatorTypes[i])
        }
      }
    }
    if !isnull(builtin) {
      found.append(builtin!)
    }
    if found.length() == 0 {
      return null(Type)
    }
    if found.length() == 1 {
      return found[0]
    }
    return OR(found)
  }

  func lookupFunctionDef(self, sym: Sym) -> db.Function? {
    found = self.findFunctionDef(FunctionDef(sym))
    if isnull(found) {
      return null(db.Function)
    }
    return found.fn
  }

  // Look up the typechecking information for an enum by name.  Returns null
  // if the name does not refer to an enum.
  func lookupEnum(self, sym: Sym) -> EnumInfo? {
    return self.findEnumInfo(EnumInfo(sym))
  }

  // True if the named type refers to a class instance.
  func isClassType(self, ty: Type?) -> bool {
    if isnull(ty) {
      return false
    }
    t = self.resolve(ty!)
    if t.type != Type.TypeClass.Typename {
      return false
    }
    return !isnull(self.lookupClass(t.tyname.name))
  }

  // True if t structurally contains the `none` type: a call recorded with
  // a none-typed argument comes from an unreachable typeswitch arm (the
  // turing test's addParens(none, ...) family) and must not drive
  // demand-materialization — a vacuously-typechecking growing recursion
  // otherwise spirals through the worklist.
  func hasNoneType(self, ty: Type) -> bool {
    t = self.resolve(ty)
    switch t.type {
      Type.TypeClass.Typename => {
        if t.tyname.name.name == "none" {
          return true
        }
        if isnull(t.tyname.params) {
          return false
        }
        for nEl in t.tyname.params.elements {
          if self.hasNoneType(nEl) {
            return true
          }
        }
        return false
      }
      Type.TypeClass.Array => return self.hasNoneType(t.array.elementType!)
      Type.TypeClass.Tuple => {
        for nEl2 in t.tuple.elements {
          if self.hasNoneType(nEl2) {
            return true
          }
        }
        return false
      }
      default => return false
    }
  }

  // True if t contains a bare (parameterless) Typename of a GENERIC class:
  // an under-resolved knot (from arrayof(ClassName) or occurs-check
  // knot-tying) that only emission-side adoption can pin.  A parameterless
  // class's bare name is complete, not a knot.
  func hasBareGenericKnot(self, ty: Type) -> bool {
    t = self.resolve(ty)
    switch t.type {
      Type.TypeClass.Typename => {
        if isnull(t.tyname.params) {
          kinfo = self.lookupClass(t.tyname.name)
          if !isnull(kinfo) {
            if kinfo.paramVars.length() > 0 {
              return true
            }
          }
          return false
        }
        for kel in t.tyname.params.elements {
          if self.hasBareGenericKnot(kel) {
            return true
          }
        }
        return false
      }
      Type.TypeClass.Array => return self.hasBareGenericKnot(t.array.elementType!)
      Type.TypeClass.Tuple => {
        for kel2 in t.tuple.elements {
          if self.hasBareGenericKnot(kel2) {
            return true
          }
        }
        return false
      }
      Type.TypeClass.Function => {
        if self.hasBareGenericKnot(t.function.params!) {
          return true
        }
        return self.hasBareGenericKnot(t.function.result!)
      }
      default => return false
    }
  }

  // True if the type is the builtin string type.
  func isStringType(self, ty: Type?) -> bool {
    if isnull(ty) {
      return false
    }
    t = self.resolve(ty!)
    if t.type != Type.TypeClass.Typename {
      return false
    }
    return t.tyname.name.name == "string"
  }

  // The function type of a builtin string method.
  func stringMethodType(self, name: string, location: db.Location) -> Type? {
    noArgs = arrayof(Type)
    switch name {
      "length" => return FN(TUPLE(noArgs), U(64))
      "append" => return FN(U(8), NONETY())
      "concat" => return FN(STRING(), NONETY())
      "toHex" => return FN(TUPLE(noArgs), STRING())
      "fromHex" => return FN(TUPLE(noArgs), STRING())
      "reverse" => return FN(TUPLE(noArgs), NONETY())
      // resize returns the resized string, so the result can be assigned.
      "resize" => return FN(U(64), STRING())
      // find/rfind take an optional offset; accept any argument tuple and
      // let the backend supply the default.
      "find", "rfind" => return FN(Type(self.newTyvar()), U(64))
      default => {
        self.typeError("Unsupported string method '%s'" % name, location)
        return null(Type)
      }
    }
  }

  // The function type of a builtin method on bool values.
  func boolMethodType(self, name: string, location: db.Location) -> Type? {
    noArgs = arrayof(Type)
    switch name {
      "toString" => return FN(TUPLE(noArgs), STRING())
      default => {
        self.typeError("Unsupported bool method '%s'" % name, location)
        return null(Type)
      }
    }
  }

  // The function type of a builtin method on integer values.
  func intMethodType(self, name: string, location: db.Location) -> Type? {
    noArgs = arrayof(Type)
    switch name {
      // toString takes an optional base; accept any argument tuple and
      // let the backend supply the default.
      "toString" => return FN(Type(self.newTyvar()), STRING())
      "toStringLE" => return FN(TUPLE(noArgs), STRING())
      "toStringBE" => return FN(TUPLE(noArgs), STRING())
      default => {
        self.typeError("Unsupported integer method '%s'" % name, location)
        return null(Type)
      }
    }
  }

  // True if the type still contains unresolved type variables after
  // resolution.  Used by the C backend to defer emission of polymorphic
  // instantiations whose bindings only resolve under an outer instantiation.
  func hasFreeVars(self, t: Type) -> bool {
    rt = self.resolve(t)
    switch rt.type {
      Type.TypeClass.Var => return true
      Type.TypeClass.Array => return self.hasFreeVars(rt.array.elementType)
      Type.TypeClass.Tuple => {
        for element in rt.tuple.elements {
          if self.hasFreeVars(element) {
            return true
          }
        }
        return false
      }
      Type.TypeClass.Function => {
        return self.hasFreeVars(rt.function.params) || self.hasFreeVars(rt.function.result)
      }
      Type.TypeClass.Typename => {
        if isnull(rt.tyname.params) {
          return false
        }
        return self.hasFreeVars(Type(rt.tyname.params!))
      }
      Type.TypeClass.Choice => {
        for choice in rt.choice.choices {
          if self.hasFreeVars(choice) {
            return true
          }
        }
        return false
      }
      default => return false
    }
  }

  // Append every distinct free type variable in |t| to |found|.  Variables
  // with negative ids come from opening another polymorphic type and belong
  // to that instantiation, not to the definition being generalized.
  func collectFreeVars(self, t: Type, var found: [Type]) {
    rt = self.resolve(t)
    switch rt.type {
      Type.TypeClass.Var => {
        if rt.tyvar.id < 0i32 {
          return
        }
        for bv in found {
          if bv.tyvar.id == rt.tyvar.id {
            return
          }
        }
        found.append(Type(rt.tyvar!))
      }
      Type.TypeClass.Array => self.collectFreeVars(rt.array.elementType, found)
      Type.TypeClass.Tuple => {
        for element in rt.tuple.elements {
          self.collectFreeVars(element, found)
        }
      }
      Type.TypeClass.Function => {
        self.collectFreeVars(rt.function.params, found)
        self.collectFreeVars(rt.function.result, found)
      }
      Type.TypeClass.Typename => {
        if !isnull(rt.tyname.params) {
          self.collectFreeVars(Type(rt.tyname.params!), found)
        }
      }
      Type.TypeClass.Choice => {
        for choice in rt.choice.choices {
          self.collectFreeVars(choice, found)
        }
      }
      default => return
    }
  }

  // Open a polymorphic type with fresh variables, recording the
  // instantiation.  Used by the C backend to synthesize specializations
  // for call sites whose recorded instantiations never resolved.
  func openPoly(self, poly: PolymorphicType) -> Type {
    return poly.open(self.unifier, &self.unifier.newVar())
  }

  func lookupTyname(self, tyname: Sym) -> Type? {
    res = null(Type)
    td = TynameDefinition(tyname, null(Type))
    found = self.findTynameDefinition(td)
    if !isnull(found) {
       res = found.value
    }
    if db.getRoot().traceTypes {
      if isnull(found) {
        println "%sTyname %s is undefined." % (TypeLoggingPrefix, tyname.name)
      } else {
        println "%sTyname %s is %s" % (TypeLoggingPrefix, tyname.name, res.toString())
      }
    }
    return res
  }

  func unify(self, a: Type, b: Type) -> TypeError? {
    return self.unifier.unify(a, b)
  }

  func dumpTypeBindings(self) {
    self.unifier.dump()
  }

  // Bind |tyvar| (which must be unbound) so resolution reaches |binding|.
  // A recorded binding can itself be an unresolved type variable; a raw
  // bindVar would then create self-loops or backward var->var links that
  // violate resolveVar's chain-orientation invariant (chains point from
  // higher to lower variable ids).  Follow the binding to its chain
  // representative and link the two chains oriented high -> low instead.
  // Returns the variable actually bound: |tyvar| itself, the binding's
  // representative when orientation demanded the reverse link, or null
  // when both sides are already the same chain (nothing to bind).
  func bindTowards(self, tyvar: TypeVar, binding: Type) -> TypeVar? {
    if binding.type != Type.TypeClass.Var {
      self.unifier.bindVar(tyvar, binding)
      return tyvar
    }
    bRep = self.unifier.representative(binding.tyvar!)
    if bRep.id == tyvar.id {
      return null(TypeVar)
    }
    bVal = self.unifier.lookupVar(bRep.id)
    if !isnull(bVal) {
      // The binding's chain ends in a concrete type: bind to that.
      self.unifier.bindVar(tyvar, bVal!)
      return tyvar
    }
    if tyvar.id > bRep.id {
      self.unifier.bindVar(tyvar, Type(bRep))
      return tyvar
    }
    self.unifier.bindVar(bRep, Type(tyvar))
    return bRep
  }

  func trailAdd(self, id: i32) {
    self.activeTrailIds.append(id)
  }

  func trailRemove(self, id: i32) {
    trIdx = 0u64
    trLen = self.activeTrailIds.length()
    while trIdx < trLen {
      if self.activeTrailIds[trIdx] == id {
        self.activeTrailIds[trIdx] = self.activeTrailIds[trLen - 1u64]
        self.activeTrailIds.resize(trLen - 1u64)
        return
      }
      trIdx += 1u64
    }
  }

  func trailActive(self, id: i32) -> bool {
    for trId in self.activeTrailIds {
      if trId == id {
        return true
      }
    }
    return false
  }

  func instantiate(self, poly: PolymorphicType, inst: TyvarInstantiation) {
    // for a limited time, pretend that the bound variables in poly are bound
    // to the bindings in the instantiation.  Bookkeeping lives on a FRAME
    // STACK (typechecker fields), not on the poly: an inner instantiate of
    // the SAME poly (recursion-frame draining) must not clobber the outer
    // frame's undo information.
    assert poly.boundVars.length() == inst.varBindings.length()
    self.instUnbindBase.append(self.instUnbindVars.length())
    self.instChainBase.append(self.instChainVars.length())
    self.instRebindBase.append(self.instRebindVars.length())
    for index in range(poly.boundVars.length()) {
       assert poly.boundVars[index].type == Type.TypeClass.Var
       btv = poly.boundVars[index].tyvar!
       binding = inst.varBindings[index]
       val = self.unifier.lookupVar(btv.id)
       if isnull(val) {
         boundVar = self.bindTowards(btv, binding)
         if isnull(boundVar) {
           // The binding is btv's own chain; nothing to bind.
         } else if boundVar.id != btv.id {
           // Orientation bound the binding's representative instead;
           // deInstantiate unbinds it and leaves btv alone.
           self.instChainVars.append(boundVar!)
           self.trailAdd(boundVar.id)
         } else {
           self.instUnbindVars.append(btv)
           self.trailAdd(btv.id)
         }
       } else if val.type == Type.TypeClass.Var {
         // Bound to another variable: bind the representative at the end of
         // the chain instead, so resolution reaches this instantiation.
         rep = self.unifier.representative(btv)
         if rep.id != btv.id && isnull(self.unifier.lookupVar(rep.id)) {
           boundVar = self.bindTowards(rep, binding)
           if !isnull(boundVar) {
             self.instChainVars.append(boundVar!)
             self.trailAdd(boundVar.id)
           }
         }
       } else {
         // Concretely bound at a use site (e.g. a builtin operator
         // constraint variable).  Keep the existing binding — UNLESS the
         // binding is (a) NOT owned by an enclosing ACTIVE instantiate
         // frame and (b) a concrete that DISAGREES with the
         // instantiation's concrete: then it is a stale bake leaked onto
         // the template variable by an earlier signature's round, and
         // this instantiation must win for its duration (deInstantiate
         // restores the old binding).
         rebDiffer = false
         if !self.trailActive(btv.id) {
           rebExisting = self.resolve(val!)
           rebWanted = self.resolve(binding)
           if !self.hasFreeVars(rebExisting) && !self.hasFreeVars(rebWanted) {
             if rebExisting.toString() != rebWanted.toString() {
               rebDiffer = true
             }
           }
         }
         if rebDiffer {
           self.unifier.unbindVar(btv)
           rebBound = self.bindTowards(btv, binding)
           self.instRebindVars.append(btv)
           self.instRebindVals.append(val!)
           if !isnull(rebBound) {
             if rebBound.id != btv.id {
               self.instChainVars.append(rebBound!)
               self.trailAdd(rebBound.id)
             } else {
               self.trailAdd(btv.id)
             }
           }
         }
       }
    }
  }

  func deInstantiate(self, poly: PolymorphicType) {
    // Pop the innermost instantiate frame: unbind exactly what it bound,
    // restore what it overrode.
    unbindBase = self.instUnbindBase[self.instUnbindBase.length() - 1u64]
    chainBase = self.instChainBase[self.instChainBase.length() - 1u64]
    rebindBase = self.instRebindBase[self.instRebindBase.length() - 1u64]
    diI = self.instUnbindVars.length()
    while diI > unbindBase {
      diI -= 1u64
      self.unifier.unbindVar(self.instUnbindVars[diI])
      self.trailRemove(self.instUnbindVars[diI].id)
    }
    diI = self.instChainVars.length()
    while diI > chainBase {
      diI -= 1u64
      self.unifier.unbindVar(self.instChainVars[diI])
      self.trailRemove(self.instChainVars[diI].id)
    }
    // Restore bindings instantiate() overrode (stale bakes it rebound).
    diI = self.instRebindVars.length()
    while diI > rebindBase {
      diI -= 1u64
      self.unifier.unbindVar(self.instRebindVars[diI])
      self.trailRemove(self.instRebindVars[diI].id)
      self.unifier.bindVar(self.instRebindVars[diI], self.instRebindVals[diI])
    }
    self.instUnbindVars.resize(unbindBase)
    self.instChainVars.resize(chainBase)
    self.instRebindVars.resize(rebindBase)
    self.instRebindVals.resize(rebindBase)
    self.instUnbindBase.resize(self.instUnbindBase.length() - 1u64)
    self.instChainBase.resize(self.instChainBase.length() - 1u64)
    self.instRebindBase.resize(self.instRebindBase.length() - 1u64)
  }


  // ---------------------------------- Type checking functions ----------------------

  func resolve(self, t: Type) -> Type {
    return self.resolveDepth(t, 0u32)
  }

  // Canonical form of a class instance type for C naming: parameters that
  // refer to the class itself collapse to the bare class name, so every
  // variant of a self-referential class type (bare nominal knot, knot
  // expanded one level, etc.) produces the same specialization string.
  func canonicalClassTyname(self, ty: TypeName) -> TypeName {
    if isnull(ty.params) {
      return ty
    }
    els = arrayof(Type)
    for el in ty.params.elements {
      r = self.resolve(el)
      if r.type == Type.TypeClass.Typename && r.tyname!.name == ty.name {
        bare = TypeName(ty.name)
        bare.isNullable = r.tyname!.isNullable
        els.append(Type(bare))
      } else {
        els.append(r)
      }
    }
    rname = TypeName(ty.name, TupleType(els))
    rname.isNullable = ty.isNullable
    return rname
  }

  // resolve() with a recursion bound: a bound variable's binding is itself
  // resolved (so e.g. Foo?(v3,) with v3 -> string resolves fully for
  // codegen), but the unifier has no occurs check, so a self-referential
  // binding must not recurse forever.
  func resolveDepth(self, t: Type, depth: u32) -> Type {
    if depth > 64u32 {
      return t
    }
    switch t.type {
      Type.TypeClass.Var => {
        t2 = self.unifier.resolveVar(t.tyvar!.id)
        if !isnull(t2) {
          if t2.type == Type.TypeClass.Polymorphic {
            // Resolve function-type bindings shallowly: their bound
            // variables may be legitimately bound while an instantiation
            // is active, which the Polymorphic arm's assert forbids.
            return t2!
          }
          return self.resolveDepth(t2!, depth + 1u32)
        }
        // The variable may be bound to another, unbound variable; in that
        // case return the representative at the end of the chain so that
        // unified variables resolve to the same variable.
        return Type(self.unifier.representative(t.tyvar!))
      }
      Type.TypeClass.Int => return t
      Type.TypeClass.AnyInt => return t
      Type.TypeClass.Float => return t
      Type.TypeClass.Typename => {
        if isnull(t.tyname.params) {
          return t
        }
        args = self.resolveDepth(Type(t.tyname.params!), depth + 1u32)
        rname = TypeName(t.tyname.name, args.tuple)
        rname.isNullable = t.tyname.isNullable
        return Type(rname)
      }
      Type.TypeClass.Array => {
        et = self.resolveDepth(t.array.elementType, depth + 1u32)
        return Type(ArrayType(et))
      }
      Type.TypeClass.Choice => {
        choices = arrayof(Type)
        for choice in t.choice!.choices {
          choices.append(self.resolveDepth(choice, depth + 1u32))
        }
        return Type(ChoiceType(choices))
      }
      Type.TypeClass.Tuple => {
        elements = arrayof(Type)
        for child in t.tuple!.elements {
          elements.append(self.resolveDepth(child, depth + 1u32))
        }
        return Type(TupleType(elements))
      }
      Type.TypeClass.Struct => {
        fieldnames = arrayof(Sym)
        fieldtypes = arrayof(Type)
        for i in range(t.strct!.fieldnames.length()) {
          fieldnames.append(t.strct!.fieldnames[i])
          fieldtypes.append(self.resolveDepth(t.strct!.fieldtypes[i], depth + 1u32))
        }
        return Type(StructType(fieldnames, fieldtypes))
      }
      Type.TypeClass.Function => {
        return Type(FunctionType(self.resolveDepth(t.function!.params, depth + 1u32),
                                 self.resolveDepth(t.function!.result, depth + 1u32)))
      }
      Type.TypeClass.Polymorphic => {
        // We want to resolve any free variables in the scope of the
        // polymorphic type.  If a bound variable is itself bound in the
        // unifier (an active instantiation, or a var-to-var chain created
        // while typechecking the defining body), substituting under the
        // binder would corrupt it; return the type unchanged instead.
        for bv in t.poly!.boundVars {
          if !isnull(self.unifier.lookupVar(bv.tyvar.id)) {
            return t
          }
        }
        //
        // It's unclear why we need to generate a new array of bound variables,
        // if we try to share the existing one, we (sometimes) end up generating
        // a new PolymorphicType with empty variables.
        newvars = arrayof(Type)
        for boundVar in t.poly!.boundVars {
          newvars.append(boundVar)
        }
        pt = PolymorphicType(newvars, self.resolveDepth(t.poly!.scope, depth + 1u32),
                             t.poly.instantiations)
        return Type(pt)
      }
    }
  }


  // Append every free (unbound) type variable nested anywhere in |ty| to
  // |acc|, once, returning the extended array.  Generalization must capture
  // variables inside composite parameter types (e.g. Complex(v1, v2) from
  // duck typing), not only parameters whose whole type is a variable.
  // Drop the phantom-parameter positions from a class type name (positions a
  // bare-variable parameter that appears in no field occupies, recorded by
  // constructorFunction via TypeUnifier.registerPhantomMask).  Leaves a class
  // with no recorded mask, or a mask that does not match the parameter count,
  // unchanged.  The struct, methods, and instance declarations name themselves
  // through this; the constructor does not (it keeps every parameter).
  func dropPhantomParams(self, tn: TypeName) -> TypeName {
    mask = self.unifier.phantomMaskFor(tn.name)
    if mask.length() == 0 || isnull(tn.params) {
      return tn
    }
    els = tn.params.elements
    if els.length() != mask.length() {
      return tn
    }
    kept = arrayof(Type)
    for i in range(els.length()) {
      if !mask[i] {
        kept.append(els[i])
      }
    }
    if kept.length() == 0 {
      return TypeName(tn.name)
    }
    return TypeName(tn.name, TupleType(kept))
  }

  func collectFreeTyvars(self, ty: Type, acc: [Type]) -> [Type] {
    out = acc
    t = ty
    if t.type == Type.TypeClass.Var {
      t = self.resolve(t)
    }
    switch t.type {
      Type.TypeClass.Var => {
        for existing in out {
          if existing.tyvar.id == t.tyvar.id {
            return out
          }
        }
        out.append(Type(t.tyvar!))
      }
      Type.TypeClass.Typename => {
        if !isnull(t.tyname.params) {
          for el in t.tyname.params.elements {
            out = self.collectFreeTyvars(el, out)
          }
        }
      }
      Type.TypeClass.Array => {
        out = self.collectFreeTyvars(t.array.elementType!, out)
      }
      Type.TypeClass.Tuple => {
        for el in t.tuple.elements {
          out = self.collectFreeTyvars(el, out)
        }
      }
      Type.TypeClass.Struct => {
        for ft in t.strct.fieldtypes {
          out = self.collectFreeTyvars(ft, out)
        }
      }
      Type.TypeClass.Function => {
        out = self.collectFreeTyvars(t.function.params, out)
        out = self.collectFreeTyvars(t.function.result, out)
      }
      Type.TypeClass.Choice => {
        for ch in t.choice.choices {
          out = self.collectFreeTyvars(ch, out)
        }
      }
      default => return out
    }
    return out
  }

  // True if the type tree contains any type variable or adaptable AnyInt
  // literal -- i.e. its specialization name is unreliable: an AnyInt names as
  // its u64/i64 default rather than the concrete width it will adapt to, and a
  // free var has no name at all.  Used to decide whether a recursive call's
  // live-resolved argument types reliably name a (possibly different)
  // instantiation, or must fall back to the current instance's name.
  func containsAdaptableType(self, ty: Type) -> bool {
    t = ty
    if t.type == Type.TypeClass.Var {
      t = self.resolve(t)
    }
    switch t.type {
      Type.TypeClass.Var => return true
      Type.TypeClass.AnyInt => return true
      Type.TypeClass.Typename => {
        if !isnull(t.tyname.params) {
          for el in t.tyname.params.elements {
            if self.containsAdaptableType(el) {
              return true
            }
          }
        }
        return false
      }
      Type.TypeClass.Array => return self.containsAdaptableType(t.array.elementType!)
      Type.TypeClass.Tuple => {
        for el in t.tuple.elements {
          if self.containsAdaptableType(el) {
            return true
          }
        }
        return false
      }
      Type.TypeClass.Struct => {
        for ft in t.strct.fieldtypes {
          if self.containsAdaptableType(ft) {
            return true
          }
        }
        return false
      }
      Type.TypeClass.Function => {
        if self.containsAdaptableType(t.function.params) {
          return true
        }
        return self.containsAdaptableType(t.function.result)
      }
      Type.TypeClass.Choice => {
        for ch in t.choice.choices {
          if self.containsAdaptableType(ch) {
            return true
          }
        }
        return false
      }
      default => return false
    }
  }

  func isComparisonOp(self, t: db.ExprType) -> bool {
    return (t == db.ExprType.Lt || t == db.ExprType.Le ||
            t == db.ExprType.Gt || t == db.ExprType.Ge ||
            t == db.ExprType.Equal || t == db.ExprType.Notequal)
  }

  // The arithmetic node kinds that combine values inside a modular
  // expression `... mod m`.  Their operands reduce into [0, m) first, so
  // they may have different widths.
  func isModularArith(self, t: db.ExprType) -> bool {
    return (t == db.ExprType.Add || t == db.ExprType.Sub ||
            t == db.ExprType.Mul || t == db.ExprType.Div ||
            t == db.ExprType.Exp || t == db.ExprType.Negate ||
            t == db.ExprType.NegateTrunc)
  }

  // Typecheck an operand of a modular expression.  Arithmetic nodes combine
  // values that are each reduced into [0, m), so their operands need not
  // share a width; only leaves typecheck normally (they reduce mod m at
  // codegen, mirroring genCModular's leaf handling).
  func typecheckModularOperand(self, e: db.Expr, modTy: Type) {
    if e.type == db.ExprType.Exp {
      // The base reduces mod m; the exponent is an ordinary integer.
      base = e.firstChildExpr!
      exponent = base.nextExprChildExpr!
      self.typecheckModularOperand(base, modTy)
      self.expr(exponent)
      e.typedValue = modTy
    } else if e.type == db.ExprType.Negate || e.type == db.ExprType.NegateTrunc {
      self.typecheckModularOperand(e.firstChildExpr!, modTy)
      e.typedValue = modTy
    } else if self.isModularArith(e.type) {
      opLeft = e.firstChildExpr!
      opRight = opLeft.nextExprChildExpr!
      self.typecheckModularOperand(opLeft, modTy)
      self.typecheckModularOperand(opRight, modTy)
      e.typedValue = modTy
    } else {
      // A leaf value (variable, literal, call, cast, ...).
      self.expr(e)
    }
  }

  // Is a function-choice worth ATTEMPTING for these args?  A user
  // operator with all-class params is eligible only when an argument
  // resolves to one of those classes; anything else (builtins, mixed
  // signatures) is always eligible.
  func choiceEligible(self, choice: Type, args: Type) -> bool {
    ceTy = self.resolve(choice)
    ceParams = null(Type)
    if ceTy.type == Type.TypeClass.Polymorphic {
      ceScope = self.resolve(ceTy.poly.scope)
      if ceScope.type == Type.TypeClass.Function {
        ceParams = self.resolve(ceScope.function.params!)
      }
    } else if ceTy.type == Type.TypeClass.Function {
      ceParams = self.resolve(ceTy.function.params!)
    }
    if isnull(ceParams) {
      return true
    }
    ceElems = arrayof(Type)
    if ceParams.type == Type.TypeClass.Tuple {
      for ceE in ceParams.tuple.elements {
        ceElems.append(self.resolve(ceE))
      }
    } else {
      ceElems.append(ceParams!)
    }
    ceClassNames = arrayof(string)
    for ceP in ceElems {
      if ceP.type == Type.TypeClass.Typename {
        if !isnull(self.lookupClass(ceP.tyname.name)) {
          ceClassNames.append(ceP.tyname.name.name)
        }
      }
    }
    if ceClassNames.length() != ceElems.length() || ceClassNames.length() == 0u64 {
      // Not an all-class-param signature; always try it.
      return true
    }
    ceArgs = self.resolve(args)
    ceArgList = arrayof(Type)
    if ceArgs.type == Type.TypeClass.Tuple {
      for ceA in ceArgs.tuple.elements {
        ceArgList.append(self.resolve(ceA))
      }
    } else {
      ceArgList.append(ceArgs)
    }
    for ceA2 in ceArgList {
      if ceA2.type == Type.TypeClass.Typename {
        for ceN in ceClassNames {
          if ceA2.tyname.name.name == ceN {
            return true
          }
        }
      }
    }
    return false
  }

  func apply(self, function: Type, args: Type,
             location: db.Location? = null(db.Location)) -> Type? {
    ty = function
    if ty.type == Type.TypeClass.Var {
      ty = self.resolve(ty)
      if ty.type == Type.TypeClass.Var {
        // This will happen in the body of a recursive function, when it attempts
        // to apply itself for the first time.  Initially, the function identifier
        // is set to a type variable.
        newty = FN(Type(self.newTyvar()), Type(self.newTyvar()))
        te = self.unifier.unify(ty, newty, location)
        assert(isnull(te))
        ty = newty
      }
    }
    switch ty.type {
      Type.TypeClass.Function => {
        te = self.unifier.unify(ty.function!.params, args, location)
        if !isnull(te) {
          self.typeError("could not unify\n%s    parameters of function %s\n%s    with args %s:\n%s%s"
                          % (TypeLoggingPrefix, ty.toString(),
                             TypeLoggingPrefix, args.toString(), TypeLoggingPrefix, te.msg),
                         location)
          return null(Type)
        }
        // Return the unresolved result: expression snapshots keep variables
        // that resolve to adaptable literal types (per-call polymorphism).
        return ty.function!.result
      }

      Type.TypeClass.Polymorphic => {
        f2 = ty.poly!.open(self.unifier, &self.unifier.newVar())
        apPreErrs = self.countTypeErrors()
        self.unifier.constraintFail = false
        apRes = self.apply(f2, args, location)
        if isnull(apRes) && self.unifier.constraintFail {
          // The generalized type carries a constraint FROZEN at the
          // definition walk (a choice arm bound a then-free template
          // var: abs's param wears Negate's f32|f64|Int arm and
          // rejects u32 although the UINT arm exists).  Retry with the
          // opened copy's constraints STRIPPED; the demand round
          // re-derives arm selection inside the body, where the
          // concrete types pick the right arms — and reports errors
          // there if none fits.
          while self.countTypeErrors() > apPreErrs {
            self.popTypeError()
          }
          f3 = ty.poly!.open(self.unifier, &self.unifier.newVar())
          apFrees = arrayof(Type)
          apFrees = self.collectFreeTyvars(f3, apFrees)
          for apV in apFrees {
            apV.tyvar.constraint = null(Type)
          }
          apRes = self.apply(f3, args, location)
        }
        self.unifier.constraintFail = false
        return apRes
      }

      Type.TypeClass.Choice => {
        countErrors = 0
        for choice in ty.choice!.choices {
           // A user operator whose params are ALL class-typed may only
           // apply when some argument actually resolves to one of those
           // classes.  A FREE operand var would otherwise greedily bind
           // to the first overload's class (Foo.age froze as
           // Element(...) at Foo's own class walk), and failed attempts
           // leave partial bindings behind (no rollback).
           if !self.choiceEligible(choice, args) {
             countErrors += 0
           } else {
           ty2 = self.apply(choice, args, location)
           if !isnull(ty2) {
             // make sure that there are no type errors -- we can ignore
             // any errors from previous branch attempts.
             while countErrors > 0 {
               self.popTypeError()
               countErrors -= 1
             }
             return ty2
           }
           countErrors += 1
           }
        }
        self.typeError("Failed to apply any choice of function type %s to %s."
                       % (ty.toString(), args.toString()),
                       location)
        return null(Type)
      }
      default => {
        self.typeError("attempting to apply a non-function %s to %s."
                         % (ty.toString(), args.toString()), location)
        return null(Type)
      }
    }
  }

  // ------------------------- Typecheck explicit type expressions ---------------------

  func namedType(self, name: Sym) -> Type {
    if name.name == "Int" {
      return INTEGER()
    } else if name.name == "Uint" {
      return UINTEGER()
    } else if name.name == "String" {
      return STRING()
    } else if name.name == "Bool" {
      return BOOLEAN()
    } else {
      return Type(TypeName(name))
    }
  }

  func explicitType(self, typeExpr: db.Expr) -> Type {
    switch typeExpr.type {
      db.ExprType.UintType => return U(<u64>typeExpr.width)
      db.ExprType.IntType =>  return I(<u64>typeExpr.width)
      db.ExprType.FloatType => return F(<u64>typeExpr.width)
      db.ExprType.StringType => return STR
      db.ExprType.BoolType => return BOOL
      db.ExprType.NoneType => return NONETY()
      db.ExprType.Ident => return self.namedType(typeExpr.val.symVal!)
      default => {
        t = self.tryExplicitType(typeExpr)
        if !isnull(t) {
          return t!
        }
        raise Status.Unimplemented, "TypeExpression type not yet supported by typechecker", typeExpr.type
      }
    }
  }

  // The type for a variable's type constraint.  Constraint forms we cannot
  // evaluate (e.g. choices like "string | bool") leave the variable
  // unconstrained rather than failing.
  func constraintType(self, typeExpr: db.Expr) -> Type {
    t = self.tryExplicitType(typeExpr)
    if isnull(t) {
      return Type(self.newTyvar())
    }
    if t.type == Type.TypeClass.AnyInt {
      // "Int"/"Uint" constraints accept any width; use a constrained type
      // variable so unification records the width actually passed.
      return Type(self.newConstrainedTyvar(t!))
    }
    if t.type == Type.TypeClass.Typename {
      name = t.tyname.name
      self.demandClass(name)
      info = self.lookupClass(name)
      if !isnull(info) {
        if isnull(info.selfType) {
          // The class is still typechecking, so its parameter list is
          // incomplete (a self-referential constraint like mother: Human?
          // inside Human's own constructor would bake the wrong arity).
          // The bare nominal knot unifies with any specialization.
          bareKnot = TypeName(name)
          bareKnot.isNullable = t.tyname.isNullable
          return Type(bareKnot)
        }
        // A class name constraint matches any instantiation of the class;
        // parameterize it with fresh variables so unification against a
        // concrete instance (e.g. Integer(u64,)) succeeds.
        if info.paramVars.length() > 0 {
          cparams = arrayof(Type)
          for pv in info.paramVars {
            cparams.append(Type(self.newTyvar()))
          }
          cname = TypeName(name, TupleType(cparams))
          cname.isNullable = t.tyname.isNullable
          return Type(cname)
        }
        return t!
      }
      if (isnull(self.lookupEnum(name)) &&
          isnull(self.lookupTyname(name)) && name.name != "string" &&
          name.name != "bool" && name.name != "none") {
        // An unrecognized name; likely an unsupported constraint form.
        return Type(self.newTyvar())
      }
    }
    return t!
  }

  // Convert a type expression to a Type, returning null for forms that
  // cannot be evaluated here (rather than raising).
  func tryExplicitType(self, typeExpr: db.Expr) -> Type? {
    switch typeExpr.type {
      db.ExprType.UintType => return U(<u64>typeExpr.width)
      db.ExprType.IntType => return I(<u64>typeExpr.width)
      db.ExprType.FloatType => return F(<u64>typeExpr.width)
      db.ExprType.StringType => return STR
      db.ExprType.BoolType => return BOOL
      db.ExprType.NoneType => return NONETY()
      db.ExprType.Ident => return self.namedType(typeExpr.val.symVal!)
      db.ExprType.Tuple, db.ExprType.List => {
        elements = arrayof(Type)
        for child in typeExpr.childExprs() {
          t = self.tryExplicitType(child)
          if isnull(t) {
            return null(Type)
          }
          elements.append(t!)
        }
        return Type(TupleType(elements))
      }
      db.ExprType.Array => {
        first = typeExpr.firstChildExpr
        if isnull(first) {
          return null(Type)
        }
        t = self.tryExplicitType(first!)
        if isnull(t) {
          return null(Type)
        }
        return ARRAY(t!)
      }
      db.ExprType.Null => {
        // Foo? -- the nullable form of the inner type.
        nullableInner = self.tryExplicitType(typeExpr.firstChildExpr!)
        if isnull(nullableInner) {
          return null(Type)
        }
        if nullableInner.type == Type.TypeClass.Typename {
          nullableName = TypeName(nullableInner.tyname.name, nullableInner.tyname.params)
          nullableName.isNullable = true
          return Type(nullableName)
        }
        return nullableInner
      }
      db.ExprType.Typeof => {
        // typeof(expr) in a type position: the type of the expression.
        return self.expr(typeExpr.firstChildExpr!)
      }
      db.ExprType.Unsigned, db.ExprType.Signed => {
        // unsigned(x)/signed(x) in a type position: x's integer type with
        // the signedness flipped accordingly.
        innerTy = self.expr(typeExpr.firstChildExpr!)
        if isnull(innerTy) {
          return null(Type)
        }
        rin = self.resolve(innerTy!)
        if rin.type == Type.TypeClass.Int {
          if typeExpr.type == db.ExprType.Unsigned {
            return U(<u64>rin.int.width)
          }
          return I(<u64>rin.int.width)
        }
        if rin.type == Type.TypeClass.AnyInt {
          if typeExpr.type == db.ExprType.Unsigned {
            return U(64)
          }
          return I(64)
        }
        if rin.type == Type.TypeClass.Var {
          // Unknown until instantiation; keep the variable (the width
          // resolves at emission).
          return innerTy
        }
        return null(Type)
      }
      default => return null(Type)
    }
  }

  // True if a typeswitch case pattern matches the resolved scrutinee type.
  func typePatternMatches(self, pattern: Type, actual: Type) -> bool {
    // The empty tuple and `none` are the same unit type: a `()` case
    // pattern must match a none-typed scrutinee (the turing test's
    // recursion base case reaches the typeswitch as none after
    // decParens((())) resolves), and vice versa.
    patIsUnit = false
    if pattern.type == Type.TypeClass.Tuple {
      if pattern.tuple.elements.length() == 0u64 {
        patIsUnit = true
      }
    }
    if pattern.type == Type.TypeClass.Typename {
      if isnull(pattern.tyname.params) && pattern.tyname.name.name == "none" {
        patIsUnit = true
      }
    }
    if patIsUnit {
      if actual.type == Type.TypeClass.Tuple {
        if actual.tuple.elements.length() == 0u64 {
          return true
        }
      }
      if actual.type == Type.TypeClass.Typename {
        if isnull(actual.tyname.params) && actual.tyname.name.name == "none" {
          return true
        }
      }
    }
    if pattern.type == Type.TypeClass.Typename && isnull(pattern.tyname.params) {
      pname = pattern.tyname.name.name
      if pname == "Class" {
        // The Class meta-pattern matches any class instance type.
        if actual.type == Type.TypeClass.Typename {
          if !isnull(self.lookupClass(actual.tyname.name)) {
            return pattern.tyname.isNullable == actual.tyname.isNullable
          }
        }
        return false
      }
      if pname == "Array" {
        // The Array meta-pattern matches any array type.
        return actual.type == Type.TypeClass.Array
      }
    }
    if (pattern.type == Type.TypeClass.Typename &&
        actual.type == Type.TypeClass.Typename &&
        isnull(pattern.tyname.params)) {
      // An unparameterized type name (e.g. a class name) matches any
      // instantiation of that name.  Nullability must agree: a Foo case
      // does not match a nullable Foo? scrutinee, nor vice versa.
      return (pattern.tyname.name.name == actual.tyname.name.name &&
              pattern.tyname.isNullable == actual.tyname.isNullable)
    }
    if pattern.type == Type.TypeClass.AnyInt && actual.type == Type.TypeClass.Int {
      return pattern.anyInt.isSigned == actual.int.isSigned
    }
    if pattern.type == Type.TypeClass.Int && actual.type == Type.TypeClass.AnyInt {
      return pattern.int.isSigned == actual.anyInt.isSigned
    }
    if pattern.type == Type.TypeClass.Tuple && actual.type == Type.TypeClass.Tuple {
      if pattern.tuple.elements.length() != actual.tuple.elements.length() {
        return false
      }
      for idx in range(pattern.tuple.elements.length()) {
        if !self.typePatternMatches(pattern.tuple.elements[idx],
                                    actual.tuple.elements[idx]) {
          return false
        }
      }
      return true
    }
    return pattern == actual
  }

  // Does a typeswitch case pattern expression match the resolved scrutinee
  // type?  Handles alternation (a | b), integer width ranges (u1 ... u64),
  // and explicit types.
  func casePatternMatches(self, typeExpr: db.Expr, rty: Type) -> bool {
    if typeExpr.type == db.ExprType.Bitor {
      altLhs = typeExpr.firstChildExpr!
      altRhs = altLhs.nextExprChildExpr!
      return (self.casePatternMatches(altLhs, rty) ||
              self.casePatternMatches(altRhs, rty))
    }
    if typeExpr.type == db.ExprType.Dotdotdot {
      lowExpr = typeExpr.firstChildExpr!
      highExpr = lowExpr.nextExprChildExpr!
      lowTy = self.tryExplicitType(lowExpr)
      highTy = self.tryExplicitType(highExpr)
      if isnull(lowTy) || isnull(highTy) {
        return false
      }
      rlo = self.resolve(lowTy!)
      rhi = self.resolve(highTy!)
      if rlo.type != Type.TypeClass.Int || rhi.type != Type.TypeClass.Int {
        return false
      }
      if rty.type == Type.TypeClass.Int {
        actualSigned = rty.int.isSigned
        actualWidth = rty.int.width
      } else if rty.type == Type.TypeClass.AnyInt {
        actualSigned = rty.anyInt.isSigned
        actualWidth = 64u32
      } else {
        return false
      }
      return (actualSigned == rlo.int.isSigned &&
              actualWidth >= rlo.int.width && actualWidth <= rhi.int.width)
    }
    t = self.tryExplicitType(typeExpr)
    if !isnull(t) {
      return self.typePatternMatches(t!, rty)
    }
    return false
  }

  // Select the typeswitch case matching the resolved scrutinee type,
  // optionally typechecking the selected case's body.  Records and returns
  // the selected index; raises if no case matches.
  // Match the case arms against an EXPLICIT scrutinee type: codegen of
  // specialized bodies recovers the live per-spec type (the statement's
  // own expression slot holds one round's snapshot).
  func selectTypeswitchCaseFor(self, statement: db.Statement, rty: Type) -> u32 {
    selected = 0xffffffffu32
    index = 0u32
    for caseStatement in statement.subBlock.statements() {
      if selected == 0xffffffffu32 {
        if caseStatement.type == db.StateType.Case && !isnull(caseStatement.expr) {
          hadPatternChild = false
          for typeExpr in caseStatement.expr.childExprs() {
            hadPatternChild = true
            if self.casePatternMatches(typeExpr, rty) {
              selected = index
            }
          }
          if !hadPatternChild {
            // A single unwrapped pattern is the case expression itself.
            if self.casePatternMatches(caseStatement.expr!, rty) {
              selected = index
            }
          }
        } else {
          // The default case matches anything.
          selected = index
        }
      }
      index += 1u32
    }
    if selected == 0xffffffffu32 {
      statement.location.error("No typeswitch case matches type " + rty.toString())
      raise Status.InvalidArgument, "No typeswitch case matches type ", rty.toString()
    }
    return selected
  }

  func selectTypeswitchCase(self, statement: db.Statement, typecheckBody: bool) -> u32 {
    rty = self.resolve(statement.expr.typedValue!)
    selected = self.selectTypeswitchCaseFor(statement, rty)
    if typecheckBody {
      i = 0u32
      for caseStatement in statement.subBlock.statements() {
        if i == selected {
          preArmErrs = self.countTypeErrors()
          for s in caseStatement.subBlock.statements() {
            self.statement(s, caseStatement.subBlock)
          }
          if self.countTypeErrors() == preArmErrs {
            // The arm typechecks under this (now concrete) scrutinee;
            // clear any definition-time poison.
            caseStatement.typecheckPoisoned = false
          }
        }
        i += 1u32
      }
      // Only cache the selection when typechecking a concrete scrutinee.
      // Codegen of polymorphic functions re-selects per instantiation.
      statement.selectedCaseIndex = selected
    }
    return selected
  }


  // ------------------------- Typechecking database structures ------------------------

  func symbol(self, symbol: Sym) -> Type? {
    sm = SymbolMapping(symbol, symbol.typedValue)
    found = self.findSymbolMapping(sm)
    if !isnull(found) {
      return found.value
    }
    // Not bound in any open scope.  Reuse the sym's last type only while
    // it is still an unresolved variable (a forward reference to a
    // module-level definition typechecked later); a concrete type is a
    // leftover local from an unrelated closed scope (syms are interned by
    // name) and must not leak into this new binding.
    prior = symbol.typedValue
    if !isnull(prior) {
      rp = self.resolve(prior!)
      if rp.type == Type.TypeClass.Var {
        return self.newSymbol(symbol, prior)
      }
    }
    return self.newSymbol(symbol, null(Type))
  }

  // Rewrite <moduleAlias>.<member> in place into a plain reference to
  // <member>.  Modules share one global namespace in the bootstrap, so the
  // qualifier only needs to disappear.  Returns true if a rewrite happened.
  func rewriteModuleMember(self, expr: db.Expr) -> bool {
    if expr.type != db.ExprType.Dot {
      return false
    }
    lhs = expr.firstChildExpr!
    if lhs.type != db.ExprType.Ident {
      return false
    }
    member = lhs.nextExprChildExpr!
    if member.type != db.ExprType.Ident {
      return false
    }
    if isnull(db.lookupModuleAlias(lhs.val.symVal!)) {
      return false
    }
    memberSym = member.val.symVal!
    expr.removeChildExpr(lhs)
    expr.removeChildExpr(member)
    expr.type = db.ExprType.Ident
    expr.val = db.Value(memberSym)
    return true
  }

  func getSymbolType(self, symbol: Sym) -> Type? {
    sm = SymbolMapping(symbol, null(Type))
    found = self.findSymbolMapping(sm)
    if !isnull(found) {
      return found.value
    }
    return null(Type)
  }

  func variable(self, v: db.Variable) -> Type? {
    // TODO: handle v.isConst
    if v.isParam && v.sym.name == "self" && !isnull(self.currentSelfType) {
      // The self parameter of a class method is the class instance type.
      ty = self.currentSelfType!
      self.newSymbol(v.sym, ty)
      v.typedValue = ty
      return ty
    }
    if isnull(v.typeExpr) {
      ty = Type(self.newTyvar())
    } else {
      ty = self.constraintType(v.typeExpr!)
    }
    if v.isParam {
      self.newSymbol(v.sym, ty)
    } else {
      ty = self.symbol(v.sym)
    }
    // Syms are interned by name, so sym.typedValue is clobbered when another
    // function has a same-named variable.  Codegen must use the type stored
    // on the Variable itself.
    v.typedValue = ty

    if db.getRoot().traceTypes {
       v.location.annotation("\n[Typecheck] ", TypeLoggingPrefix)
       println "%s%s" % (TypeLoggingPrefix, ty.toString())
    }
    return ty
  }

  func value(self, val: db.Value) -> Type? {
    switch val.type {
      db.DatatypeType.Bool => return BOOL
      db.DatatypeType.String => return STR
      db.DatatypeType.Int => {
        if val.widthUnspecified {
          // Unsuffixed literals adapt to any integer width; codegen
          // defaults unresolved AnyInt to 64 bits.
          return INTEGER()
        }
        return I(<u64>val.width)
      }
      db.DatatypeType.Uint => {
        if val.widthUnspecified {
          return UINTEGER()
        }
        return U(<u64>val.width)
      }
      db.DatatypeType.Float => return F(<u64>val.width)
      db.DatatypeType.Sym => return self.symbol(val.symVal!)
      default => raise Status.Unimplemented, "Value type not yet supported by typechecker: ", val.type
    }
  }

  // ---- typecheck expressions
  func expr(self, expr: db.Expr) -> Type? {
    result = null(Type)
    switch expr.type {
      db.ExprType.Constant => result = self.value(expr.val)
      db.ExprType.Ident => result = self.value(expr.val)

      // randN: a random N-bit unsigned integer.
      db.ExprType.RandUint => result = U(<u64>expr.width)

      db.ExprType.List, db.ExprType.Tuple => {
        elements = arrayof(Type)
        allTypeValues = true
        for child in expr.childExprs() {
          ty = self.expr(child)
          if isnull(ty) {
            return ty
          }
          if !child.isType {
            allTypeValues = false
          }
          elements.append(ty!)
        }
        if allTypeValues && !isnull(expr.firstChildExpr) {
          // A tuple of type values, e.g. (u32, string), is itself a type value.
          expr.isType = true
        }
        result = Type(TupleType(elements))
      }

      // Binary expressions --------------------------------------------------
      db.ExprType.Add, db.ExprType.Div, db.ExprType.Mul, db.ExprType.Sub, db.ExprType.Bitxor, db.ExprType.AddTrunc, db.ExprType.MulTrunc, db.ExprType.SubTrunc, db.ExprType.Bitand, db.ExprType.Bitor, db.ExprType.Or, db.ExprType.Exp, db.ExprType.Mod, db.ExprType.And, db.ExprType.Or, db.ExprType.Xor, db.ExprType.Shl, db.ExprType.Shr, db.ExprType.Rotl, db.ExprType.Rotr, db.ExprType.Lt, db.ExprType.Le, db.ExprType.Gt, db.ExprType.Ge, db.ExprType.Equal, db.ExprType.Notequal, db.ExprType.Equals, db.ExprType.Equals, db.ExprType.AddEquals, db.ExprType.SubEquals, db.ExprType.MulEquals, db.ExprType.DivEquals, db.ExprType.ModEquals, db.ExprType.AndEquals, db.ExprType.OrEquals, db.ExprType.XorEquals, db.ExprType.BitandEquals, db.ExprType.BitorEquals, db.ExprType.BitxorEquals, db.ExprType.ExpEquals, db.ExprType.ShlEquals, db.ExprType.ShrEquals, db.ExprType.RotlEquals, db.ExprType.RotrEquals, db.ExprType.AddTruncEquals, db.ExprType.SubTruncEquals, db.ExprType.MulTruncEquals => {
        if isnull(expr.firstChildExpr) || isnull(expr.firstChildExpr.nextExprChildExpr) {
          self.typeError("internal: binary expression with missing operands",
              expr.location)
          return null(Type)
        }
        left = self.expr(expr.firstChildExpr!)
        right = self.expr(expr.firstChildExpr!.nextExprChildExpr!)
        if isnull(left) || isnull(right) {
          return left
        }
        bopty = self.operatorChoices(expr.type, builtinType(expr.type))!
        // In a plain top-level function (no enclosing class context), a user
        // operator overload applied to bare-variable operands must NOT commit
        // to that overload -- doing so binds the operands to the overload's
        // class and monomorphizes the function.  Keep the operands polymorphic;
        // the C backend re-dispatches the operator per concrete instantiation.
        // Scoped to isnull(currentClassInfo) so it does not fire inside class
        // methods / relation-transformer compares (e.g. classheapsort's
        // _compareElement), which rely on the commit.
        ddDefer = false
        if bopty.type == Type.TypeClass.Choice && isnull(self.currentClassInfo) {
          ddL = self.resolve(left!)
          ddR = self.resolve(right!)
          if ddL.type == Type.TypeClass.Var && ddR.type == Type.TypeClass.Var {
            ddDefer = true
          }
        }
        if ddDefer {
          if self.isComparisonOp(expr.type) {
            result = BOOL
          } else {
            result = left
          }
        } else {
          argty = Type(TupleType([left!, right!]))
          result = self.apply(bopty, argty, expr.location)
        }
     }

      db.ExprType.Cast, db.ExprType.CastTrunc => {
        castTypeChild = expr.firstChildExpr!
        castValueChild = castTypeChild.nextExprChildExpr!
        self.expr(castValueChild)
        castTarget = null(Type)
        if castTypeChild.type == db.ExprType.Ident {
          // <x>v where x is a variable casts v to the type of x.
          castTarget = self.getSymbolType(castTypeChild.val.symVal!)
        }
        if isnull(castTarget) {
          if castTypeChild.type == db.ExprType.Dot {
            // <self.m>v casts to the type held by the field.
            castTarget = self.expr(castTypeChild)
          }
        }
        if isnull(castTarget) {
          castTarget = self.tryExplicitType(castTypeChild)
        }
        if isnull(castTarget) {
          self.typeError("Unsupported cast target type", expr.location)
          return null(Type)
        }
        castTypeChild.typedValue = castTarget
        result = castTarget
      }

      db.ExprType.In => {
        // 'in' has no builtin form; it requires a user-defined operator.
        left = self.expr(expr.firstChildExpr!)
        right = self.expr(expr.firstChildExpr!.nextExprChildExpr!)
        if isnull(left) || isnull(right) {
          return left
        }
        inopty = self.operatorChoices(expr.type, null(Type))
        if isnull(inopty) {
          self.typeError("No 'in' operator defined for these types", expr.location)
          return null(Type)
        }
        argty = Type(TupleType([left!, right!]))
        result = self.apply(inopty!, argty, expr.location)
      }

      db.ExprType.Select => {
        condChild = expr.firstChildExpr!
        trueChild = condChild.nextExprChildExpr!
        falseChild = trueChild.nextExprChildExpr!
        condTy = self.expr(condChild)
        trueTy = self.expr(trueChild)
        falseTy = self.expr(falseChild)
        if isnull(condTy) || isnull(trueTy) || isnull(falseTy) {
          return null(Type)
        }
        te = self.unify(condTy!, BOOL)
        if !isnull(te) {
          self.typeError(
            "Condition of ?: must be bool, not %s" % condTy.toString(), expr.location)
        }
        te = self.unify(trueTy!, falseTy!)
        if !isnull(te) {
          self.typeError(
            "Branches of ?: have different types %s and %s" %
                (trueTy.toString(), falseTy.toString()),
            expr.location)
        }
        result = trueTy
      }

      db.ExprType.Modint => {
        // <left> mod <m>: the left expression evaluates in Z/m.  The result
        // has the modulus's type, or bool when the left expression is a
        // comparison (both comparison operands reduce mod m).
        modLeft = expr.firstChildExpr!
        modModulus = modLeft.nextExprChildExpr!
        modTy = self.expr(modModulus)
        if isnull(modTy) {
          return null(Type)
        }
        // A still-FREE modulus (a template class's <m> during its
        // definition walk) must not bind to the adaptable UINTEGER
        // STRUCTURE: that freezes the class's type slots as AnyInt, and
        // the later concrete construction (u255) can only check against
        // the structure, never narrow it (edwards2's whole class family
        // emitted u64-defaulted).  Leave it free; the constructor call
        // binds it concrete, and the constraint checks then.
        modFreeVar = self.resolve(modTy!).type == Type.TypeClass.Var
        if !modFreeVar {
          te = self.unify(modTy!, UINTEGER())
          if !isnull(te) {
            self.typeError(
              "Modulus must be an unsigned integer: %s" % te.msg, expr.location)
            return null(Type)
          }
        }
        // A modular congruence `a == b mod m` (also !=, <, <=, >, >=) reduces
        // each operand into [0, m) and then compares, so the operands need
        // not share a type: `i*i == -1 mod m` compares an unsigned square
        // with a signed -1.  Typecheck the operands individually instead of
        // applying the comparison operator, which would couple them.
        isModCompare = (modLeft.type == db.ExprType.Equal ||
                        modLeft.type == db.ExprType.Notequal ||
                        modLeft.type == db.ExprType.Lt ||
                        modLeft.type == db.ExprType.Le ||
                        modLeft.type == db.ExprType.Gt ||
                        modLeft.type == db.ExprType.Ge)
        if isModCompare {
          cmpL = modLeft.firstChildExpr!
          cmpR = cmpL.nextExprChildExpr!
          self.typecheckModularOperand(cmpL, modTy!)
          self.typecheckModularOperand(cmpR, modTy!)
          modLeft.typedValue = BOOL
          result = BOOL
        } else if self.isModularArith(modLeft.type) {
          // Modular arithmetic reduces every operand into [0, m) before
          // combining, so the operands need not share a width: `a * R mod N`
          // with a:u256 and R:u257 is fine.  Typecheck the subtree without
          // coupling operand types; the result has the modulus's type.
          self.typecheckModularOperand(modLeft, modTy!)
          result = modTy
        } else {
          modLeftTy = self.expr(modLeft)
          if isnull(modLeftTy) {
            return modLeftTy
          }
          rModLeftTy = self.resolve(modLeftTy!)
          if (rModLeftTy.type == Type.TypeClass.Typename &&
              rModLeftTy.tyname.name.name == "bool") {
            result = rModLeftTy
          } else {
            // Sign differences (e.g. -1 mod 13) are fine: values reduce into
            // [0, m), so only adapt widths when both sides are concrete.
            te = self.unify(modLeftTy!, modTy!)
            result = modTy
          }
        }
      }

      db.ExprType.Slice => {
        sliceBase = expr.firstChildExpr!
        sliceLower = sliceBase.nextExprChildExpr!
        sliceUpper = sliceLower.nextExprChildExpr!
        baseTy = self.expr(sliceBase)
        lowerTy = self.expr(sliceLower)
        upperTy = self.expr(sliceUpper)
        if isnull(baseTy) || isnull(lowerTy) || isnull(upperTy) {
          return baseTy
        }
        te = self.unify(lowerTy!, UINTEGER())
        if isnull(te) {
          te = self.unify(upperTy!, UINTEGER())
        }
        if !isnull(te) {
          self.typeError(
            "Slice bounds must be unsigned integers: %s" % te.msg, expr.location)
          return null(Type)
        }
        rBaseTy = self.resolve(baseTy!)
        if self.isStringType(rBaseTy) || rBaseTy.type == Type.TypeClass.Array {
          // A slice of a string or array has the same type as its base.
          result = rBaseTy
        } else {
          self.typeError(
            "Only strings and arrays can be sliced, not %s." % rBaseTy.toString(),
            expr.location)
          return null(Type)
        }
      }

      db.ExprType.Index => {
        leftChild = expr.firstChildExpr!
        rightChild = expr.firstChildExpr!.nextExprChildExpr!
        left = self.expr(leftChild)
        right = self.expr(rightChild)
        if isnull(left) || isnull(right) {
          return left
        }
        // Index must be an unsigned integer.
        te = self.unify(right!, UINTEGER())
        if !isnull(te) {
          self.typeError(
            "Index expression must be an unsigned integer, not %s." % right.toString(),
            expr.location)
        } else if self.resolve(leftChild.typedValue!).type == Type.TypeClass.Array {
          // The raw type may be a variable bound to the array (a member
          // typed during a deferred re-typecheck).
          result = self.resolve(leftChild.typedValue!).array.elementType
        } else if self.isStringType(self.resolve(leftChild.typedValue!)) {
          // Indexing a string yields a byte.
          result = U(8)
        } else if rightChild.type != db.ExprType.Constant {
          self.sawStructuralGenericError = true
          self.recordVarBlocker(leftChild.typedValue!)
          self.typeError(
           "Indexes must be unsigned integer literals, not %s." % rightChild.toString(),
           expr.location)
        } else {
          indexval = rightChild.val.intVal
          if indexval.width > 64u32 {
            raise Status.Unimplemented, "Index widths greater than 64 bits are not supported"
          }
          index = indexval.uint64()
          if left.type == Type.TypeClass.Typename {
             lst = self.structInstanceType(left!)
             if !isnull(lst) {
               left = lst
             } else {
               lty = self.lookupTyname(left.tyname.name)
               if isnull(lty) {
                 self.typeError(
                   "Cannot index into undefined typename %s." % left.toString(), expr.location)
               } else {
                 left = lty
               }
             }
          }
          if left.type != Type.TypeClass.Tuple && left.type != Type.TypeClass.Struct && left.type != Type.TypeClass.Array {
            self.sawStructuralGenericError = true
            self.recordVarBlocker(left)
            self.typeError(
              "Cannot index into type %s." % left.toString(), expr.location)
          } else {
            result = left.index(index)
          }
        }
      }

      db.ExprType.Dot => {
        if self.rewriteModuleMember(expr) {
          // Now a plain identifier reference to the module member.
          return self.expr(expr)
        }
        dotLhs = expr.firstChildExpr!
        if dotLhs.type == db.ExprType.Ident {
          // Static member access through the class name (e.g. Bar.new(...)):
          // the member's full function type; no self is passed.
          self.demandClass(dotLhs.val.symVal!)
          staticInfo = self.lookupClass(dotLhs.val.symVal!)
          if !isnull(staticInfo) {
            staticField = dotLhs.nextExprChildExpr!
            staticMethod = self.findMethod(staticInfo!, staticField.toString())
            if !isnull(staticMethod) {
              if isnull(staticMethod.typedValue) {
                self.demandMethod(staticInfo!, staticMethod!)
              }
              smty = staticMethod.typedValue
              if !isnull(smty) {
                sopen = smty!
                if sopen.type == Type.TypeClass.Polymorphic {
                  sopen = sopen.poly!.open(self.unifier, &self.unifier.newVar())
                }
                expr.typedValue = sopen
                return sopen
              }
            }
          }
        }
        sty = self.expr(expr.firstChildExpr!)
        if isnull(sty) {
          return null(Type)
        }
        field = expr.firstChildExpr!.nextExprChildExpr!
        // Distinguish `self.<field>` from a field read through any other
        // instance: only self returns the class's canonical field variable
        // (so assignments through self constrain the real field type); every
        // other instance projects onto its own type arguments (see
        // classMemberType / substituteClassVars).
        lhsIsSelf = false
        lhsExpr = expr.firstChildExpr!
        if lhsExpr.type == db.ExprType.Ident {
          if lhsExpr.val.symVal!.name == "self" {
            lhsIsSelf = true
          }
        }
        isClassAccess = false
        if sty.type == Type.TypeClass.Typename {
          // The class may not have typechecked yet (e.g. an element of a
          // relation iterated from an earlier class's method).
          self.demandClass(sty.tyname.name)
          info = self.lookupClass(sty.tyname.name)
          einfo = self.lookupEnum(sty.tyname.name)
          if !isnull(info) {
            // Member access on a class instance.
            isClassAccess = true
            result = self.classMemberType(info!, sty!, field, lhsIsSelf, expr.location)
          } else if !isnull(einfo) {
            // Enum member access like Color.red: typed as the enum itself
            // so enum-constrained parameters accept it (C emits u32).
            isClassAccess = true
            if einfo.hasMember(field.toString()) {
              result = Type(TypeName(sty.tyname.name))
            } else {
              self.typeError("Enum %s has no member %s" % (einfo.sym.name, field.toString()),
                             expr.location)
              result = null(Type)
            }
          } else if sty.tyname.name.name == "Exception" {
            // The exception variable bound by an except clause.
            isClassAccess = true
            if field.toString() == "errorMessage" {
              result = STRING()
            } else {
              self.typeError("Unsupported exception member %s" % field.toString(),
                             expr.location)
              result = null(Type)
            }
          } else if sty.tyname.name.name == "string" {
            // Built-in string methods.
            isClassAccess = true
            result = self.stringMethodType(field.toString(), expr.location)
          } else if sty.tyname.name.name == "bool" {
            // Built-in bool methods.
            isClassAccess = true
            result = self.boolMethodType(field.toString(), expr.location)
          } else {
            st = self.structInstanceType(sty!)
            if !isnull(st) {
              sty = st!
            } else {
              ty = self.lookupTyname(sty.tyname.name)
              if isnull(ty) {
                self.typeError(
                  "Field Selection on an undefined type name %s" % sty.tyname.name.name,
                  expr.location)
                return null(Type)
              }
              sty = ty!
            }
          }
        }

        if isClassAccess {
          isClassAccess = true  // Result was computed by classMemberType above.
        } else if sty.type == Type.TypeClass.Struct {
          ty = sty.strct.select(field.toString())
          if isnull(ty) {
            self.typeError(
              "Field %s does not exist in struct %s" % (field.toString(), sty.toString()),
              expr.location)
          }
          result = ty
        } else if sty.type == Type.TypeClass.Array {
          // arrays have built-in methods 'append', 'length', 'values', 'items',
          // 'concat', 'reverse' etc.
          elementType = sty.array.elementType
          nullTypes = arrayof(Type)
          // Although the following methods technically take the array object
          // as first parameter, we ignore that. If we add the array type in these
          // types we shall need to update the code that typechecks the arguments
          // passed in.
          // length doubles as a property: `a.length` (no call) is a u64.
          isCallTarget = false
          dotParent = expr.parentExpr
          if !isnull(dotParent) && dotParent.type == db.ExprType.Call &&
              dotParent.firstChildExpr == expr {
            isCallTarget = true
          }
          switch field.toString() {
            "append" => result = FN(elementType, NONETY())
            "length" => {
              if isCallTarget {
                result = FN(TUPLE(nullTypes), U(64))
              } else {
                result = U(64)
              }
            }
            // resize returns the resized array, so the result can be
            // assigned (a = [0].resize(12)); the count is any unsigned
            // width (heap code uses u32 indices).
            "resize" => result = FN(Type(self.newConstrainedTyvar(UINTEGER())),
                                    ARRAY(elementType))
            "reverse" => result = FN(TUPLE(nullTypes), NONETY())
            "concat" => result = FN(ARRAY(elementType), NONETY())
            // toString captures the array print form ("[1u64, 2u64]").
            "toString" => result = FN(TUPLE(nullTypes), STRING())

            // The following two require support for iterators:
            // "values" => result = FN(TUPLE(nullTypes), ITERATOR(elementType))
            //"items" => result = FN(TUPLE(nullTypes), ITERATOR(TUPLE(U(64), elementType))

            default => {
              self.typeError(
                "Unsupported array method '%s'" % field.toString(), expr.location)
            }
          }

        } else if sty.type == Type.TypeClass.Tuple {
          // Tuples have a built-in toString() capturing their print form.
          if field.toString() == "toString" {
            noTupleArgs = arrayof(Type)
            result = FN(TUPLE(noTupleArgs), STRING())
          } else {
            self.typeError(
              "Unsupported tuple method '%s'" % field.toString(), expr.location)
          }
        } else if sty.type == Type.TypeClass.Int || sty.type == Type.TypeClass.AnyInt {
          // Built-in integer methods like toString().
          result = self.intMethodType(field.toString(), expr.location)
        } else if sty.type == Type.TypeClass.Var {
          // Duck-type an unconstrained value (e.g. an unannotated
          // parameter) by its member name: if exactly one class defines
          // the member, the value must be an instance of that class.
          duckInfo = self.findClassByMember(field.toString())
          if isnull(duckInfo) {
            // The receiver cannot be pinned to a single class, but if every
            // class declaring this member as a field agrees on its (concrete)
            // type, the access has that type regardless of the eventual class
            // (e.g. `child.hash` is u64 whether child is Foo or Bar).  Resolve
            // it directly so a consuming call (hashValue(child.hash)) gets a
            // concrete argument and the method need not leak a disconnected
            // variable into emission.
            commonFieldTy = self.commonMemberFieldType(field.toString())
            if !isnull(commonFieldTy) {
              result = commonFieldTy
            } else {
              self.sawStructuralGenericError = true
              self.recordVarBlocker(sty)
              // Genuinely ambiguous: yield a fresh variable rather than null so
              // this access defers with the enclosing function and re-resolves
              // under a concrete instantiation (a null would propagate as none
              // and record a spurious none-typed instantiation that the C
              // backend emits and fails to typecheck).
              result = Type(self.newTyvar())
              self.typeError(
                "Field Selection on %s, which is neither an array nor a struct" % sty.toString(),
                expr.location)
            }
          } else {
            duckTy = self.classInstanceType(duckInfo!)
            duckTe = self.unify(sty!, duckTy)
            if !isnull(duckTe) {
              self.typeError(duckTe.msg, expr.location)
            }
            result = self.classMemberType(duckInfo!, duckTy, field, lhsIsSelf, expr.location)
          }
        } else {
          self.typeError(
            "Field Selection on %s, which is neither an array nor a struct" % sty.toString(),
            expr.location)
        }
      }

      // Unary expressions ----------------------------------------------------------
      db.ExprType.Arrayof => {
         // arrayof(t) where t is a variable holding a type value (e.g. a
         // class parameter like Set(elementType)) uses that value; class
         // names bind to their constructor's function type and fall through
         // to the explicit-type path.
         aofTy = null(Type)
         if expr.firstChildExpr.type == db.ExprType.Ident {
           aofTy = self.getSymbolType(expr.firstChildExpr.val.symVal!)
           if !isnull(aofTy) {
             rAofTy = self.resolve(aofTy!)
             if (rAofTy.type == Type.TypeClass.Function ||
                 rAofTy.type == Type.TypeClass.Polymorphic) {
               aofTy = null(Type)
             }
           }
         }
         if isnull(aofTy) {
           if expr.firstChildExpr.type == db.ExprType.Dot {
             // arrayof(self.m): the element type is the field's value type.
             aofTy = self.expr(expr.firstChildExpr!)
           }
         }
         if isnull(aofTy) {
           aofTy = self.explicitType(expr.firstChildExpr!)
         }
         if self.retypecheckNesting > 0u32 {
           // A materialization round pins arrayof(ClassName)'s bare knot
           // to the signature consistent with the round's self type, so
           // the round's body (and its emission) carries concrete element
           // types.  The template pass keeps the knot.
           aofPinned = self.concretizeKnots(self.resolve(aofTy!), 0u32)
           aofTy = aofPinned
         }
         expr.firstChildExpr.typedValue = aofTy
         result = ARRAY(self.resolve(aofTy!))
         // Stage 0: note an as-yet-unregistered class element so Stage 2's
         // per-signature materialization can be demanded here.  Today this arm
         // is silent, which is why Dict's ctor never defers.  Recording only --
         // no deferral is forced yet (that coupling lands in Stage 2).
         aofElem = self.resolve(aofTy!)
         if aofElem.type == Type.TypeClass.Typename {
           if isnull(self.lookupClass(aofElem.tyname.name)) {
             aofBlocker = Blocker(BlockerKind.ClassRegistered)
             aofBlocker.className = aofElem.tyname.name
             self.deferredWorklist.append(Deferred(null(db.Function), aofBlocker))
           }
         }
      }

      db.ExprType.Array => {
        ty = Type(self.newTyvar())
        for child in expr.childExprs() {
          childType = self.expr(child)
          if isnull(childType) {
            return childType
          }
          te = self.unify(ty!, childType!)
          if !isnull(te) {
            self.typeError(
              "Array Elements do not have the same type: %s and %s." % (
                  ty.toString(), childType.toString()),
              expr.location)
          }
        }
        result = ARRAY(self.resolve(ty!))
      }

      db.ExprType.Negate, db.ExprType.NegateTrunc, db.ExprType.Bitnot, db.ExprType.Not => {
        childType = self.expr(expr.firstChildExpr!)
        if isnull(childType) {
          return childType
        }
        opty = builtinType(expr.type)
        result = self.apply(opty, childType!, expr.location)
      }

      db.ExprType.Call => {
        fnchild = expr.firstChildExpr!
        // A <moduleAlias>.<member> target becomes a plain identifier, so
        // named and default arguments normalize for it too.
        didRewrite = self.rewriteModuleMember(fnchild)
        // "123".toUint(type, var ok): the result type is the type argument.
        if fnchild.type == db.ExprType.Dot {
          suBase = fnchild.firstChildExpr!
          suMember = suBase.nextExprChildExpr
          suIsToUint = false
          if !isnull(suMember) {
            if suMember.type == db.ExprType.Ident {
              if suMember.val.symVal.name == "toUint" {
                suIsToUint = true
              }
            }
          }
          if suIsToUint {
            suBaseTy = self.expr(suBase)
            suIsString = false
            if !isnull(suBaseTy) {
              suIsString = self.isStringType(self.resolve(suBaseTy!))
            }
            if suIsString {
              suArgs = fnchild.nextExprChildExpr!
              suTypeArg = suArgs.firstChildExpr!
              suResult = self.explicitType(suTypeArg)
              suTypeArg.typedValue = suResult
              suOkArg = suTypeArg.nextExprChildExpr
              if !isnull(suOkArg) {
                if suOkArg.type == db.ExprType.Ident {
                  suOkTy = self.symbol(suOkArg.val.symVal!)
                  if !isnull(suOkTy) {
                    self.unify(suOkTy!, BOOL)
                  }
                  suOkArg.typedValue = BOOL
                }
              }
              fnchild.typedValue = FN(suResult, suResult)
              expr.typedValue = suResult
              return suResult
            }
          }
        }
        if fnchild.type == db.ExprType.Ident {
          // A constructor call may precede the class's own typechecking
          // (e.g. a hoisted nested class defined after its user); resolving
          // it loosely would record no instantiation for the C backend.
          self.demandClass(fnchild.val.symVal!)
          callee = self.lookupFunctionDef(fnchild.val.symVal!)
          if !isnull(callee) {
            self.normalizeCallArgs(expr, callee!)
          }
        }
        fnchild = expr.firstChildExpr!
        argchild = fnchild.nextExprChildExpr
        // Track this call's callee for demand materialization: the Dot
        // typecheck (classMemberType) fills the top record; argument
        // typechecking nests further calls, hence a stack.
        self.calleeStack.append(CalleeRecord())
        fn = self.expr(fnchild)
        args = self.expr(argchild!)
        callRec = self.calleeStack[self.calleeStack.length() - 1]
        self.calleeStack.resize(self.calleeStack.length() - 1)
        if isnull(fn) || isnull(args) {
          return fn
        }
        result = self.apply(fn!, args!, expr.location)
        if !isnull(result) && !isnull(callRec.viaExpr) {
          if callRec.viaExpr == fnchild {
            self.demandCallResult(callRec, fn!, result!)
          }
        } else if !isnull(result) && fnchild.type == db.ExprType.Ident {
          // A PLAIN-FUNCTION call: the open happened inside apply's
          // Polymorphic branch, so fill the record from the callee's poly
          // now (C3: recursion through plain functions needs per-call
          // materialized frames just like methods do).
          icFn = self.lookupFunctionDef(fnchild.val.symVal!)
          if !isnull(icFn) {
            icTy = icFn.typedValue
            if !isnull(icTy) {
              if icTy.type == Type.TypeClass.Polymorphic {
                callRec.fn = icFn
                callRec.viaExpr = fnchild
                callRec.inst = icTy.poly.instantiations.lastTyvarInstantiation
                if !isnull(callRec.inst) {
                  if !isnull(callRec.inst.type) {
                    self.demandCallResult(callRec, callRec.inst.type!, result!)
                  }
                }
              }
            }
          }
        }
      }

      // Type values: type-literal expressions used as values, e.g. t = u32
      // or bar(string).  They exist only at compile time; codegen emits a
      // zero dummy where a runtime value is syntactically required.
      db.ExprType.UintType, db.ExprType.IntType, db.ExprType.FloatType, db.ExprType.StringType, db.ExprType.BoolType, db.ExprType.NoneType => {
        expr.isType = true
        result = self.tryExplicitType(expr)
      }

      db.ExprType.Typeof => {
        typeofTy = self.expr(expr.firstChildExpr!)
        if isnull(typeofTy) {
          return typeofTy
        }
        expr.isType = true
        result = typeofTy
      }

      db.ExprType.Widthof => {
        // widthof(e): the bit width of e's type, a compile-time u32.
        widthofTy = self.expr(expr.firstChildExpr!)
        if isnull(widthofTy) {
          return widthofTy
        }
        result = U(32)
      }

      db.ExprType.Unsigned, db.ExprType.Signed => {
        signTy = self.expr(expr.firstChildExpr!)
        if isnull(signTy) {
          return signTy
        }
        rSignTy = self.resolve(signTy!)
        wantSigned = expr.type == db.ExprType.Signed
        if rSignTy.type == Type.TypeClass.Int {
          result = Type(IntType(wantSigned, rSignTy.int.width))
        } else if rSignTy.type == Type.TypeClass.AnyInt {
          result = wantSigned ? INTEGER() : UINTEGER()
        } else if rSignTy.type == Type.TypeClass.Var {
          // A generic operand: the result adapts like an unsuffixed literal
          // of the requested sign (concrete widths bind at instantiation).
          result = wantSigned ? INTEGER() : UINTEGER()
        } else {
          self.typeError("unsigned()/signed() require an integer value", expr.location)
          return null(Type)
        }
      }

      db.ExprType.Null => {
        nullChild = expr.firstChildExpr!
        nullTy = null(Type)
        if nullChild.type == db.ExprType.Ident {
          self.demandClass(nullChild.val.symVal!)
          nullInfo = self.lookupClass(nullChild.val.symVal!)
          if !isnull(nullInfo) {
            // null(Foo): a nullable instance of a not-yet-known instantiation
            // of the class.  Instance types always carry a params tuple
            // (possibly empty), so mirror that shape with fresh variables.
            // Use the recorded final arity when paramVars is still being filled
            // (re-entrant null(Foo) during Foo's own param loop, reached via a
            // cascade peer's constructor) so the instance is not too short.
            nullArity = nullInfo.paramVars.length()
            if nullInfo.expectedParamArity >= 0i64 {
              if <u64>nullInfo.expectedParamArity > nullArity {
                nullArity = <u64>nullInfo.expectedParamArity
              }
            }
            nullParams = arrayof(Type)
            for npi in range(nullArity) {
              nullParams.append(Type(self.newTyvar()))
            }
            nullName = TypeName(nullChild.val.symVal!, TupleType(nullParams))
            nullName.isNullable = true
            nullTy = Type(nullName)
          }
        }
        if isnull(nullTy) {
          // null(expr): the nullable form of the expression's type.
          nullChildTy = self.expr(nullChild)
          if isnull(nullChildTy) {
            return nullChildTy
          }
          rNullTy = self.resolve(nullChildTy!)
          if rNullTy.type == Type.TypeClass.Typename {
            nullName2 = TypeName(rNullTy.tyname.name, rNullTy.tyname.params)
            nullName2.isNullable = true
            nullTy = Type(nullName2)
          } else {
            nullTy = nullChildTy
          }
        }
        result = nullTy
      }

      db.ExprType.Isnull => {
        isnullTy = self.expr(expr.firstChildExpr!)
        if isnull(isnullTy) {
          return isnullTy
        }
        result = BOOL
      }

      db.ExprType.Notnull => {
        // x! strips nullability from the type of x.
        notnullTy = self.expr(expr.firstChildExpr!)
        if isnull(notnullTy) {
          return notnullTy
        }
        rNotnullTy = self.resolve(notnullTy!)
        if rNotnullTy.type == Type.TypeClass.Typename && rNotnullTy.tyname.isNullable {
          notnullName = TypeName(rNotnullTy.tyname.name, rNotnullTy.tyname.params)
          result = Type(notnullName)
        } else {
          result = notnullTy
        }
      }

      // &foo(sampleArgs): the address of a function, typed as that function's
      // FunctionType so it unifies with a function-pointer parameter.  The
      // sample arguments select the instantiation of a polymorphic callee.
      db.ExprType.Funcaddr => {
        faCall = expr.firstChildExpr!
        if faCall.type != db.ExprType.Call {
          self.typeError("'&' must be applied to a function call", expr.location)
          return null(Type)
        }
        faCallee = faCall.firstChildExpr!
        faArgs = faCallee.nextExprChildExpr
        faFnTy = self.expr(faCallee)
        if isnull(faFnTy) {
          return faFnTy
        }
        faArgsTy = null(Type)
        if !isnull(faArgs) {
          faArgsTy = self.expr(faArgs!)
        }
        faResolved = self.resolve(faFnTy!)
        faResult = faResolved
        if faResolved.type == Type.TypeClass.Polymorphic && !isnull(faArgsTy) {
          // Open the callee and apply the sample args so the concrete
          // signature (and its instantiation, recorded for the C backend)
          // is selected; the opened FunctionType is the resulting type.
          faOpened = faResolved.poly!.open(self.unifier, &self.unifier.newVar())
          faApplied = self.apply(faOpened, faArgsTy!, expr.location)
          if !isnull(faApplied) {
            faResult = self.resolve(faOpened)
          }
        }
        faCall.typedValue = faResult
        result = faResult
      }

      default => raise Status.Unimplemented, "Expression type not yet supported by typechecker: ", db.getExprTypeName(expr.type)
    }

    if db.getRoot().traceTypes {
       expr.location.annotation("\n[Typecheck] ", TypeLoggingPrefix)
       if isnull(result) {
         println "%sType Error!" % TypeLoggingPrefix
         // Dump latest type errors as we go. These won't repeat errors already
         // reported. We've already printed the line and caret marks, so don't print them again
         self.dumpTypeErrors(false, TypeLoggingPrefix)
       } else {
         println "%s%s" % (TypeLoggingPrefix, result.toString())
       }
    }
    if !isnull(result) {
      resolvedResult = self.resolve(result!)
      if (resolvedResult.type == Type.TypeClass.AnyInt &&
          result.type == Type.TypeClass.Var) {
        // Keep the variable: a parameter's literal-induced AnyInt binding
        // is forgotten at generalization (per-call literal polymorphism),
        // so codegen must resolve through the variable per instantiation.
        expr.typedValue = result
        return result
      }
      result = resolvedResult
    }
    expr.typedValue = result
    return result
  }

  // True if the resolved type contains an adaptable integer anywhere.
  func containsAnyInt(self, t: Type) -> bool {
    switch t.type {
      Type.TypeClass.AnyInt => return true
      Type.TypeClass.Array => return self.containsAnyInt(self.resolve(t.array.elementType!))
      Type.TypeClass.Tuple => {
        for element in t.tuple.elements {
          if self.containsAnyInt(self.resolve(element)) {
            return true
          }
        }
        return false
      }
      Type.TypeClass.Function => {
        return (self.containsAnyInt(self.resolve(t.function.params!)) ||
            self.containsAnyInt(self.resolve(t.function.result!)))
      }
      default => return false
    }
  }


  // Rewrite a call's arguments into full positional form, in the HIR, so
  // both typechecking and code generation see a plain argument tuple:
  // named arguments move to their parameter's position and omitted
  // parameters take a copy of their default initializer.
  func normalizeCallArgs(self, expr: db.Expr, fn: db.Function) {
    if expr.argsNormalized {
      return
    }
    expr.argsNormalized = true
    fnchild = expr.firstChildExpr!
    argchild = fnchild.nextExprChildExpr!
    // The parameters, in order.
    params = arrayof(db.Variable)
    for variable in fn.variables() {
      if variable.isParam && variable.sym.name != "self" {
        params.append(variable)
      }
    }
    // The given arguments.
    positional = arrayof(db.Expr)
    namedNames = arrayof(string)
    namedValues = arrayof(db.Expr)
    if argchild.type == db.ExprType.Tuple {
      for child in argchild.childExprs() {
        if child.type == db.ExprType.Namedparam {
          namedNames.append(child.firstChildExpr.val.symVal.name)
          namedValues.append(child.firstChildExpr.nextExprChildExpr!)
        } else {
          positional.append(child)
        }
      }
    } else if argchild.type == db.ExprType.Namedparam {
      namedNames.append(argchild.firstChildExpr.val.symVal.name)
      namedValues.append(argchild.firstChildExpr.nextExprChildExpr!)
    } else {
      positional.append(argchild)
    }
    if namedNames.length() == 0 && positional.length() == params.length() {
      // Already plain positional and complete.
      return
    }
    // Pick each parameter's argument: positional from the left, then named,
    // then the parameter's default value.
    selected = arrayof(db.Expr)
    for index in range(params.length()) {
      if index < positional.length() {
        selected.append(positional[index])
      } else {
        found = null(db.Expr)
        for n in range(namedNames.length()) {
          if namedNames[n] == params[index].sym.name {
            found = namedValues[n]
          }
        }
        if isnull(found) {
          init = params[index].initializerExpr
          if isnull(init) {
            // Missing argument with no default; leave the call unchanged
            // and let unification report the error.
            return
          }
          found = init.copy()
        }
        selected.append(found!)
      }
    }
    // Detach the old argument expressions and rebuild as a plain tuple.
    // Only the argument container and Namedparam wrappers are unlinked;
    // the argument expressions themselves keep their children.
    expr.removeChildExpr(argchild)
    if argchild.type == db.ExprType.Tuple {
      while !isnull(argchild.firstChildExpr) {
        detach = argchild.firstChildExpr!
        argchild.removeChildExpr(detach)
        if detach.type == db.ExprType.Namedparam {
          value = detach.firstChildExpr.nextExprChildExpr!
          detach.removeChildExpr(value)
        }
      }
    } else if argchild.type == db.ExprType.Namedparam {
      value = argchild.firstChildExpr.nextExprChildExpr!
      argchild.removeChildExpr(value)
    }
    newArgs = db.Expr(db.ExprType.Tuple, argchild.location)
    for s in selected {
      newArgs.appendChildExpr(s)
    }
    expr.appendChildExpr(newArgs)
  }

  // Iterator inlining --------------------------------------------------------
  //
  // A foreach statement over a user-defined iterator is rewritten in place
  // into an InlinedBlock statement holding:
  //   <param> = <argument or default>    (one per iterator parameter)
  //   <iterator body>                    (variables renamed to be unique)
  // where each "yield e" becomes an assignment of e to the loop variable
  // followed by a copy of the foreach body.  Typeswitches in the iterator
  // body keep only the arm selected for the (concrete) argument types, which
  // is how e.g. range(first, second = false) dispatches on argument count.

  // The iterator function a foreach statement iterates, or null: a call to
  // an iterator function or method, or a class instance, which iterates via
  // its values() iterator.
  func findForeachIterator(self, iterExpr: db.Expr) -> db.Function? {
    if iterExpr.type == db.ExprType.Call {
      target = iterExpr.firstChildExpr!
      if target.type == db.ExprType.Ident {
        fn = self.lookupFunctionDef(target.val.symVal!)
        if !isnull(fn) && fn.type == db.FuncType.Iterator {
          return fn
        }
        return null(db.Function)
      }
      if target.type == db.ExprType.Dot {
        methodExpr = target.firstChildExpr!.nextExprChildExpr!
        if methodExpr.type != db.ExprType.Ident {
          return null(db.Function)
        }
        return self.findClassIterator(target.firstChildExpr!, methodExpr.val.symVal.name)
      }
      return null(db.Function)
    }
    return self.findClassIterator(iterExpr, "values")
  }

  // Find an iterator method of the class that |baseExpr| is an instance of.
  func findClassIterator(self, baseExpr: db.Expr, methodName: string) -> db.Function? {
    baseTy = self.expr(baseExpr)
    if isnull(baseTy) {
      return null(db.Function)
    }
    rbase = self.resolve(baseTy!)
    if rbase.type == Type.TypeClass.Array {
      // An iterator added to Array via `appendcode Array` (no ClassInfo).
      return self.findArrayExtIterator(methodName)
    }
    info = null(ClassInfo)
    if rbase.type == Type.TypeClass.Var {
      // Duck-type an unconstrained base (e.g. a forward-referenced module
      // global) by the iterator's name: a unique class defining it fixes
      // the base's class.
      duckInfo = self.findClassByIterator(methodName)
      if !isnull(duckInfo) {
        duckTy = self.classInstanceType(duckInfo!)
        te = self.unify(baseTy!, duckTy)
        if isnull(te) {
          info = duckInfo
        }
      }
    } else if rbase.type == Type.TypeClass.Typename {
      info = self.lookupClass(rbase.tyname.name)
    }
    if isnull(info) {
      return null(db.Function)
    }
    for childfunc in info.fn.childFunctions() {
      if childfunc.type == db.FuncType.Iterator && childfunc.sym.name == methodName {
        return childfunc
      }
    }
    return null(db.Function)
  }

  // Register an iterator/method added to the Array type via `appendcode Array`.
  func registerArrayExtMethod(self, fn: db.Function) {
    m = ArrayExtMethod(fn)
    self.appendArrayExtMethod(m)
  }

  // An Array-extension iterator named |name|, or null.
  func findArrayExtIterator(self, name: string) -> db.Function? {
    for m in self.arrayExtMethods() {
      if m.fn.sym.name == name && m.fn.type == db.FuncType.Iterator {
        return m.fn
      }
    }
    return null(db.Function)
  }

  // The unique class defining an iterator named |name|, if any.
  func findClassByIterator(self, name: string) -> ClassInfo? {
    found = null(ClassInfo)
    count = 0
    for info in self.classInfos() {
      for childfunc in info.fn.childFunctions() {
        if childfunc.type == db.FuncType.Iterator && childfunc.sym.name == name {
          count += 1
          found = info
        }
      }
    }
    if count == 1 {
      return found
    }
    return null(ClassInfo)
  }

  func renamedSym(self, name: string) -> Sym? {
    for idx in range(self.renameOld.length()) {
      if self.renameOld[idx] == name {
        return self.renameNew[idx]
      }
    }
    return null(Sym)
  }

  func addRename(self, name: string) {
    if !isnull(self.renamedSym(name)) {
      return
    }
    self.renameOld.append(name)
    self.renameNew.append(Sym.new(self.renamePrefix + name))
  }

  // Record every variable assigned in the iterator body so it can be renamed.
  func collectIteratorLocals(self, block: db.Block) {
    for s in block.statements() {
      if !isnull(s.expr) {
        self.collectAssignedNamesInExpr(s.expr!)
      }
      if s.type == db.StateType.Foreach {
        nestedLoopVar = s.expr.firstChildExpr!
        if nestedLoopVar.type == db.ExprType.Ident {
          self.addRename(nestedLoopVar.val.symVal.name)
        }
      }
      if !isnull(s.subBlock) {
        self.collectIteratorLocals(s.subBlock!)
      }
    }
  }

  func collectAssignedNamesInExpr(self, expr: db.Expr) {
    if expr.type == db.ExprType.Equals {
      lhs = expr.firstChildExpr!
      if lhs.type == db.ExprType.Ident {
        self.addRename(lhs.val.symVal.name)
      }
    }
    for child in expr.childExprs() {
      self.collectAssignedNamesInExpr(child)
    }
  }

  func renameStatementIdents(self, statement: db.Statement) {
    if !isnull(statement.expr) {
      self.renameExprIdents(statement.expr!)
    }
    if !isnull(statement.subBlock) {
      for s in statement.subBlock.statements() {
        self.renameStatementIdents(s)
      }
    }
  }

  func renameExprIdents(self, expr: db.Expr) {
    if expr.type == db.ExprType.Ident {
      identName = expr.val.symVal.name
      newSym = self.renamedSym(identName)
      if !isnull(newSym) {
        expr.val = db.Value(newSym!)
      }
      return
    }
    if expr.type == db.ExprType.Dot {
      // Only the base is a variable; the member name is not renamed.
      self.renameExprIdents(expr.firstChildExpr!)
      return
    }
    isFirst = true
    for child in expr.childExprs() {
      // The first child of a named parameter is the parameter name.
      if !isFirst || expr.type != db.ExprType.Namedparam {
        self.renameExprIdents(child)
      }
      isFirst = false
    }
  }

  func appendAssignStatement(self, block: db.Block, sym: Sym, value: db.Expr,
                             location: db.Location) {
    s = db.Statement(block, db.StateType.Assign, location)
    assign = db.Expr.newBinary(db.ExprType.Equals,
                               db.Expr.newIdent(sym, location), value, location)
    s.insertExpr(assign)
  }

  // Replace each yield in |block| with an assignment of the yield value to
  // the foreach loop variable, followed by a copy of the foreach body.
  func convertYields(self, block: db.Block, loopVarExpr: db.Expr, body: db.Block) {
    for s in block.statements() {
      if s.type == db.StateType.Yield {
        yieldValue = s.expr!
        s.removeExpr(yieldValue)
        assign = db.Expr.newBinary(db.ExprType.Equals, loopVarExpr.copy(),
                                   yieldValue, s.location)
        s.insertExpr(assign)
        s.type = db.StateType.Assign
        body.copyStatementsAfterStatement(s)
      } else if !isnull(s.subBlock) {
        self.convertYields(s.subBlock!, loopVarExpr, body)
      }
    }
  }

  // Inline |iterFn| into the foreach |statement|, rewriting it in place into
  // an InlinedBlock, then typecheck the result.
  func inlineIterator(self, statement: db.Statement, iterFn: db.Function) {
    loopVarExpr = statement.expr.firstChildExpr!
    iterExpr = loopVarExpr.nextExprChildExpr!
    location = statement.location
    self.iteratorInlineCounter += 1u32
    self.renamePrefix = "_itr%u_" % self.iteratorInlineCounter
    emptyOld = arrayof(string)
    emptyNew = arrayof(Sym)
    self.renameOld = emptyOld
    self.renameNew = emptyNew
    for variable in iterFn.variables() {
      if variable.isParam {
        self.addRename(variable.sym.name)
      }
    }
    self.collectIteratorLocals(iterFn.subBlock!)

    // Gather the positional call arguments and the method-call base.
    selfExpr = null(db.Expr)
    args = arrayof(db.Expr)
    if iterExpr.type == db.ExprType.Call {
      target = iterExpr.firstChildExpr!
      if target.type == db.ExprType.Dot {
        selfExpr = target.firstChildExpr
      }
      argchild = target.nextExprChildExpr
      if !isnull(argchild) {
        if argchild.type == db.ExprType.Tuple || argchild.type == db.ExprType.List {
          for a in argchild.childExprs() {
            args.append(a)
          }
        } else {
          args.append(argchild!)
        }
      }
    } else {
      // Iterating a class instance: the instance is the iterator's self.
      selfExpr = iterExpr
    }

    // Assign arguments (or parameter defaults) to the renamed parameters.
    newBlock = db.Block(location)
    argIndex = 0u64
    for variable in iterFn.variables() {
      if variable.isParam {
        paramSym = self.renamedSym(variable.sym.name)!
        if variable.sym.name == "self" {
          if !isnull(selfExpr) {
            self.appendAssignStatement(newBlock, paramSym, selfExpr.copy(), location)
          }
        } else {
          value = null(db.Expr)
          if argIndex < args.length() {
            value = args[argIndex].copy()
          } else {
            init = variable.initializerExpr
            if !isnull(init) {
              value = init.copy()
            }
          }
          if isnull(value) {
            self.typeError("Missing argument %s in call to iterator %s" %
                           (variable.sym.name, iterFn.sym.name), location)
            return
          }
          self.appendAssignStatement(newBlock, paramSym, value!, location)
          argIndex += 1u64
        }
      }
    }

    // Copy the iterator body with renamed variables.
    for s in iterFn.subBlock.statements() {
      copied = s.appendCopy(newBlock)
      self.renameStatementIdents(copied)
    }

    // Convert yields, splicing in copies of the foreach body.
    body = statement.subBlock!
    statement.removeSubBlock(body)
    self.convertYields(newBlock, loopVarExpr, body)
    body.destroy()
    statement.insertSubBlock(newBlock)
    statement.type = db.StateType.InlinedBlock

    for s in newBlock.statements() {
      self.statement(s, newBlock)
    }

    // Record the loop variable's resolved type on the (original) loop-var
    // expression.  convertYields binds the loop variable through *copies* of
    // this expression, so the original — which the C backend uses to declare
    // the local in the enclosing scope — would otherwise stay untyped and, at
    // emission, fall back to the interned sym's clobbered binding from another
    // instantiation's same-named loop variable (e.g. a LinkedList _findPrev's
    // `prevChild`, Edge here but Node in a sibling relation's method).
    if loopVarExpr.type == db.ExprType.Ident && isnull(loopVarExpr.typedValue) {
      loopVarTy = self.getSymbolType(loopVarExpr.val.symVal!)
      if !isnull(loopVarTy) {
        loopVarExpr.typedValue = self.resolve(loopVarTy!)
      }
    }
    // Bake all the copy's expression types while this call site's
    // unification context is still live (see bakeExprTypes).
    self.bakeExprTypes(newBlock)
  }

  // Statements -------------------------------------------------------------
  // The special type bound to except-clause exception variables.  Member
  // accesses on it (e.errorMessage) are resolved in the Dot arm of expr().
  func exceptionType(self) -> Type {
    return Type(TypeName(Sym.new("Exception")))
  }

  // The binding type for a polymorphic typeswitch case pattern: type-class
  // keywords bind structurally (an Array pattern binds the scrutinee to an
  // array of a fresh element variable, so the arm body can index and measure
  // it); anything else binds as an explicit type.
  func typeswitchPatternType(self, pattern: db.Expr) -> Type? {
    if pattern.type == db.ExprType.Ident {
      patternName = pattern.val.symVal.name
      if patternName == "Array" {
        return Type(ArrayType(Type(self.newTyvar())))
      } else if patternName == "String" {
        return STRING()
      } else if patternName == "Bool" {
        return BOOL
      }
    }
    return self.tryExplicitType(pattern)
  }

  func statement(self, statement: db.Statement, parent: db.Block) {
    if isnull(statement) || isnull(parent) {
      self.typeError("internal: null statement in block", null(db.Location))
      return NONETY()
    }
    self.currentStatementGenerated = statement.generated
    switch statement.type {
      db.StateType.Assign => {
        if isnull(statement.expr) {
          self.typeError("internal: assign statement with no expression",
              statement.location)
        } else {
          self.expr(statement.expr)
        }
      }
      // Generated bodies (relation cascade code) can carry expression-less
      // statements by the time emission-driven materialization re-walks
      // them; there is nothing to type in that case.
      db.StateType.Call => {
        if !isnull(statement.expr) {
          self.expr(statement.expr)
        }
      }
      db.StateType.Print => {
        if !isnull(statement.expr) {
          self.expr(statement.expr)
        }
      }
      db.StateType.Println => {
        if !isnull(statement.expr) {
          self.expr(statement.expr)
        }
      }
      // panic prints its arguments and aborts; arguments typecheck like
      // println's.
      db.StateType.Panic => {
        if !isnull(statement.expr) {
          self.expr(statement.expr)
        }
      }
      db.StateType.Raise => {
        // The first expression is the error code path (e.g. Status.Foo),
        // not a value; the rest are message values.
        rchild = statement.expr.firstChildExpr
        rfirst = true
        while !isnull(rchild) {
          if !rfirst {
            self.expr(rchild!)
          }
          rfirst = false
          rchild = rchild.nextExprChildExpr
        }
      }
      db.StateType.If => {
        ty = self.expr(statement.expr)
        te = null(TypeError)
        if !isnull(ty) {
          te = self.unify(ty!, BOOL)
        }
        if !isnull(te) {
          self.typeError("Condition expression must be a boolean", statement.expr.location)
        }
        assert !isnull(statement.subBlock)
        for s in statement.subBlock.statements() {
          self.statement(s, statement.subBlock)
        }
        parent.returnType = statement.subBlock.returnType
      }
      db.StateType.Else => {
        assert !isnull(statement.subBlock)
        for s in statement.subBlock.statements() {
          self.statement(s, statement.subBlock)
        }
        parent.returnType = statement.subBlock.returnType
      }
      db.StateType.ElseIf => {
        assert !isnull(statement.expr)
        ty = self.expr(statement.expr)
        te = null(TypeError)
        if !isnull(ty) {
          te = self.unify(ty!, BOOL)
        }
        if !isnull(te) {
          self.typeError("Condition expression must be a boolean", statement.expr.location)
        }
        assert !isnull(statement.subBlock)
        for s in statement.subBlock.statements() {
          self.statement(s, statement.subBlock)
        }
        parent.returnType = statement.subBlock.returnType
      }
      db.StateType.For => {
        // Right now, only handles for expressions of the form
        // for <assignment>, <condition>, <increment> {
        //  ...
        // }
        i = 0
        for child in statement.expr.childExprs() {
           ty = self.expr(child)
           if i == 1 && !isnull(ty) {
             te = self.unify(ty!, BOOL)
             if !isnull(te) {
               self.typeError("Condition expression must be a boolean", child.location)
             }
           }
           i += 1
        }
        assert !isnull(statement.subBlock)
        for s in statement.subBlock.statements() {
          self.statement(s, statement.subBlock)
        }
      }
      db.StateType.Return => {
        if isnull(statement.expr) {
          // A bare return: the function returns none.
          parent.returnType = NONETY()
        } else {
          ty = self.expr(statement.expr)
          parent.returnType = ty
        }
      }
      db.StateType.Try => {
        assert !isnull(statement.subBlock)
        for s in statement.subBlock.statements() {
          self.statement(s, statement.subBlock)
        }
        parent.returnType = statement.subBlock.returnType
      }
      db.StateType.Except => {
        // Bind the exception variable (the IDENT after `except`) to the
        // special Exception typename; field accesses on it are resolved in
        // the Dot arm.  The sub-block holds Case statements whose patterns
        // are raise code paths (e.g. Status.Foo); those are matched as text
        // at codegen time and are not typechecked as values.
        identExpr = statement.expr!
        excTy = self.exceptionType()
        self.newSymbol(identExpr.val.symVal!, excTy)
        identExpr.typedValue = excTy
        for caseStatement in statement.subBlock.statements() {
          assert !isnull(caseStatement.subBlock)
          for s in caseStatement.subBlock.statements() {
            self.statement(s, caseStatement.subBlock)
          }
          if !isnull(caseStatement.subBlock.returnType) {
            parent.returnType = caseStatement.subBlock.returnType
          }
        }
      }
      db.StateType.While => {
        ty = self.expr(statement.expr)
        te = null(TypeError)
        if !isnull(ty) {
          te = self.unify(ty!, BOOL)
        }
        if !isnull(te) {
          self.typeError("Condition expression must be a boolean", statement.expr.location)
        }
        // The sub-block is null when this terminates a do-while statement.
        if !isnull(statement.subBlock) {
          for s in statement.subBlock.statements() {
            self.statement(s, statement.subBlock)
          }
          parent.returnType = statement.subBlock.returnType
        }
      }
      db.StateType.Do => {
        assert !isnull(statement.subBlock)
        for s in statement.subBlock.statements() {
          self.statement(s, statement.subBlock)
        }
        parent.returnType = statement.subBlock.returnType
      }
      db.StateType.Typeswitch => {
        scrutTy = self.expr(statement.expr)
        assert !isnull(statement.subBlock)
        if !isnull(scrutTy) {
          rty = self.resolve(scrutTy!)
          // A scrutinee that is not fully concrete selects its arm per
          // instantiation at codegen, never once during generalization.
          // This covers a bare type variable and, just as importantly, a
          // composite still holding free variables (e.g. a tuple of
          // polymorphic parameters): caching one arm there would emit the
          // same arm for every instantiation.
          scrutFreeVars = arrayof(Type)
          scrutFreeVars = self.collectFreeTyvars(rty, scrutFreeVars)
          scrutHasFreeVars = scrutFreeVars.length() != 0
          // A typeswitch whose case patterns are value expressions (e.g.
          // enum members) is really a value switch.
          isValueSwitch = false
          for caseStatement in statement.subBlock.statements() {
            if caseStatement.type == db.StateType.Case {
              firstPattern = caseStatement.expr.firstChildExpr
              if !isnull(firstPattern) {
                if (firstPattern.type == db.ExprType.Dot ||
                    firstPattern.type == db.ExprType.Constant) {
                  isValueSwitch = true
                }
              }
            }
          }
          if isValueSwitch {
            statement.type = db.StateType.Switch
            self.statement(statement, parent)
          } else if rty.type == Type.TypeClass.Var || scrutHasFreeVars {
            // Polymorphic scrutinee: typecheck every arm with the scrutinee
            // variable temporarily bound to that arm's pattern type.  The
            // case itself is selected at codegen time, per instantiation.
            // When the scrutinee is a composite holding free variables
            // (e.g. a tuple of polymorphic params) there is no single
            // scrutinee variable to bind, so the arms typecheck unbound;
            // selection still defers to codegen, which is the whole point.
            scrutIsVar = rty.type == Type.TypeClass.Var
            for caseStatement in statement.subBlock.statements() {
              // The scrutinee variable must come out of each arm exactly
              // as it went in: an arm body can bind it even when the
              // pattern provided no binding (t null), and a leaked binding
              // poisons every later arm (duplicate unifier mappings).
              armWasUnbound = false
              bound = false
              if scrutIsVar {
                armWasUnbound = isnull(self.unifier.lookupVar(rty.tyvar.id))
                if caseStatement.type == db.StateType.Case {
                  if !isnull(caseStatement.expr) {
                    firstPattern = caseStatement.expr.firstChildExpr
                    if isnull(firstPattern) {
                      // A single unwrapped pattern is the case expression.
                      firstPattern = caseStatement.expr
                    }
                    t = self.typeswitchPatternType(firstPattern!)
                    if !isnull(t) {
                      // A pattern that resolves to the scrutinee's own
                      // variable carries no information; binding it would
                      // create a self-loop in the unifier chain.
                      selfBind = false
                      if t.type == Type.TypeClass.Var {
                        if self.unifier.representative(t.tyvar!).id == rty.tyvar.id {
                          selfBind = true
                        }
                      }
                      if !selfBind {
                        self.unifier.bindVar(rty.tyvar!, t!)
                        bound = true
                      }
                    }
                  }
                }
              }
              // An arm that fails to typecheck under its binding is only an
              // error if codegen selects it (matching the legacy compiler,
              // which typechecks just the selected arm per instantiation,
              // e.g. hashed.rn's intentional error arm).  Roll its errors
              // back and poison the arm.
              preArmErrors = self.countTypeErrors()
              for s in caseStatement.subBlock.statements() {
                self.statement(s, caseStatement.subBlock)
              }
              if self.countTypeErrors() > preArmErrors {
                while self.countTypeErrors() > preArmErrors {
                  self.popTypeError()
                }
                caseStatement.typecheckPoisoned = true
              }
              if !isnull(caseStatement.subBlock.returnType) {
                parent.returnType = caseStatement.subBlock.returnType
              }
              if armWasUnbound {
                while !isnull(self.unifier.lookupVar(rty.tyvar.id)) {
                  self.unifier.unbindVar(rty.tyvar!)
                }
              }
            }
          } else {
            self.selectTypeswitchCase(statement, true)
            tsIndex = 0u32
            for caseStatement in statement.subBlock.statements() {
              if (tsIndex == statement.selectedCaseIndex &&
                  !isnull(caseStatement.subBlock.returnType)) {
                parent.returnType = caseStatement.subBlock.returnType
              }
              tsIndex += 1u32
            }
          }
        }
      }
      db.StateType.Switch => {
        // The sub-block holds Case statements (expr = list of match values)
        // and an optional Default statement.  Every match value must unify
        // with the type of the switch expression.
        scrutTy = self.expr(statement.expr)
        assert !isnull(statement.subBlock)
        for caseStatement in statement.subBlock.statements() {
          if caseStatement.type == db.StateType.Case {
            for valExpr in caseStatement.expr.childExprs() {
              vty = self.expr(valExpr)
              te = self.unify(vty!, scrutTy!)
              if !isnull(te) {
                self.typeError("Case value must match the switch expression type",
                               valExpr.location)
              }
            }
          }
          assert !isnull(caseStatement.subBlock)
          for s in caseStatement.subBlock.statements() {
            self.statement(s, caseStatement.subBlock)
          }
          if !isnull(caseStatement.subBlock.returnType) {
            parent.returnType = caseStatement.subBlock.returnType
          }
        }
      }
      db.StateType.Assert => {
        // The expression is a list; the first element is the condition and
        // any further elements are message values to print on failure.
        first = true
        for child in statement.expr.childExprs() {
          ty = self.expr(child)
          if first && !isnull(ty) {
            te = self.unify(ty!, BOOL)
            if !isnull(te) {
              self.typeError("Assert condition must be a boolean", child.location)
            }
          }
          first = false
        }
      }
      db.StateType.Foreach => {
        // The expression is a list: (loop variable, iterable expression).
        // Supported iterables: range(n), range(a, b), arrays, and the
        // array methods values() and items().
        loopVarExpr = statement.expr.firstChildExpr!
        iterExpr = loopVarExpr.nextExprChildExpr!
        // A call to a user-defined iterator (or a class instance, which
        // iterates via its values() iterator) is inlined in place.
        iterFn = self.findForeachIterator(iterExpr)
        if !isnull(iterFn) {
          self.inlineIterator(statement, iterFn!)
          return NONETY()
        }
        elemTy = null(Type)
        if iterExpr.type == db.ExprType.Call {
          target = iterExpr.firstChildExpr!
          argExpr = target.nextExprChildExpr
          if target.type == db.ExprType.Ident && target.val.symVal.name == "range" {
            argTy = self.expr(argExpr!)
            if isnull(argTy) {
              // A type error in the bound expression was already reported.
              elemTy = Type(self.newTyvar())
            } else {
              rty = self.resolve(argTy!)
              if rty.type == Type.TypeClass.Tuple {
                // range(start, end): the bounds must have the same type.
                firstBound = rty.tuple.elements[0]
                for el in rty.tuple.elements {
                  te = self.unify(firstBound, el)
                  if !isnull(te) {
                    self.typeError("range bounds must have the same type", iterExpr.location)
                  }
                }
                elemTy = firstBound
              } else {
                elemTy = rty
              }
            }
            iterExpr.typedValue = elemTy
          } else if target.type == db.ExprType.Dot {
            base = target.firstChildExpr!
            methodName = base.nextExprChildExpr.toString()
            if methodName == "values" || methodName == "items" {
              baseTy = self.expr(base)
              baseElemTy = null(Type)
              if !isnull(baseTy) {
                rbase = self.resolve(baseTy!)
                if rbase.type == Type.TypeClass.Array {
                  baseElemTy = rbase.array.elementType
                } else if self.isStringType(rbase) {
                  // Iterating a string yields bytes.
                  baseElemTy = U(8)
                }
              }
              if !isnull(baseElemTy) {
                if methodName == "values" {
                  elemTy = baseElemTy
                } else {
                  pairTypes = arrayof(Type)
                  pairTypes.append(U(64))
                  pairTypes.append(baseElemTy!)
                  elemTy = TUPLE(pairTypes)
                }
                iterExpr.typedValue = elemTy
              }
            }
          }
        }
        if isnull(elemTy) {
          ty = self.expr(iterExpr)
          if isnull(ty) {
            // A type error in the iterable was already reported.
            elemTy = Type(self.newTyvar())
          } else {
            rty = self.resolve(ty!)
            if rty.type == Type.TypeClass.Array {
              elemTy = rty.array.elementType
            } else if self.isStringType(rty) {
              elemTy = U(8)
            } else {
              if rty.type == Type.TypeClass.Var {
                // An unconstrained parameter: iterability is decided per
                // instantiation, like member access on a variable.
                self.sawStructuralGenericError = true
                self.recordVarBlocker(rty)
              }
              self.typeError("Cannot iterate over %s" % rty.toString(), iterExpr.location)
              elemTy = Type(self.newTyvar())
            }
          }
        }
        self.newSymbol(loopVarExpr.val.symVal!, elemTy)
        loopVarExpr.typedValue = elemTy
        if !isnull(statement.subBlock) {
          for s in statement.subBlock.statements() {
            self.statement(s, statement.subBlock)
          }
        }
      }
      db.StateType.InlinedBlock => {
        // Statements spliced in by iterator inlining; typecheck like a block.
        for s in statement.subBlock.statements() {
          self.statement(s, statement.subBlock!)
        }
      }
      // Module loading happens before typechecking; the statements
      // themselves contribute no types.
      db.StateType.Import => return NONETY()
      db.StateType.ImportLib => return NONETY()
      db.StateType.ImportRpc => return NONETY()
      db.StateType.Use => return NONETY()

      // Relations and code blocks execute in the module pre-pass; ref and
      // unref manage transformer reference counts (not implemented).
      db.StateType.Transform => return NONETY()
      db.StateType.Relation => return NONETY()
      db.StateType.Appendcode => return NONETY()
      db.StateType.Prependcode => return NONETY()
      db.StateType.Ref => return NONETY()
      db.StateType.Unref => return NONETY()

      default => raise Status.Unimplemented, "Statement type not yet supported by typechecker: ", db.statementTypeGetKeyword(statement.type)
    }
    return NONETY()
  }

  // Find a class constructor by name anywhere in the loaded program.
  func findClassFunction(self, name: string) -> db.Function? {
    return self.findClassFunctionIn(db.getMainFunc(), name)
  }

  func findClassFunctionIn(self, fn: db.Function, name: string) -> db.Function? {
    for childfunc in fn.childFunctions() {
      if childfunc.type == db.FuncType.Constructor && childfunc.sym.name == name {
        return childfunc
      }
      found = self.findClassFunctionIn(childfunc, name)
      if !isnull(found) {
        return found
      }
    }
    return null(db.Function)
  }


  // Typecheck Functions, including modules ---------------------------------
  func function(self, fn: db.Function) {
    switch fn.type {
      db.FuncType.Module => {
        // Desugaring -- transformer/relation expansion, nested-class and
        // nested-function hoisting, and generated destructors -- ran in a
        // separate pass before typecheck (see types/desugar.rn).  The
        // Relation/Transform/Appendcode/Prependcode statements remain in the
        // AST as inert no-ops; the operator-signature pre-registration below
        // still scans the relation statements.
        //
        // Typecheck imported child modules first: they are appended after
        // this module's own children, but their definitions must bind before
        // the importer's code references them.
        for childfunc in fn.childFunctions() {
          if childfunc.type == db.FuncType.Module {
            self.function(childfunc)
          }
        }
        // Register all functions first so call sites can look up parameter
        // names and defaults regardless of definition order.  Module
        // children stay out of the registry: their names may collide with
        // the functions they export (e.g. use sqrt providing func sqrt).
        for childfunc in fn.childFunctions() {
          if childfunc.type != db.FuncType.Module {
            self.registerFunctionDef(childfunc)
          }
        }
        // Pre-bind module globals whose initializers are self-contained
        // literals, so functions referencing them forward see their types
        // (module statements themselves typecheck after all functions).
        for statement in fn.subBlock.statements() {
          if statement.type == db.StateType.Assign && !isnull(statement.expr) {
            preAssign = statement.expr!
            if preAssign.type == db.ExprType.Equals {
              preLhs = preAssign.firstChildExpr!
              preRhs = preLhs.nextExprChildExpr!
              if (preLhs.type == db.ExprType.Ident &&
                  (preRhs.type == db.ExprType.Array ||
                   preRhs.type == db.ExprType.Constant)) {
                preErrors = self.countTypeErrors()
                prty = self.expr(preRhs)
                while self.countTypeErrors() > preErrors {
                  self.popTypeError()
                }
                if !isnull(prty) {
                  self.newSymbolGlobal(preLhs.val.symVal!, prty!)
                }
              }
            }
          }
        }
        // Register operator overload SIGNATURES before any typechecking:
        // generated code (e.g. a heap's _compare) may apply an operator a
        // class defines, while that class's own constructor depends on the
        // generated code.  Bare type names avoid demand-typechecking; the
        // Operator arm replaces the entry with the real type later.  Only
        // classes named in relation statements need this (and ordinary
        // overloads dispatch better through their real generalized types).
        relationClassNames = arrayof(string)
        for statement in fn.subBlock.statements() {
          if (statement.type == db.StateType.Relation ||
              statement.type == db.StateType.Transform) {
            if !isnull(statement.expr) {
              self.collectIdentNames(statement.expr!, relationClassNames)
            }
          }
        }
        for childfunc in fn.childFunctions() {
          inRelation = false
          for rcn in relationClassNames {
            if rcn == childfunc.sym.name {
              inRelation = true
            }
          }
          if childfunc.type == db.FuncType.Constructor && inRelation {
            for opfn in childfunc.childFunctions() {
              if opfn.type == db.FuncType.Operator {
                opParams = arrayof(Type)
                for opv in opfn.variables() {
                  if opv.isParam {
                    opTy = null(Type)
                    if !isnull(opv.typeExpr) {
                      opTy = self.tryExplicitType(opv.typeExpr!)
                    }
                    if isnull(opTy) {
                      opTy = Type(self.newTyvar())
                    }
                    opParams.append(opTy!)
                  }
                }
                self.operatorFns.append(opfn)
                self.operatorTypes.append(FN(TUPLE(opParams), Type(self.newTyvar())))
                self.registerUserOpClasses(opfn)
              }
            }
          }
        }
        for childfunc in fn.childFunctions() {
          if childfunc.type != db.FuncType.Module {
            self.function(childfunc)
          }
        }
        // Generated destroy() methods have no user call sites, so nothing
        // demands them; typecheck them eagerly or cleanup emission walks
        // untyped bodies.
        for childfunc in fn.childFunctions() {
          if childfunc.type == db.FuncType.Constructor {
            dInfo = self.lookupClass(childfunc.sym)
            if !isnull(dInfo) {
              for dchild in childfunc.childFunctions() {
                if dchild.sym.name == "destroy" && dchild.type == db.FuncType.Plain {
                  if isnull(dchild.typedValue) {
                    self.demandMethod(dInfo!, dchild)
                  }
                  if dchild.deferredTypecheck && !dchild.deferredRetypechecked {
                    // No call site records an instantiation for a deferred
                    // destroy; synthesize one from the class instance type
                    // and retypecheck now, or emission walks a cleared body.
                    ddty = dchild.typedValue!
                    if ddty.type == Type.TypeClass.Polymorphic {
                      if isnull(ddty.poly.instantiations.firstTyvarInstantiation) {
                        dErrs = self.countTypeErrors()
                        dopened = ddty.poly.open(self.unifier, &self.unifier.newVar())
                        dSelfSlot = dopened.function.params
                        if dSelfSlot.type == Type.TypeClass.Tuple {
                          if dSelfSlot.tuple.elements.length() > 0 {
                            dSelfSlot = dSelfSlot.tuple.elements[0]
                          }
                        }
                        self.unify(dSelfSlot!, dInfo.selfType!)
                        dSynthInst = ddty.poly.instantiations.lastTyvarInstantiation
                        if !isnull(dSynthInst) {
                          self.instantiate(ddty.poly!, dSynthInst!)
                          self.retypecheckDeferred(dchild)
                          dchild.deferredRetypechecked = true
                          self.deInstantiate(ddty.poly!)
                        }
                        while self.countTypeErrors() > dErrs {
                          self.popTypeError()
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
        for statement in fn.subBlock.statements() {
          self.statement(statement, fn.subBlock)
        }
      }

      db.FuncType.Plain => self.plainFunction(fn)
      db.FuncType.Operator => {
        // Overloaded operators typecheck like plain functions, plus an
        // entry in the operator registry consulted at operator expressions.
        // A signature pre-registered in the module pre-pass is replaced
        // with the real generalized type.
        prevSuppressed = self.suppressedOperatorFn
        self.suppressedOperatorFn = fn
        self.plainFunction(fn)
        self.suppressedOperatorFn = prevSuppressed
        opIdx = -1i64
        for opi in range(self.operatorFns.length()) {
          if self.operatorFns[opi] == fn {
            opIdx = <i64>opi
          }
        }
        if opIdx >= 0i64 {
          self.operatorTypes[<u64>opIdx] = fn.typedValue!
        } else {
          self.operatorFns.append(fn)
          self.operatorTypes.append(fn.typedValue!)
        }
        self.registerUserOpClasses(fn)
      }
      db.FuncType.Struct => self.structFunction(fn)
      db.FuncType.Constructor => self.constructorFunction(fn)
      db.FuncType.Enum => self.enumFunction(fn)
      // Iterators are not typechecked standalone; their bodies are inlined
      // into each foreach statement that calls them and typechecked there.
      db.FuncType.Iterator => return
      // Transformers are compile-time code generators, expanded by the
      // desugar pass (types/desugar.rn) before typecheck; nothing to do here.
      db.FuncType.Transformer => return
      // Destructors are typechecked like methods.  The C backend does not
      // yet emit or call them (that needs reference counting).
      db.FuncType.Final => self.plainFunction(fn)
      default => {
        raise Status.Unimplemented, "Function type not yet supported by typechecker: ", fn.type
      }
    }
  }

  // Typecheck a class constructor.  The class's data members are discovered
  // from assignments of the form self.<field> = <expr> in the constructor
  // body.  Methods are the constructor's child functions; their self
  // parameter is bound to the class instance type.
  func constructorFunction(self, fn: db.Function) {
    if !isnull(fn.typedValue) {
      // Already typechecked on demand from an earlier reference.
      return
    }
    self.openScope()
    info = ClassInfo(fn.sym)
    info.fn = fn
    // Note: empty arrays must be bound to locals first; passing arrayof(T)
    // directly as a constructor argument crashes the C-based rune compiler.
    emptyFieldnames = arrayof(Sym)
    emptyFieldtypes = arrayof(Type)
    info.strct = StructType(emptyFieldnames, emptyFieldtypes)
    self.insertClassInfo(info)
    info.constructing = true
    // A class declaring ANY operator child dispatches builtin-operator
    // expressions to it; exempt the class from builtin adaptable
    // constraints BEFORE any body (relation templates included)
    // typechecks against its instances.
    for cfOp in fn.childFunctions() {
      if cfOp.type == db.FuncType.Operator {
        cfSeen = false
        for cfC in self.unifier.userOpClasses {
          if cfC == fn.sym.name {
            cfSeen = true
          }
        }
        if !cfSeen {
          self.unifier.userOpClasses.append(fn.sym.name)
        }
      }
    }

    // Record the final non-self parameter count BEFORE filling paramVars, so a
    // re-entrant null(ThisClass) (a cascade peer's constructor referencing this
    // class while this param loop is suspended on a peer demand) reads the
    // right arity instead of a half-filled paramVars.  fn.variables() holds
    // only parameters at this point (locals are added when the body runs).
    arityCount = 0i64
    for variable in fn.variables() {
      if variable.sym.name != "self" {
        arityCount += 1i64
      }
    }
    info.expectedParamArity = arityCount
    params = arrayof(Type)
    for variable in fn.variables() {
      if variable.sym.name != "self" {
        ty = self.variable(variable)!
        params.append(ty)
        info.paramVars.append(ty)
      }
    }
    if params.length() == 1 {
      paramType = params[0]
    } else {
      paramType = Type(TupleType(params))
    }

    // The class instance type, e.g. Point(v1, v2).
    selfType = Type(TypeName(fn.sym, TupleType(info.paramVars)))
    info.selfType = selfType
    self.newTyname(fn.sym, Type(info.strct!))
    self.newSymbol(Sym.new("self"), selfType)

    prevClassInfo = self.currentClassInfo
    prevSelfType = self.currentSelfType
    prevClassBoundVars = self.classBoundVars
    self.currentClassInfo = info
    self.currentSelfType = selfType
    self.classBoundVars = info.paramVars

    // Typecheck the constructor body; this discovers the data members.
    preCtorErrors = self.countTypeErrors()
    prevCtorStructural = self.sawStructuralGenericError
    self.sawStructuralGenericError = false
    preCtorFields = info.strct.fieldnames.length()
    for statement in fn.subBlock.statements() {
      self.statement(statement, fn.subBlock)
    }
    // A constructor body that errors structurally on unconstrained
    // parameters (self.rows = m.length()) typechecks again under a
    // concrete instantiation before emission; the fields it created in
    // the failed pass are dropped and re-created concretely then.
    if self.countTypeErrors() > preCtorErrors && self.sawStructuralGenericError {
      ctorHasGenericParam = false
      for pv in info.paramVars {
        rpv2 = self.resolve(pv)
        if rpv2.type == Type.TypeClass.Var {
          ctorHasGenericParam = true
        }
      }
      if ctorHasGenericParam {
        while self.countTypeErrors() > preCtorErrors {
          self.popTypeError()
        }
        info.strct.fieldnames.resize(preCtorFields)
        info.strct.fieldtypes.resize(preCtorFields)
        if !isnull(fn.subBlock) {
          self.clearExprTypes(fn.subBlock!)
        }
        fn.deferredTypecheck = true
      }
    }
    self.sawStructuralGenericError = prevCtorStructural

    self.currentClassInfo = prevClassInfo
    self.currentSelfType = prevSelfType
    self.classBoundVars = prevClassBoundVars

    bindingScope = self.closeScope()
    paramType = self.resolve(paramType)
    boundVars = arrayof(Type)
    for sm in bindingScope.symbolMappings() {
      if !isnull(sm.value) && sm.value.type == Type.TypeClass.Var {
        ty = self.resolve(sm.value!)
        if ty.type == Type.TypeClass.Var {
          exists = false
          for bv in boundVars {
            if bv.tyvar.id == ty.tyvar.id {
              exists = true
            }
          }
          if !exists {
            boundVars.append(Type(ty.tyvar!))
          }
        }
      }
    }

    resType = self.resolve(selfType)
    fnType = Type(FunctionType(paramType, resType))
    if boundVars.length() > 0 {
      fnType = Type(PolymorphicType(boundVars, fnType))
    }
    self.newSymbolGlobal(fn.sym, fnType)
    fn.typedValue = fnType
    // The parameters' interned symbols still point at the variables that
    // were just generalized into boundVars (same hazard as functionType's
    // epilogue): a later same-named module-level variable (dicttest's
    // `value` vs Entry's <value> parameter) would reuse the generalized
    // variable through symbol()'s forward-reference path and bind it,
    // permanently monomorphizing this constructor's template slot.
    if boundVars.length() > 0 {
      for ctorClearParam in fn.variables() {
        if !isnull(ctorClearParam.sym.typedValue) {
          if self.resolve(ctorClearParam.sym.typedValue!).type == Type.TypeClass.Var {
            ctorClearParam.sym.typedValue = null(Type)
          }
        }
      }
    }

    // Record which constructor parameters are "phantom": a plain parameter
    // whose type stays a bare type variable appearing in no field type (so it
    // does not affect the struct, e.g. MyString(self, value) whose body always
    // stores `self.value: string`).  Instances differing only in such a
    // position must unify even though their constructors monomorphize per
    // argument type.  Excluded:
    //  - template parameters (`<key>`): they parameterize the class through
    //    relations/methods even when no field names them (maptest's
    //    `Symtab(self, <key>)`), so collapsing them loses the specialization.
    //  - parameters with a concrete or constrained type (value.rn's
    //    `value: string | bool | i64` resolves to a constrained variable, not a
    //    bare one) — though such a class collapses harmlessly when its struct
    //    really is argument-type-independent.
    // The mask aligns with info.paramVars: both walk the non-self parameters in
    // order.
    fieldVars = arrayof(Type)
    for ft in info.strct.fieldtypes {
      fieldVars = self.collectFreeTyvars(ft, fieldVars)
    }
    phantomMask = arrayof(bool)
    anyPhantom = false
    for variable in fn.variables() {
      if variable.sym.name != "self" {
        isPhantom = false
        // Require an UNANNOTATED parameter (no type expression).  A constrained
        // parameter (`value: Int | Uint`) resolves to a constrained variable
        // that the field check cannot reliably exclude once the field type bakes
        // concrete (integer.rn's Integer stores `self.value = value` yet its
        // field var resolves away), so it would falsely read as phantom.  An
        // unannotated parameter that genuinely reaches a field keeps its var in
        // that field type, so the field check excludes it correctly.
        if (!variable.inTemplateSig && isnull(variable.typeExpr) &&
            !isnull(variable.typedValue)) {
          rpv = self.resolve(variable.typedValue!)
          if rpv.type == Type.TypeClass.Var {
            isPhantom = true
            for fv in fieldVars {
              if fv.tyvar.id == rpv.tyvar.id {
                isPhantom = false
              }
            }
          }
        }
        if isPhantom {
          anyPhantom = true
        }
        phantomMask.append(isPhantom)
      }
    }
    if anyPhantom {
      self.unifier.registerPhantomMask(fn.sym, phantomMask)
    }

    // Typecheck the methods after the fields and the constructor type are
    // recorded: method bodies may reference other classes (triggering
    // on-demand typechecks), and those may call back into this class's
    // methods, which find complete fields this way.
    methodPrevClassInfo = self.currentClassInfo
    methodPrevSelfType = self.currentSelfType
    methodPrevClassBoundVars = self.classBoundVars
    self.currentClassInfo = info
    self.currentSelfType = selfType
    self.classBoundVars = info.paramVars
    for childfunc in fn.childFunctions() {
      isGeneratedMethod = false
      if !isnull(childfunc.subBlock) && !isnull(childfunc.subBlock.firstStatement) {
        isGeneratedMethod = childfunc.subBlock.firstStatement.generated
      }
      preMethodErrors = self.countTypeErrors()
      self.function(childfunc)
      if isGeneratedMethod && self.countTypeErrors() > preMethodErrors {
        // A relation-generated method that fails to typecheck is only an
        // error if something calls it (the legacy compiler never checks
        // uncalled methods); a call demand-retries and surfaces it then.
        while self.countTypeErrors() > preMethodErrors {
          self.popTypeError()
        }
        childfunc.typedValue = null(Type)
        // Clear the partially-assigned expression types so a retry (or a
        // mistaken emission) never sees half-typed state.
        if !isnull(childfunc.subBlock) {
          self.clearExprTypes(childfunc.subBlock!)
        }
      }
    }
    self.currentClassInfo = methodPrevClassInfo
    self.currentSelfType = methodPrevSelfType
    self.classBoundVars = methodPrevClassBoundVars
    info.constructing = false
  }

  // Typecheck an enum declaration: record the members and their values, and
  // bind the enum's name so that Color.red style accesses resolve.
  func enumFunction(self, fn: db.Function) {
    info = EnumInfo(fn.sym)
    nextValue = 0u32
    for variable in fn.variables() {
      value = nextValue
      init = variable.initializerExpr
      if !isnull(init) && init.type == db.ExprType.Constant {
        value = <u32>init.val.intVal.uint64()
        if !init.autocast {
          info.valueWidth = init.val.intVal.width
        }
      }
      info.memberNames.append(variable.sym)
      info.memberValues.append(value)
      nextValue = value + 1u32
    }
    self.insertEnumInfo(info)
    self.newSymbolGlobal(fn.sym, Type(TypeName(fn.sym)))
  }

  // Typecheck a member access on a class instance: either a data member or
  // a method.  Inside the class's own constructor, unknown members are
  // created as new data members.
  func classMemberType(self, info: ClassInfo, instanceType: Type, field: db.Expr,
                       selfAccess: bool, location: db.Location?) -> Type? {
    name = field.toString()
    method = self.findMethod(info, name)
    if !isnull(method) {
      mcRes = self.methodCallType(info, instanceType, method!, location)
      // Record the callee and the instantiation its open just appended
      // for the enclosing call's demand materialization (only when the
      // method type is polymorphic: then methodCallType surely opened).
      if self.calleeStack.length() > 0 {
        fieldDot = field.parentExpr
        if !isnull(fieldDot) {
          if fieldDot.type == db.ExprType.Dot {
            mcTy = method.typedValue
            if !isnull(mcTy) {
              if mcTy.type == Type.TypeClass.Polymorphic {
                calleeRec = self.calleeStack[self.calleeStack.length() - 1]
                calleeRec.fn = method
                calleeRec.viaExpr = fieldDot
                calleeRec.inst = mcTy.poly.instantiations.lastTyvarInstantiation
              }
            }
          }
        }
      }
      return mcRes
    }
    inOwnConstructor = !isnull(self.currentClassInfo) && self.currentClassInfo.sym == info.sym
    ty = info.strct.select(name)
    if !isnull(ty) {
      // Only `self.<field>` returns the class's canonical field variable, so
      // that assignments through self constrain the real field type.  A field
      // read through any OTHER instance — including a different instance of
      // this same class inside one of its own methods (e.g. an operator's
      // element1/element2 parameters) — must project onto that instance's
      // type arguments via substituteClassVars.  Returning the canonical var
      // there lets a field-vs-field comparison knot the class's field types
      // to whatever the operands unify with (the template-class knot).
      if inOwnConstructor && selfAccess {
        // The canonical slot: writes through self constrain the real
        // field type (the template pass and constructor rounds).  A
        // METHOD's materialization round must NOT read it — it holds at
        // most one signature's bake; fall through to the per-spec
        // snapshot / projection instead.
        if self.retypecheckNesting == 0u32 || self.roundIsCtor {
          return ty
        }
      }
      // A concrete instance whose constructor has materialized prefers
      // its specialization's field snapshot: the canonical slot holds at
      // most ONE signature's bake.
      rMemberInst = self.resolve(instanceType)
      if rMemberInst.type == Type.TypeClass.Typename {
        if !self.hasFreeVars(rMemberInst) && !isnull(rMemberInst.tyname.params) {
          memberSpec = rMemberInst.toString()
          for mfb in info.fieldBakes() {
            if mfb.spec == memberSpec {
              mfi = 0
              for mfname in info.strct.fieldnames {
                if mfname.name == name && mfi < mfb.types.length() {
  return mfb.types[mfi]
                }
                mfi += 1
              }
            }
          }
        }
      }
      return self.substituteClassVars(info, instanceType, ty!)
    }
    // Assignment to an unknown member creates it: always inside the
    // class's own constructor, and from anywhere when the member access
    // is the target of an assignment (foo.value = 123 adds a field).
    isAssignTarget = false
    fieldParent = field.parentExpr
    if (!isnull(fieldParent) && fieldParent.type == db.ExprType.Dot &&
        !isnull(fieldParent.parentExpr) &&
        fieldParent.parentExpr.type == db.ExprType.Equals &&
        fieldParent.parentExpr.firstChildExpr == fieldParent) {
      isAssignTarget = true
    }
    if name == "toString" {
      // Every class gets an auto-generated toString (the field formatter
      // the print helper uses), callable as a method.
      noToStringArgs = arrayof(Type)
      return FN(TUPLE(noToStringArgs), STRING())
    }
    // instance.B(...): a (hoisted) nested class constructed through an
    // instance of its outer class; the member is the constructor.
    nestedClassFn = self.findClassFunction(name)
    if !isnull(nestedClassFn) {
      self.demandClass(nestedClassFn.sym)
      ncty = nestedClassFn.typedValue
      if !isnull(ncty) {
        ncOpen = ncty!
        if ncOpen.type == Type.TypeClass.Polymorphic {
          ncOpen = ncOpen.poly!.open(self.unifier, &self.unifier.newVar())
        }
        return ncOpen
      }
    }
    // A deferred constructor has not discovered its fields yet: member
    // misses (and assignment-creations, which would duplicate the real
    // field) defer the accessing body instead.
    ctorDeferredPending = false
    if !inOwnConstructor && !isnull(info.fn) {
      if info.fn.deferredTypecheck && !info.fn.deferredRetypechecked {
        ctorDeferredPending = true
      }
    }
    if ctorDeferredPending {
      self.sawStructuralGenericError = true
      self.recordSignatureBlocker(info.fn, info.sym.name)
      self.typeError("Class %s has no member %s" % (info.sym.name, name), location)
      return null(Type)
    }
    if inOwnConstructor || isAssignTarget {
      // First assignment to self.<name> creates the data member.
      fresh = Type(self.newTyvar())
      info.strct.fieldnames.append(Sym.new(name))
      info.strct.fieldtypes.append(fresh)
      if self.currentStatementGenerated {
        info.generatedFieldNames.append(name)
      }
      return fresh
    }
    self.typeError("Class %s has no member %s" % (info.sym.name, name), location)
    return null(Type)
  }

  // Find a method (child function) of a class by name.
  func findMethod(self, info: ClassInfo, name: string) -> db.Function? {
    for childfunc in info.fn.childFunctions() {
      if childfunc.sym.name == name && (childfunc.type == db.FuncType.Plain ||
          childfunc.type == db.FuncType.Final) {
        return childfunc
      }
    }
    return null(db.Function)
  }

  // Compute the type of a method accessed through an instance: the method's
  // function type with the self parameter removed (it is passed implicitly).
  func methodCallType(self, info: ClassInfo, instanceType: Type, method: db.Function,
                      location: db.Location?) -> Type? {
    // Only the function's own typedValue is trustworthy: syms are interned
    // by name, so method.sym.typedValue may be a stale local (e.g. a local
    // named hash next to a hash() method).
    mty = method.typedValue
    if isnull(mty) && method.sym.name == "destroy" && info.constructing {
      // A cascade destroy cross-called while its own class is still under
      // construction (mutual recursion: destroy_Foo <-> destroy_Bar, each
      // demanded from inside the other's class body).  Walking it now would
      // typecheck against half-recorded fields and cache a broken body that
      // nothing revisits.  Leave it untyped and resolve this cross-call
      // against a provisional `self -> none` arrow; the eager-destroy pass
      // walks the real body once every class is fully built.
      if !isnull(info.selfType) {
        self.unify(info.selfType!, instanceType)
      }
      provArgs = arrayof(Type)
      return FN(TUPLE(provArgs), NONETY())
    }
    if isnull(mty) {
      // The method has not typechecked yet (e.g. a reference from another
      // class checked on demand): typecheck it now in its class's context.
      self.demandMethod(info, method)
      mty = method.typedValue
    }
    if isnull(mty) {
      self.typeError("Method %s of class %s has no type" % (method.sym.name, info.sym.name),
                     location)
      return null(Type)
    }
    ty = mty!
    if ty.type == Type.TypeClass.Polymorphic {
      ty = ty.poly!.open(self.unifier, &self.unifier.newVar())
    }
    if ty.type != Type.TypeClass.Function {
      self.typeError("Method %s of class %s is not a function (has type %s)"
                     % (method.sym.name, info.sym.name, ty.toString()),
                     location)
      return null(Type)
    }
    params = ty.function.params
    result = ty.function.result
    if params.type == Type.TypeClass.Tuple && params.tuple.elements.length() > 0 {
      selfParam = params.tuple.elements[0]
      rest = arrayof(Type)
      for i in range(params.tuple.elements.length()) {
        if i > 0 {
          rest.append(params.tuple.elements[i])
        }
      }
      if rest.length() == 1 {
        restType = rest[0]
      } else {
        restType = Type(TupleType(rest))
      }
    } else {
      // Single parameter: just self.
      selfParam = params
      noParams = arrayof(Type)
      restType = Type(TupleType(noParams))
    }
    te = self.unify(selfParam, instanceType)
    if !isnull(te) {
      self.typeError("Cannot call method %s on %s: %s"
                     % (method.sym.name, instanceType.toString(), te.msg), location)
      return null(Type)
    }
    return Type(FunctionType(restType, result))
  }

  // True if t structurally contains a type VARIABLE — without resolving.
  // Distinguishes a baked instantiation snapshot (fully concrete
  // structure) from a template-era one whose variables merely happen to
  // resolve under the current bindings (and would resolve DIFFERENTLY
  // under another round's leftovers).
  func hasRawVars(self, t: Type) -> bool {
    switch t.type {
      Type.TypeClass.Var => return true
      Type.TypeClass.Array => return self.hasRawVars(t.array.elementType!)
      Type.TypeClass.Tuple => {
        for rvEl in t.tuple.elements {
          if self.hasRawVars(rvEl) {
            return true
          }
        }
        return false
      }
      Type.TypeClass.Function => {
        if self.hasRawVars(t.function.params!) {
          return true
        }
        return self.hasRawVars(t.function.result!)
      }
      Type.TypeClass.Typename => {
        if isnull(t.tyname.params) {
          return false
        }
        for rvEl2 in t.tyname.params.elements {
          if self.hasRawVars(rvEl2) {
            return true
          }
        }
        return false
      }
      default => return false
    }
  }

  // During a materialization round, map a bare generic-class knot to the
  // unique recorded constructor instantiation CONSISTENT with the round's
  // enclosing class instance: any type argument of the candidate that
  // names the enclosing class must equal the round's resolved self type
  // (an Entry knot read inside Dict(u32,string)'s methods means "the
  // Entry OF THIS Dict").  Ambiguity or no candidate leaves the knot
  // unchanged.
  func concretizeKnots(self, ty: Type, depth: u32) -> Type {
    // The consistency anchor: the round's own class instance.
    kSelfName = ""
    kSelfSpec = ""
    if !isnull(self.currentClassInfo) && !isnull(self.currentSelfType) {
      kcrs = self.resolve(self.currentSelfType!)
      if kcrs.type == Type.TypeClass.Typename && !self.hasFreeVars(kcrs) {
        kSelfName = kcrs.tyname.name.name
        kSelfSpec = kcrs.toString()
      }
    }
    return self.concretizeKnotsW(ty, depth, kSelfName, kSelfSpec)
  }

  // concretizeKnots with an EXPLICIT consistency anchor (emission-time
  // callers anchor on the emitting method's resolved self instance).
  func concretizeKnotsW(self, ty: Type, depth: u32, kSelfName: string,
      kSelfSpec: string) -> Type {
    if depth > 6u32 {
      return self.resolve(ty)
    }
    t = self.resolve(ty)
    switch t.type {
      Type.TypeClass.Typename => {
        if isnull(t.tyname.params) {
          kinfo = self.lookupClass(t.tyname.name)
          if isnull(kinfo) {
            return t
          }
          if kinfo.paramVars.length() == 0 {
            return t
          }
          if isnull(kinfo.fn) {
            return t
          }
          kty = kinfo.fn.typedValue
          if isnull(kty) {
            return t
          }
          if kty.type != Type.TypeClass.Polymorphic {
            return t
          }
          kFound = null(Type)
          kDistinct = arrayof(string)
          kpi = kty.poly.instantiations
          if !isnull(kpi) {
            for kinst in kpi {
              kit = kinst.type
              if !isnull(kit) {
                rkit = self.resolve(kit!)
                if rkit.type == Type.TypeClass.Function {
                  rres = self.resolve(rkit.function.result!)
                  if (rres.type == Type.TypeClass.Typename &&
                      !isnull(rres.tyname.params) && !self.hasFreeVars(rres)) {
                    kConsistent = true
                    if kSelfName != "" {
                      for kel in rres.tyname.params.elements {
                        rkel = self.resolve(kel)
                        if rkel.type == Type.TypeClass.Typename {
                          if rkel.tyname.name.name == kSelfName {
                            if rkel.toString() != kSelfSpec {
                              kConsistent = false
                            }
                          }
                        }
                      }
                    }
                    if kConsistent {
                      kSeen = false
                      kStr = rres.toString()
                      for kd in kDistinct {
                        if kd == kStr {
                          kSeen = true
                        }
                      }
                      if !kSeen {
                        kDistinct.append(kStr)
                        kFound = rres
                      }
                    }
                  }
                }
              }
            }
          }
          if kDistinct.length() == 1 {
            return kFound!
          }
          return t
        }
        kEls = arrayof(Type)
        for kel2 in t.tyname.params.elements {
          kEls.append(self.concretizeKnotsW(kel2, depth + 1u32, kSelfName, kSelfSpec))
        }
        kName = TypeName(t.tyname.name, TupleType(kEls))
        kName.isNullable = t.tyname.isNullable
        return Type(kName)
      }
      Type.TypeClass.Array => {
        return ARRAY(self.concretizeKnotsW(t.array.elementType!, depth + 1u32, kSelfName, kSelfSpec))
      }
      Type.TypeClass.Tuple => {
        kTEls = arrayof(Type)
        for ktel in t.tuple.elements {
          kTEls.append(self.concretizeKnotsW(ktel, depth + 1u32, kSelfName, kSelfSpec))
        }
        return Type(TupleType(kTEls))
      }
      default => return t
    }
  }

  // Substitute the class's type parameters with the instance's type
  // arguments inside a member type, without binding the class's type
  // variables globally.
  func substituteClassVars(self, info: ClassInfo, instanceType: Type, memberType: Type) -> Type {
    rSubInst = self.resolve(instanceType)
    if self.retypecheckNesting > 0u32 {
      if rSubInst.type == Type.TypeClass.Typename && isnull(rSubInst.tyname.params) {
        // A knot instance during a materialization round: try to pin it
        // to the signature consistent with the round's self type, so the
        // normal projection below applies.
        rSubInst = self.concretizeKnots(rSubInst, 0u32)
      }
    }
    if rSubInst.type != Type.TypeClass.Typename || isnull(rSubInst.tyname.params) {
      // A bare class knot (or an unresolved/non-instance base).  DURING A
      // MATERIALIZATION round the canonical slot may only be handed out
      // when it is already concrete: a FREE canonical would be unified
      // with the round's concrete types, permanently baking one
      // signature into the shared template (Entry.value = u32 poisoned
      // dicttest's second Dict signature) — hand out a fresh variable
      // instead; the round's own bindings or emission recovery resolve
      // it.  The TEMPLATE pass keeps the canonical: that chaining is the
      // intentional template-class knot (mutual-constructor relation
      // inference depends on it).
      if self.retypecheckNesting > 0u32 {
        rSubMember = self.resolve(memberType)
        if !self.hasFreeVars(rSubMember) {
          return rSubMember
        }
        return Type(self.newTyvar())
      }
      return memberType
    }
    instParams = rSubInst.tyname.params!
    // Resolve first so the member type and paramVars both use the chain
    // representatives; replaceVar matches on exact variable ids.
    result = self.resolve(memberType)
    for i in range(info.paramVars.length()) {
      pv = self.resolve(info.paramVars[i])
      if pv.type == Type.TypeClass.Var && i < instParams.elements.length() {
        fresh = self.newTyvar()
        result = result.replaceVar(pv.tyvar!, fresh)
        te = self.unify(Type(fresh), instParams.elements[i])
      }
    }
    rSubResult = self.resolve(result)
    if self.retypecheckNesting > 0u32 {
      // A projected member can still carry bare knots (a [Entry] table
      // slot); pin them to the signature consistent with this round.
      rSubResult = self.concretizeKnots(rSubResult, 0u32)
    }
    if rSubResult.type == Type.TypeClass.Var && self.retypecheckNesting > 0u32 {
      // The slot never linked to the class's parameter variables (its
      // linkage was lost to deferral rollback, or the paramVars are
      // currently bound by a materialization round so replaceVar had
      // nothing to match).  For a CONCRETE instance during a
      // materialization round, returning the canonical variable would
      // let this site poison the template — hand out a fresh variable
      // instead.  When the instance's arguments are still variables (a
      // method's own self), keep the chain: self.<field> writes are
      // supposed to constrain the template.
      subParamsFree = false
      for spEl in instParams.elements {
        if self.hasFreeVars(spEl) {
          subParamsFree = true
        }
      }
      if !subParamsFree {
        return Type(self.newTyvar())
      }
    }
    return rSubResult
  }

  // If ty is a Typename whose definition is a (possibly polymorphic)
  // struct, return the struct type with this instance's type arguments
  // substituted for the struct's type parameters.
  func structInstanceType(self, ty: Type) -> Type? {
    if ty.type != Type.TypeClass.Typename {
      return null(Type)
    }
    def = self.lookupTyname(ty.tyname.name)
    if isnull(def) {
      return null(Type)
    }
    if def.type == Type.TypeClass.Struct {
      return def
    }
    if (def.type != Type.TypeClass.Polymorphic ||
        def.poly.scope.type != Type.TypeClass.Struct) {
      return null(Type)
    }
    result = def.poly.scope
    if isnull(ty.tyname.params) {
      return result
    }
    instParams = ty.tyname.params!
    for i in range(def.poly.boundVars.length()) {
      bv = def.poly.boundVars[i]
      if i < instParams.elements.length() {
        fresh = self.newTyvar()
        result = result.replaceVar(bv.tyvar!, fresh)
        te = self.unify(Type(fresh), instParams.elements[i])
      }
    }
    return self.resolve(result!)
  }

  func structFunction(self, fn: db.Function) {
    self.openScope()
    params = arrayof(Type)
    fieldnames = arrayof(Sym)
    fieldtypes = arrayof(Type)
    for variable in fn.variables() {
        ty = self.variable(variable)!
        params.append(ty)
        fieldnames.append(variable.sym)
        fieldtypes.append(ty)
    }

    if params.length() == 1 {
      paramType = params[0]
    } else {
      paramType = Type(TupleType(params))
    }

    bindingScope = self.closeScope()
    paramType = self.resolve(paramType)
    boundVars = arrayof(Type)
    for sm in bindingScope.symbolMappings() {
      if !isnull(sm.value) && sm.value.type == Type.TypeClass.Var {
        // Has this type variable been instantiated?
        ty = self.resolve(sm.value!)
        if ty.type == Type.TypeClass.Var {
          boundVars.append(Type(ty.tyvar!))
        }
      }
    }

    tynameDef = Type(StructType(fieldnames, fieldtypes))
    if boundVars.length() > 0 {
      resType = Type(TypeName(fn.sym, TupleType(boundVars)))
      fnType = Type(FunctionType(paramType, resType))
      fnType = Type(PolymorphicType(boundVars, fnType))
      tynameDef = Type(PolymorphicType(boundVars, tynameDef))
    } else {
      fnType = Type(FunctionType(paramType, Type(TypeName(fn.sym))))
    }

    // associate function name symbol to this type.
    self.newSymbolGlobal(fn.sym, fnType)
    fn.typedValue = fnType
    self.newTyname(fn.sym, tynameDef)
  }

  func plainFunction(self, fn: db.Function) {
    if !isnull(fn.typedValue) {
      // Already typechecked (e.g. on demand from another class's method).
      // Re-typechecking would replace the polymorphic type and orphan the
      // instantiations recorded on it for the C backend.
      return
    }
    // Todo: consider storage types
    if isnull(fn.typeExpr) {
      returnType = Type(self.newTyvar())
    } else {
      // Like parameter constraints: class names parameterize with fresh
      // variables (nullable forms like FilePtr? included) so the body's
      // instance types unify against them.
      returnType = self.constraintType(fn.typeExpr!)
    }

    // open new scope - new parameter bindings are added to the scope
    // automatically
    self.openScope()
    // Variables issued from here on belong to this function's typecheck;
    // generalization of nested free variables is limited to them so the
    // enclosing class's type parameters stay shared across call sites.
    varWindowStart = self.unifier.nextFreshVar
    params = arrayof(Type)
    for variable in fn.variables() {
      param = self.variable(variable)!
      params.append(param)
    }
    if params.length() == 1 {
      paramType = params[0]
    } else {
      paramType = Type(TupleType(params))
    }
    // Pre-bind a monomorphic in-progress type built from the real
    // parameter variables: a recursive call (direct or mutual) in the
    // body then unifies against this through methodCallType instead of
    // demanding a re-typecheck of this function, which never terminates.
    monoResult = Type(self.newTyvar())
    fn.typedValue = Type(FunctionType(paramType, monoResult))
    // The parameter scope stays open while the body typechecks so that
    // parameter lookups resolve to this function's bindings; the body's
    // locals bind into their own scope.
    self.openScope()

    // must walk through all return statements.
    preBodyErrors = self.countTypeErrors()
    prevStructuralFlag = self.sawStructuralGenericError
    self.sawStructuralGenericError = false
    returnType = null(Type)
    emptyBody = arrayof(db.Statement)
    bodyStatements = emptyBody
    if !isnull(fn.subBlock) {
      for s in fn.subBlock.statements() {
        bodyStatements.append(s)
      }
    }
    for statement in bodyStatements {
      self.statement(statement, fn.subBlock!)
      if !isnull(fn.subBlock.returnType) {
        if isnull(returnType) {
          returnType = fn.subBlock.returnType
        } else {
          te = self.unify(returnType!, fn.subBlock.returnType!)
          if !isnull(te) {
            self.typeError(
               ("Conflicting return types\n%s    %s\n%s    and %s\n%s%s"
                 % (TypeLoggingPrefix, returnType.toString(),
                    TypeLoggingPrefix, fn.subBlock.returnType.toString(),
                    TypeLoggingPrefix, te.msg)),
               fn.location)
          }
        }
      }
    }

    // Make sure that the explicit return type, if it exists, agrees with
    // the type computed from the function body.
    if !isnull(fn.typeExpr) {
        explicitReturnType = self.constraintType(fn.typeExpr!)
        if isnull(returnType) {
            returnType = explicitReturnType
        } else {
            te = self.unify(returnType!, explicitReturnType)
            if !isnull(te) {
                self.typeError(
                    ("Could not unify\n%s    explicit return type %s\n%s    with %s:\n%s%s"
                      % (TypeLoggingPrefix, fn.typeExpr.toString(),
                         TypeLoggingPrefix, returnType.toString(), TypeLoggingPrefix, te.msg)),
                    fn.location)
           }
        }
    }

    if isnull(returnType) {
      returnType = Type(TypeName(Sym.new("none")))
    }
    // A body that errors on member access or indexing of unconstrained
    // parameters typechecks again under a concrete instantiation before
    // emission, like the legacy compiler.  Concrete functions keep their
    // errors: instantiation cannot improve them.
    if self.countTypeErrors() > preBodyErrors && self.sawStructuralGenericError {
      // Forget literal-induced AnyInt bindings on parameters before deferring,
      // exactly as the non-deferred generalization path does below.  A body
      // like `d + 1` or `d mod m` binds the parameter's variable to AnyInt
      // (defaulting to u64); without unbinding it, the parameter is excluded
      // from deferVars and bakes in as u64 even though the call passes a wider
      // type (e.g. a u255 modulus).  Unbind so it generalizes and the call
      // site's argument width decides (per-call literal polymorphism).
      for unbindVar in fn.variables() {
        if (unbindVar.isParam && !isnull(unbindVar.typedValue) &&
            unbindVar.typedValue.type == Type.TypeClass.Var) {
          unbindBoundTo = self.resolve(unbindVar.typedValue!)
          if unbindBoundTo.type == Type.TypeClass.AnyInt {
            unbindChainVar = unbindVar.typedValue.tyvar!
            unbindChainDepth = 0
            while unbindChainDepth < 64 {
              unbindChainBinding = self.unifier.lookupVar(unbindChainVar.id)
              if isnull(unbindChainBinding) {
                unbindChainDepth = 64
              } else if unbindChainBinding.type == Type.TypeClass.Var {
                unbindChainVar = unbindChainBinding.tyvar!
                unbindChainDepth += 1
              } else {
                if unbindChainBinding.type == Type.TypeClass.AnyInt {
                  self.unifier.unbindVar(unbindChainVar)
                }
                unbindChainDepth = 64
              }
            }
          }
        }
      }
      deferVars = arrayof(Type)
      for variable in fn.variables() {
        if variable.isParam && !isnull(variable.typedValue) {
          dpv = self.resolve(variable.typedValue!)
          if dpv.type == Type.TypeClass.Var {
            deferVars.append(Type(dpv.tyvar!))
          } else if dpv.type == Type.TypeClass.Typename {
            // A class-instance parameter (a: Matrix) is generic through
            // its unresolved type parameters.
            if !isnull(dpv.tyname.params) {
              for dpel in dpv.tyname.params.elements {
                rdp = self.resolve(dpel)
                if rdp.type == Type.TypeClass.Var {
                  deferVars.append(Type(rdp.tyvar!))
                }
              }
            }
          }
        }
      }
      if deferVars.length() > 0 {
        while self.countTypeErrors() > preBodyErrors {
          self.popTypeError()
        }
        if !isnull(fn.subBlock) {
          self.clearExprTypes(fn.subBlock!)
        }
        // Tie the in-progress result to the body's actual return type before
        // deciding whether to generalize it, exactly as the non-deferred path
        // does below.  A void method (bare `return` -> none) otherwise leaves
        // monoResult an unresolved variable that gets generalized; its
        // instantiations then carry a free result var, never pass the
        // concreteness check, and are never emitted -- so a caller's
        // `obj.voidMethod()` references an undeclared specialization.
        if !isnull(returnType) {
          self.unify(monoResult, returnType!)
        }
        rres = self.resolve(monoResult)
        deferHasValueReturn = false
        if !isnull(fn.subBlock) {
          if !isnull(db.findReturnExpr(fn.subBlock!)) {
            deferHasValueReturn = true
          }
        }
        if rres.type == Type.TypeClass.Var {
          deferVars.append(Type(rres.tyvar!))
        } else if deferHasValueReturn {
          // monoResult was bound during the ERRORED template walk (the
          // void-method tie above is only trustworthy for bodies WITHOUT
          // value returns).  A deferred body's result must stay
          // per-instantiation — decParens' shared `none` result otherwise
          // gives every specialization a void signature.  Mint a fresh
          // generalized result variable.
          freshRes = self.newTyvar()
          monoResult = Type(freshRes)
          deferVars.append(Type(freshRes))
        }
        deferredType = Type(PolymorphicType(deferVars,
            Type(FunctionType(paramType, monoResult))))
        // Re-point each parameter Variable at its generalized signature
        // slot, exactly like the non-deferred epilogue: the deferral path
        // exits before it, leaving pre-generalization variables whose
        // chains later rounds permanently bake — emission then composes
        // one signature's names/types for another's call sites.
        dfParams = self.resolve(paramType)
        dfIdx = 0u64
        for dfVar in fn.variables() {
          if dfVar.isParam {
            if dfParams.type == Type.TypeClass.Tuple {
              if dfIdx < dfParams.tuple.elements.length() {
                dfVar.typedValue = dfParams.tuple.elements[dfIdx]
              }
            } else if dfIdx == 0u64 {
              dfVar.typedValue = dfParams
            }
            dfIdx += 1u64
          }
        }
        self.closeScope()  // The body's locals.
        self.closeScope()  // The parameters.
        deferIsMethod = (!isnull(fn.parentFunction) &&
            fn.parentFunction.type == db.FuncType.Constructor &&
            fn.type != db.FuncType.Operator)
        if !deferIsMethod {
          self.newSymbolGlobal(fn.sym, deferredType)
        }
        fn.typedValue = deferredType
        fn.deferredTypecheck = true
        self.sawStructuralGenericError = prevStructuralFlag
        return
      }
    }
    self.sawStructuralGenericError = prevStructuralFlag
    // Recursive call sites typed against the in-progress result variable
    // must agree with the actual return type.
    te = self.unify(monoResult, returnType!)
    if !isnull(te) {
      self.typeError("Recursive call result conflicts with return type: %s" % te.msg,
                     fn.location)
    }
    self.closeScope()  // The body's locals.
    bindingScope = self.closeScope()  // The parameters, for generalization.
    // Forget literal-induced AnyInt bindings on parameters: a comparison
    // like a == 1 must not fix the parameter's width; the call site's
    // argument decides (per-call literal polymorphism).  Follow the
    // variable chain and unbind the variable holding the AnyInt itself, so
    // every variable chained to the parameter stays connected.
    for variable in fn.variables() {
      if (variable.isParam && !isnull(variable.typedValue) &&
          variable.typedValue.type == Type.TypeClass.Var) {
        boundTo = self.resolve(variable.typedValue!)
        if boundTo.type == Type.TypeClass.AnyInt {
          chainVar = variable.typedValue.tyvar!
          chainDepth = 0
          while chainDepth < 64 {
            chainBinding = self.unifier.lookupVar(chainVar.id)
            if isnull(chainBinding) {
              chainDepth = 64
            } else if chainBinding.type == Type.TypeClass.Var {
              chainVar = chainBinding.tyvar!
              chainDepth += 1
            } else {
              if chainBinding.type == Type.TypeClass.AnyInt {
                self.unifier.unbindVar(chainVar)
              }
              chainDepth = 64
            }
          }
        }
      }
    }
    // Replace type variables in the parameters and return type with their
    // instantiations, if any.
    paramType = self.resolve(paramType)
    returnType = self.resolve(returnType!)

    fnType = Type(FunctionType(paramType, returnType!))
    boundVars = arrayof(Type)
    for sm in bindingScope.symbolMappings() {
      if !isnull(sm.value) && sm.value.type == Type.TypeClass.Var {
        // Has this type variable been instantiated?
        ty = self.resolve(sm.value!)
        if ty.type == Type.TypeClass.Var {
          exists = false
          for bv in boundVars {
            if bv.tyvar.id == ty.tyvar.id {
              exists = true
            }
          }
          if !exists {
            boundVars.append(Type(ty.tyvar!))
          }
        }
      }
    }
    // Variables nested inside composite parameter or return types (e.g. a
    // duck-typed parameter resolved to Complex(v1, v2)) generalize too;
    // otherwise the first call site binds them for every later call.  Only
    // variables created during this function's typecheck qualify: older
    // ones belong to enclosing context (class instantiations, globals).
    nestedVars = arrayof(Type)
    nestedVars = self.collectFreeTyvars(paramType, nestedVars)
    nestedVars = self.collectFreeTyvars(returnType!, nestedVars)
    for nv in nestedVars {
      if nv.tyvar.id <= varWindowStart {
        exists = false
        for bv in boundVars {
          if bv.tyvar.id == nv.tyvar.id {
            exists = true
          }
        }
        if !exists {
          boundVars.append(nv)
        }
      }
    }
    // Class methods must also generalize over the enclosing class's type
    // parameters, so that each call site instantiates them freshly.
    for cv in self.classBoundVars {
      rcv = self.resolve(cv)
      if rcv.type == Type.TypeClass.Var {
        exists = false
        for bv in boundVars {
          if bv.tyvar.id == rcv.tyvar.id {
            exists = true
          }
        }
        if !exists {
          boundVars.append(Type(rcv.tyvar!))
        }
      }
    }
    // A variable still free in the RESULT type must be per-call: two call
    // sites of the same function each record their own result slot, and
    // one shared free result variable can never satisfy both (dicttest's
    // value = dict.find(...) at two signatures).  The id-window gate above
    // protects enclosing-context variables inside parameters; a residual
    // free variable in the result is this function's own unresolved
    // return (typically a callee's un-generalized result chained
    // through), so quantify it unconditionally.
    resultFreeVars = arrayof(Type)
    resultFreeVars = self.collectFreeTyvars(returnType!, resultFreeVars)
    // A MODULE-LEVEL function has no enclosing type context at all: any
    // variable still free in its parameters (a class's template variable
    // chained in through a hoisted relation helper's argument) is per-call
    // too.  Methods keep the window gate: their enclosing class's
    // variables are quantified via classBoundVars above.
    isModuleFn = true
    if !isnull(fn.parentFunction) {
      if fn.parentFunction.type == db.FuncType.Constructor {
        isModuleFn = false
      }
    }
    if isModuleFn {
      resultFreeVars = self.collectFreeTyvars(paramType, resultFreeVars)
    }
    for rfv in resultFreeVars {
      exists = false
      for bv in boundVars {
        if bv.tyvar.id == rfv.tyvar.id {
          exists = true
        }
      }
      if !exists {
        boundVars.append(rfv)
      }
    }
    if boundVars.length() > 0 {
      fnType = Type(PolymorphicType(boundVars, fnType))
      // Re-point each parameter Variable at its generalized signature
      // slot: the pre-generalization variable chains into whatever the
      // template unified it with (another function's vars), and a later
      // signature's round can permanently bake that chain — emission
      // paths that read variable.typedValue then see the stale signature
      // forever.  The resolved slots ARE the generalized boundVars, which
      // instantiate() manages per signature.
      rptParams = self.resolve(paramType)
      fpIdx = 0u64
      for fpVar in fn.variables() {
        if fpVar.isParam {
          if rptParams.type == Type.TypeClass.Tuple {
            if fpIdx < rptParams.tuple.elements.length() {
              fpVar.typedValue = rptParams.tuple.elements[fpIdx]
            }
          } else if fpIdx == 0u64 {
            fpVar.typedValue = rptParams
          }
          fpIdx += 1u64
        }
      }
    }

    // Associate the function name symbol to this type — but not for class
    // methods: those are only reachable through member access, and binding
    // an interned method name like "hash" globally poisons same-named
    // locals in whatever function a demand-typecheck interrupted.
    isMethod = (!isnull(fn.parentFunction) &&
                fn.parentFunction.type == db.FuncType.Constructor &&
                fn.type != db.FuncType.Operator)
    if !isMethod {
      self.newSymbolGlobal(fn.sym, fnType)
    }
    fn.typedValue = fnType

    // The parameters' interned symbols still point at the variables that were
    // just generalized into boundVars.  Clear those mappings so a later
    // same-named module-level (or other-function) variable does not reuse a
    // generalized boundVar through symbol()'s forward-reference path and then
    // bind it — that would monomorphize this polymorphic function (e.g. a
    // module local `T` colliding with a `func f(T: Uint)` parameter).  Codegen
    // reads each parameter's type from the Variable, not the interned symbol.
    if boundVars.length() > 0 {
      for clearParam in fn.variables() {
        if !isnull(clearParam.sym.typedValue) {
          if self.resolve(clearParam.sym.typedValue!).type == Type.TypeClass.Var {
            clearParam.sym.typedValue = null(Type)
          }
        }
      }
    }

    if db.getRoot().traceTypes {
       fn.location.annotation("\n[Typecheck] ", TypeLoggingPrefix)
       println "%s%s" % (TypeLoggingPrefix, fnType.toString())
       println "%s%s: %s" % (TypeLoggingPrefix, fn.sym.name, fnType.toString())
    }
  }
}


unittest TypeClasses {
  // Instantiate all the type classes so that they get compiled.
  v = TypeVar(0i32, null(Type))
  i = IntType(true, 3u32)
  f = FloatType(32u32)
  c = ChoiceType([Type(IntType(true, 32u32))])
  t = TupleType([Type(IntType(true, 32u32))])
  tn = TypeName("boo")
  fn = FunctionType(Type(tn), Type(tn))
  p = PolymorphicType(0u64, TypeVar(0i32, null(Type)), Type(IntType(true, 32u32)))
  p.toString()
}

unittest TypeApplyTest {
  tc = TypeChecker()
  assert tc.apply(FN(STR, INT), STR) == INT
  assert isnull(tc.apply(FN(STR, INT), INT))
  assert tc.apply(FN(INT, STR), I(64)) == STR
  assert tc.apply(POLY(1, FN(V(1), V(1))), BOOL) == BOOL
  assert isnull(tc.apply(BPOLY(1, [ANYINT], FN(V(1), V(1))), BOOL))
}

unittest SimpleTypeCheckTest {
  filepath = db.Filepath.new("test_filepath", null(db.Filepath), false)
  location = db.Location(filepath, 0u32, 0u32, 0u32)
  left = db.Expr.newConstant(db.Value("Hello"), location)
  right = db.Expr.newConstant(db.Value("World"), location)
  expr = db.Expr.newBinary(db.ExprType.Lt, left, right, location)

  tc = TypeChecker()
  assert tc.expr(expr) == BOOL
}

unittest StructTypeCheckTest {
  filepath = db.Filepath.new("test_filepath", null(db.Filepath), false)
  location = db.Location(filepath, 0u32, 0u32, 0u32)
  sym = Sym("hello")

  fn = db.Function.new(null(db.Function), db.Function.FuncType.Struct, sym,
                       db.Function.Linkage.Module, location)

  tc = TypeChecker()
  tc.structFunction(fn)
  td = TynameDefinition(sym.name, null(Type))
  def = tc.lookupTyname(sym.name)
  assert !isnull(def)
}
