//
// Based on the Hindley-Milner algorithm, see
// https://en.wikipedia.org/wiki/Hindley%E2%80%93Milner_type_system
// for an introduction.
//
// To see how it works, consider the following expression:
//
//   1 + (2 * 3)
//
// with (a simplified representation of the AST for this comment):
//   root: BinaryOp(PLUS,
//     n0:   Uint64(1),
//     n1:   BinaryOp(TIMES,
//    n10:    Uint64(2),
//    n11:    Uint64(3)
//           )
//         )
//
// The algorithm is 'syntax-directed': it builds a type for a node
// directly from the types of its children. The algorithm starts
// at the root:
//
//     1. It is the binary operator PLUS, look up its type:
//           BPOLY(1, [STR, NUM], FN(TUPLE([v, v]), v))
//             (in symbols: forall v1:string|num. (v1, v1) -> v1))
//
//           (this is a "bounded polymorphic function" that takes one
//            type variable 'v1'. The type variable is 'bound' in that
//            it is limited to be either a string (STR) or a numeric (NUM)
//            type. (NUM here means Int | Uint | f32 | f64.))
//
//     2. Recursively typecheck the children:
//           n0 has type Uint64
//           n1 has type Uint64
//
//     3. Apply the type in (2) to the children. This involves
//
//          (a) "opening" the bounded polymorphic type. That is,
//              i. generate a new type variable, 'x', where x is a
//                 hitherto unused type variable number. Note that in our
//                 algorithm, variables generated by opening polymorphic
//                 types have negative numbers, while those inferred for
//                 functions are positive.
//             ii. attach the type constraint [STR, NUM] to the new variable
//            iii. instantiate the body to become:
//                   (vx:str|num, vx:str|num) -> vx:str|num
//
//          (b) "apply" this new function type to the types in (3):
//              i. unify argument type (vx:str|num, vx:str|num)
//                 to (typeof(n0), typeof(n1))
//
//                 unification of tuple types is just sequential unification
//                 of child types. So
//
//             ii. unify the left side of the fn param tuple, vx:str|num
//                 against the left size of the arg tuple, typeof(n0)=Uint64
//                 vx is not instantiated, but it does have the constraint
//                 str|num.  Uint64 belongs to 'num' so the constraint succeeds,
//                 which means vx is now bound to concrete type Uint64.
//
//            iii. unify the right side of the fn param tuple, vx:str|num=Uint64
//                 against the right side of the arg tuple, typeof(n1)=Uint64.
//                 Since vx is already bound, this becomes
//                 unify Uint64 with Uint64, which succeeds because they are
//                 identical types.
//
//             iv. Finally, we return the 'result type' of the function, which
//                 is just vx:str|num=Uint64.
//
// This simple example shows what happens with an ill-formed expression.
// Consider
//
//    1 + "Hello, world!"
//
// or
//    root: BinaryOp(PLUS,
//      n0:   Uint64(1),
//      n1:   String("Hello, world!")
//          )
//
// Following the above typechecking process, we fail at step 3(b).iii above:
//
//   The type variable vx:str|num will have been bound to type Uint64 in
//   step 3(b).ii. When we come to apply the right hand side of the fn param
//   tuple, vx:str|num=Uint64 against the right hand side of the arg tuple,
//   typeof(n1)=string, we end up trying to unify type Uint64 against type
//   string, which fails because they are not equal.
//
// Inferring polymorphic types for definitions.
//
// The above algorithm instantiates existing types. However, we also need to
// infer new polymorphic types for user-defined functions. Consider the function
//
//     func id (x) {
//         return x
//     }
//
// We intuitively know that it is polymorphic in the argument x.  It should have
// type POLY(1, FN(v, v))  -- in symbols:  forall v1.(v1 -> v1).
//
// Type generalization occurs at definitions. We start by generating type variables
// for the parameters, here, x has type v1.  Then, using the above algorithm we
// typecheck the body of the function -- it returns a value of type v1.
//
// Since this is a func, we can infer its type to be
//
//    <typeof parameters> -> <typeof result>
//
// In this example, this boils down to  v1 -> v1.  Since we know that the variable
// v1 was introduced in this function definition (we generated it for parameter x),
// we know that we can bind it to become forall v1.(v1 -> v1).


import database as db
use sym
use builtins
use typeclasses
use typeunifier
use typebuilder
use typeerror

TypeLoggingPrefix = ": "

STR = STRING()
BOOL = BOOLEAN()
INT = INTEGER()
UINT = UINTEGER()
ANYINT = ANYINTEGER()
NUM = NUMBER()

// Associates a given tyname with its definition.
// Note that this is probably too simple -- it may be that
// we will want typename variables, and when that happens
// we will need a unique tyname identifier.
class TynameDefinition(self, tyname: Sym, ty:Type?) {
  self.tyname = tyname
  self.value = ty

  func hash(self) -> u64 {
    return hashValue(self.tyname.name)
  }

  func equals(self, other: TynameDefinition) -> bool {
    return self.tyname == other.tyname
  }
}

// Associates a given program variable with its type.
class SymbolMapping(self, key: Sym, ty: Type?) {
  self.key = key
  self.value = ty

  func hash(self) -> u64 {
    return hashValue(self.key.name)
  }

  func equals(self, other: SymbolMapping) -> bool {
    return self.key == other.key
  }
}

relation DoublyLinked BindingScope SymbolMapping cascade

class BindingScope(self) {
  func add(self, sm: SymbolMapping) {
    self.appendSymbolMapping(sm)
  }
}

// Records the members of an enum and their integer values.
class EnumInfo(self, sym: Sym) {
  self.sym = sym
  self.memberNames = arrayof(Sym)
  self.memberValues = arrayof(u32)

  func hash(self) -> u64 {
    return hashValue(self.sym.name)
  }

  func equals(self, other: EnumInfo) -> bool {
    return self.sym == other.sym
  }

  // Returns the value of the named member, or u32 max if not found.
  func memberValue(self, name: string) -> u32 {
    for i in range(self.memberNames.length()) {
      if self.memberNames[i].name == name {
        return self.memberValues[i]
      }
    }
    return ~0u32
  }

  func hasMember(self, name: string) -> bool {
    for i in range(self.memberNames.length()) {
      if self.memberNames[i].name == name {
        return true
      }
    }
    return false
  }
}

// Records typechecking information about a class: its constructor function,
// the struct type holding its data members, and the type variables of its
// constructor parameters (in declaration order).
class ClassInfo(self, sym: Sym) {
  self.sym = sym
  self.fn = null(db.Function)
  self.strct = null(StructType(arrayof(Sym), arrayof(Type)))
  self.selfType = null(Type)
  self.paramVars = arrayof(Type)

  func hash(self) -> u64 {
    return hashValue(self.sym.name)
  }

  func equals(self, other: ClassInfo) -> bool {
    return self.sym == other.sym
  }
}

// Maps a function name to its definition, so call sites can look up
// parameter names and default values.
class FunctionDef(self, sym: Sym) {
  self.sym = sym
  self.fn = null(db.Function)

  func hash(self) -> u64 {
    return hashValue(self.sym.name)
  }

  func equals(self, other: FunctionDef) -> bool {
    return self.sym == other.sym
  }
}

relation HashedClass TypeChecker SymbolMapping cascade
relation HashedClass TypeChecker TynameDefinition cascade
relation HashedClass TypeChecker ClassInfo cascade
relation HashedClass TypeChecker EnumInfo cascade
relation HashedClass TypeChecker FunctionDef cascade
relation DoublyLinked TypeChecker BindingScope cascade
relation DoublyLinked TypeChecker TypeError cascade

class TypeChecker(self) {
  self.unifier = TypeUnifier()
  self.nextTyvarId = 1i32
  self.numTypeErrorsReported = 0
  // Set while typechecking a class constructor or its methods.
  self.currentClassInfo = null(ClassInfo)
  self.currentSelfType = null(Type)
  self.classBoundVars = arrayof(Type)
  // Overloaded operator functions and their types, in definition order.
  self.operatorFns = arrayof(db.Function)
  self.operatorTypes = arrayof(Type)
  // State for iterator inlining: a counter making inlined variable names
  // unique, and the rename map (old name -> new Sym) for the current inline.
  self.iteratorInlineCounter = 0u32
  self.renamePrefix = ""
  self.renameOld = arrayof(string)
  self.renameNew = arrayof(Sym)
  self.openScope()

  func typeError(self, msg: string, location: db.Location?) {
    self.appendTypeError(TypeError(msg, location))
  }

  func popTypeError(self) {
    if !isnull(self.lastTypeError) {
      self.removeTypeError(self.lastTypeError!)
    }
  }

  func dumpTypeErrors(self, dumpText: bool = true, prefix: string = "") {
    count = self.countTypeErrors()
    pos = self.numTypeErrorsReported

    while pos < count {
      te = self.indexTypeError(pos)
      if !isnull(te.location) {
        te.location.error(te.msg, dumpText, prefix)
      } else {
        println prefix + "Type error: %s" % te.msg
      }
      self.numTypeErrorsReported += 1
      pos += 1
    }
  }

  func openScope(self) {
    self.appendBindingScope(BindingScope())
  }

  func closeScope(self) -> BindingScope {
    scope = self.lastBindingScope!
    self.removeBindingScope(scope)
    return scope
  }

  func newSymbol(self, symbol: Sym, ty: Type?) -> Type? {
    // TODO: there may already exist a symbol mapping, if we are creating
    // a symbol with the same name as another in an outer scope.
    if isnull(ty) {
      type = Type(self.newTyvar())
    } else {
      type = ty
    }
    sm = SymbolMapping(symbol, type)
    self.insertSymbolMapping(sm)
    self.lastBindingScope.add(sm)
    symbol.typedValue = type
    return type
  }

  func newTyvar(self) -> TypeVar {
    tyvar = TypeVar(self.nextTyvarId, null(Type))
    self.nextTyvarId += 1
    return tyvar
  }

  func newConstrainedTyvar(self, constraint: Type) -> TypeVar {
    tyvar = TypeVar(self.nextTyvarId, constraint)
    self.nextTyvarId += 1
    return tyvar
  }

  func newTyname(self, tyname: Sym, def: Type) {
    td = TynameDefinition(tyname, def)
    self.insertTynameDefinition(td)
    if db.getRoot().traceTypes {
       println "%sDefine tyname %s = %s." % (TypeLoggingPrefix, tyname.name, def.toString())
    }
  }

  // Look up the typechecking information for a class by name.  Returns null
  // if the name does not refer to a class.
  func lookupClass(self, sym: Sym) -> ClassInfo? {
    return self.findClassInfo(ClassInfo(sym))
  }

  func registerFunctionDef(self, fn: db.Function) {
    fd = FunctionDef(fn.sym)
    fd.fn = fn
    self.insertFunctionDef(fd)
  }

  // The function type to apply for an operator expression: the builtin
  // operator type, extended with any user-defined overloads.
  func operatorChoices(self, op: db.ExprType, builtin: Type?) -> Type? {
    found = arrayof(Type)
    if !isnull(builtin) {
      found.append(builtin!)
    }
    for i in range(self.operatorFns.length()) {
      if self.operatorFns[i].opType == op {
        found.append(self.operatorTypes[i])
      }
    }
    if found.length() == 0 {
      return null(Type)
    }
    if found.length() == 1 {
      return found[0]
    }
    return OR(found)
  }

  func lookupFunctionDef(self, sym: Sym) -> db.Function? {
    found = self.findFunctionDef(FunctionDef(sym))
    if isnull(found) {
      return null(db.Function)
    }
    return found.fn
  }

  // Look up the typechecking information for an enum by name.  Returns null
  // if the name does not refer to an enum.
  func lookupEnum(self, sym: Sym) -> EnumInfo? {
    return self.findEnumInfo(EnumInfo(sym))
  }

  // True if the named type refers to a class instance.
  func isClassType(self, ty: Type?) -> bool {
    if isnull(ty) {
      return false
    }
    t = self.resolve(ty!)
    if t.type != Type.TypeClass.Typename {
      return false
    }
    return !isnull(self.lookupClass(t.tyname.name))
  }

  // True if the type is the builtin string type.
  func isStringType(self, ty: Type?) -> bool {
    if isnull(ty) {
      return false
    }
    t = self.resolve(ty!)
    if t.type != Type.TypeClass.Typename {
      return false
    }
    return t.tyname.name.name == "string"
  }

  // The function type of a builtin string method.
  func stringMethodType(self, name: string, location: db.Location) -> Type? {
    noArgs = arrayof(Type)
    switch name {
      "length" => return FN(TUPLE(noArgs), U(64))
      "append" => return FN(U(8), NONETY())
      "concat" => return FN(STRING(), NONETY())
      "toHex" => return FN(TUPLE(noArgs), STRING())
      "fromHex" => return FN(TUPLE(noArgs), STRING())
      "reverse" => return FN(TUPLE(noArgs), NONETY())
      "resize" => return FN(U(64), NONETY())
      // find/rfind take an optional offset; accept any argument tuple and
      // let the backend supply the default.
      "find", "rfind" => return FN(Type(self.newTyvar()), U(64))
      default => {
        self.typeError("Unsupported string method '%s'" % name, location)
        return null(Type)
      }
    }
  }

  // The function type of a builtin method on bool values.
  func boolMethodType(self, name: string, location: db.Location) -> Type? {
    noArgs = arrayof(Type)
    switch name {
      "toString" => return FN(TUPLE(noArgs), STRING())
      default => {
        self.typeError("Unsupported bool method '%s'" % name, location)
        return null(Type)
      }
    }
  }

  // The function type of a builtin method on integer values.
  func intMethodType(self, name: string, location: db.Location) -> Type? {
    noArgs = arrayof(Type)
    switch name {
      // toString takes an optional base; accept any argument tuple and
      // let the backend supply the default.
      "toString" => return FN(Type(self.newTyvar()), STRING())
      "toStringLE" => return FN(TUPLE(noArgs), STRING())
      "toStringBE" => return FN(TUPLE(noArgs), STRING())
      default => {
        self.typeError("Unsupported integer method '%s'" % name, location)
        return null(Type)
      }
    }
  }

  // True if the type still contains unresolved type variables after
  // resolution.  Used by the C backend to defer emission of polymorphic
  // instantiations whose bindings only resolve under an outer instantiation.
  func hasFreeVars(self, t: Type) -> bool {
    rt = self.resolve(t)
    switch rt.type {
      Type.TypeClass.Var => return true
      Type.TypeClass.Array => return self.hasFreeVars(rt.array.elementType)
      Type.TypeClass.Tuple => {
        for element in rt.tuple.elements {
          if self.hasFreeVars(element) {
            return true
          }
        }
        return false
      }
      Type.TypeClass.Function => {
        return self.hasFreeVars(rt.function.params) || self.hasFreeVars(rt.function.result)
      }
      Type.TypeClass.Typename => {
        if isnull(rt.tyname.params) {
          return false
        }
        return self.hasFreeVars(Type(rt.tyname.params!))
      }
      Type.TypeClass.Choice => {
        for choice in rt.choice.choices {
          if self.hasFreeVars(choice) {
            return true
          }
        }
        return false
      }
      default => return false
    }
  }

  func lookupTyname(self, tyname: Sym) -> Type? {
    res = null(Type)
    td = TynameDefinition(tyname, null(Type))
    found = self.findTynameDefinition(td)
    if !isnull(found) {
       res = found.value
    }
    if db.getRoot().traceTypes {
      if isnull(found) {
        println "%sTyname %s is undefined." % (TypeLoggingPrefix, tyname.name)
      } else {
        println "%sTyname %s is %s" % (TypeLoggingPrefix, tyname.name, res.toString())
      }
    }
    return res
  }

  func unify(self, a: Type, b: Type) -> TypeError? {
    return self.unifier.unify(a, b)
  }

  func dumpTypeBindings(self) {
    self.unifier.dump()
  }

  func instantiate(self, poly: PolymorphicType, inst: TyvarInstantiation) {
    // for a limited time, pretend that the bound variables in poly are bound
    // to the bindings in the instantiation.
    assert poly.boundVars.length() == inst.varBindings.length()
    emptyIds = arrayof(i32)
    poly.skippedBindIds = emptyIds
    for index in range(poly.boundVars.length()) {
       assert poly.boundVars[index].type == Type.TypeClass.Var
       btv = poly.boundVars[index].tyvar!
       binding = inst.varBindings[index]
       val = self.unifier.lookupVar(btv.id)
       if isnull(val) {
         self.unifier.bindVar(btv, binding)
       } else if val.type == Type.TypeClass.Var {
         // Bound to another variable: bind the representative at the end of
         // the chain instead, so resolution reaches this instantiation.
         poly.skippedBindIds.append(btv.id)
         rep = self.unifier.representative(btv)
         if rep.id != btv.id && isnull(self.unifier.lookupVar(rep.id)) {
           self.unifier.bindVar(rep, binding)
           poly.chainBoundVars.append(rep)
         }
       } else {
         // Concretely bound at a use site (e.g. a builtin operator
         // constraint variable).  Keep the existing binding.
         poly.skippedBindIds.append(btv.id)
       }
    }
  }

  func deInstantiate(self, poly: PolymorphicType) {
    // for a limited time, pretend that the bound variables in poly are bound
    // to the bindings in the instantiation.
    for ty in poly.boundVars {
      assert ty.type == Type.TypeClass.Var
      skipped = false
      for id in poly.skippedBindIds {
        if id == ty.tyvar.id {
          skipped = true
        }
      }
      if !skipped {
        self.unifier.unbindVar(ty.tyvar!)
        assert isnull(self.unifier.lookupVar(ty.tyvar.id))
      }
    }
    for rep in poly.chainBoundVars {
      self.unifier.unbindVar(rep)
    }
    emptyIds = arrayof(i32)
    poly.skippedBindIds = emptyIds
    emptyVars = arrayof(TypeVar)
    poly.chainBoundVars = emptyVars
  }


  // ---------------------------------- Type checking functions ----------------------

  func resolve(self, t: Type) -> Type {
    switch t.type {
      Type.TypeClass.Var => {
        t2 = self.unifier.resolveVar(t.tyvar!.id)
        if !isnull(t2) {
          return t2!
        }
        // The variable may be bound to another, unbound variable; in that
        // case return the representative at the end of the chain so that
        // unified variables resolve to the same variable.
        return Type(self.unifier.representative(t.tyvar!))
      }
      Type.TypeClass.Int => return t
      Type.TypeClass.AnyInt => return t
      Type.TypeClass.Float => return t
      Type.TypeClass.Typename => {
        if isnull(t.tyname.params) {
          return t
        }
        args = self.resolve(Type(t.tyname.params!))
        return Type(TypeName(t.tyname.name, args.tuple))
      }
      Type.TypeClass.Array => {
        et = self.resolve(t.array.elementType)
        return Type(ArrayType(et))
      }
      Type.TypeClass.Choice => {
        choices = arrayof(Type)
        for choice in t.choice!.choices {
          choices.append(self.resolve(choice))
        }
        return Type(ChoiceType(choices))
      }
      Type.TypeClass.Tuple => {
        elements = arrayof(Type)
        for child in t.tuple!.elements {
          elements.append(self.resolve(child))
        }
        return Type(TupleType(elements))
      }
      Type.TypeClass.Struct => {
        fieldnames = arrayof(Sym)
        fieldtypes = arrayof(Type)
        for i in range(t.strct!.fieldnames.length()) {
          fieldnames.append(t.strct!.fieldnames[i])
          fieldtypes.append(self.resolve(t.strct!.fieldtypes[i]))
        }
        return Type(StructType(fieldnames, fieldtypes))
      }
      Type.TypeClass.Function => {
        return Type(FunctionType(self.resolve(t.function!.params),
                                 self.resolve(t.function!.result)))
      }
      Type.TypeClass.Polymorphic => {
        // We want to resolve any free variables in the scope of the
        // polymorphic type. However, first make sure that no bound variable
        // exists in the unifier.
        //
        // It's unclear why we need to generate a new array of bound variables,
        // if we try to share the existing one, we (sometimes) end up generating
        // a new PolymorphicType with empty variables.
        newvars = arrayof(Type)
        for boundVar in t.poly!.boundVars {
          assert isnull(self.unifier.lookupVar(boundVar.tyvar.id))
          newvars.append(boundVar)
        }
        pt = PolymorphicType(newvars, self.resolve(t.poly!.scope),
                             t.poly.instantiations)
        return Type(pt)
      }
    }
  }

  func apply(self, function: Type, args: Type,
             location: db.Location? = null(db.Location)) -> Type? {
    ty = function
    if ty.type == Type.TypeClass.Var {
      ty = self.resolve(ty)
      if ty.type == Type.TypeClass.Var {
        // This will happen in the body of a recursive function, when it attempts
        // to apply itself for the first time.  Initially, the function identifier
        // is set to a type variable.
        newty = FN(Type(self.newTyvar()), Type(self.newTyvar()))
        te = self.unifier.unify(ty, newty, location)
        assert(isnull(te))
        ty = newty
      }
    }
    switch ty.type {
      Type.TypeClass.Function => {
        te = self.unifier.unify(ty.function!.params, args, location)
        if !isnull(te) {
          self.typeError("could not unify\n%s    parameters of function %s\n%s    with args %s:\n%s%s"
                          % (TypeLoggingPrefix, ty.toString(),
                             TypeLoggingPrefix, args.toString(), TypeLoggingPrefix, te.msg),
                         location)
          return null(Type)
        }
        return self.resolve(ty.function!.result)
      }

      Type.TypeClass.Polymorphic => {
        f2 = ty.poly!.open(self.unifier, &self.unifier.newVar())
        return self.apply(f2, args, location)
      }

      Type.TypeClass.Choice => {
        countErrors = 0
        for choice in ty.choice!.choices {
           ty2 = self.apply(choice, args, location)
           if !isnull(ty2) {
             // make sure that there are no type errors -- we can ignore
             // any errors from previous branch attempts.
             while countErrors > 0 {
               self.popTypeError()
               countErrors -= 1
             }
             return ty2
           }
           countErrors += 1
        }
        self.typeError("Failed to apply any choice of function type %s to %s."
                       % (ty.toString(), args.toString()),
                       location)
        return null(Type)
      }
      default => {
        self.typeError("attempting to apply a non-function %s to %s."
                         % (ty.toString(), args.toString()), location)
        return null(Type)
      }
    }
  }

  // ------------------------- Typecheck explicit type expressions ---------------------

  func namedType(self, name: Sym) -> Type {
    if name.name == "Int" {
      return INTEGER()
    } else if name.name == "Uint" {
      return UINTEGER()
    } else if name.name == "String" {
      return STRING()
    } else if name.name == "Bool" {
      return BOOLEAN()
    } else {
      return Type(TypeName(name))
    }
  }

  func explicitType(self, typeExpr: db.Expr) -> Type {
    switch typeExpr.type {
      db.ExprType.UintType => return U(<u64>typeExpr.width)
      db.ExprType.IntType =>  return I(<u64>typeExpr.width)
      db.ExprType.FloatType => return F(<u64>typeExpr.width)
      db.ExprType.StringType => return STR
      db.ExprType.BoolType => return BOOL
      db.ExprType.NoneType => return NONETY()
      db.ExprType.Ident => return self.namedType(typeExpr.val.symVal!)
      default => raise Status.Unimplemented, "TypeExpression type not yet supported by C backend", typeExpr.type
    }
  }

  // The type for a variable's type constraint.  Constraint forms we cannot
  // evaluate (e.g. choices like "string | bool") leave the variable
  // unconstrained rather than failing.
  func constraintType(self, typeExpr: db.Expr) -> Type {
    t = self.tryExplicitType(typeExpr)
    if isnull(t) {
      return Type(self.newTyvar())
    }
    if t.type == Type.TypeClass.AnyInt {
      // "Int"/"Uint" constraints accept any width; use a constrained type
      // variable so unification records the width actually passed.
      return Type(self.newConstrainedTyvar(t!))
    }
    if t.type == Type.TypeClass.Typename {
      name = t.tyname.name
      info = self.lookupClass(name)
      if !isnull(info) {
        // A class name constraint matches any instantiation of the class;
        // parameterize it with fresh variables so unification against a
        // concrete instance (e.g. Integer(u64,)) succeeds.
        if info.paramVars.length() > 0 {
          cparams = arrayof(Type)
          for pv in info.paramVars {
            cparams.append(Type(self.newTyvar()))
          }
          return Type(TypeName(name, TupleType(cparams)))
        }
        return t!
      }
      if (isnull(self.lookupEnum(name)) &&
          isnull(self.lookupTyname(name)) && name.name != "string" &&
          name.name != "bool" && name.name != "none") {
        // An unrecognized name; likely an unsupported constraint form.
        return Type(self.newTyvar())
      }
    }
    return t!
  }

  // Convert a type expression to a Type, returning null for forms that
  // cannot be evaluated here (rather than raising).
  func tryExplicitType(self, typeExpr: db.Expr) -> Type? {
    switch typeExpr.type {
      db.ExprType.UintType => return U(<u64>typeExpr.width)
      db.ExprType.IntType => return I(<u64>typeExpr.width)
      db.ExprType.FloatType => return F(<u64>typeExpr.width)
      db.ExprType.StringType => return STR
      db.ExprType.BoolType => return BOOL
      db.ExprType.NoneType => return NONETY()
      db.ExprType.Ident => return self.namedType(typeExpr.val.symVal!)
      db.ExprType.Tuple, db.ExprType.List => {
        elements = arrayof(Type)
        for child in typeExpr.childExprs() {
          t = self.tryExplicitType(child)
          if isnull(t) {
            return null(Type)
          }
          elements.append(t!)
        }
        return Type(TupleType(elements))
      }
      db.ExprType.Array => {
        first = typeExpr.firstChildExpr
        if isnull(first) {
          return null(Type)
        }
        t = self.tryExplicitType(first!)
        if isnull(t) {
          return null(Type)
        }
        return ARRAY(t!)
      }
      default => return null(Type)
    }
  }

  // True if a typeswitch case pattern matches the resolved scrutinee type.
  func typePatternMatches(self, pattern: Type, actual: Type) -> bool {
    if (pattern.type == Type.TypeClass.Typename &&
        actual.type == Type.TypeClass.Typename &&
        isnull(pattern.tyname.params)) {
      // An unparameterized type name (e.g. a class name) matches any
      // instantiation of that name.
      return pattern.tyname.name.name == actual.tyname.name.name
    }
    if pattern.type == Type.TypeClass.AnyInt && actual.type == Type.TypeClass.Int {
      return pattern.anyInt.isSigned == actual.int.isSigned
    }
    if pattern.type == Type.TypeClass.Int && actual.type == Type.TypeClass.AnyInt {
      return pattern.int.isSigned == actual.anyInt.isSigned
    }
    if pattern.type == Type.TypeClass.Tuple && actual.type == Type.TypeClass.Tuple {
      if pattern.tuple.elements.length() != actual.tuple.elements.length() {
        return false
      }
      for idx in range(pattern.tuple.elements.length()) {
        if !self.typePatternMatches(pattern.tuple.elements[idx],
                                    actual.tuple.elements[idx]) {
          return false
        }
      }
      return true
    }
    return pattern == actual
  }

  // Select the typeswitch case matching the resolved scrutinee type,
  // optionally typechecking the selected case's body.  Records and returns
  // the selected index; raises if no case matches.
  func selectTypeswitchCase(self, statement: db.Statement, typecheckBody: bool) -> u32 {
    rty = self.resolve(statement.expr.typedValue!)
    selected = 0xffffffffu32
    index = 0u32
    for caseStatement in statement.subBlock.statements() {
      if selected == 0xffffffffu32 {
        if caseStatement.type == db.StateType.Case {
          for typeExpr in caseStatement.expr.childExprs() {
            t = self.tryExplicitType(typeExpr)
            if !isnull(t) && self.typePatternMatches(t!, rty) {
              selected = index
            }
          }
        } else {
          // The default case matches anything.
          selected = index
        }
      }
      index += 1u32
    }
    if selected == 0xffffffffu32 {
      statement.location.error("No typeswitch case matches type " + rty.toString())
      raise Status.InvalidArgument, "No typeswitch case matches type ", rty.toString()
    }
    if typecheckBody {
      i = 0u32
      for caseStatement in statement.subBlock.statements() {
        if i == selected {
          for s in caseStatement.subBlock.statements() {
            self.statement(s, caseStatement.subBlock)
          }
        }
        i += 1u32
      }
      // Only cache the selection when typechecking a concrete scrutinee.
      // Codegen of polymorphic functions re-selects per instantiation.
      statement.selectedCaseIndex = selected
    }
    return selected
  }


  // ------------------------- Typechecking database structures ------------------------

  func symbol(self, symbol: Sym) -> Type? {
    sm = SymbolMapping(symbol, symbol.typedValue)
    found = self.findSymbolMapping(sm)
    if !isnull(found) {
      return found.value
    }
    return self.newSymbol(symbol, symbol.typedValue)
  }

  func getSymbolType(self, symbol: Sym) -> Type? {
    sm = SymbolMapping(symbol, null(Type))
    found = self.findSymbolMapping(sm)
    if !isnull(found) {
      return found.value
    }
    return null(Type)
  }

  func variable(self, v: db.Variable) -> Type? {
    // TODO: handle v.isConst
    if v.isParam && v.sym.name == "self" && !isnull(self.currentSelfType) {
      // The self parameter of a class method is the class instance type.
      ty = self.currentSelfType!
      self.newSymbol(v.sym, ty)
      v.typedValue = ty
      return ty
    }
    if isnull(v.typeExpr) {
      ty = Type(self.newTyvar())
    } else {
      ty = self.constraintType(v.typeExpr!)
    }
    if v.isParam {
      self.newSymbol(v.sym, ty)
    } else {
      ty = self.symbol(v.sym)
    }
    // Syms are interned by name, so sym.typedValue is clobbered when another
    // function has a same-named variable.  Codegen must use the type stored
    // on the Variable itself.
    v.typedValue = ty

    if db.getRoot().traceTypes {
       v.location.annotation("\n[Typecheck] ", TypeLoggingPrefix)
       println "%s%s" % (TypeLoggingPrefix, ty.toString())
    }
    return ty
  }

  func value(self, val: db.Value) -> Type? {
    switch val.type {
      db.DatatypeType.Bool => return BOOL
      db.DatatypeType.String => return STR
      db.DatatypeType.Int => {
        if val.widthUnspecified {
          // Unsuffixed literals adapt to any integer width; codegen
          // defaults unresolved AnyInt to 64 bits.
          return INTEGER()
        }
        return I(<u64>val.width)
      }
      db.DatatypeType.Uint => {
        if val.widthUnspecified {
          return UINTEGER()
        }
        return U(<u64>val.width)
      }
      db.DatatypeType.Float => return F(<u64>val.width)
      db.DatatypeType.Sym => return self.symbol(val.symVal!)
      default => raise Status.Unimplemented, "Value type not yet supported by typechecker: ", val.type
    }
  }

  // ---- typecheck expressions
  func expr(self, expr: db.Expr) -> Type? {
    result = null(Type)
    switch expr.type {
      db.ExprType.Constant => result = self.value(expr.val)
      db.ExprType.Ident => result = self.value(expr.val)

      db.ExprType.List, db.ExprType.Tuple => {
        elements = arrayof(Type)
        for child in expr.childExprs() {
          ty = self.expr(child)
          if isnull(ty) {
            return ty
          }
          elements.append(ty!)
        }
        result = Type(TupleType(elements))
      }

      // Binary expressions --------------------------------------------------
      db.ExprType.Add, db.ExprType.Div, db.ExprType.Mul, db.ExprType.Sub, db.ExprType.Bitxor, db.ExprType.AddTrunc, db.ExprType.MulTrunc, db.ExprType.SubTrunc, db.ExprType.Bitand, db.ExprType.Bitor, db.ExprType.Or, db.ExprType.Exp, db.ExprType.Mod, db.ExprType.And, db.ExprType.Or, db.ExprType.Xor, db.ExprType.Shl, db.ExprType.Shr, db.ExprType.Rotl, db.ExprType.Rotr, db.ExprType.Lt, db.ExprType.Le, db.ExprType.Gt, db.ExprType.Ge, db.ExprType.Equal, db.ExprType.Notequal, db.ExprType.Equals, db.ExprType.Equals, db.ExprType.AddEquals, db.ExprType.SubEquals, db.ExprType.MulEquals, db.ExprType.DivEquals, db.ExprType.ModEquals, db.ExprType.AndEquals, db.ExprType.OrEquals, db.ExprType.XorEquals, db.ExprType.BitandEquals, db.ExprType.BitorEquals, db.ExprType.BitxorEquals, db.ExprType.ExpEquals, db.ExprType.ShlEquals, db.ExprType.ShrEquals, db.ExprType.RotlEquals, db.ExprType.RotrEquals, db.ExprType.AddTruncEquals, db.ExprType.SubTruncEquals, db.ExprType.MulTruncEquals => {
        left = self.expr(expr.firstChildExpr!)
        right = self.expr(expr.firstChildExpr!.nextExprChildExpr!)
        if isnull(left) || isnull(right) {
          return left
        }
        bopty = self.operatorChoices(expr.type, builtinType(expr.type))!
        argty = Type(TupleType([left!, right!]))
        result = self.apply(bopty, argty, expr.location)
     }

      db.ExprType.Cast, db.ExprType.CastTrunc => {
        castTypeChild = expr.firstChildExpr!
        castValueChild = castTypeChild.nextExprChildExpr!
        self.expr(castValueChild)
        castTarget = null(Type)
        if castTypeChild.type == db.ExprType.Ident {
          // <x>v where x is a variable casts v to the type of x.
          castTarget = self.getSymbolType(castTypeChild.val.symVal!)
        }
        if isnull(castTarget) {
          castTarget = self.tryExplicitType(castTypeChild)
        }
        if isnull(castTarget) {
          self.typeError("Unsupported cast target type", expr.location)
          return null(Type)
        }
        castTypeChild.typedValue = castTarget
        result = castTarget
      }

      db.ExprType.In => {
        // 'in' has no builtin form; it requires a user-defined operator.
        left = self.expr(expr.firstChildExpr!)
        right = self.expr(expr.firstChildExpr!.nextExprChildExpr!)
        if isnull(left) || isnull(right) {
          return left
        }
        inopty = self.operatorChoices(expr.type, null(Type))
        if isnull(inopty) {
          self.typeError("No 'in' operator defined for these types", expr.location)
          return null(Type)
        }
        argty = Type(TupleType([left!, right!]))
        result = self.apply(inopty!, argty, expr.location)
      }

      db.ExprType.Select => {
        condChild = expr.firstChildExpr!
        trueChild = condChild.nextExprChildExpr!
        falseChild = trueChild.nextExprChildExpr!
        condTy = self.expr(condChild)
        trueTy = self.expr(trueChild)
        falseTy = self.expr(falseChild)
        if isnull(condTy) || isnull(trueTy) || isnull(falseTy) {
          return null(Type)
        }
        te = self.unify(condTy!, BOOL)
        if !isnull(te) {
          self.typeError(
            "Condition of ?: must be bool, not %s" % condTy.toString(), expr.location)
        }
        te = self.unify(trueTy!, falseTy!)
        if !isnull(te) {
          self.typeError(
            "Branches of ?: have different types %s and %s" %
                (trueTy.toString(), falseTy.toString()),
            expr.location)
        }
        result = trueTy
      }

      db.ExprType.Index => {
        leftChild = expr.firstChildExpr!
        rightChild = expr.firstChildExpr!.nextExprChildExpr!
        left = self.expr(leftChild)
        right = self.expr(rightChild)
        if isnull(left) || isnull(right) {
          return left
        }
        // Index must be an unsigned integer.
        te = self.unify(right!, UINTEGER())
        if !isnull(te) {
          self.typeError(
            "Index expression must be an unsigned integer, not %s." % right.toString(),
            expr.location)
        } else if leftChild.typedValue.type == Type.TypeClass.Array {
          // TODO: ARRAY INDEX STUFF HERE
          result = leftChild.typedValue.array.elementType
        } else if self.isStringType(leftChild.typedValue) {
          // Indexing a string yields a byte.
          result = U(8)
        } else if rightChild.type != db.ExprType.Constant {
          self.typeError(
           "Indexes must be unsigned integer literals, not %s." % rightChild.toString(),
           expr.location)
        } else {
          indexval = rightChild.val.intVal
          if indexval.width > 64u32 {
            raise Status.Unimplemented, "Index widths greater than 64 bits are not supported"
          }
          index = indexval.uint64()
          if left.type == Type.TypeClass.Typename {
             lst = self.structInstanceType(left!)
             if !isnull(lst) {
               left = lst
             } else {
               lty = self.lookupTyname(left.tyname.name)
               if isnull(lty) {
                 self.typeError(
                   "Cannot index into undefined typename %s." % left.toString(), expr.location)
               } else {
                 left = lty
               }
             }
          }
          if left.type != Type.TypeClass.Tuple && left.type != Type.TypeClass.Struct && left.type != Type.TypeClass.Array {
            self.typeError(
              "Cannot index into type %s." % left.toString(), expr.location)
          } else {
            result = left.index(index)
          }
        }
      }

      db.ExprType.Dot => {
        sty = self.expr(expr.firstChildExpr!)
        field = expr.firstChildExpr!.nextExprChildExpr!
        isClassAccess = false
        if sty.type == Type.TypeClass.Typename {
          info = self.lookupClass(sty.tyname.name)
          einfo = self.lookupEnum(sty.tyname.name)
          if !isnull(info) {
            // Member access on a class instance.
            isClassAccess = true
            result = self.classMemberType(info!, sty!, field, expr.location)
          } else if !isnull(einfo) {
            // Enum member access like Color.red.
            isClassAccess = true
            if einfo.hasMember(field.toString()) {
              result = U(32)
            } else {
              self.typeError("Enum %s has no member %s" % (einfo.sym.name, field.toString()),
                             expr.location)
              result = null(Type)
            }
          } else if sty.tyname.name.name == "string" {
            // Built-in string methods.
            isClassAccess = true
            result = self.stringMethodType(field.toString(), expr.location)
          } else if sty.tyname.name.name == "bool" {
            // Built-in bool methods.
            isClassAccess = true
            result = self.boolMethodType(field.toString(), expr.location)
          } else {
            st = self.structInstanceType(sty!)
            if !isnull(st) {
              sty = st!
            } else {
              ty = self.lookupTyname(sty.tyname.name)
              if isnull(ty) {
                self.typeError(
                  "Field Selection on an undefined type name %s" % sty.tyname.name.name,
                  expr.location)
                return null(Type)
              }
              sty = ty!
            }
          }
        }

        if isClassAccess {
          isClassAccess = true  // Result was computed by classMemberType above.
        } else if sty.type == Type.TypeClass.Struct {
          ty = sty.strct.select(field.toString())
          if isnull(ty) {
            self.typeError(
              "Field %s does not exist in struct %s" % (field.toString(), sty.toString()),
              expr.location)
          }
          result = ty
        } else if sty.type == Type.TypeClass.Array {
          // arrays have built-in methods 'append', 'length', 'values', 'items',
          // 'concat', 'reverse' etc.
          elementType = sty.array.elementType
          nullTypes = arrayof(Type)
          // Although the following methods technically take the array object
          // as first parameter, we ignore that. If we add the array type in these
          // types we shall need to update the code that typechecks the arguments
          // passed in.
          switch field.toString() {
            "append" => result = FN(elementType, NONETY())
            "length" => result = FN(TUPLE(nullTypes), U(64))
            "reverse" => result = FN(TUPLE(nullTypes), NONETY())
            "concat" => result = FN(ARRAY(elementType), NONETY())

            // The following two require support for iterators:
            // "values" => result = FN(TUPLE(nullTypes), ITERATOR(elementType))
            //"items" => result = FN(TUPLE(nullTypes), ITERATOR(TUPLE(U(64), elementType))

            default => {
              self.typeError(
                "Unsupported array method '%s'" % field.toString(), expr.location)
            }
          }

        } else if sty.type == Type.TypeClass.Int || sty.type == Type.TypeClass.AnyInt {
          // Built-in integer methods like toString().
          result = self.intMethodType(field.toString(), expr.location)
        } else {
          self.typeError(
            "Field Selection on %s, which is neither an array nor a struct" % sty.toString(),
            expr.location)
        }
      }

      // Unary expressions ----------------------------------------------------------
      db.ExprType.Arrayof => {
         elementType = self.explicitType(expr.firstChildExpr!)!
         expr.firstChildExpr.typedValue = elementType
         result = ARRAY(self.resolve(elementType!))
      }

      db.ExprType.Array => {
        ty = Type(self.newTyvar())
        for child in expr.childExprs() {
          childType = self.expr(child)
          if isnull(childType) {
            return childType
          }
          te = self.unify(ty!, childType!)
          if !isnull(te) {
            self.typeError(
              "Array Elements do not have the same type: %s and %s." % (
                  ty.toString(), childType.toString()),
              expr.location)
          }
        }
        result = ARRAY(self.resolve(ty!))
      }

      db.ExprType.Negate, db.ExprType.NegateTrunc, db.ExprType.Bitnot, db.ExprType.Not => {
        childType = self.expr(expr.firstChildExpr!)
        if isnull(childType) {
          return childType
        }
        opty = builtinType(expr.type)
        result = self.apply(opty, childType!, expr.location)
      }

      db.ExprType.Call => {
        fnchild = expr.firstChildExpr!
        if fnchild.type == db.ExprType.Ident {
          callee = self.lookupFunctionDef(fnchild.val.symVal!)
          if !isnull(callee) {
            self.normalizeCallArgs(expr, callee!)
          }
        }
        fnchild = expr.firstChildExpr!
        argchild = fnchild.nextExprChildExpr
        fn = self.expr(fnchild)
        args = self.expr(argchild!)
        if isnull(fn) || isnull(args) {
          return fn
        }
        result = self.apply(fn!, args!, expr.location)
      }

      default => raise Status.Unimplemented, "Expression type not yet supported by typechecker: ", db.getExprTypeName(expr.type)
    }

    if db.getRoot().traceTypes {
       expr.location.annotation("\n[Typecheck] ", TypeLoggingPrefix)
       if isnull(result) {
         println "%sType Error!" % TypeLoggingPrefix
         // Dump latest type errors as we go. These won't repeat errors already
         // reported. We've already printed the line and caret marks, so don't print them again
         self.dumpTypeErrors(false, TypeLoggingPrefix)
       } else {
         println "%s%s" % (TypeLoggingPrefix, result.toString())
       }
    }
    if !isnull(result) {
      result = self.resolve(result!)
    }
    expr.typedValue = result
    return result
  }


  // Rewrite a call's arguments into full positional form, in the HIR, so
  // both typechecking and code generation see a plain argument tuple:
  // named arguments move to their parameter's position and omitted
  // parameters take a copy of their default initializer.
  func normalizeCallArgs(self, expr: db.Expr, fn: db.Function) {
    fnchild = expr.firstChildExpr!
    argchild = fnchild.nextExprChildExpr!
    // The parameters, in order.
    params = arrayof(db.Variable)
    for variable in fn.variables() {
      if variable.isParam && variable.sym.name != "self" {
        params.append(variable)
      }
    }
    // The given arguments.
    positional = arrayof(db.Expr)
    namedNames = arrayof(string)
    namedValues = arrayof(db.Expr)
    if argchild.type == db.ExprType.Tuple {
      for child in argchild.childExprs() {
        if child.type == db.ExprType.Namedparam {
          namedNames.append(child.firstChildExpr.val.symVal.name)
          namedValues.append(child.firstChildExpr.nextExprChildExpr!)
        } else {
          positional.append(child)
        }
      }
    } else if argchild.type == db.ExprType.Namedparam {
      namedNames.append(argchild.firstChildExpr.val.symVal.name)
      namedValues.append(argchild.firstChildExpr.nextExprChildExpr!)
    } else {
      positional.append(argchild)
    }
    if namedNames.length() == 0 && positional.length() == params.length() {
      // Already plain positional and complete.
      return
    }
    // Pick each parameter's argument: positional from the left, then named,
    // then the parameter's default value.
    selected = arrayof(db.Expr)
    for index in range(params.length()) {
      if index < positional.length() {
        selected.append(positional[index])
      } else {
        found = null(db.Expr)
        for n in range(namedNames.length()) {
          if namedNames[n] == params[index].sym.name {
            found = namedValues[n]
          }
        }
        if isnull(found) {
          init = params[index].initializerExpr
          if isnull(init) {
            // Missing argument with no default; leave the call unchanged
            // and let unification report the error.
            return
          }
          found = init.copy()
        }
        selected.append(found!)
      }
    }
    // Detach the old argument expressions and rebuild as a plain tuple.
    // Only the argument container and Namedparam wrappers are unlinked;
    // the argument expressions themselves keep their children.
    expr.removeChildExpr(argchild)
    if argchild.type == db.ExprType.Tuple {
      while !isnull(argchild.firstChildExpr) {
        detach = argchild.firstChildExpr!
        argchild.removeChildExpr(detach)
        if detach.type == db.ExprType.Namedparam {
          value = detach.firstChildExpr.nextExprChildExpr!
          detach.removeChildExpr(value)
        }
      }
    } else if argchild.type == db.ExprType.Namedparam {
      value = argchild.firstChildExpr.nextExprChildExpr!
      argchild.removeChildExpr(value)
    }
    newArgs = db.Expr(db.ExprType.Tuple, argchild.location)
    for s in selected {
      newArgs.appendChildExpr(s)
    }
    expr.appendChildExpr(newArgs)
  }

  // Iterator inlining --------------------------------------------------------
  //
  // A foreach statement over a user-defined iterator is rewritten in place
  // into an InlinedBlock statement holding:
  //   <param> = <argument or default>    (one per iterator parameter)
  //   <iterator body>                    (variables renamed to be unique)
  // where each "yield e" becomes an assignment of e to the loop variable
  // followed by a copy of the foreach body.  Typeswitches in the iterator
  // body keep only the arm selected for the (concrete) argument types, which
  // is how e.g. range(first, second = false) dispatches on argument count.

  // The iterator function a foreach statement iterates, or null: a call to
  // an iterator function or method, or a class instance, which iterates via
  // its values() iterator.
  func findForeachIterator(self, iterExpr: db.Expr) -> db.Function? {
    if iterExpr.type == db.ExprType.Call {
      target = iterExpr.firstChildExpr!
      if target.type == db.ExprType.Ident {
        fn = self.lookupFunctionDef(target.val.symVal!)
        if !isnull(fn) && fn.type == db.FuncType.Iterator {
          return fn
        }
        return null(db.Function)
      }
      if target.type == db.ExprType.Dot {
        methodExpr = target.firstChildExpr!.nextExprChildExpr!
        if methodExpr.type != db.ExprType.Ident {
          return null(db.Function)
        }
        return self.findClassIterator(target.firstChildExpr!, methodExpr.val.symVal.name)
      }
      return null(db.Function)
    }
    return self.findClassIterator(iterExpr, "values")
  }

  // Find an iterator method of the class that |baseExpr| is an instance of.
  func findClassIterator(self, baseExpr: db.Expr, methodName: string) -> db.Function? {
    baseTy = self.expr(baseExpr)
    if isnull(baseTy) {
      return null(db.Function)
    }
    rbase = self.resolve(baseTy!)
    if rbase.type != Type.TypeClass.Typename {
      return null(db.Function)
    }
    info = self.lookupClass(rbase.tyname.name)
    if isnull(info) {
      return null(db.Function)
    }
    for childfunc in info.fn.childFunctions() {
      if childfunc.type == db.FuncType.Iterator && childfunc.sym.name == methodName {
        return childfunc
      }
    }
    return null(db.Function)
  }

  func renamedSym(self, name: string) -> Sym? {
    for idx in range(self.renameOld.length()) {
      if self.renameOld[idx] == name {
        return self.renameNew[idx]
      }
    }
    return null(Sym)
  }

  func addRename(self, name: string) {
    if !isnull(self.renamedSym(name)) {
      return
    }
    self.renameOld.append(name)
    self.renameNew.append(Sym.new(self.renamePrefix + name))
  }

  // Record every variable assigned in the iterator body so it can be renamed.
  func collectIteratorLocals(self, block: db.Block) {
    for s in block.statements() {
      if !isnull(s.expr) {
        self.collectAssignedNamesInExpr(s.expr!)
      }
      if s.type == db.StateType.Foreach {
        nestedLoopVar = s.expr.firstChildExpr!
        if nestedLoopVar.type == db.ExprType.Ident {
          self.addRename(nestedLoopVar.val.symVal.name)
        }
      }
      if !isnull(s.subBlock) {
        self.collectIteratorLocals(s.subBlock!)
      }
    }
  }

  func collectAssignedNamesInExpr(self, expr: db.Expr) {
    if expr.type == db.ExprType.Equals {
      lhs = expr.firstChildExpr!
      if lhs.type == db.ExprType.Ident {
        self.addRename(lhs.val.symVal.name)
      }
    }
    for child in expr.childExprs() {
      self.collectAssignedNamesInExpr(child)
    }
  }

  func renameStatementIdents(self, statement: db.Statement) {
    if !isnull(statement.expr) {
      self.renameExprIdents(statement.expr!)
    }
    if !isnull(statement.subBlock) {
      for s in statement.subBlock.statements() {
        self.renameStatementIdents(s)
      }
    }
  }

  func renameExprIdents(self, expr: db.Expr) {
    if expr.type == db.ExprType.Ident {
      identName = expr.val.symVal.name
      newSym = self.renamedSym(identName)
      if !isnull(newSym) {
        expr.val = db.Value(newSym!)
      }
      return
    }
    if expr.type == db.ExprType.Dot {
      // Only the base is a variable; the member name is not renamed.
      self.renameExprIdents(expr.firstChildExpr!)
      return
    }
    isFirst = true
    for child in expr.childExprs() {
      // The first child of a named parameter is the parameter name.
      if !isFirst || expr.type != db.ExprType.Namedparam {
        self.renameExprIdents(child)
      }
      isFirst = false
    }
  }

  func appendAssignStatement(self, block: db.Block, sym: Sym, value: db.Expr,
                             location: db.Location) {
    s = db.Statement(block, db.StateType.Assign, location)
    assign = db.Expr.newBinary(db.ExprType.Equals,
                               db.Expr.newIdent(sym, location), value, location)
    s.insertExpr(assign)
  }

  // Replace each yield in |block| with an assignment of the yield value to
  // the foreach loop variable, followed by a copy of the foreach body.
  func convertYields(self, block: db.Block, loopVarExpr: db.Expr, body: db.Block) {
    for s in block.statements() {
      if s.type == db.StateType.Yield {
        yieldValue = s.expr!
        s.removeExpr(yieldValue)
        assign = db.Expr.newBinary(db.ExprType.Equals, loopVarExpr.copy(),
                                   yieldValue, s.location)
        s.insertExpr(assign)
        s.type = db.StateType.Assign
        body.copyStatementsAfterStatement(s)
      } else if !isnull(s.subBlock) {
        self.convertYields(s.subBlock!, loopVarExpr, body)
      }
    }
  }

  // Inline |iterFn| into the foreach |statement|, rewriting it in place into
  // an InlinedBlock, then typecheck the result.
  func inlineIterator(self, statement: db.Statement, iterFn: db.Function) {
    loopVarExpr = statement.expr.firstChildExpr!
    iterExpr = loopVarExpr.nextExprChildExpr!
    location = statement.location
    self.iteratorInlineCounter += 1u32
    self.renamePrefix = "_itr%u_" % self.iteratorInlineCounter
    emptyOld = arrayof(string)
    emptyNew = arrayof(Sym)
    self.renameOld = emptyOld
    self.renameNew = emptyNew
    for variable in iterFn.variables() {
      if variable.isParam {
        self.addRename(variable.sym.name)
      }
    }
    self.collectIteratorLocals(iterFn.subBlock!)

    // Gather the positional call arguments and the method-call base.
    selfExpr = null(db.Expr)
    args = arrayof(db.Expr)
    if iterExpr.type == db.ExprType.Call {
      target = iterExpr.firstChildExpr!
      if target.type == db.ExprType.Dot {
        selfExpr = target.firstChildExpr
      }
      argchild = target.nextExprChildExpr
      if !isnull(argchild) {
        if argchild.type == db.ExprType.Tuple || argchild.type == db.ExprType.List {
          for a in argchild.childExprs() {
            args.append(a)
          }
        } else {
          args.append(argchild!)
        }
      }
    } else {
      // Iterating a class instance: the instance is the iterator's self.
      selfExpr = iterExpr
    }

    // Assign arguments (or parameter defaults) to the renamed parameters.
    newBlock = db.Block(location)
    argIndex = 0u64
    for variable in iterFn.variables() {
      if variable.isParam {
        paramSym = self.renamedSym(variable.sym.name)!
        if variable.sym.name == "self" {
          if !isnull(selfExpr) {
            self.appendAssignStatement(newBlock, paramSym, selfExpr.copy(), location)
          }
        } else {
          value = null(db.Expr)
          if argIndex < args.length() {
            value = args[argIndex].copy()
          } else {
            init = variable.initializerExpr
            if !isnull(init) {
              value = init.copy()
            }
          }
          if isnull(value) {
            self.typeError("Missing argument %s in call to iterator %s" %
                           (variable.sym.name, iterFn.sym.name), location)
            return
          }
          self.appendAssignStatement(newBlock, paramSym, value!, location)
          argIndex += 1u64
        }
      }
    }

    // Copy the iterator body with renamed variables.
    for s in iterFn.subBlock.statements() {
      copied = s.appendCopy(newBlock)
      self.renameStatementIdents(copied)
    }

    // Convert yields, splicing in copies of the foreach body.
    body = statement.subBlock!
    statement.removeSubBlock(body)
    self.convertYields(newBlock, loopVarExpr, body)
    body.destroy()
    statement.insertSubBlock(newBlock)
    statement.type = db.StateType.InlinedBlock

    for s in newBlock.statements() {
      self.statement(s, newBlock)
    }
  }

  // Statements -------------------------------------------------------------
  func statement(self, statement: db.Statement, parent: db.Block) {
    switch statement.type {
      db.StateType.Assign => self.expr(statement.expr)
      db.StateType.Call => self.expr(statement.expr)
      db.StateType.Print => self.expr(statement.expr)
      db.StateType.Println => self.expr(statement.expr)
      db.StateType.Raise => {
        // The first expression is the error code path (e.g. Status.Foo),
        // not a value; the rest are message values.
        rchild = statement.expr.firstChildExpr
        rfirst = true
        while !isnull(rchild) {
          if !rfirst {
            self.expr(rchild!)
          }
          rfirst = false
          rchild = rchild.nextExprChildExpr
        }
      }
      db.StateType.If => {
        ty = self.expr(statement.expr)
        te = isnull(ty) ? null(TypeError) : self.unify(ty!, BOOL)
        if !isnull(te) {
          self.typeError("Condition expression must be a boolean", statement.expr.location)
        }
        assert !isnull(statement.subBlock)
        for s in statement.subBlock.statements() {
          self.statement(s, statement.subBlock)
        }
        parent.returnType = statement.subBlock.returnType
      }
      db.StateType.Else => {
        assert !isnull(statement.subBlock)
        for s in statement.subBlock.statements() {
          self.statement(s, statement.subBlock)
        }
        parent.returnType = statement.subBlock.returnType
      }
      db.StateType.ElseIf => {
        assert !isnull(statement.expr)
        ty = self.expr(statement.expr)
        te = isnull(ty) ? null(TypeError) : self.unify(ty!, BOOL)
        if !isnull(te) {
          self.typeError("Condition expression must be a boolean", statement.expr.location)
        }
        assert !isnull(statement.subBlock)
        for s in statement.subBlock.statements() {
          self.statement(s, statement.subBlock)
        }
        parent.returnType = statement.subBlock.returnType
      }
      db.StateType.For => {
        // Right now, only handles for expressions of the form
        // for <assignment>, <condition>, <increment> {
        //  ...
        // }
        i = 0
        for child in statement.expr.childExprs() {
           ty = self.expr(child)
           if i == 1 && !isnull(ty) {
             te = self.unify(ty!, BOOL)
             if !isnull(te) {
               self.typeError("Condition expression must be a boolean", child.location)
             }
           }
           i += 1
        }
        assert !isnull(statement.subBlock)
        for s in statement.subBlock.statements() {
          self.statement(s, statement.subBlock)
        }
      }
      db.StateType.Return => {
        ty = self.expr(statement.expr)
        parent.returnType = ty
      }
      db.StateType.While => {
        ty = self.expr(statement.expr)
        te = isnull(ty) ? null(TypeError) : self.unify(ty!, BOOL)
        if !isnull(te) {
          self.typeError("Condition expression must be a boolean", statement.expr.location)
        }
        // The sub-block is null when this terminates a do-while statement.
        if !isnull(statement.subBlock) {
          for s in statement.subBlock.statements() {
            self.statement(s, statement.subBlock)
          }
          parent.returnType = statement.subBlock.returnType
        }
      }
      db.StateType.Do => {
        assert !isnull(statement.subBlock)
        for s in statement.subBlock.statements() {
          self.statement(s, statement.subBlock)
        }
        parent.returnType = statement.subBlock.returnType
      }
      db.StateType.Typeswitch => {
        scrutTy = self.expr(statement.expr)
        assert !isnull(statement.subBlock)
        if !isnull(scrutTy) {
          rty = self.resolve(scrutTy!)
          // A typeswitch whose case patterns are value expressions (e.g.
          // enum members) is really a value switch.
          isValueSwitch = false
          for caseStatement in statement.subBlock.statements() {
            if caseStatement.type == db.StateType.Case {
              firstPattern = caseStatement.expr.firstChildExpr
              if !isnull(firstPattern) {
                if (firstPattern.type == db.ExprType.Dot ||
                    firstPattern.type == db.ExprType.Constant) {
                  isValueSwitch = true
                }
              }
            }
          }
          if isValueSwitch {
            statement.type = db.StateType.Switch
            self.statement(statement, parent)
          } else if rty.type == Type.TypeClass.Var {
            // Polymorphic scrutinee: typecheck every arm with the scrutinee
            // variable temporarily bound to that arm's pattern type.  The
            // case itself is selected at codegen time, per instantiation.
            for caseStatement in statement.subBlock.statements() {
              bound = false
              if caseStatement.type == db.StateType.Case {
                firstPattern = caseStatement.expr.firstChildExpr
                t = self.tryExplicitType(firstPattern!)
                if !isnull(t) {
                  self.unifier.bindVar(rty.tyvar!, t!)
                  bound = true
                }
              }
              for s in caseStatement.subBlock.statements() {
                self.statement(s, caseStatement.subBlock)
              }
              if !isnull(caseStatement.subBlock.returnType) {
                parent.returnType = caseStatement.subBlock.returnType
              }
              if bound {
                self.unifier.unbindVar(rty.tyvar!)
              }
            }
          } else {
            self.selectTypeswitchCase(statement, true)
            tsIndex = 0u32
            for caseStatement in statement.subBlock.statements() {
              if (tsIndex == statement.selectedCaseIndex &&
                  !isnull(caseStatement.subBlock.returnType)) {
                parent.returnType = caseStatement.subBlock.returnType
              }
              tsIndex += 1u32
            }
          }
        }
      }
      db.StateType.Switch => {
        // The sub-block holds Case statements (expr = list of match values)
        // and an optional Default statement.  Every match value must unify
        // with the type of the switch expression.
        scrutTy = self.expr(statement.expr)
        assert !isnull(statement.subBlock)
        for caseStatement in statement.subBlock.statements() {
          if caseStatement.type == db.StateType.Case {
            for valExpr in caseStatement.expr.childExprs() {
              vty = self.expr(valExpr)
              te = self.unify(vty!, scrutTy!)
              if !isnull(te) {
                self.typeError("Case value must match the switch expression type",
                               valExpr.location)
              }
            }
          }
          assert !isnull(caseStatement.subBlock)
          for s in caseStatement.subBlock.statements() {
            self.statement(s, caseStatement.subBlock)
          }
          if !isnull(caseStatement.subBlock.returnType) {
            parent.returnType = caseStatement.subBlock.returnType
          }
        }
      }
      db.StateType.Assert => {
        // The expression is a list; the first element is the condition and
        // any further elements are message values to print on failure.
        first = true
        for child in statement.expr.childExprs() {
          ty = self.expr(child)
          if first && !isnull(ty) {
            te = self.unify(ty!, BOOL)
            if !isnull(te) {
              self.typeError("Assert condition must be a boolean", child.location)
            }
          }
          first = false
        }
      }
      db.StateType.Foreach => {
        // The expression is a list: (loop variable, iterable expression).
        // Supported iterables: range(n), range(a, b), arrays, and the
        // array methods values() and items().
        loopVarExpr = statement.expr.firstChildExpr!
        iterExpr = loopVarExpr.nextExprChildExpr!
        // A call to a user-defined iterator (or a class instance, which
        // iterates via its values() iterator) is inlined in place.
        iterFn = self.findForeachIterator(iterExpr)
        if !isnull(iterFn) {
          self.inlineIterator(statement, iterFn!)
          return NONETY()
        }
        elemTy = null(Type)
        if iterExpr.type == db.ExprType.Call {
          target = iterExpr.firstChildExpr!
          argExpr = target.nextExprChildExpr
          if target.type == db.ExprType.Ident && target.val.symVal.name == "range" {
            argTy = self.expr(argExpr!)
            rty = self.resolve(argTy!)
            if rty.type == Type.TypeClass.Tuple {
              // range(start, end): the bounds must have the same type.
              firstBound = rty.tuple.elements[0]
              for el in rty.tuple.elements {
                te = self.unify(firstBound, el)
                if !isnull(te) {
                  self.typeError("range bounds must have the same type", iterExpr.location)
                }
              }
              elemTy = firstBound
            } else {
              elemTy = rty
            }
            iterExpr.typedValue = elemTy
          } else if target.type == db.ExprType.Dot {
            base = target.firstChildExpr!
            methodName = base.nextExprChildExpr.toString()
            if methodName == "values" || methodName == "items" {
              baseTy = self.expr(base)
              rbase = self.resolve(baseTy!)
              baseElemTy = null(Type)
              if rbase.type == Type.TypeClass.Array {
                baseElemTy = rbase.array.elementType
              } else if self.isStringType(rbase) {
                // Iterating a string yields bytes.
                baseElemTy = U(8)
              }
              if !isnull(baseElemTy) {
                if methodName == "values" {
                  elemTy = baseElemTy
                } else {
                  pairTypes = arrayof(Type)
                  pairTypes.append(U(64))
                  pairTypes.append(baseElemTy!)
                  elemTy = TUPLE(pairTypes)
                }
                iterExpr.typedValue = elemTy
              }
            }
          }
        }
        if isnull(elemTy) {
          ty = self.expr(iterExpr)
          rty = self.resolve(ty!)
          if rty.type == Type.TypeClass.Array {
            elemTy = rty.array.elementType
          } else if self.isStringType(rty) {
            elemTy = U(8)
          } else {
            self.typeError("Cannot iterate over %s" % rty.toString(), iterExpr.location)
            elemTy = Type(self.newTyvar())
          }
        }
        self.newSymbol(loopVarExpr.val.symVal!, elemTy)
        loopVarExpr.typedValue = elemTy
        if !isnull(statement.subBlock) {
          for s in statement.subBlock.statements() {
            self.statement(s, statement.subBlock)
          }
        }
      }
      db.StateType.InlinedBlock => {
        // Statements spliced in by iterator inlining; typecheck like a block.
        for s in statement.subBlock.statements() {
          self.statement(s, statement.subBlock!)
        }
      }
      default => raise Status.Unimplemented, "Statement type not yet supported by typechecker: ", db.statementTypeGetKeyword(statement.type)
    }
    return NONETY()
  }

  // Typecheck Functions, including modules ---------------------------------
  func function(self, fn: db.Function) {
    switch fn.type {
      db.FuncType.Module => {
        // Register all functions first so call sites can look up parameter
        // names and defaults regardless of definition order.
        for childfunc in fn.childFunctions() {
          self.registerFunctionDef(childfunc)
        }
        for childfunc in fn.childFunctions() {
          self.function(childfunc)
        }
        for statement in fn.subBlock.statements() {
          self.statement(statement, fn.subBlock)
        }
      }

      db.FuncType.Plain => self.plainFunction(fn)
      db.FuncType.Operator => {
        // Overloaded operators typecheck like plain functions, plus an
        // entry in the operator registry consulted at operator expressions.
        self.plainFunction(fn)
        self.operatorFns.append(fn)
        self.operatorTypes.append(fn.typedValue!)
      }
      db.FuncType.Struct => self.structFunction(fn)
      db.FuncType.Constructor => self.constructorFunction(fn)
      db.FuncType.Enum => self.enumFunction(fn)
      // Iterators are not typechecked standalone; their bodies are inlined
      // into each foreach statement that calls them and typechecked there.
      db.FuncType.Iterator => return
      // Destructors are typechecked like methods.  The C backend does not
      // yet emit or call them (that needs reference counting).
      db.FuncType.Final => self.plainFunction(fn)
      default => {
        raise Status.Unimplemented, "Function type not yet supported by typechecker: ", fn.type
      }
    }
  }

  // Typecheck a class constructor.  The class's data members are discovered
  // from assignments of the form self.<field> = <expr> in the constructor
  // body.  Methods are the constructor's child functions; their self
  // parameter is bound to the class instance type.
  func constructorFunction(self, fn: db.Function) {
    self.openScope()
    info = ClassInfo(fn.sym)
    info.fn = fn
    // Note: empty arrays must be bound to locals first; passing arrayof(T)
    // directly as a constructor argument crashes the C-based rune compiler.
    emptyFieldnames = arrayof(Sym)
    emptyFieldtypes = arrayof(Type)
    info.strct = StructType(emptyFieldnames, emptyFieldtypes)
    self.insertClassInfo(info)

    params = arrayof(Type)
    for variable in fn.variables() {
      if variable.sym.name != "self" {
        ty = self.variable(variable)!
        params.append(ty)
        info.paramVars.append(ty)
      }
    }
    if params.length() == 1 {
      paramType = params[0]
    } else {
      paramType = Type(TupleType(params))
    }

    // The class instance type, e.g. Point(v1, v2).
    selfType = Type(TypeName(fn.sym, TupleType(info.paramVars)))
    info.selfType = selfType
    self.newTyname(fn.sym, Type(info.strct!))
    self.newSymbol(Sym.new("self"), selfType)

    prevClassInfo = self.currentClassInfo
    prevSelfType = self.currentSelfType
    prevClassBoundVars = self.classBoundVars
    self.currentClassInfo = info
    self.currentSelfType = selfType
    self.classBoundVars = info.paramVars

    // Typecheck the constructor body; this discovers the data members.
    for statement in fn.subBlock.statements() {
      self.statement(statement, fn.subBlock)
    }

    // Typecheck the methods with self bound to this class.
    for childfunc in fn.childFunctions() {
      self.function(childfunc)
    }

    self.currentClassInfo = prevClassInfo
    self.currentSelfType = prevSelfType
    self.classBoundVars = prevClassBoundVars

    bindingScope = self.closeScope()
    paramType = self.resolve(paramType)
    boundVars = arrayof(Type)
    for sm in bindingScope.symbolMappings() {
      if !isnull(sm.value) && sm.value.type == Type.TypeClass.Var {
        ty = self.resolve(sm.value!)
        if ty.type == Type.TypeClass.Var {
          exists = false
          for bv in boundVars {
            if bv.tyvar.id == ty.tyvar.id {
              exists = true
            }
          }
          if !exists {
            boundVars.append(Type(ty.tyvar!))
          }
        }
      }
    }

    resType = self.resolve(selfType)
    fnType = Type(FunctionType(paramType, resType))
    if boundVars.length() > 0 {
      fnType = Type(PolymorphicType(boundVars, fnType))
    }
    self.newSymbol(fn.sym, fnType)
    fn.typedValue = fnType
  }

  // Typecheck an enum declaration: record the members and their values, and
  // bind the enum's name so that Color.red style accesses resolve.
  func enumFunction(self, fn: db.Function) {
    info = EnumInfo(fn.sym)
    nextValue = 0u32
    for variable in fn.variables() {
      value = nextValue
      init = variable.initializerExpr
      if !isnull(init) && init.type == db.ExprType.Constant {
        value = <u32>init.val.intVal.uint64()
      }
      info.memberNames.append(variable.sym)
      info.memberValues.append(value)
      nextValue = value + 1u32
    }
    self.insertEnumInfo(info)
    self.newSymbol(fn.sym, Type(TypeName(fn.sym)))
  }

  // Typecheck a member access on a class instance: either a data member or
  // a method.  Inside the class's own constructor, unknown members are
  // created as new data members.
  func classMemberType(self, info: ClassInfo, instanceType: Type, field: db.Expr,
                       location: db.Location?) -> Type? {
    name = field.toString()
    method = self.findMethod(info, name)
    if !isnull(method) {
      return self.methodCallType(info, instanceType, method!, location)
    }
    inOwnConstructor = !isnull(self.currentClassInfo) && self.currentClassInfo.sym == info.sym
    ty = info.strct.select(name)
    if !isnull(ty) {
      if inOwnConstructor {
        return ty
      }
      return self.substituteClassVars(info, instanceType, ty!)
    }
    if inOwnConstructor {
      // First assignment to self.<name> creates the data member.
      fresh = Type(self.newTyvar())
      info.strct.fieldnames.append(Sym.new(name))
      info.strct.fieldtypes.append(fresh)
      return fresh
    }
    self.typeError("Class %s has no member %s" % (info.sym.name, name), location)
    return null(Type)
  }

  // Find a method (child function) of a class by name.
  func findMethod(self, info: ClassInfo, name: string) -> db.Function? {
    for childfunc in info.fn.childFunctions() {
      if childfunc.sym.name == name && childfunc.type == db.FuncType.Plain {
        return childfunc
      }
    }
    return null(db.Function)
  }

  // Compute the type of a method accessed through an instance: the method's
  // function type with the self parameter removed (it is passed implicitly).
  func methodCallType(self, info: ClassInfo, instanceType: Type, method: db.Function,
                      location: db.Location?) -> Type? {
    mty = method.sym.typedValue
    if isnull(mty) {
      self.typeError("Method %s of class %s has no type" % (method.sym.name, info.sym.name),
                     location)
      return null(Type)
    }
    ty = mty!
    if ty.type == Type.TypeClass.Polymorphic {
      ty = ty.poly!.open(self.unifier, &self.unifier.newVar())
    }
    if ty.type != Type.TypeClass.Function {
      self.typeError("Method %s of class %s is not a function" % (method.sym.name, info.sym.name),
                     location)
      return null(Type)
    }
    params = ty.function.params
    result = ty.function.result
    if params.type == Type.TypeClass.Tuple && params.tuple.elements.length() > 0 {
      selfParam = params.tuple.elements[0]
      rest = arrayof(Type)
      for i in range(params.tuple.elements.length()) {
        if i > 0 {
          rest.append(params.tuple.elements[i])
        }
      }
      if rest.length() == 1 {
        restType = rest[0]
      } else {
        restType = Type(TupleType(rest))
      }
    } else {
      // Single parameter: just self.
      selfParam = params
      noParams = arrayof(Type)
      restType = Type(TupleType(noParams))
    }
    te = self.unify(selfParam, instanceType)
    if !isnull(te) {
      self.typeError("Cannot call method %s on %s: %s"
                     % (method.sym.name, instanceType.toString(), te.msg), location)
      return null(Type)
    }
    return Type(FunctionType(restType, result))
  }

  // Substitute the class's type parameters with the instance's type
  // arguments inside a member type, without binding the class's type
  // variables globally.
  func substituteClassVars(self, info: ClassInfo, instanceType: Type, memberType: Type) -> Type {
    if instanceType.type != Type.TypeClass.Typename || isnull(instanceType.tyname.params) {
      return memberType
    }
    instParams = instanceType.tyname.params!
    // Resolve first so the member type and paramVars both use the chain
    // representatives; replaceVar matches on exact variable ids.
    result = self.resolve(memberType)
    for i in range(info.paramVars.length()) {
      pv = self.resolve(info.paramVars[i])
      if pv.type == Type.TypeClass.Var && i < instParams.elements.length() {
        fresh = self.newTyvar()
        result = result.replaceVar(pv.tyvar!, fresh)
        te = self.unify(Type(fresh), instParams.elements[i])
      }
    }
    return self.resolve(result)
  }

  // If ty is a Typename whose definition is a (possibly polymorphic)
  // struct, return the struct type with this instance's type arguments
  // substituted for the struct's type parameters.
  func structInstanceType(self, ty: Type) -> Type? {
    if ty.type != Type.TypeClass.Typename {
      return null(Type)
    }
    def = self.lookupTyname(ty.tyname.name)
    if isnull(def) {
      return null(Type)
    }
    if def.type == Type.TypeClass.Struct {
      return def
    }
    if (def.type != Type.TypeClass.Polymorphic ||
        def.poly.scope.type != Type.TypeClass.Struct) {
      return null(Type)
    }
    result = def.poly.scope
    if isnull(ty.tyname.params) {
      return result
    }
    instParams = ty.tyname.params!
    for i in range(def.poly.boundVars.length()) {
      bv = def.poly.boundVars[i]
      if i < instParams.elements.length() {
        fresh = self.newTyvar()
        result = result.replaceVar(bv.tyvar!, fresh)
        te = self.unify(Type(fresh), instParams.elements[i])
      }
    }
    return self.resolve(result!)
  }

  func structFunction(self, fn: db.Function) {
    self.openScope()
    params = arrayof(Type)
    fieldnames = arrayof(Sym)
    fieldtypes = arrayof(Type)
    for variable in fn.variables() {
        ty = self.variable(variable)!
        params.append(ty)
        fieldnames.append(variable.sym)
        fieldtypes.append(ty)
    }

    if params.length() == 1 {
      paramType = params[0]
    } else {
      paramType = Type(TupleType(params))
    }

    bindingScope = self.closeScope()
    paramType = self.resolve(paramType)
    boundVars = arrayof(Type)
    for sm in bindingScope.symbolMappings() {
      if !isnull(sm.value) && sm.value.type == Type.TypeClass.Var {
        // Has this type variable been instantiated?
        ty = self.resolve(sm.value!)
        if ty.type == Type.TypeClass.Var {
          boundVars.append(Type(ty.tyvar!))
        }
      }
    }

    tynameDef = Type(StructType(fieldnames, fieldtypes))
    if boundVars.length() > 0 {
      resType = Type(TypeName(fn.sym, TupleType(boundVars)))
      fnType = Type(FunctionType(paramType, resType))
      fnType = Type(PolymorphicType(boundVars, fnType))
      tynameDef = Type(PolymorphicType(boundVars, tynameDef))
    } else {
      fnType = Type(FunctionType(paramType, Type(TypeName(fn.sym))))
    }

    // associate function name symbol to this type.
    self.newSymbol(fn.sym, fnType)
    fn.typedValue = fnType
    self.newTyname(fn.sym, tynameDef)
  }

  func plainFunction(self, fn: db.Function) {
    // Todo: consider storage types
    if isnull(fn.typeExpr) {
      returnType = Type(self.newTyvar())
    } else {
      returnType = self.explicitType(fn.typeExpr)
    }

    // open new scope - new parameter bindings are added to the scope
    // automatically
    self.openScope()
    params = arrayof(Type)
    for variable in fn.variables() {
      param = self.variable(variable)!
      params.append(param)
    }
    if params.length() == 1 {
      paramType = params[0]
    } else {
      paramType = Type(TupleType(params))
    }
    bindingScope = self.closeScope()

    // must walk through all return statements.
    returnType = null(Type)
    for statement in fn.subBlock.statements() {
      self.statement(statement, fn.subBlock)
      if !isnull(fn.subBlock.returnType) {
        if isnull(returnType) {
          returnType = fn.subBlock.returnType
        } else {
          te = self.unify(returnType!, fn.subBlock.returnType!)
          if !isnull(te) {
            self.typeError(
               ("Conflicting return types\n%s    %s\n%s    and %s\n%s%s"
                 % (TypeLoggingPrefix, returnType.toString(),
                    TypeLoggingPrefix, fn.subBlock.returnType.toString(),
                    TypeLoggingPrefix, te.msg)),
               fn.location)
          }
        }
      }
    }

    // Make sure that the explicit return type, if it exists, agrees with
    // the type computed from the function body.
    if !isnull(fn.typeExpr) {
        explicitReturnType = self.explicitType(fn.typeExpr)
        if isnull(returnType) {
            returnType = explicitReturnType
        } else {
            te = self.unify(returnType!, explicitReturnType)
            if !isnull(te) {
                self.typeError(
                    ("Could not unify\n%s    explicit return type %s\n%s    with %s:\n%s%s"
                      % (TypeLoggingPrefix, fn.typeExpr.toString(),
                         TypeLoggingPrefix, ty.toString(), TypeLoggingPrefix, te.msg)),
                    fn.location)
           }
        }
    }

    if isnull(returnType) {
      returnType = Type(TypeName(Sym.new("none")))
    }
    // Replace type variables in the parameters and return type with their
    // instantiations, if any.
    paramType = self.resolve(paramType)
    returnType = self.resolve(returnType!)

    fnType = Type(FunctionType(paramType, returnType!))
    boundVars = arrayof(Type)
    for sm in bindingScope.symbolMappings() {
      if !isnull(sm.value) && sm.value.type == Type.TypeClass.Var {
        // Has this type variable been instantiated?
        ty = self.resolve(sm.value!)
        if ty.type == Type.TypeClass.Var {
          boundVars.append(Type(ty.tyvar!))
        }
      }
    }
    // Class methods must also generalize over the enclosing class's type
    // parameters, so that each call site instantiates them freshly.
    for cv in self.classBoundVars {
      rcv = self.resolve(cv)
      if rcv.type == Type.TypeClass.Var {
        exists = false
        for bv in boundVars {
          if bv.tyvar.id == rcv.tyvar.id {
            exists = true
          }
        }
        if !exists {
          boundVars.append(Type(rcv.tyvar!))
        }
      }
    }
    if boundVars.length() > 0 {
      fnType = Type(PolymorphicType(boundVars, fnType))
    }

    // associate function name symbol to this type.
    self.newSymbol(fn.sym, fnType)
    fn.typedValue = fnType

    if db.getRoot().traceTypes {
       fn.location.annotation("\n[Typecheck] ", TypeLoggingPrefix)
       println "%s%s" % (TypeLoggingPrefix, fnType.toString())
       println "%s%s: %s" % (TypeLoggingPrefix, fn.sym.name, fnType.toString())
    }
  }
}


unittest TypeClasses {
  // Instantiate all the type classes so that they get compiled.
  v = TypeVar(0i32, null(Type))
  i = IntType(true, 3u32)
  f = FloatType(32u32)
  c = ChoiceType([Type(IntType(true, 32u32))])
  t = TupleType([Type(IntType(true, 32u32))])
  tn = TypeName("boo")
  fn = FunctionType(Type(tn), Type(tn))
  p = PolymorphicType(0u64, TypeVar(0i32, null(Type)), Type(IntType(true, 32u32)))
  p.toString()
}

unittest TypeApplyTest {
  tc = TypeChecker()
  assert tc.apply(FN(STR, INT), STR) == INT
  assert isnull(tc.apply(FN(STR, INT), INT))
  assert tc.apply(FN(INT, STR), I(64)) == STR
  assert tc.apply(POLY(1, FN(V(1), V(1))), BOOL) == BOOL
  assert isnull(tc.apply(BPOLY(1, [ANYINT], FN(V(1), V(1))), BOOL))
}

unittest SimpleTypeCheckTest {
  filepath = db.Filepath.new("test_filepath", null(db.Filepath), false)
  location = db.Location(filepath, 0u32, 0u32, 0u32)
  left = db.Expr.newConstant(db.Value("Hello"), location)
  right = db.Expr.newConstant(db.Value("World"), location)
  expr = db.Expr.newBinary(db.ExprType.Lt, left, right, location)

  tc = TypeChecker()
  assert tc.expr(expr) == BOOL
}

unittest StructTypeCheckTest {
  filepath = db.Filepath.new("test_filepath", null(db.Filepath), false)
  location = db.Location(filepath, 0u32, 0u32, 0u32)
  sym = Sym("hello")

  fn = db.Function.new(null(db.Function), db.Function.FuncType.Struct, sym,
                       db.Function.Linkage.Module, location)

  tc = TypeChecker()
  tc.structFunction(fn)
  td = TynameDefinition(sym.name, null(Type))
  def = tc.lookupTyname(sym.name)
  assert !isnull(def)
}
