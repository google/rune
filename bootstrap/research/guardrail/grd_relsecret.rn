// Guardrail fixture for the relations->desugar migration.
// Exercises, in generated relation-member codegen:
//   - OneToOne back-pointer fields (self.Bar on Foo, self.Foo on Bar)
//   - generated insertBar (ref child) / removeBar (unref child)
//   - generated destroy cascade (cascadeDelete)
//   - a secret(...) value flowing through a relation-participating class
//     and revealed, so secret-type folding over generated members is covered
// Emitted C must be BYTE-IDENTICAL before/after the desugar lift.

class Foo(self) {
  self.token = secret(0u256)
  final(self) {
    println "Destroying Foo ", <u32>self
  }
}

class Bar(self, foo: Foo) {
  foo.insertBar(self)
  final(self) {
    println "Destroying Bar ", <u32>self
  }
}

relation OneToOne Foo Bar cascade

foo0 = Foo()
foo0.token = secret(0x1234u256)
bar0 = Bar(foo0)
println "secret ok: ", reveal(foo0.token == 0x1234u256)
foo1 = Foo()
foo1.token = secret(0x5678u256)
bar1 = Bar(foo1)
println "secret ok: ", reveal(foo1.token == 0x5678u256)
bar0.destroy()
foo0 = null(foo0)
foo1 = null(foo1)
