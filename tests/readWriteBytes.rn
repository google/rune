bytes = <[u8]>readBytes(4u64)
result = [0u8]
result.resize(0u64)
result = appendBytes(result, bytes)
writeBytes(result)

// The explicit reader takes over stdin at construction and retains prefetched
// bytes in its own handle. Its filtered span reader preserves an existing
// prefix, leaves its delimiter unconsumed, gives delimiter precedence over an
// equal skipped byte, and retains a final span through EOF.
reader = byteReaderNew()
line = [80u8]
assert byteReaderPeekByte(reader) == 105u16
line = byteReaderAppendUntilByteSkippingByteInto(
    reader, line, 62u8, 45u8)
assert line.length() == 4u64
assert line[0] == 80u8
assert line[1] == 105u8
assert line[2] == 120u8
assert line[3] == 105u8
assert byteReaderPeekByte(reader) == 62u16
line = byteReaderReadlnInto(reader, line)
assert line.length() == 7u64
assert line[0] == 62u8
assert line[6] == 114u8

tail = [81u8]
tail = byteReaderAppendUntilByteSkippingByteInto(
    reader, tail, 62u8, 45u8)
assert tail.length() == 5u64
assert tail[0] == 81u8
assert tail[1] == 116u8
assert tail[4] == 108u8
assert byteReaderPeekByte(reader) == 62u16

// A delimiter equal to the skipped byte is still left for the next read.
sameByte = [82u8]
sameByte = byteReaderAppendUntilByteSkippingByteInto(
    reader, sameByte, 62u8, 62u8)
assert sameByte.length() == 1u64
assert sameByte[0] == 82u8
assert byteReaderPeekByte(reader) == 62u16
line = byteReaderReadlnInto(reader, line)
assert line.length() == 4u64
assert line[0] == 62u8
assert line[3] == 100u8

finalSpan = [83u8]
finalSpan = byteReaderAppendUntilByteSkippingByteInto(
    reader, finalSpan, 62u8, 45u8)
assert finalSpan.length() == 4u64
assert finalSpan[0] == 83u8
assert finalSpan[1] == 122u8
assert finalSpan[2] == 113u8
assert finalSpan[3] == 10u8
assert byteReaderPeekByte(reader) == 256u16
byteReaderFree(reader)

TABLE_SIZE = 256u64
table = [0u8]
table.resize(TABLE_SIZE)
i = 0u64
while i < TABLE_SIZE {
  table[i] = <u8>i
  i += 1u64
}
table[65u64] = 90u8
data = [65u8, 66u8, 67u8]
writeReverseTranslated(data, table, 2u64, 10u8)

// The masked writer is a separate opt-in surface. Its table is binary-safe:
// index 1 deliberately maps A/a to NUL, and wrapping must retain that byte.
MASKED_TABLE_SIZE = 32u64
maskedTable = [0u8]
maskedTable.resize(MASKED_TABLE_SIZE)
maskedIndex = 0u64
while maskedIndex < MASKED_TABLE_SIZE {
  maskedTable[maskedIndex] = <u8>maskedIndex
  maskedIndex += 1u64
}
maskedTable[1u64] = 0u8
maskedTable[2u64] = 66u8
maskedTable[3u64] = 67u8
maskedTable[5u64] = 69u8
maskedData = [65u8, 66u8, 67u8, 65u8, 69u8]
writeReverseMasked5Translated(maskedData, maskedTable, 2u64, 10u8)
