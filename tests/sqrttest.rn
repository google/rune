import math

println math.sqrt(4.0)

// This function is only called when the runtime reports AVX support. It keeps
// F64x4 use inside a generated function so the C backend's target annotation
// can be exercised without making the generated main AVX-only.
func f64x4TargetedSmoke() {
  lanes = [1.0f64, 4.0f64, 9.0f64, 16.0f64]
  loaded = f64x4Load(lanes, 0u64)
  source = f64x4FromLanes(f64x4Lane(loaded, 0u64),
                          f64x4Lane(loaded, 1u64),
                          f64x4Lane(loaded, 2u64),
                          f64x4Lane(loaded, 3u64))
  inverseRoot = f64x4ApproxReciprocalSqrt(source)
  // Keep the explicitly approximate operation observable in the smoke path
  // without making its platform-specific low bits part of stdout.
  if f64x4Lane(inverseRoot, 0u64) < 0.0f64 {
    println "unreachable negative reciprocal square root"
  }
  two = f64x4Splat(2.0f64)
  result = f64x4Add(source, two)
  result = f64x4Sub(result, two)
  result = f64x4Mul(result, two)
  f64x4Store(result, lanes, 0u64)
  println f64x4HorizontalSum(result)
  comparison = f64x4FromLanes(1.0f64, 3.0f64, 2.0f64, 4.0f64)
  println f64x4LessEqualMask(comparison, two)
  lengths = f64x4SquaredLengths4(
      f64x4FromLanes(1.0f64, 2.0f64, 3.0f64, 4.0f64),
      f64x4FromLanes(2.0f64, 3.0f64, 4.0f64, 5.0f64),
      f64x4FromLanes(3.0f64, 4.0f64, 5.0f64, 6.0f64),
      f64x4FromLanes(4.0f64, 5.0f64, 6.0f64, 7.0f64))
  assert f64x4Lane(lengths, 0u64) == 30.0f64
  assert f64x4Lane(lengths, 1u64) == 54.0f64
  assert f64x4Lane(lengths, 2u64) == 86.0f64
  assert f64x4Lane(lengths, 3u64) == 126.0f64
}

if simdAvxAvailable() {
  f64x4TargetedSmoke()
}
